{
  "name": "@schedjs/storage-postgres",
  "version": "0.4.2",
  "description": "Cron scheduler PostgreSQL storage adapter for Node.js — contract-tested",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@schedjs/core": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "cron",
    "scheduler",
    "job-scheduler",
    "job-queue",
    "task-scheduler",
    "background-jobs",
    "self-hosted",
    "queue",
    "nodejs",
    "typescript",
    "storage",
    "postgres",
    "postgresql"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schedjs/schedjs.git"
  },
  "homepage": "https://schedjs.github.io/schedjs",
  "bugs": {
    "url": "https://github.com/schedjs/schedjs/issues"
  },
  "author": {
    "name": "schedjs",
    "url": "https://github.com/schedjs"
  }
}
