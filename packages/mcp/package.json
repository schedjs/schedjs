{
  "name": "@schedjs/mcp",
  "version": "0.5.2",
  "description": "Cron scheduler MCP server (Model Context Protocol) for Node.js — AI control plane: list/get tasks & runs, trigger/pause/resume, delete",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sched-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@schedjs/core": "workspace:*"
  },
  "devDependencies": {
    "@schedjs/admin-api": "workspace:*"
  },
  "keywords": [
    "cron",
    "scheduler",
    "job-scheduler",
    "job-queue",
    "task-scheduler",
    "background-jobs",
    "self-hosted",
    "queue",
    "nodejs",
    "typescript",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schedjs/schedjs.git"
  },
  "homepage": "https://schedjs.github.io/schedjs",
  "bugs": {
    "url": "https://github.com/schedjs/schedjs/issues"
  },
  "author": {
    "name": "schedjs",
    "url": "https://github.com/schedjs"
  }
}
