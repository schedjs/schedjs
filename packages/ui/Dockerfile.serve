# sched-ui serve — standalone admin UI container (replaces the old nginx morda).
#   docker compose -f docker-compose.dev.yml up --build
#   → morda: http://127.0.0.1:8095  (token: dev-key, in the header field)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/ui/package.json packages/ui/
COPY packages/core/package.json packages/core/
RUN corepack enable && yarn install --mode=skip-build
COPY packages/core packages/core
COPY packages/ui packages/ui
COPY tsconfig.json vitest.config.ts ./
# core first — @schedjs/ui type-checks against @schedjs/core dist (workspace symlink)
RUN yarn exec tsc -p packages/core/tsconfig.build.json && yarn exec tsc -p packages/ui/tsconfig.build.json && node packages/ui/scripts/bundle.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/packages/ui/dist /app/dist
COPY --from=build /app/packages/ui/package.json /app/package.json
EXPOSE 8081
# /api is proxied to the daemon container on the compose network
CMD ["node", "dist/serve.js", "--host", "0.0.0.0", "--port", "8081", "--proxy", "http://daemon:8080"]
