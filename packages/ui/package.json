{
  "name": "@schedjs/ui",
  "version": "0.4.0",
  "description": "Cron scheduler admin web UI — framework-agnostic Lit components + standalone dashboard (`sched-ui serve`)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sched-ui": "dist/serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs && yarn run -T tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^16"
  },
  "keywords": [
    "cron",
    "scheduler",
    "job-scheduler",
    "job-queue",
    "task-scheduler",
    "background-jobs",
    "self-hosted",
    "queue",
    "nodejs",
    "typescript",
    "ui",
    "dashboard",
    "web-ui",
    "lit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schedjs/schedjs.git"
  },
  "homepage": "https://schedjs.github.io/schedjs",
  "bugs": {
    "url": "https://github.com/schedjs/schedjs/issues"
  },
  "author": {
    "name": "schedjs",
    "url": "https://github.com/schedjs"
  }
}
