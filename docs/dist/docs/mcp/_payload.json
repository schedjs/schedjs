cription":547,"extension":548,"links":549,"meta":550,"navigation":551,"path":121,"seo":552,"stem":122,"__hash__":553},"docs\u002Fdocs\u002F11.mcp.md",{"type":138,"value":139,"toc":539},"minimark",[140,156,164,178,183,193,197,200,206,217,221,224,230,253,257,351,355,497,513,517],[141,142,143,147,148,155],"p",{},[144,145,146],"code",{},"@schedjs\u002Fmcp"," exposes sched's control plane as a ",[149,150,154],"a",{"href":151,"rel":152},"https:\u002F\u002Fmodelcontextprotocol.org",[153],"nofollow","Model Context Protocol"," server.\nAn AI client (Claude Desktop, codex, pi, Cursor) can inspect and drive a running daemon — list tasks, read\nrun history, trigger runs, pause\u002Fresume — from natural language, with the same guarantees as the admin API.",[141,157,158,159,163],{},"The MCP server is a ",[160,161,162],"strong",{},"projection of the admin API",": it never opens storage itself, it calls the daemon's\nREST API with the same bearer key. The daemon stays the single owner of state.",[165,166,167],"blockquote",{},[141,168,169,170,173,174,177],{},"Docs MCP (search over these docs) is a separate, built-in server: Docus serves ",[144,171,172],{},"\u002Fmcp"," on the docs site\n(list-pages + read-page). This page is about the ",[160,175,176],{},"product"," MCP for managing sched.",[179,180,182],"h2",{"id":181},"install","Install",[184,185,190],"pre",{"className":186,"code":188,"language":189},[187],"language-text","yarn workspace @schedjs\u002Fmcp build\n","text",[144,191,188],{"__ignoreMap":192},"",[179,194,196],{"id":195},"run-stdio","Run (stdio)",[141,198,199],{},"Default transport for local AI clients:",[184,201,204],{"className":202,"code":203,"language":189},[187],"sched-mcp --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[144,205,203],{"__ignoreMap":192},[141,207,208,209,212,213,216],{},"Point your client at ",[144,210,211],{},"npx sched-mcp"," (or the built ",[144,214,215],{},"dist\u002Fcli.js",") with the same arguments.",[179,218,220],{"id":219},"run-streamable-http","Run (Streamable HTTP)",[141,222,223],{},"For remote\u002Fdaemon-side hosting:",[184,225,228],{"className":226,"code":227,"language":189},[187],"sched-mcp --http 8091 --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[144,229,227],{"__ignoreMap":192},[141,231,232,233,236,237,240,241,244,245,248,249,252],{},"The HTTP mode is ",[160,234,235],{},"session-based"," (stateful Streamable HTTP): each client gets its own MCP\nsession — a ",[144,238,239],{},"Mcp-Session-Id"," header is issued on ",[144,242,243],{},"initialize"," and must be echoed on later\nrequests. Sessions are removed when the client sends ",[144,246,247],{},"DELETE",", and are garbage-collected\nafter 30 min of inactivity, so a long-running server neither leaks transports nor clashes\non a shared connection. Unknown session ids are rejected with ",[144,250,251],{},"404",".",[179,254,256],{"id":255},"options","Options",[258,259,260,279],"table",{},[261,262,263],"thead",{},[264,265,266,270,273,276],"tr",{},[267,268,269],"th",{},"Flag",[267,271,272],{},"Env",[267,274,275],{},"Default",[267,277,278],{},"Meaning",[280,281,282,303,321,336],"tbody",{},[264,283,284,290,295,300],{},[285,286,287],"td",{},[144,288,289],{},"--admin-url URL",[285,291,292],{},[144,293,294],{},"SCHED_ADMIN_URL",[285,296,297],{},[144,298,299],{},"http:\u002F\u002F127.0.0.1:8080",[285,301,302],{},"Admin API base URL",[264,304,305,310,315,318],{},[285,306,307],{},[144,308,309],{},"--api-key KEY",[285,311,312],{},[144,313,314],{},"SCHED_ADMIN_KEY",[285,316,317],{},"—",[285,319,320],{},"Admin API bearer key (open in dev mode if unset)",[264,322,323,328,330,333],{},[285,324,325],{},[144,326,327],{},"--http PORT",[285,329,317],{},[285,331,332],{},"stdio",[285,334,335],{},"Serve Streamable HTTP on PORT",[264,337,338,343,345,348],{},[285,339,340],{},[144,341,342],{},"--readonly",[285,344,317],{},[285,346,347],{},"off",[285,349,350],{},"Reject mutations; only list\u002Fget tools respond",[179,352,354],{"id":353},"tools","Tools",[258,356,357,370],{},[261,358,359],{},[264,360,361,364,367],{},[267,362,363],{},"Tool",[267,365,366],{},"Args",[267,368,369],{},"Description",[280,371,372,384,399,411,426,441,455,469,483],{},[264,373,374,379,381],{},[285,375,376],{},[144,377,378],{},"list_tasks",[285,380,317],{},[285,382,383],{},"All tasks: name, runner, schedule, paused, next run",[264,385,386,391,396],{},[285,387,388],{},[144,389,390],{},"get_task",[285,392,393],{},[144,394,395],{},"name",[285,397,398],{},"One task, full config",[264,400,401,406,408],{},[285,402,403],{},[144,404,405],{},"list_schedules",[285,407,317],{},[285,409,410],{},"Schedules: taskName, schedule (cron\u002Finterval\u002Fonce), tz, nextRunAt, lastRunAt, paused, effectiveStatus",[264,412,413,418,423],{},[285,414,415],{},[144,416,417],{},"list_runs",[285,419,420],{},[144,421,422],{},"task? status? limit? offset?",[285,424,425],{},"Runs, newest first; filter by task\u002Fstatus",[264,427,428,433,438],{},[285,429,430],{},[144,431,432],{},"get_run",[285,434,435],{},[144,436,437],{},"runId",[285,439,440],{},"One run: status, error, log, result, artifacts",[264,442,443,448,452],{},[285,444,445],{},[144,446,447],{},"trigger_task",[285,449,450],{},[144,451,395],{},[285,453,454],{},"Run a task immediately (mutation)",[264,456,457,462,466],{},[285,458,459],{},[144,460,461],{},"pause_task",[285,463,464],{},[144,465,395],{},[285,467,468],{},"Stop scheduling a task (mutation)",[264,470,471,476,480],{},[285,472,473],{},[144,474,475],{},"resume_task",[285,477,478],{},[144,479,395],{},[285,481,482],{},"Resume a paused task (mutation)",[264,484,485,490,494],{},[285,486,487],{},[144,488,489],{},"delete_run",[285,491,492],{},[144,493,437],{},[285,495,496],{},"Delete a run from history (mutation)",[141,498,499,500,502,503,502,505,502,507,509,510,512],{},"Mutations (",[144,501,447],{},", ",[144,504,461],{},[144,506,475],{},[144,508,489],{},") are disabled in ",[144,511,342],{}," mode.",[179,514,516],{"id":515},"safety-model","Safety model",[518,519,520,527,533],"ul",{},[521,522,523,526],"li",{},[160,524,525],{},"Server-side validation"," — schedules\u002Fstatuses are validated by the admin API; unknown tasks\u002Fruns\nreturn a clear error, never a crash.",[521,528,529,532],{},[160,530,531],{},"Read-only mode"," — hard gate for automation: mutations answer with an explicit error.",[521,534,535,538],{},[160,536,537],{},"Human approval"," — the MCP server does not invent a confirm protocol; the confirm gate lives in\nthe AI-client layer: the AI proposes, a human approves, the AI calls the mutation tool.",{"title":192,"searchDepth":12,"depth":12,"links":540},[541,542,543,544,545,546],{"id":181,"depth":12,"text":182},{"id":195,"depth":12,"text":196},{"id":219,"depth":12,"text":220},{"id":255,"depth":12,"text":256},{"id":353,"depth":12,"text":354},{"id":515,"depth":12,"text":516},"Product MCP — AI control plane over the admin API (list\u002Fget tasks & runs, trigger\u002Fpause\u002Fresume, delete)","md",null,{},true,{"title":120,"description":547},"16UwUtf9OYyeaJpNVJrYc3nLrCWzBfmNquSq4czDjLc",[555,558],{"title":112,"path":113,"stem":114,"description":556,"order":115,"badge":557,"children":-1},"Four ways to consume the sched admin UI — standalone, embedded at a path, components, or your own on the admin api",{"label":117,"color":118},{"title":124,"path":125,"stem":126,"description":559,"children":-1},"schedd (daemon) flags, env vars, config + sched (operator CLI) commands, exit codes",1787817621353]