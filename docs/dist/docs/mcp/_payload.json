39},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":129,"body":146,"description":793,"extension":794,"links":795,"meta":796,"navigation":797,"path":130,"seo":798,"stem":131,"__hash__":799},"docs\u002Fdocs\u002F12.mcp.md",{"type":147,"value":148,"toc":785},"minimark",[149,165,173,187,192,202,206,209,215,226,230,233,239,262,266,360,364,696,723,759,763],[150,151,152,156,157,164],"p",{},[153,154,155],"code",{},"@schedjs\u002Fmcp"," exposes sched's control plane as a ",[158,159,163],"a",{"href":160,"rel":161},"https:\u002F\u002Fmodelcontextprotocol.org",[162],"nofollow","Model Context Protocol"," server.\nAn AI client (Claude Desktop, codex, pi, Cursor) can inspect and drive a running daemon — list tasks, read\nrun history, trigger runs, pause\u002Fresume — from natural language, with the same guarantees as the admin API.",[150,166,167,168,172],{},"The MCP server is a ",[169,170,171],"strong",{},"projection of the admin API",": it never opens storage itself, it calls the daemon's\nREST API with the same bearer key. The daemon stays the single owner of state.",[174,175,176],"blockquote",{},[150,177,178,179,182,183,186],{},"Docs MCP (search over these docs) is a separate, built-in server: Docus serves ",[153,180,181],{},"\u002Fmcp"," on the docs site\n(list-pages + read-page). This page is about the ",[169,184,185],{},"product"," MCP for managing sched.",[188,189,191],"h2",{"id":190},"install","Install",[193,194,199],"pre",{"className":195,"code":197,"language":198},[196],"language-text","yarn workspace @schedjs\u002Fmcp build\n","text",[153,200,197],{"__ignoreMap":201},"",[188,203,205],{"id":204},"run-stdio","Run (stdio)",[150,207,208],{},"Default transport for local AI clients:",[193,210,213],{"className":211,"code":212,"language":198},[196],"sched-mcp --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[153,214,212],{"__ignoreMap":201},[150,216,217,218,221,222,225],{},"Point your client at ",[153,219,220],{},"npx sched-mcp"," (or the built ",[153,223,224],{},"dist\u002Fcli.js",") with the same arguments.",[188,227,229],{"id":228},"run-streamable-http","Run (Streamable HTTP)",[150,231,232],{},"For remote\u002Fdaemon-side hosting:",[193,234,237],{"className":235,"code":236,"language":198},[196],"sched-mcp --http 8091 --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[153,238,236],{"__ignoreMap":201},[150,240,241,242,245,246,249,250,253,254,257,258,261],{},"The HTTP mode is ",[169,243,244],{},"session-based"," (stateful Streamable HTTP): each client gets its own MCP\nsession — a ",[153,247,248],{},"Mcp-Session-Id"," header is issued on ",[153,251,252],{},"initialize"," and must be echoed on later\nrequests. Sessions are removed when the client sends ",[153,255,256],{},"DELETE",", and are garbage-collected\nafter 30 min of inactivity, so a long-running server neither leaks transports nor clashes\non a shared connection. Unknown session ids are rejected with ",[153,259,260],{},"404",".",[188,263,265],{"id":264},"options","Options",[267,268,269,288],"table",{},[270,271,272],"thead",{},[273,274,275,279,282,285],"tr",{},[276,277,278],"th",{},"Flag",[276,280,281],{},"Env",[276,283,284],{},"Default",[276,286,287],{},"Meaning",[289,290,291,312,330,345],"tbody",{},[273,292,293,299,304,309],{},[294,295,296],"td",{},[153,297,298],{},"--admin-url URL",[294,300,301],{},[153,302,303],{},"SCHED_ADMIN_URL",[294,305,306],{},[153,307,308],{},"http:\u002F\u002F127.0.0.1:8080",[294,310,311],{},"Admin API base URL",[273,313,314,319,324,327],{},[294,315,316],{},[153,317,318],{},"--api-key KEY",[294,320,321],{},[153,322,323],{},"SCHED_ADMIN_KEY",[294,325,326],{},"—",[294,328,329],{},"Admin API bearer key (open in dev mode if unset)",[273,331,332,337,339,342],{},[294,333,334],{},[153,335,336],{},"--http PORT",[294,338,326],{},[294,340,341],{},"stdio",[294,343,344],{},"Serve Streamable HTTP on PORT",[273,346,347,352,354,357],{},[294,348,349],{},[153,350,351],{},"--readonly",[294,353,326],{},[294,355,356],{},"off",[294,358,359],{},"Reject mutations; only list\u002Fget tools respond",[188,361,363],{"id":362},"tools","Tools",[267,365,366,379],{},[270,367,368],{},[273,369,370,373,376],{},[276,371,372],{},"Tool",[276,374,375],{},"Args",[276,377,378],{},"Description",[289,380,381,393,408,424,439,465,480,494,508,522,549,564,583,597,612,626,640,656,668,682],{},[273,382,383,388,390],{},[294,384,385],{},[153,386,387],{},"list_tasks",[294,389,326],{},[294,391,392],{},"All tasks: name, runner, schedule, paused, next run",[273,394,395,400,405],{},[294,396,397],{},[153,398,399],{},"get_task",[294,401,402],{},[153,403,404],{},"name",[294,406,407],{},"One task, full config",[273,409,410,415,417],{},[294,411,412],{},[153,413,414],{},"list_schedules",[294,416,326],{},[294,418,419,420,423],{},"Schedules: taskName, schedule (cron\u002Finterval\u002Fonce), tz, nextRunAt, lastRunAt, paused, disabled, disabledBy, effectiveStatus (",[153,421,422],{},"disabled"," when the row or its task is disabled)",[273,425,426,431,436],{},[294,427,428],{},[153,429,430],{},"get_schedule",[294,432,433],{},[153,434,435],{},"scheduleId",[294,437,438],{},"One schedule: rule, tz, data, effectiveStatus",[273,440,441,446,451],{},[294,442,443],{},[153,444,445],{},"create_schedule",[294,447,448],{},[153,449,450],{},"taskName schedule tz?",[294,452,453,454,457,458,461,462],{},"Create (or upsert by ",[153,455,456],{},"dedupKey",") a schedule (mutation); ",[153,459,460],{},"data"," validated against the task ",[153,463,464],{},"inputSchema",[273,466,467,472,477],{},[294,468,469],{},[153,470,471],{},"update_schedule",[294,473,474],{},[153,475,476],{},"scheduleId schedule? tz?",[294,478,479],{},"Edit a schedule in place (mutation, partial merge)",[273,481,482,487,491],{},[294,483,484],{},[153,485,486],{},"pause_schedule",[294,488,489],{},[153,490,435],{},[294,