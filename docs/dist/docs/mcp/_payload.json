39},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":129,"body":146,"description":789,"extension":790,"links":791,"meta":792,"navigation":793,"path":130,"seo":794,"stem":131,"__hash__":795},"docs\u002Fdocs\u002F12.mcp.md",{"type":147,"value":148,"toc":781},"minimark",[149,165,173,187,192,202,206,209,215,226,230,233,239,262,266,360,364,692,719,755,759],[150,151,152,156,157,164],"p",{},[153,154,155],"code",{},"@schedjs\u002Fmcp"," exposes sched's control plane as a ",[158,159,163],"a",{"href":160,"rel":161},"https:\u002F\u002Fmodelcontextprotocol.org",[162],"nofollow","Model Context Protocol"," server.\nAn AI client (Claude Desktop, codex, pi, Cursor) can inspect and drive a running daemon — list tasks, read\nrun history, trigger runs, pause\u002Fresume — from natural language, with the same guarantees as the admin API.",[150,166,167,168,172],{},"The MCP server is a ",[169,170,171],"strong",{},"projection of the admin API",": it never opens storage itself, it calls the daemon's\nREST API with the same bearer key. The daemon stays the single owner of state.",[174,175,176],"blockquote",{},[150,177,178,179,182,183,186],{},"Docs MCP (search over these docs) is a separate, built-in server: Docus serves ",[153,180,181],{},"\u002Fmcp"," on the docs site\n(list-pages + read-page). This page is about the ",[169,184,185],{},"product"," MCP for managing sched.",[188,189,191],"h2",{"id":190},"install","Install",[193,194,199],"pre",{"className":195,"code":197,"language":198},[196],"language-text","yarn workspace @schedjs\u002Fmcp build\n","text",[153,200,197],{"__ignoreMap":201},"",[188,203,205],{"id":204},"run-stdio","Run (stdio)",[150,207,208],{},"Default transport for local AI clients:",[193,210,213],{"className":211,"code":212,"language":198},[196],"sched-mcp --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[153,214,212],{"__ignoreMap":201},[150,216,217,218,221,222,225],{},"Point your client at ",[153,219,220],{},"npx sched-mcp"," (or the built ",[153,223,224],{},"dist\u002Fcli.js",") with the same arguments.",[188,227,229],{"id":228},"run-streamable-http","Run (Streamable HTTP)",[150,231,232],{},"For remote\u002Fdaemon-side hosting:",[193,234,237],{"className":235,"code":236,"language":198},[196],"sched-mcp --http 8091 --admin-url http:\u002F\u002F127.0.0.1:8080 --api-key \u003CSCHED_ADMIN_KEY>\n",[153,238,236],{"__ignoreMap":201},[150,240,241,242,245,246,249,250,253,254,257,258,261],{},"The HTTP mode is ",[169,243,244],{},"session-based"," (stateful Streamable HTTP): each client gets its own MCP\nsession — a ",[153,247,248],{},"Mcp-Session-Id"," header is issued on ",[153,251,252],{},"initialize"," and must be echoed on later\nrequests. Sessions are removed when the client sends ",[153,255,256],{},"DELETE",", and are garbage-collected\nafter 30 min of inactivity, so a long-running server neither leaks transports nor clashes\non a shared connection. Unknown session ids are rejected with ",[153,259,260],{},"404",".",[188,263,265],{"id":264},"options","Options",[267,268,269,288],"table",{},[270,271,272],"thead",{},[273,274,275,279,282,285],"tr",{},[276,277,278],"th",{},"Flag",[276,280,281],{},"Env",[276,283,284],{},"Default",[276,286,287],{},"Meaning",[289,290,291,312,330,345],"tbody",{},[273,292,293,299,304,309],{},[294,295,296],"td",{},[153,297,298],{},"--admin-url URL",[294,300,301],{},[153,302,303],{},"SCHED_ADMIN_URL",[294,305,306],{},[153,307,308],{},"http:\u002F\u002F127.0.0.1:8080",[294,310,311],{},"Admin API base URL",[273,313,314,319,324,327],{},[294,315,316],{},[153,317,318],{},"--api-key KEY",[294,320,321],{},[153,322,323],{},"SCHED_ADMIN_KEY",[294,325,326],{},"—",[294,328,329],{},"Admin API bearer key (open in dev mode if unset)",[273,331,332,337,339,342],{},[294,333,334],{},[153,335,336],{},"--http PORT",[294,338,326],{},[294,340,341],{},"st