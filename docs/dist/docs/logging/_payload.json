"class":237},[227,354,252],{"class":241},[227,356,357],{"class":237},"attempt",[227,359,299],{"class":259},[227,361,302],{"class":241},[159,363,365,366],{"id":364},"_2-terminal-events-onrunfinal","2. Terminal events — ",[167,367,368],{},"onRunFinal",[150,370,371,372,374,375,378,379,382,383,382,386,389,390,392,393,396,397,400,401,404],{},"The ",[167,373,368],{}," hook fires once per run reaching a ",[154,376,377],{},"terminal"," state\n(",[167,380,381],{},"succeeded"," \u002F ",[167,384,385],{},"failed",[167,387,388],{},"cancelled",") — with the finished ",[167,391,169],{}," and the\nrun's ",[154,394,395],{},"streak context",": ",[167,398,399],{},"previousFailures",", the number of terminal failures\nthat preceded it (0 = a fresh incident). Wire it to your logger, metrics, or the\nbuilt-in status alerts (",[167,402,403],{},"createAlerts"," — webhook):",[218,406,408],{"className":220,"code":407,"language":222,"meta":223,"style":223},"const engine = createEngine({\n  \u002F\u002F ...\n  onRunFinal: (run, { previousFailures }) => {\n    console.log(`[sched] ${run.taskName} ${run.status} attempt=${run.attempt} after ${previousFailures} failure(s) ${run.error ?? ''}`);\n  },\n});\n",[167,409,410,427,433,465,558,564],{"__ignoreMap":223},[227,411,412,414,417,419,422,424],{"class":229,"line":230},[227,413,234],{"class":233},[227,415,416],{"class":237}," engine",[227,418,242],{"class":241},[227,420,421],{"class":255}," createEngine",[227,423,260],{"class":259},[227,425,426],{"class":241},"{\n",[227,428,429],{"class":229,"line":21},[227,430,432],{"class":431},"s9Tkl","  \u002F\u002F ...\n",[227,434,436,439,441,443,447,449,452,455,458,462],{"class":229,"line":435},3,[227,437,438],{"class":255},"  onRunFinal",[227,440,270],{"class":241},[227,442,310],{"class":241},[227,444,446],{"class":445},"sqOPj","run",[227,448,284],{"class":241},[227,450,451],{"class":241}," {",[227,453,454],{"class":445}," previousFailures",[227,456,457],{"class":241}," })",[227,459,461],{"class":460},"sIOq