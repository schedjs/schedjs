"class":237},[227,354,252],{"class":241},[227,356,357],{"class":237},"attempt",[227,359,299],{"class":259},[227,361,302],{"class":241},[159,363,365,366],{"id":364},"_2-terminal-events-onrunfinal","2. Terminal events — ",[167,367,368],{},"onRunFinal",[150,370,371,372,374,375,378,379,382,383,382,386,389,390,392,393,396,397,400,401,404],{},"The ",[167,373,368],{}," hook fires once per run reaching a ",[154,376,377],{},"terminal"," state\n(",[167,380,381],{},"succeeded"," \u002F ",[167,384,385],{},"failed",[167,387,388],{},"cancelled",") — with the finished ",[167,391,169],{}," and the\nrun's ",[154,394,395],{},"streak context",": ",[167,398,399],{},"previousFailures",", the number of terminal failures\nthat preceded it (0 = a fresh incident). Wire it to your logger, metrics, or the\nbuilt-in status alerts (",[167,402,403],{},"createAlerts"," — webhook):",[218,406,408],{"className":220,"code":407,"language":222,"meta":223,"style":223},"const engine = createEngine({\n  \u002F\u002F ...\n  onRunFinal: (run, { previousFailures }) => {\n    console.log(`[sched] ${run.taskName} ${run.status} attempt=${run.attempt} after ${previousFailures} failure(s) ${run.error ?? ''}`);\n  },\n});\n",[167,409,410,427,433,465,558,564],{"__ignoreMap":223},[227,411,412,414,417,419,422,424],{"class":229,"line":230},[227,413,234],{"class":233},[227,415,416],{"class":237}," engine",[227,418,242],{"class":241},[227,420,421],{"class":255}," createEngine",[227,423,260],{"class":259},[227,425,426],{"class":241},"{\n",[227,428,429],{"class":229,"line":21},[227,430,432],{"class":431},"s9Tkl","  \u002F\u002F ...\n",[227,434,436,439,441,443,447,449,452,455,458,462],{"class":229,"line":435},3,[227,437,438],{"class":255},"  onRunFinal",[227,440,270],{"class":241},[227,442,310],{"class":241},[227,444,446],{"class":445},"sqOPj","run",[227,448,284],{"class":241},[227,450,451],{"class":241}," {",[227,453,454],{"class":445}," previousFailures",[227,456,457],{"class":241}," })",[227,459,461],{"class":460},"sIOqK"," =>",[227,463,464],{"class":241}," {\n",[227,466,468,471,473,475,478,481,484,488,491,493,496,499,502,504,506,508,510,513,515,517,519,521,523,526,528,530,532,535,537,539,541,544,547,550,552,554,556],{"class":229,"line":467},4,[227,469,470],{"class":237},"    console",[227,472,252],{"class":241},[227,474,173],{"class":255},[227,476,260],{"class":477},"sLdnO",[227,479,480],{"class":273},"`",[227,482,483],{"class":277},"[sched] ",[227,485,487],{"class":486},"s8XtY","${",[227,489,446],{"class":490},"su_V2",[227,492,252],{"class":241},[227,494,495],{"class":490},"taskName",[227,497,498],{"class":486},"}",[227,500,501],{"class":486}," ${",[227,503,446],{"class":490},[227,505,252],{"class":241},[227,507,348],{"class":490},[227,509,498],{"class":486},[227,511,512],{"class":277}," attempt=",[227,514,487],{"class":486},[227,516,446],{"class":490},[227,518,252],{"class":241},[227,520,357],{"class":490},[227,522,498],{"class":486},[227,524,525],{"class":277}," after ",[227,527,487],{"class":486},[227,529,399],{"class":490},[227,531,498],{"class":486},[227,533,534],{"class":277}," failure(s) ",[227,536,487],{"class":486},[227,538,446],{"class":490},[227,540,252],{"class":241},[227,542,543],{"class":490},"error ",[227,545,546],{"class":318},"??",[227,548,549],{"class":273}," ''",[227,551,498],{"class":486},[227,553,480],{"class":273},[227,555,299],{"class":477},[227,557,302],{"class":241},[227,559,561],{"class":229,"line":560},5,[227,562,563],{"class":241},"  },\n",[227,565,567,569,571],{"class":229,"line":566},6,[227,568,498],{"class":241},[227,570,299],{"class":259},[227,572,302],{"class":241},[150,574,575],{},"Two semantics worth knowing:",[176,577,578,598],{},[179,579,580,583,584,588,589,592,593,213],{},[154,581,582],{},"Retries defer the hook."," A failed run with retries left does ",[585,586,587],"em",{},"not"," fire — the alert\nlands only on the ",[154,590,591],{},"final, exhausted"," failure (that's what \"persistent failure\"\nmeans; see ",[594,595,597],"a",{"href":596},"tasks#retry","Tasks → retry",[179,599,600,184,603,606],{},[154,601,602],{},"Manual triggers always fire",[167,604,605],{},"triggerTask"," is a one-shot, its result alerts\nimmediately, and it never auto-retries.",[608,609,611],"h3",{"id":610},"streak-context-why-alerts-fire-once-per-incident","Streak context — why alerts fire once per incident",[150,613,614,616,617,620,621,623,624,626],{},[167,615,399],{}," is the engine's snapshot of a task's ",[154,618,619],{},"consecutive terminal\nfailures before this run",", taken before the terminal write. Only alert-eligible\nruns move it: a failure with a retry still scheduled is not an incident yet, and\na ",[167,622,388],{}," run neither counts nor breaks a streak (a human acted, not the\npipeline). A ",[167,625,381],{}," run resets it.",[150,628,629,310,631,634,635,639,640,643],{},[167,630,403],{},[167,632,633],{},"onStreak",", see ",[594,636,638],{"href":637},"self-hosting#status-alerts","Self-hosting → Status alerts",")\nuses it to send ",[154,641,642],{},"one"," message per incident instead of one per run:",[645,646,647,666],"table",{},[648,649,650],"thead",{},[651,652,653,656,660],"tr",{},[654,655,446],"th",{},[654,657,658],{},[167,659,399],{},[654,661,662,665],{},[167,663,664],{},"onStreak: 3"," → alert",[667,668,669,681,692,709,720,736],"tbody",{},[651,670,671,675,678],{},[672,673,674],"td",{},"1st failure",[672,676,677],{},"0",[672,679,680],{},"silent (1 ≠ 3)",[651,682,683,686,689],{},[672,684,685],{},"2nd failure",[672,687,688],{},"1",[672,690,691],{},"silent",[651,693,694,697,700],{},[672,695,696],{},"3rd failure",[672,698,699],{},"2",[672,701,702,705,706],{},[167,703,704],{},"run.failed"," + ",[167,707,708],{},"consecutiveFailures: 3",[651,710,711,714,717],{},[672,712,713],{},"4th failure",[672,715,716],{},"3",[672,718,719],{},"silent — one alert per streak, no reminders",[651,721,722,725,727],{},[672,723,724],{},"success",[672,726,716],{},[672,728,729,705,732,735],{},[167,730,731],{},"run.succeeded",[167,733,734],{},"previousFailures: 3"," («отпустило»)",[651,737,738,741,743],{},[672,739,740],{},"next failure",[672,742,677],{},[672,744,745],{},"a fresh incident — silent until the streak reaches 3 again",[150,747,748,749,752,753,756,757,759,760,763,764,767,768,771],{},"The counter lives in the engine process, not in storage: the storage\n",[167,750,751],{},"failCount"," is ",[585,754,755],{},"cumulative"," (never reset by a success), and a persisted\nconsecutive-counter would be a ",[167,758,75],{},"-contract change. A daemon restart\n",[154,761,762],{},"forgets an in-flight streak",": the count restarts from 1, so with\n",[167,765,766],{},"onStreak: N > 1"," the next failure is silent again and the alert only lands\nafter a further N−1 terminal failures — carrying ",[167,769,770],{},"consecutiveFailures: N",", the\npost-restart count, not the incident's true depth. The cost is lateness (up to\nN−1 runs), never silence: no alert is ever lost for good.",[150,773,774,776,777,779,780,783,784,787,788,791,792,213],{},[167,775,403],{}," (webhook) is a ready-made ",[167,778,368],{}," consumer — wire it as\n",[167,781,782],{},"onRunFinal: createAlerts(config).handleFinal"," and\n",[167,785,786],{},"onEvent: createAlerts(config).handleEvent"," (daemon: the ",[167,789,790],{},"alerts"," option; see\n",[594,793,638],{"href":637},[159,795,797],{"id":796},"_3-engine-events-claim-dispatch-retry-zombie-reap","3. Engine events — claim \u002F dispatch \u002F retry \u002F zombie reap",[150,799,800,801,804,805,808],{},"The engine core stays silent by default, but ships a native event stream via\n",[167,802,803],{},"onEvent"," — a typed union of lifecycle events, one per claim, dispatch, run\noutcome, retry schedule, poll and zombie reap. This is the supported way to\nwatch ",[585,806,807],{},"why"," a task fired (or didn't):",[218,810,812],{"className":220,"code":811,"language":222,"meta":223,"style":223},"import { createEngine, createEventLogger } from '@schedjs\u002Fcore';\n\nconst engine = createEngine({\n  storage,\n  runner,\n  onEvent: createEventLogger(), \u002F\u002F ready-made console formatter\n});\n",[167,813,814,842,848,862,870,877,894],{"__ignoreMap":223},[227,815,816,819,821,823,825,828,830,833,835,838,840],{"class":229,"line":230},[227,817,818],{"class":245},"import",[227,820,451],{"class":241},[227,822,421],{"class":237},[227,824,284],{"class":241},[227,826,827],{"class":237}," createEventLogger",[227,829,296],{"class":241},[227,831,832],{"class":245}," from",[227,834,274],{"class":273},[227,836,837],{"class":277},"@schedjs\u002Fcore",[227,839,281],{"class":273},[227,841,302],{"class":241},[227,843,844],{"class":229,"line":21},[227,845,847],{"emptyLinePlaceholder":846},true,"\n",[227,849,850,852,854,856,858,860],{"class":229,"line":435},[227,851,234],{"class":233},[227,853,416],{"class":237},[227,855,242],{"class":241},[227,857,421],{"class":255},[227,859,260],{"class":259},[227,861,426],{"class":241},[227,863,864,867],{"class":229,"line":467},[227,865,866],{"class":237},"  storage",[227,868,869],{"class":241},",\n",[227,871,872,875],{"class":229,"line":560},[227,873,874],{"class":237},"  runner",[227,876,869],{"class":241},[227,878,879,882,884,886,889,891],{"class":229,"line":566},[227,880,881],{"class":266},"  onEvent",[227,883,270],{"class":241},[227,885,827],{"class":255},[227,887,888],{"class":259},"()",[227,890,284],{"class":241},[227,892,893],{"class":431}," \u002F\u002F ready-made console formatter\n",[227,895,897,899,901],{"class":229,"line":896},7,[227,898,498],{"class":241},[227,900,299],{"class":259},[227,902,302],{"class":241},[150,904,905,906,382,908,382,911,913],{},"The events (all carry ",[167,907,495],{},[167,909,910],{},"runId",[167,912,357],{}," where relevant):",[645,915,916,929],{},[648,917,918],{},[651,919,920,923,926],{},[654,921,922],{},"Event",[654,924,925],{},"When",[654,927,928],{},"Extra fields",[667,930,931,946,959,974,996,1015,1033,1050,1087,1102,1119],{},[651,932,933,938,941],{},[672,934,935],{},[167,