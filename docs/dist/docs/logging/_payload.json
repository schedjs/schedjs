0,1290,1291,1292,1294,1295,1298],{},"The engine's storage calls remain a valid, lower-level observation point —\nevery engine action (due scan, claim, completion, zombie reap) is a ",[167,1293,75],{},"\nmethod call, so a proxy logs the lifecycle at a coarser granularity (e.g. to\ncapture ",[556,1296,1297],{},"skipped"," claims, which the event stream intentionally leaves silent):",[218,1300,1302],{"className":220,"code":1301,"language":222,"meta":223,"style":223},"import type { Storage } from '@schedjs\u002Fcore';\n\nfunction loggingStorage(s: Storage): Storage {\n  return {\n    ...s,\n    async listDueTasks(now) {\n      const due = await s.listDueTasks(now);\n      console.log(`[sched] tick: ${due.length} due`);\n      return due;\n    },\n    async claimTask(name, at) {\n      const ok = await s.claimTask(name, at);\n      console.log(`[sched] claim ${name} → ${ok ? 'taken' : 'skipped (locked\u002Fpaused)'}`);\n      return ok;\n    },\n    async completeTask(name, result) {\n      await s.completeTask(name, result);\n      console.log(`[sched] done ${name} failed=${result.failed} next=${result.nextRunAt?.toISOString()}`);\n    },\n    async reapZombieLocks(olderThan) {\n      const n = await s.reapZombieLocks(olderThan);\n      if (n > 0) console.log(`[sched] reaped ${n} zombie lock(s)`);\n      return n;\n    },\n  };\n}\n\n\u002F\u002F pass the wrapper to the engine:\ncreateEngine({ storage: loggingStorage(createSqliteStorage(db)), \u002F* ... *\u002F });\n",[167,1303,1304,1328,1332,1357,1364,1373,1391,1419,1457,1467,1472,1494,1525,1583,1592,1597,1618,1643,1706,1711,1728,1755,1802,1811,1816,1822,1828,1833,1839],{"__ignoreMap":223},[227,1305,1306,1308,1311,1313,1316,1318,1320,1322,1324,1326],{"class":229,"line":230},[227,1307,626],{"class":245},[227,1309,1310],{"class":245}," type",[227,1312,629],{"class":241},[227,1314,1315],{"class":237}," Storage",[227,1317,296],{"class":241},[227,1319,641],{"class":245},[227,1321,274],{"class":273},[227,1323,646],{"class":