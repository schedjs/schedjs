96},"tasks#retry","Tasks → retry",[179,599,600,184,603,606],{},[154,601,602],{},"Manual triggers always fire",[167,604,605],{},"triggerTask"," is a one-shot, its result alerts\nimmediately, and it never auto-retries.",[608,609,611],"h3",{"id":610},"streak-context-why-alerts-fire-once-per-incident","Streak context — why alerts fire once per incident",[150,613,614,616,617,620,621,623,624,626],{},[167,615,399],{}," is the engine's snapshot of a task's ",[154,618,619],{},"consecutive terminal\nfailures before this run",", taken before the terminal write. Only alert-eligible\nruns move it: a failure with a retry still scheduled is not an incident yet, and\na ",[167,622,388],{}," run neither counts nor breaks a streak (a human acted, not the\npipeline). A ",[167,625,381],{}," run resets it.",[150,628,629,310,631,634,635,639,640,643],{},[167,630,403],{},[167,632,633],{},"onStreak",", see ",[594,636,638],{"href":637},"self-hosting#status-alerts","Self-hosting → Status alerts",")\nuses it to send ",[154,641,642],{},"one"," message per incident instead of one per run:",[645,646,647,666],"table",{},[648,649,650],"thead",{},[651,652,653,656,660],"tr",{},[654,655,446],"th",{},[654,657,658],{},[167,659,399],{},[654,661,662,665],{},[167,663,664],{},"onStreak: 3"," → alert",[667,668,669,681,692,709,720,736],"tbody",{},[651,670,671,675,678],{},[672,673,674],"td",{},"1st failure",[672,676,677],{},"0",[672,679,680],{},"silent (1 ≠ 3)",[651,682,683,686,689],{},[672,684,685],{},"2nd failure",[672,687,688],{},"1",[672,690,691],{},"silent",[651,693,694,697,700],{},[672,695,696],{},"3rd failure",[672,698,699],{},"2",[672,701,702,705,706],{},[167,703,704],{},"run.failed"," + ",[167,707,708],{},"consecutiveFailures: 3",[651,710,711,714,717],{},[672,712,713],{},"4th failure",[672,715,716],{},"3",[672,718,719],{},"silent — one alert per streak, no reminders",[651,721,722,725,727],{},[672,723,724],{},"success",[672,726,716],{},[672,728,729,705,732,735],{},[167,730,731],{},"run.succeeded",[167,733,734],{},"previousFailures: 3"," («отпустило»)",[651,737,738,741,743],{},[672,739,740],{},"next failure",[672,742,677],{},[672,744,745],{},"a fresh incident alerts again",[150,747,748,749,752,753,756,757,759],{},"The counter lives in the engine process, not in storage: the storage\n",[167,750,751],{},"failCount"," is ",[585,754,755],{},"cumulative"," (never reset by a success), and a persisted\nconsecutive-counter would be a ",[167,758,75],{},"-contract change. A daemon restart\nforgets an in-flight streak — the next failure alerts once more rather than\nstaying silent (no alert is ever lost).",[150,761,762,764,765,767,768,771,772,775,776,779,780,213],{},[167,763,403],{}," (webhook) is a ready-made ",[167,766,368],{}," consumer — wire it as\n",[167,769,770],{},"onRunFinal: createAlerts(config).handleFinal"," and\n",[167,773,774],{},"onEvent: createAlerts(config).handleEvent"," (daemon: the ",[167,777,778],{},"alerts"," option; see\n",[594,781,638],{"href":637},[159,783,785],{"id":784},"_3-engine-events-claim-dispatch-retry-zombie-reap","3. Engine events — claim \u002F dispatch \u002F retry \u002F zombie reap",[150,787,788,789,792,793,796],{},"The engine core stays silent by default, but ships a native event stream via\n",[167,790,791],{},"onEvent"," — a typed union of lifecycle events, one per claim, dispatch, run\noutcome, retry schedule, poll and zombie reap. This is the supported way to\nwatch ",[585,794,795],{},"why"," a task fired (or didn't):",[218,798,800],{"className":220,"code":799,"language":222,"meta":223,"style":223},"import { createEngine, createEventLogger } from '@schedjs\u002Fcore';\n\nconst engine = createEngine({\n  storage,\n  runner,\n  onEvent: createEventLogger(), \u002F\u002F ready-made console formatter\n});\n",[167,801,802,830,836,850,858,865,882],{"__ignoreMap":223},[227,803,804,807,809,811,813,816,818,821,823,826,828],{"class":229,"line":230},[227,805,806],{"class":245},"import",[227,808,451],{"class":241},[227,810,421],{"class":237},[22