,{"href":600},"self-hosting#status-alerts","Self-hosting → Status alerts",[159,603,605],{"id":604},"_3-engine-events-claim-dispatch-retry-zombie-reap","3. Engine events — claim \u002F dispatch \u002F retry \u002F zombie reap",[150,607,608,609,612,613,616],{},"The engine core stays silent by default, but ships a native event stream via\n",[167,610,611],{},"onEvent"," — a typed union of lifecycle events, one per claim, dispatch, run\noutcome, retry schedule, poll and zombie reap. This is the supported way to\nwatch ",[556,614,615],{},"why"," a task fired (or didn't):",[218,618,620],{"className":220,"code":619,"language":222,"meta":223,"style":223},"import { createEngine, createEventLogger } from '@schedjs\u002Fcore';\n\nconst engine = createEngine({\n  storage,\n  runner,\n  onEvent: createEventLogger(), \u002F\u002F ready-made console formatter\n});\n",[167,621,622,651,657,671,679,686,703],{"__ignoreMap":223},[227,623,624,627,630,632,634,637,639,642,644,647,649],{"class":229,"line":230},[227,625,626],{"class":245},"import",[227,628,629],{"class":241}," {",[227,631,413],{"class":237},[227,633,284],{"class":241},[227,635,636],{"class":237}," createEventLogger",[227,638,296],{"class":241},[227,640,641],{"class":245}," from",[227,643,274],{"class":273},[227,645,646],{"class":277},"@schedjs\u002Fcore",[227,648,281],{"class":273},[227,650,302],{"class":241},[227,652,653],{"class":229,"line":21},[227,654,656],{"emptyLinePlaceholder":655},true,"\n",[227,658,659,661,663,665,667,669],{"class":229,"line":427},[227,660,234],{"class":233},[227,662,408],{"class":237},[227,664,242],{"class":241},[227,666,413],{"class":255},[227,668,260],{"class":259},[227,670,418],{"class":241},[227,672,673,676],{"class":229,"line":450},[227,674,675],{"class":237},"  storage",[227,677,678],{"class":241},",\n",[227,680,681,684],{"class":229,"line":531},[227,682,683],{"class":237},"  runner",[227,685,678],{"class":241},[227,687,688,691,693,695,698,700],{"class":229,"line":537},[227,689,690],{"class":