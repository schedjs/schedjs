\u002Frunners\u002Fcustom\u002Ffile-runner","docs\u002F07.runners\u002Fcustom\u002F01.file-runner",false,{"title":75,"path":76,"stem":77,"children":78},"Storage","\u002Fdocs\u002Fstorage","docs\u002F08.storage\u002Findex",[79,81,103],{"title":80,"path":76,"stem":77},"Overview",{"title":82,"icon":83,"path":84,"stem":85,"children":86,"page":73},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F08.storage\u002F01.adapters",[87,91,95,99],{"title":88,"path":89,"stem":90},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F08.storage\u002F01.adapters\u002F01.sqlite",{"title":92,"path":93,"stem":94},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F08.storage\u002F01.adapters\u002F02.mysql",{"title":96,"path":97,"stem":98},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F08.storage\u002F01.adapters\u002F03.postgres",{"title":100,"path":101,"stem":102},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F08.storage\u002F01.adapters\u002F04.mongo",{"title":104,"path":105,"stem":106,"children":107},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F08.storage\u002F09.custom",[108],{"title":109,"path":110,"stem":111},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F08.storage\u002Fcustom\u002F01.memory-storage",{"title":113,"path":114,"stem":115},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F09.logging",{"title":117,"path":118,"stem":119},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F10.admin-api",{"title":121,"path":122,"stem":123,"order":124,"badge":125},"Admin UI","\u002Fdocs\u002Fui","docs\u002F11.ui",10,{"label":126,"color":127},"PRE","warning",{"title":129,"path":130,"stem":131},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F12.mcp",{"title":133,"path":134,"stem":135},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F13.cli",{"title":137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":31,"body":146,"description":687,"extension":688,"links":689,"meta":690,"navigation":691,"path":32,"seo":692,"stem":33,"__hash__":693},"docs\u002Fdocs\u002F06.protocol.md",{"type":147,"value":148,"toc":679},"minimark",[149,158,163,174,185,189,195,201,221,227,233,255,269,275,323,327,334,340,355,369,373,390,393,397,538,542,549,647,672],[150,151,152,153,157],"p",{},"The wire contract between sched and workers. Workers stay dumb: ",[154,155,156],"strong",{},"receive → execute →\nreport back",". sched owns the history (Model A).",[159,160,162],"h2",{"id":161},"request-envelope-daemon-worker","Request envelope (daemon → worker)",[164,165,170],"pre",{"className":166,"code":168,"language":169},[167],"language-text","POST {config.url}\nheaders:\n  x-sched-run-id: \u003CrunId>          # idempotency: worker dedupes by run id\n  x-sched-api-key: \u003CapiKey>        # outbound auth (when config.auth is set)\n  content-type: application\u002Fjson\nbody: {\n  \"task\": { \"name\": \"...\", \"config\": { ... } },\n  \"data\": { ... }                  # run parameters\n}\n","text",[171,172,168],"code",{"__ignoreMap":173},"",[150,175,176,177,180,181,184],{},"Sending ",[171,178,179],{},"x-sched-run-id"," always is the sched side of idempotency: a worker that stores\nresults by ",[171,182,183],{},"runId"," answers a redelivery with the saved outcome instead of re-executing.",[159,186,188],{"id":187},"response-envelope-worker-daemon","Response envelope (worker → daemon)",[150,190,191,194],{},[154,192,193],{},"Sync outcome"," (short jobs, within the request timeout):",[164,196,199],{"className":197,"code":198,"language":169},[167],"200 {\n  \"status\":   \"succeeded\" | \"failed\",\n  \"result\":   { ... } | null,\n  \"error\":    \"...\" | null,          # required when failed\n  \"progress\": 100 | null,\n  \"log\":      \"...\" | null,          # captured stdout\u002Fstderr, soft-capped\n  \"artifacts\": [ { \"kind\": \"s3\"|\"email\"|\"url\"|\"file\", \"ref\": \"...\", \"label\": \"...\" } ] | null\n}\n",[171,200,198],{"__ignoreMap":173},[150,202,203,206,207,210,211,214,215,220],{},[154,204,205],{},"Artifacts are generated by the worker, never by sched."," The worker uploads the\nartifact (S3 object, email, file) and hands sched a reference; sched persists it on the\nrun and the UI links to it. A failed upload is reported in ",[171,208,209],{},"error","\u002F",[171,212,213],{},"result",", not by\nfailing the run. See ",[216,217,219],"a",{"href":218},"runs#artifacts-who-generates-what","Artifacts",".",[150,222,223,226],{},[154,224,225],{},"Async lifecycle"," (long jobs):",[164,228,231],{"className":229,"code":230,"language":169},[167],"202 { \"status\": \"accepted\", \"statusUrl\": \"http:\u002F\u002Fworker\u002Fstatus\u002F\u003CrunId>\", \"cancelUrl\": \"http:\u002F\u002Fworker\u002Fcancel\u002F\u003CrunId>\", \"pollIntervalMs\": 1000 }\n",[171,232,230],{"__ignoreMap":173},[150,234,235,238,239,242,243,246,247,250,251,254],{},[171,236,237],{},"statusUrl"," may be ",[154,240,241],{},"relative"," — it is resolved against the task's ",[171,244,245],{},"config.url","\n(standard URL resolution: ",[171,248,249],{},"\u002Fstatus\u002F\u003Cid>"," = origin-relative, ",[171,252,253],{},"status\u002F\u003Cid>"," =\npath-relative). A worker must not need to know its externally reachable address;\nabsolute URLs pass through unchanged.",[150,256,257,258,261,262,265,266,268],{},"The run is marked ",[171,259,260],{},"queued","; the engine then ",[154,263,264],{},"polls"," ",[171,267,237],{}," (same outbound auth)\nuntil a terminal envelope arrives. Intermediate responses update progress\u002Flog\u002Fresult\nwithout completing the run:",[164,270,273],{"className":271,"code":272,"language":169},[167],"200 { \"status\": \"queued\" | \"running\", \"progress\": 50, \"log\": \"...\" }\n",[171,274,272],{"__ignoreMap":173},[150,276,277,265,280,283,284,287,288,291,292,294,295,297,298,302,303,306,307,309,310,265,313,315,316,318,319,322],{},[154,278,279],{},"Cancel.",[171,281,282],{},"cancelUrl"," is optional — a worker that advertises it gets a real\ncancel channel: ",[171,285,286],{},"POST \u002Fruns\u002F:id\u002Fcancel"," makes sched POST ",[171,289,290],{},"{ \"runId\": \"\u003Cid>\" }","\nto ",[171,293,282],{}," (same outbound auth + ",[171,296,179],{}," header) ",[299,300,301],"em",{},"before"," finishing\nthe run ",[171,304,305],{},"cancelled",". The worker must stop the pipeline at the next stage boundary\n— no new external mutations (npm publish, git push, …) after acknowledging the\ncancel — and may keep serving ",[171,308,237],{}," until it actually stops. A worker\n",[299,311,312],{},"without",[171,314,282],{}," keeps the legacy semantics: cancel = stop polling, the\nworker may finish on its own (documented — never rely on it for destructive\nstages). If the cancel signal itself fails (worker unreachable), the run is\nstill ",[171,317,305],{}," but its error reads ",[171,320,321],{},"cancelled by user (cancel signal failed: \u003Creason>)"," — the operator knows the worker may still be running.",[159,324,326],{"id":325},"stdio-transport","Stdio transport",[150,328,329,330,333],{},"The envelope is transport-agnostic. Over HTTP it travels as request\u002Fresponse bodies;\nover stdio (the process and docker runners' ",[171,331,332],{},"envelope: true",") it travels on the child's\npipes:",[164,335,338],{"className":336,"code":337,"language":169},[167],"stdin:   { \"task\": { \"name\": \"...\", \"config\": { ... } }, \"data\": { ... } }   (then EOF)\nstdout:  NDJSON envelopes — intermediate { \"status\": \"running\", \"progress\": 42 },\n         then one terminal { \"status\": \"succeeded\"|\"failed\"|\"cancelled\", ... }\nstderr:  worker logs (never stdout — stdout is the protocol channel)\n",[171,339,337],{"__ignoreMap":173},[150,341,342,343,346,347,350,351,354],{},"Intermediate ",[171,344,345],{},"running"," progress is ",[154,348,349],{},"persisted live"," by the engine (",[171,352,353],{},"onProgress"," →\nstorage.updateRun) as it arrives, so the UI shows the counter growing before the run\nfinishes — not just the final value written at completion.",[150,356,357,358,361,362,365,366,220],{},"The worker still gets the run metadata as env (",[171,359,360],{},"SCHED_RUN_ID",", ",[171,363,364],{},"SCHED_TASK_NAME",")\nplus the data-derived vars. Reference worker: ",[171,367,368],{},"examples\u002Fstdio-worker.mjs",[159,370,372],{"id":371},"why-polling-not-callbacks","Why polling, not callbacks",[374,375,376,380,387],"ul",{},[377,378,379],"li",{},"The daemon opens no inbound surface → auth stays outbound-only, simpler.",[377,381,382,383,386],{},"Repeats the worker pattern of ",[299,384,385],{},"getting"," status rather than receiving pushes.",[377,388,389],{},"For docker, the daemon owns the container lifecycle anyway.",[150,391,392],{},"Callbacks (worker → daemon push) are a future option — they'd need an inbound surface + auth.",[159,394,396],{"id":395},"fail-fast-rules","Fail-fast rules",[374,398,399,417,427,434,477,483,497,502],{},[377,400,401,404,405,408,409,412,413,416],{},[154,402,403],{},"Envelope mode + non-envelope 2xx = broken worker."," A task with\n",[171,406,407],{},"config.envelope: true"," whose dispatch response is a 2xx without a valid\nenvelope (",[171,410,411],{},"status"," string) fails the run with ",[171,414,415],{},"envelope mode but non-envelope 2xx body — broken worker"," — it never silently falls back to simple-mode\nsuccess (same doctrine as the stdio runners).",[377,418,419,422,423,426],{},[171,420,421],{},"accepted"," without a ",[171,424,425],{},"poll()"," implementation → run fails immediately.",[377,428,429,422,431,433],{},[171,430,421],{},[171,432,237],{},", or with an unresolvable one → run fails.",[377,435,436,265,443,446,447,450,451,454,455,457,458,461,462,464,465,468,469,472,473,476],{},[154,437,438,439,442],{},"Run deadline (task ",[171,440,441],{},"timeoutMs","):",[171,444,445],{},"> 0"," force-fails the run after N ms\nfrom start (async: the per-task poll ceiling, overriding the global\n",[171,448,449],{},"pollTimeoutMs","; sync: abort via the runner's signal). Before failing, sched\n",[154,452,453],{},"signals the worker to stop"," when the accepted envelope advertised a\n",[171,456,282],{}," — same ",[171,459,460],{},"POST { runId }"," as user cancel, so the worker halts at\nthe next stage boundary ",[299,463,301],{}," any further external mutations (a timed-out\nrun must not keep publishing while the verdict says ",[171,466,467],{},"failed","). A signal\nfailure is appended to the run error (",[171,470,471],{},"cancel signal failed: \u003Creason>",") so\nthe operator knows the worker may still be running. ",[171,474,475],{},"-1"," (the default\nwhen omitted) = never auto-terminate — only manual cancel stops the run.",[377,478,479,482],{},[154,480,481],{},"Transient poll errors are retried"," (network errors, 5xx, 408\u002F429 — 2\nretries by default, 500 ms apart) before the run is given up; permanent poll\nerrors (4xx, non-envelope, unexpected status) fail immediately.",[377,484,485,488,489,492,493,496],{},[154,486,487],{},"Poll failures are labelled:"," every poll-originated failure is recorded as\n",[171,490,491],{},"http runner: poll failed: \u003Creason>"," (e.g. ",[171,494,495],{},"poll failed: fetch failed","), so\nthe operator can tell a lost poll connection apart from a worker-reported\nterminal failure.",[377,498,499,500,220],{},"Poll errors (non-2xx after retries, malformed envelope, unexpected status) → run ",[171,501,467],{},[377,503,504,506,507,510,511,513,514,516,517,519,520,522,523,525,526,529,530,533,534,537],{},[171,505,449],{}," (default 25 min, must be \u003C ",[171,508,509],{},"lockTtlMs"," — 5 min margin under the 30 min default so the poll fails a hung async run before the zombie watchdog can re-dispatch it) caps a hung async run. On firing, sched ",[154,512,453],{}," via the accepted envelope's ",[171,515,282],{}," (same ",[171,518,460],{}," as user cancel) before failing the run — the worker halts at the next stage boundary, so a ",[171,521,467],{}," verdict is not contradicted by a worker that keeps mutating. A worker without a ",[171,524,282],{}," keeps the legacy stop-polling semantics (it may finish on its own). Configure it via ",[171,527,528],{},"createEngine({ pollTimeoutMs })"," in embedded mode, or ",[171,531,532],{},"--poll-timeout SECONDS"," \u002F ",[171,535,536],{},"DaemonOptions.pollTimeoutMs"," in the daemon.",[159,539,541],{"id":540},"worker-examples-by-language","Worker examples by language",[150,543,544,545,548],{},"The envelope contract is deliberately SDK-free: any language with HTTP + JSON\nimplements a worker with nothing but its standard library. Reference workers\n(",[171,546,547],{},"examples\u002Fworkers\u002F","), one file each:",[550,551,552,571],"table",{},[553,554,555],"thead",{},[556,557,558,562,565,568],"tr",{},[559,560,561],"th",{},"Language",[559,563,564],{},"Worker",[559,566,567],{},"Run",[559,569,570],{},"Default port",[572,573,574,593,611,629],"tbody",{},[556,575,576,580,585,590],{},[577,578,579],"td",{},"Go",[577,581,582],{},[171,583,584],{},"examples\u002Fworkers\u002Fgo\u002Fworker.go",[577,586,587],{},[171,588,589],{},"cd examples\u002Fworkers\u002Fgo && go run .",[577,591,592],{},"8080",[556,594,595,598,603,608],{},[577,596,597],{},"Python",[577,599,600],{},[171,601,602],{},"examples\u002Fworkers\u002Fpython\u002Fworker.py",[577,604,605],{},[171,606,607],{},"cd examples\u002Fworkers\u002Fpython && python3 worker.py",[577,609,610],{},"8081",[556,612,613,616,621,626],{},[577,614,615],{},"C#",[577,617,618],{},[171,619,620],{},"examples\u002Fworkers\u002Fcsharp\u002FProgram.cs",[577,622,623],{},[171,624,625],{},"cd examples\u002Fworkers\u002Fcsharp && dotnet run",[577,627,628],{},"8082",[556,630,631,634,639,644],{},[577,632,633],{},"Java",[577,635,636],{},[171,637,638],{},"examples\u002Fworkers\u002Fjava\u002FWorker.java",[577,640,641],{},[171,642,643],{},"cd examples\u002Fworkers\u002Fjava && javac Worker.java && java Worker",[577,645,646],{},"8083",[150,648,649,650,653,654,657,658,660,661,664,665,668,669,671],{},"Each worker implements two example tasks — ",[171,651,652],{},"ping"," (sync) and ",[171,655,656],{},"long"," (async\nwith ",[171,659,237],{}," polling) — plus optional auth (",[171,662,663],{},"SCHED_API_KEY"," →\n",[171,666,667],{},"x-sched-api-key"," on dispatch and poll) and run-id idempotency (results stored\nby ",[171,670,179],{},", redelivery answers with the saved outcome).",[150,673,674,675,678],{},"See ",[171,676,677],{},"examples\u002Fworkers\u002FREADME.md"," for the full task contract, per-language setup\nand curl validation scenarios.",{"title":173,"searchDepth":21,"depth":21,"links":680},[681,682,683,684,685,686],{"id":161,"depth":21,"text":162},{"id":187,"depth":21,"text":188},{"id":325,"depth":21,"text":326},{"id":371,"depth":21,"text":372},{"id":395,"depth":21,"text":396},{"id":540,"depth":21,"text":541},"The wire contract between sched and workers","md",null,{},true,{"title":31,"description":687},"tLKO4ePdbdHPDpkbMT1BkVR5FUQ8dZXb3eYJ7Ok8i8I",[695,697],{"title":27,"path":28,"stem":29,"description":696,"children":-1},"The run lifecycle and RunRecord",{"title":41,"path":42,"stem":43,"description":698,"children":-1},"Run tasks over HTTP — request\u002Fresponse, sync or accepted + poll",1789814222079]