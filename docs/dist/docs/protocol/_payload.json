,{"title":71,"path":72,"stem":73,"children":74},"Storage","\u002Fdocs\u002Fstorage","docs\u002F07.storage\u002Findex",[75,77,99],{"title":76,"path":72,"stem":73},"Overview",{"title":78,"icon":79,"path":80,"stem":81,"children":82,"page":69},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F07.storage\u002F01.adapters",[83,87,91,95],{"title":84,"path":85,"stem":86},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F07.storage\u002F01.adapters\u002F01.sqlite",{"title":88,"path":89,"stem":90},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F07.storage\u002F01.adapters\u002F02.mysql",{"title":92,"path":93,"stem":94},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F07.storage\u002F01.adapters\u002F03.postgres",{"title":96,"path":97,"stem":98},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F07.storage\u002F01.adapters\u002F04.mongo",{"title":100,"path":101,"stem":102,"children":103},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F07.storage\u002F09.custom",[104],{"title":105,"path":106,"stem":107},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F07.storage\u002Fcustom\u002F01.memory-storage",{"title":109,"path":110,"stem":111},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F08.logging",{"title":113,"path":114,"stem":115},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F09.admin-api",{"title":117,"path":118,"stem":119,"order":120,"badge":121},"Admin UI","\u002Fdocs\u002Fui","docs\u002F10.ui",10,{"label":122,"color":123},"PRE","warning",{"title":125,"path":126,"stem":127},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F11.mcp",{"title":129,"path":130,"stem":131},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F12.cli",{"title":133,"path":134,"stem":135},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F13.self-hosting",{"title":137,"path":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":27,"body":142,"description":683,"extension":684,"links":685,"meta":686,"navigation":687,"path":28,"seo":688,"stem":29,"__hash__":689},"docs\u002Fdocs\u002F05.protocol.md",{"type":143,"value":144,"toc":675},"minimark",[145,154,159,170,181,185,191,197,217,223,229,251,265,271,319,323,330,336,351,365,369,386,389,393,534,538,545,643,668],[146,147,148,149,153],"p",{},"The wire contract between sched and workers. Workers stay dumb: ",[150,151,152],"strong",{},"receive → execute →\nreport back",". sched owns the history (Model A).",[155,156,158],"h2",{"id":157},"request-envelope-daemon-worker","Request envelope (daemon → worker)",[160,161,166],"pre",{"className":162,"code":164,"language":165},[163],"language-text","POST {config.url}\nheaders:\n  x-sched-run-id: \u003CrunId>          # idempotency: worker dedupes by run id\n  x-sched-api-key: \u003CapiKey>        # outbound auth (when config.auth is set)\n  content-type: application\u002Fjson\nbody: {\n  \"task\": { \"name\": \"...\", \"config\": { ... } },\n  \"data\": { ... }                  # run parameters\n}\n","text",[167,168,164],"code",{"__ignoreMap":169},"",[146,171,172,173,176,177,180],{},"Sending ",[167,174,175],{},"x-sched-run-id"," always is the sched side of idempotency: a worker that stores\nresults by ",[167,178,179],{},"runId"," answers a redelivery with the saved outcome instead of re-executing.",[155,182,184],{"id":183},"response-envelope-worker-daemon","Response envelope (worker → daemon)",[146,186,187,190],{},[150,188,189],{},"Sync outcome"," (short jobs, within the request timeout):",[160,192,195],{"className":193,"code":194,"language":165},[163],"200 {\n  \"status\":   \"succeeded\" | \"failed\",\n  \"result\":   { ... } | null,\n  \"error\":    \"...\" | null,          # required when failed\n  \"progress\": 100 | null,\n  \"log\":      \"...\" | null,          # captured stdout\u002Fstderr, soft-capped\n  \"artifacts\": [ { \"kind\": \"s3\"|\"email\"|\"url\"|\"file\", \"ref\": \"...\", \"label\": \"...\" } ] | null\n}\n",[167,196,194],{"__ignoreMap":169},[146,198,199,202,203,206,207,210,211,216],{},[150,200,201],{},"Artifacts are generated by the worker, never by sched."," The worker uploads the\nartifact (S3 object, email, file) and hands sched a reference; sched persists it on the\nrun and the UI links to it. A failed upload is reported in ",[167,204,205],{},"error","\u002F",[167,208,209],{},"result",", not by\nfailing the run. See ",[212,213,215],"a",{"href":214},"runs#artifacts-who-generates-what","Artifacts",".",[146,218,219,222],{},[150,220,221],{},"Async lifecycle"," (long jobs):",[160,224,227],{"className":225,"code":226,"language":165},[163],"202 { \"status\": \"accepted\", \"statusUrl\": \"http:\u002F\u002Fworker\u002Fstatus\u002F\u003CrunId>\", \"cancelUrl\": \"http:\u002F\u002Fworker\u002Fcancel\u002F\u003CrunId>\", \"pollIntervalMs\": 1000 }\n",[167,228,226],{"__ignoreMap":169},[146,230,231,234,235,238,239,242,243,246,247,250],{},[167,232,233],{},"statusUrl"," may be ",[150,236,237],{},"relative"," — it is resolved against the task's ",[167,240,241],{},"config.url","\n(standard URL resolution: ",[167,244,245],{},"\u002Fstatus\u002F\u003Cid>"," = origin-relative, ",[167,248,249],{},"status\u002F\u003Cid>"," =\npath-relative). A worker must not need to know its externally reachable address;\nabsolute URLs pass through unchanged.",[146,252,253,254,257,258,261,262,264],{},"The run is marked ",[167,255,256],{},"queued","; the engine then ",[150,259,260],{},"polls"," ",[167,263,233],{}," (same outbound auth)\nuntil a terminal envelope arrives. Intermediate responses update progress\u002Flog\u002Fresult\nwithout completing the run:",[160,266,269],{"className":267,"code":268,"language":165},[163],"200 { \"status\": \"queued\" | \"running\", \"progress\": 50, \"log\": \"...\" }\n",[167,270,268],{"__ignoreMap":169},[146,272,273,261,276,279,280,283,284,287,288,290,291,293,294,298,299,302,303,305,306,261,309,311,312,314,315,318],{},[150,274,275],{},"Cancel.",[167,277,278],{},"cancelUrl"," is optional — a worker that advertises it gets a real\ncancel channel: ",[167,281,282],{},"POST \u002Fruns\u002F:id\u002Fcancel"," makes sched POST ",[167,285,286],{},"{ \"runId\": \"\u003Cid>\" }","\nto ",[167,289,278],{}," (same outbound auth + ",[167,292,175],{}," header) ",[295,296,297],"em",{},"before"," finishing\nthe run ",[167,300,301],{},"cancelled",". The worker must stop the pipeline at the next stage boundary\n— no new external mutations (npm publish, git push, …) after acknowledging the\ncancel — and may keep serving ",[167,304,233],{}," until it actually stops. A worker\n",[295,307,308],{},"without",[167,310,278],{}," keeps the legacy semantics: cancel = stop polling, the\nworker may finish on its own (documented — never rely on it for destructive\nstages). If the cancel signal itself fails (worker unreachable), the run is\nstill ",[167,313,301],{}," but its error reads ",[167,316,317],{},"cancelled by user (cancel signal failed: \u003Creason>)"," — the operator knows the worker may still be running.",[155,320,322],{"id":321},"stdio-transport","Stdio transport",[146,324,325,326,329],{},"The envelope is transport-agnostic. Over HTTP it travels as request\u002Fresponse bodies;\nover stdio (the process and docker runners' ",[167,327,328],{},"envelope: true",") it travels on the child's\npipes:",[160,331,334],{"className":332,"code":333,"language":165},[163],"stdin:   { \"task\": { \"name\": \"...\", \"config\": { ... } }, \"data\": { ... } }   (then EOF)\nstdout:  NDJSON envelopes — intermediate { \"status\": \"running\", \"progress\": 42 },\n         then one terminal { \"status\": \"succeeded\"|\"failed\"|\"cancelled\", ... }\nstderr:  worker logs (never stdout — stdout is the protocol channel)\n",[167,335,333],{"__ignoreMap":169},[146,337,338,339,342,343,346,347,350],{},"Intermediate ",[167,340,341],{},"running"," progress is ",[150,344,345],{},"persisted live"," by the engine (",[167,348,349],{},"onProgress"," →\nstorage.updateRun) as it arrives, so the UI shows the counter growing before the run\nfinishes — not just the final value written at completion.",[146,352,353,354,357,358,361,362,216],{},"The worker still gets the run metadata as env (",[167,355,356],{},"SCHED_RUN_ID",", ",[167,359,360],{},"SCHED_TASK_NAME",")\nplus the data-derived vars. Reference worker: ",[167,363,364],{},"examples\u002Fstdio-worker.mjs",[155,366,368],{"id":367},"why-polling-not-callbacks","Why polling, not callbacks",[370,371,372,376,383],"ul",{},[373,374,375],"li",{},"The daemon opens no inbound surface → auth stays outbound-only, simpler.",[373,377,378,379,382],{},"Repeats the worker pattern of ",[295,380,381],{},"getting"," status rather than receiving pushes.",[373,384,385],{},"For docker, the daemon owns the container lifecycle anyway.",[146,387,388],{},"Callbacks (worker → daemon push) are a future option — they'd need an inbound surface + auth.",[155,390,392],{"id":391},"fail-fast-rules","Fail-fast rules",[370,394,395,413,423,430,473,479,493,498],{},[373,396,397,400,401,404,405,408,409,412],{},[150,398,399],{},"Envelope mode + non-envelope 2xx = broken worker."," A task with\n",[167,402,403],{},"config.envelope: true"," whose dispatch response is a 2xx without a valid\nenvelope (",[167,406,407],{},"status"," string) fails the run with ",[167,410,411],{},"envelope mode but non-envelope 2xx body — broken worker"," — it never silently falls back to simple-mode\nsuccess (same doctrine as the stdio runners).",[373,414,415,418,419,422],{},[167,416,417],{},"accepted"," without a ",[167,420,421],{},"poll()"," implementation → run fails immediately.",[373,424,425,418,427,429],{},[167,426,417],{},[167,428,233],{},", or with an unresolvable one → run fails.",[373,431,432,261,439,442,443,446,447,450,451,453,454,457,458,460,461,464,465,468,469,472],{},[150,433,434,435,438],{},"Run deadline (task ",[167,436,437],{},"timeoutMs","):",[167,440,441],{},"> 0"," force-fails the run after N ms\nfrom start (async: the per-task poll ceiling, overriding the global\n",[167,444,445],{},"pollTimeoutMs","; sync: abort via the runner's signal). Before failing, sched\n",[150,448,449],{},"signals the worker to stop"," when the accepted envelope advertised a\n",[167,452,278],{}," — same ",[167,455,456],{},"POST { runId }"," as user cancel, so the worker halts at\nthe next stage boundary ",[295,459,297],{}," any further external mutations (a timed-out\nrun must not keep publishing while the verdict says ",[167,462,463],{},"failed","). A signal\nfailure is appended to the run error (",[167,466,467],{},"cancel signal failed: \u003Creason>",") so\nthe operator knows the worker may still be running. ",[167,470,471],{},"-1"," (the default\nwhen omitted) = never auto-terminate — only manual cancel stops the run.",[373,474,475,478],{},[150,476,477],{},"Transient poll errors are retried"," (network errors, 5xx, 408\u002F429 — 2\nretries by default, 500 ms apart) before the run is given up; permanent poll\nerrors (4xx, non-envelope, unexpected status) fail immediately.",[373,480,481,484,485,488,489,492],{},[150,482,483],{},"Poll failures are labelled:"," every poll-originated failure is recorded as\n",[167,486,487],{},"http runner: poll failed: \u003Creason>"," (e.g. ",[167,490,491],{},"poll failed: fetch failed","), so\nthe operator can tell a lost poll connection apart from a worker-reported\nterminal failure.",[373,494,495,496,216],{},"Poll errors (non-2xx after retries, malformed envelope, unexpected status) → run ",[167,497,463],{},[373,499,500,502,503,506,507,509,510,512,513,515,516,518,519,521,522,525,526,529,530,533],{},[167,501,445],{}," (default 25 min, must be \u003C ",[167,504,505],{},"lockTtlMs"," — 5 min margin under the 30 min default so the poll fails a hung async run before the zombie watchdog can re-dispatch it) caps a hung async run. On firing, sched ",[150,508,449],{}," via the accepted envelope's ",[167,511,278],{}," (same ",[167,514,456],{}," as user cancel) before failing the run — the worker halts at the next stage boundary, so a ",[167,517,463],{}," verdict is not contradicted by a worker that keeps mutating. A worker without a ",[167,520,278],{}," keeps the legacy stop-polling semantics (it may finish on its own). Configure it via ",[167,523,524],{},"createEngine({ pollTimeoutMs })"," in embedded mode, or ",[167,527,528],{},"--poll-timeout SECONDS"," \u002F ",[167,531,532],{},"DaemonOptions.pollTimeoutMs"," in the daemon.",[155,535,537],{"id":536},"worker-examples-by-language","Worker examples by language",[146,539,540,541,544],{},"The envelope contract is deliberately SDK-free: any language with HTTP + JSON\nimplements a worker with nothing but its standard library. Reference workers\n(",[167,542,543],{},"examples\u002Fworkers\u002F","), one file each:",[546,547,548,567],"table",{},[549,550,551],"thead",{},[552,553,554,558,561,564],"tr",{},[555,556,557],"th",{},"Language",[555,559,560],{},"Worker",[555,562,563],{},"Run",[555,565,566],{},"Default port",[568,569,570,589,607,625],"tbody",{},[552,571,572,576,581,586],{},[573,574,575],"td",{},"Go",[573,577,578],{},[167,579,580],{},"examples\u002Fworkers\u002Fgo\u002Fworker.go",[573,582,583],{},[167,584,585],{},"cd examples\u002Fworkers\u002Fgo && go run .",[573,587,588],{},"8080",[552,590,591,594,599,604],{},[573,592,593],{},"Python",[573,595,596],{},[167,597,598],{},"examples\u002Fworkers\u002Fpython\u002Fworker.py",[573,600,601],{},[167,602,603],{},"cd examples\u002Fworkers\u002Fpython && python3 worker.py",[573,605,606],{},"8081",[552,608,609,612,617,622],{},[573,610,611],{},"C#",[573,613,614],{},[167,615,616],{},"examples\u002Fworkers\u002Fcsharp\u002FProgram.cs",[573,618,619],{},[167,620,621],{},"cd examples\u002Fworkers\u002Fcsharp && dotnet run",[573,623,624],{},"8082",[552,626,627,630,635,640],{},[573,628,629],{},"Java",[573,631,632],{},[167,633,634],{},"examples\u002Fworkers\u002Fjava\u002FWorker.java",[573,636,637],{},[167,638,639],{},"cd examples\u002Fworkers\u002Fjava && javac Worker.java && java Worker",[573,641,642],{},"8083",[146,644,645,646,649,650,653,654,656,657,660,661,664,665,667],{},"Each worker implements two example tasks — ",[167,647,648],{},"ping"," (sync) and ",[167,651,652],{},"long"," (async\nwith ",[167,655,233],{}," polling) — plus optional auth (",[167,658,659],{},"SCHED_API_KEY"," →\n",[167,662,663],{},"x-sched-api-key"," on dispatch and poll) and run-id idempotency (results stored\nby ",[167,666,175],{},", redelivery answers with the saved outcome).",[146,669,670,671,674],{},"See ",[167,672,673],{},"examples\u002Fworkers\u002FREADME.md"," for the full task contract, per-language setup\nand curl validation scenarios.",{"title":169,"searchDepth":17,"depth":17,"links":676},[677,678,679,680,681,682],{"id":157,"depth":17,"text":158},{"id":183,"depth":17,"text":184},{"id":321,"depth":17,"text":322},{"id":367,"depth":17,"text":368},{"id":391,"depth":17,"text":392},{"id":536,"depth":17,"text":537},"The wire contract between sched and workers","md",null,{},true,{"title":27,"description":683},"nYTAE3c5JKk5lSgkypSXtuepTqQn0WvieWUbanOW1kw",[691,693],{"title":23,"path":24,"stem":25,"description":692,"children":-1},"The run lifecycle and RunRecord",{"title":37,"path":38,"stem":39,"description":694,"children":-1},"Run tasks over HTTP — request\u002Fresponse, sync or accepted + poll",1788099637038]