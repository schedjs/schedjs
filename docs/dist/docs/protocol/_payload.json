[{"data":1,"prerenderedAt":690},["ShallowReactive",2],{"navigation_docs":3,"-docs-protocol":135,"-docs-protocol-surround":685},[4,8,13,17,21,25,65,103,107,111,119,123,127,131],{"title":5,"path":6,"stem":7},"Introduction","\u002Fdocs\u002Fintroduction","docs\u002F01.introduction",{"title":9,"path":10,"stem":11,"order":12},"Quick start","\u002Fdocs\u002Fquick-start","docs\u002F02.quick-start",2,{"title":14,"path":15,"stem":16},"Tasks","\u002Fdocs\u002Ftasks","docs\u002F03.tasks",{"title":18,"path":19,"stem":20},"Runs","\u002Fdocs\u002Fruns","docs\u002F04.runs",{"title":22,"path":23,"stem":24},"Runner protocol","\u002Fdocs\u002Fprotocol","docs\u002F05.protocol",{"title":26,"icon":27,"path":28,"stem":29,"children":30,"page":64},"Runners","i-lucide-plug","\u002Fdocs\u002Frunners","docs\u002F06.runners",[31,35,39,43,47,51,55],{"title":32,"path":33,"stem":34},"HTTP runner","\u002Fdocs\u002Frunners\u002Fhttp","docs\u002F06.runners\u002F01.http",{"title":36,"path":37,"stem":38},"Docker runner","\u002Fdocs\u002Frunners\u002Fdocker","docs\u002F06.runners\u002F02.docker",{"title":40,"path":41,"stem":42},"Process runner","\u002Fdocs\u002Frunners\u002Fprocess","docs\u002F06.runners\u002F03.process",{"title":44,"path":45,"stem":46},"SSH runner","\u002Fdocs\u002Frunners\u002Fssh","docs\u002F06.runners\u002F04.ssh",{"title":48,"path":49,"stem":50},"MCP runner","\u002Fdocs\u002Frunners\u002Fmcp","docs\u002F06.runners\u002F05.mcp",{"title":52,"path":53,"stem":54},"Internal runner (embedded)","\u002Fdocs\u002Frunners\u002Finternal","docs\u002F06.runners\u002F06.internal",{"title":56,"path":57,"stem":58,"children":59},"Custom runners","\u002Fdocs\u002Frunners\u002Fcustom","docs\u002F06.runners\u002F07.custom",[60],{"title":61,"path":62,"stem":63},"File runner","\u002Fdocs\u002Frunners\u002Fcustom\u002Ffile-runner","docs\u002F06.runners\u002Fcustom\u002F01.file-runner",false,{"title":66,"path":67,"stem":68,"children":69},"Storage","\u002Fdocs\u002Fstorage","docs\u002F07.storage\u002Findex",[70,72,94],{"title":71,"path":67,"stem":68},"Overview",{"title":73,"icon":74,"path":75,"stem":76,"children":77,"page":64},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F07.storage\u002F01.adapters",[78,82,86,90],{"title":79,"path":80,"stem":81},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F07.storage\u002F01.adapters\u002F01.sqlite",{"title":83,"path":84,"stem":85},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F07.storage\u002F01.adapters\u002F02.mysql",{"title":87,"path":88,"stem":89},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F07.storage\u002F01.adapters\u002F03.postgres",{"title":91,"path":92,"stem":93},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F07.storage\u002F01.adapters\u002F04.mongo",{"title":95,"path":96,"stem":97,"children":98},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F07.storage\u002F09.custom",[99],{"title":100,"path":101,"stem":102},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F07.storage\u002Fcustom\u002F01.memory-storage",{"title":104,"path":105,"stem":106},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F08.logging",{"title":108,"path":109,"stem":110},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F09.admin-api",{"title":112,"path":113,"stem":114,"order":115,"badge":116},"Admin UI","\u002Fdocs\u002Fui","docs\u002F10.ui",10,{"label":117,"color":118},"PRE","warning",{"title":120,"path":121,"stem":122},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F11.mcp",{"title":124,"path":125,"stem":126},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F12.cli",{"title":128,"path":129,"stem":130},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F13.self-hosting",{"title":132,"path":133,"stem":134},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":136,"title":22,"body":137,"description":678,"extension":679,"links":680,"meta":681,"navigation":682,"path":23,"seo":683,"stem":24,"__hash__":684},"docs\u002Fdocs\u002F05.protocol.md",{"type":138,"value":139,"toc":670},"minimark",[140,149,154,165,176,180,186,192,212,218,224,246,260,266,314,318,325,331,346,360,364,381,384,388,529,533,540,638,663],[141,142,143,144,148],"p",{},"The wire contract between sched and workers. Workers stay dumb: ",[145,146,147],"strong",{},"receive → execute →\nreport back",". sched owns the history (Model A).",[150,151,153],"h2",{"id":152},"request-envelope-daemon-worker","Request envelope (daemon → worker)",[155,156,161],"pre",{"className":157,"code":159,"language":160},[158],"language-text","POST {config.url}\nheaders:\n  x-sched-run-id: \u003CrunId>          # idempotency: worker dedupes by run id\n  x-sched-api-key: \u003CapiKey>        # outbound auth (when config.auth is set)\n  content-type: application\u002Fjson\nbody: {\n  \"task\": { \"name\": \"...\", \"config\": { ... } },\n  \"data\": { ... }                  # run parameters\n}\n","text",[162,163,159],"code",{"__ignoreMap":164},"",[141,166,167,168,171,172,175],{},"Sending ",[162,169,170],{},"x-sched-run-id"," always is the sched side of idempotency: a worker that stores\nresults by ",[162,173,174],{},"runId"," answers a redelivery with the saved outcome instead of re-executing.",[150,177,179],{"id":178},"response-envelope-worker-daemon","Response envelope (worker → daemon)",[141,181,182,185],{},[145,183,184],{},"Sync outcome"," (short jobs, within the request timeout):",[155,187,190],{"className":188,"code":189,"language":160},[158],"200 {\n  \"status\":   \"succeeded\" | \"failed\",\n  \"result\":   { ... } | null,\n  \"error\":    \"...\" | null,          # required when failed\n  \"progress\": 100 | null,\n  \"log\":      \"...\" | null,          # captured stdout\u002Fstderr, soft-capped\n  \"artifacts\": [ { \"kind\": \"s3\"|\"email\"|\"url\"|\"file\", \"ref\": \"...\", \"label\": \"...\" } ] | null\n}\n",[162,191,189],{"__ignoreMap":164},[141,193,194,197,198,201,202,205,206,211],{},[145,195,196],{},"Artifacts are generated by the worker, never by sched."," The worker uploads the\nartifact (S3 object, email, file) and hands sched a reference; sched persists it on the\nrun and the UI links to it. A failed upload is reported in ",[162,199,200],{},"error","\u002F",[162,203,204],{},"result",", not by\nfailing the run. See ",[207,208,210],"a",{"href":209},"runs#artifacts-who-generates-what","Artifacts",".",[141,213,214,217],{},[145,215,216],{},"Async lifecycle"," (long jobs):",[155,219,222],{"className":220,"code":221,"language":160},[158],"202 { \"status\": \"accepted\", \"statusUrl\": \"http:\u002F\u002Fworker\u002Fstatus\u002F\u003CrunId>\", \"cancelUrl\": \"http:\u002F\u002Fworker\u002Fcancel\u002F\u003CrunId>\", \"pollIntervalMs\": 1000 }\n",[162,223,221],{"__ignoreMap":164},[141,225,226,229,230,233,234,237,238,241,242,245],{},[162,227,228],{},"statusUrl"," may be ",[145,231,232],{},"relative"," — it is resolved against the task's ",[162,235,236],{},"config.url","\n(standard URL resolution: ",[162,239,240],{},"\u002Fstatus\u002F\u003Cid>"," = origin-relative, ",[162,243,244],{},"status\u002F\u003Cid>"," =\npath-relative). A worker must not need to know its externally reachable address;\nabsolute URLs pass through unchanged.",[141,247,248,249,252,253,256,257,259],{},"The run is marked ",[162,250,251],{},"queued","; the engine then ",[145,254,255],{},"polls"," ",[162,258,228],{}," (same outbound auth)\nuntil a terminal envelope arrives. Intermediate responses update progress\u002Flog\u002Fresult\nwithout completing the run:",[155,261,264],{"className":262,"code":263,"language":160},[158],"200 { \"status\": \"queued\" | \"running\", \"progress\": 50, \"log\": \"...\" }\n",[162,265,263],{"__ignoreMap":164},[141,267,268,256,271,274,275,278,279,282,283,285,286,288,289,293,294,297,298,300,301,256,304,306,307,309,310,313],{},[145,269,270],{},"Cancel.",[162,272,273],{},"cancelUrl"," is optional — a worker that advertises it gets a real\ncancel channel: ",[162,276,277],{},"POST \u002Fruns\u002F:id\u002Fcancel"," makes sched POST ",[162,280,281],{},"{ \"runId\": \"\u003Cid>\" }","\nto ",[162,284,273],{}," (same outbound auth + ",[162,287,170],{}," header) ",[290,291,292],"em",{},"before"," finishing\nthe run ",[162,295,296],{},"cancelled",". The worker must stop the pipeline at the next stage boundary\n— no new external mutations (npm publish, git push, …) after acknowledging the\ncancel — and may keep serving ",[162,299,228],{}," until it actually stops. A worker\n",[290,302,303],{},"without",[162,305,273],{}," keeps the legacy semantics: cancel = stop polling, the\nworker may finish on its own (documented — never rely on it for destructive\nstages). If the cancel signal itself fails (worker unreachable), the run is\nstill ",[162,308,296],{}," but its error reads ",[162,311,312],{},"cancelled by user (cancel signal failed: \u003Creason>)"," — the operator knows the worker may still be running.",[150,315,317],{"id":316},"stdio-transport","Stdio transport",[141,319,320,321,324],{},"The envelope is transport-agnostic. Over HTTP it travels as request\u002Fresponse bodies;\nover stdio (the process and docker runners' ",[162,322,323],{},"envelope: true",") it travels on the child's\npipes:",[155,326,329],{"className":327,"code":328,"language":160},[158],"stdin:   { \"task\": { \"name\": \"...\", \"config\": { ... } }, \"data\": { ... } }   (then EOF)\nstdout:  NDJSON envelopes — intermediate { \"status\": \"running\", \"progress\": 42 },\n         then one terminal { \"status\": \"succeeded\"|\"failed\"|\"cancelled\", ... }\nstderr:  worker logs (never stdout — stdout is the protocol channel)\n",[162,330,328],{"__ignoreMap":164},[141,332,333,334,337,338,341,342,345],{},"Intermediate ",[162,335,336],{},"running"," progress is ",[145,339,340],{},"persisted live"," by the engine (",[162,343,344],{},"onProgress"," →\nstorage.updateRun) as it arrives, so the UI shows the counter growing before the run\nfinishes — not just the final value written at completion.",[141,347,348,349,352,353,356,357,211],{},"The worker still gets the run metadata as env (",[162,350,351],{},"SCHED_RUN_ID",", ",[162,354,355],{},"SCHED_TASK_NAME",")\nplus the data-derived vars. Reference worker: ",[162,358,359],{},"examples\u002Fstdio-worker.mjs",[150,361,363],{"id":362},"why-polling-not-callbacks","Why polling, not callbacks",[365,366,367,371,378],"ul",{},[368,369,370],"li",{},"The daemon opens no inbound surface → auth stays outbound-only, simpler.",[368,372,373,374,377],{},"Repeats the worker pattern of ",[290,375,376],{},"getting"," status rather than receiving pushes.",[368,379,380],{},"For docker, the daemon owns the container lifecycle anyway.",[141,382,383],{},"Callbacks (worker → daemon push) are a future option — they'd need an inbound surface + auth.",[150,385,387],{"id":386},"fail-fast-rules","Fail-fast rules",[365,389,390,408,418,425,468,474,488,493],{},[368,391,392,395,396,399,400,403,404,407],{},[145,393,394],{},"Envelope mode + non-envelope 2xx = broken worker."," A task with\n",[162,397,398],{},"config.envelope: true"," whose dispatch response is a 2xx without a valid\nenvelope (",[162,401,402],{},"status"," string) fails the run with ",[162,405,406],{},"envelope mode but non-envelope 2xx body — broken worker"," — it never silently falls back to simple-mode\nsuccess (same doctrine as the stdio runners).",[368,409,410,413,414,417],{},[162,411,412],{},"accepted"," without a ",[162,415,416],{},"poll()"," implementation → run fails immediately.",[368,419,420,413,422,424],{},[162,421,412],{},[162,423,228],{},", or with an unresolvable one → run fails.",[368,426,427,256,434,437,438,441,442,445,446,448,449,452,453,455,456,459,460,463,464,467],{},[145,428,429,430,433],{},"Run deadline (task ",[162,431,432],{},"timeoutMs","):",[162,435,436],{},"> 0"," force-fails the run after N ms\nfrom start (async: the per-task poll ceiling, overriding the global\n",[162,439,440],{},"pollTimeoutMs","; sync: abort via the runner's signal). Before failing, sched\n",[145,443,444],{},"signals the worker to stop"," when the accepted envelope advertised a\n",[162,447,273],{}," — same ",[162,450,451],{},"POST { runId }"," as user cancel, so the worker halts at\nthe next stage boundary ",[290,454,292],{}," any further external mutations (a timed-out\nrun must not keep publishing while the verdict says ",[162,457,458],{},"failed","). A signal\nfailure is appended to the run error (",[162,461,462],{},"cancel signal failed: \u003Creason>",") so\nthe operator knows the worker may still be running. ",[162,465,466],{},"-1"," (the default\nwhen omitted) = never auto-terminate — only manual cancel stops the run.",[368,469,470,473],{},[145,471,472],{},"Transient poll errors are retried"," (network errors, 5xx, 408\u002F429 — 2\nretries by default, 500 ms apart) before the run is given up; permanent poll\nerrors (4xx, non-envelope, unexpected status) fail immediately.",[368,475,476,479,480,483,484,487],{},[145,477,478],{},"Poll failures are labelled:"," every poll-originated failure is recorded as\n",[162,481,482],{},"http runner: poll failed: \u003Creason>"," (e.g. ",[162,485,486],{},"poll failed: fetch failed","), so\nthe operator can tell a lost poll connection apart from a worker-reported\nterminal failure.",[368,489,490,491,211],{},"Poll errors (non-2xx after retries, malformed envelope, unexpected status) → run ",[162,492,458],{},[368,494,495,497,498,501,502,504,505,507,508,510,511,513,514,516,517,520,521,524,525,528],{},[162,496,440],{}," (default 25 min, must be \u003C ",[162,499,500],{},"lockTtlMs"," — 5 min margin under the 30 min default so the poll fails a hung async run before the zombie watchdog can re-dispatch it) caps a hung async run. On firing, sched ",[145,503,444],{}," via the accepted envelope's ",[162,506,273],{}," (same ",[162,509,451],{}," as user cancel) before failing the run — the worker halts at the next stage boundary, so a ",[162,512,458],{}," verdict is not contradicted by a worker that keeps mutating. A worker without a ",[162,515,273],{}," keeps the legacy stop-polling semantics (it may finish on its own). Configure it via ",[162,518,519],{},"createEngine({ pollTimeoutMs })"," in embedded mode, or ",[162,522,523],{},"--poll-timeout SECONDS"," \u002F ",[162,526,527],{},"DaemonOptions.pollTimeoutMs"," in the daemon.",[150,530,532],{"id":531},"worker-examples-by-language","Worker examples by language",[141,534,535,536,539],{},"The envelope contract is deliberately SDK-free: any language with HTTP + JSON\nimplements a worker with nothing but its standard library. Reference workers\n(",[162,537,538],{},"examples\u002Fworkers\u002F","), one file each:",[541,542,543,562],"table",{},[544,545,546],"thead",{},[547,548,549,553,556,559],"tr",{},[550,551,552],"th",{},"Language",[550,554,555],{},"Worker",[550,557,558],{},"Run",[550,560,561],{},"Default port",[563,564,565,584,602,620],"tbody",{},[547,566,567,571,576,581],{},[568,569,570],"td",{},"Go",[568,572,573],{},[162,574,575],{},"examples\u002Fworkers\u002Fgo\u002Fworker.go",[568,577,578],{},[162,579,580],{},"cd examples\u002Fworkers\u002Fgo && go run .",[568,582,583],{},"8080",[547,585,586,589,594,599],{},[568,587,588],{},"Python",[568,590,591],{},[162,592,593],{},"examples\u002Fworkers\u002Fpython\u002Fworker.py",[568,595,596],{},[162,597,598],{},"cd examples\u002Fworkers\u002Fpython && python3 worker.py",[568,600,601],{},"8081",[547,603,604,607,612,617],{},[568,605,606],{},"C#",[568,608,609],{},[162,610,611],{},"examples\u002Fworkers\u002Fcsharp\u002FProgram.cs",[568,613,614],{},[162,615,616],{},"cd examples\u002Fworkers\u002Fcsharp && dotnet run",[568,618,619],{},"8082",[547,621,622,625,630,635],{},[568,623,624],{},"Java",[568,626,627],{},[162,628,629],{},"examples\u002Fworkers\u002Fjava\u002FWorker.java",[568,631,632],{},[162,633,634],{},"cd examples\u002Fworkers\u002Fjava && javac Worker.java && java Worker",[568,636,637],{},"8083",[141,639,640,641,644,645,648,649,651,652,655,656,659,660,662],{},"Each worker implements two example tasks — ",[162,642,643],{},"ping"," (sync) and ",[162,646,647],{},"long"," (async\nwith ",[162,650,228],{}," polling) — plus optional auth (",[162,653,654],{},"SCHED_API_KEY"," →\n",[162,657,658],{},"x-sched-api-key"," on dispatch and poll) and run-id idempotency (results stored\nby ",[162,661,170],{},", redelivery answers with the saved outcome).",[141,664,665,666,669],{},"See ",[162,667,668],{},"examples\u002Fworkers\u002FREADME.md"," for the full task contract, per-language setup\nand curl validation scenarios.",{"title":164,"searchDepth":12,"depth":12,"links":671},[672,673,674,675,676,677],{"id":152,"depth":12,"text":153},{"id":178,"depth":12,"text":179},{"id":316,"depth":12,"text":317},{"id":362,"depth":12,"text":363},{"id":386,"depth":12,"text":387},{"id":531,"depth":12,"text":532},"The wire contract between sched and workers","md",null,{},true,{"title":22,"description":678},"nYTAE3c5JKk5lSgkypSXtuepTqQn0WvieWUbanOW1kw",[686,688],{"title":18,"path":19,"stem":20,"description":687,"children":-1},"The run lifecycle and RunRecord",{"title":32,"path":33,"stem":34,"description":689,"children":-1},"Run tasks over HTTP — request\u002Fresponse, sync or accepted + poll",1787817621353]