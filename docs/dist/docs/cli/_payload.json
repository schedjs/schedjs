 24 requirement."," ",[177,242,179],{}," requires Node >= 24 (",[177,245,246],{},"engines","): ",[177,249,250],{},"node:sqlite","\nis stable there, so the one-line ",[177,253,254],{},"ExperimentalWarning: SQLite …"," that Node 22\nprinted on every start is gone.",[257,258,260],"h2",{"id":259},"usage","Usage",[262,263,268],"pre",{"className":264,"code":265,"language":266,"meta":267,"style":267},"language-bash shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","schedd [--tasks tasks.json] [--db sched.db] [--lock-ttl SECONDS]\n       [--lock-heartbeat SECONDS] [--retention-ttl SECONDS] [--temporary-retention-ttl SECONDS]\n       [--poll-timeout SECONDS] [--tick-interval MS] [--watchdog-interval MS]\n       [--admin-port PORT] [--admin-host HOST] [--storage SPECIFIER]\n","bash","",[177,269,270,298,326,350],{"__ignoreMap":267},[271,272,275,278,282,286,289,292,295],"span",{"class":273,"line":274},"line",1,[271,276,179],{"class":277},"sYn-s",[271,279,281],{"class":280},"sftqT"," [--tasks ",[271,283,285],{"class":284},"sTbE_","tasks.json]",[271,287,288],{"class":280}," [--db ",[271,290,291],{"class":284},"sched.db]",[271,293,294],{"class":280}," [--lock-ttl ",[271,296,297],{"class":284},"SECONDS]\n",[271,299,300,304,307,310,313,316,318,320,323],{"class":273,"line":17},[271,301,303],{"class":302},"soVBu","       [",[271,305,306],{"class":280},"--lock-heartbeat SECONDS",[271,308,309],{"class":302},"]",[271,311,312],{"class":302}," [",[271,314,315],{"class":280},"--retention-ttl SECONDS",[271,317,309],{"class":302},[271,319,312],{"class":302},[271,321,322],{"class":280},"--temporary-retention-ttl SECONDS",[271,324,325],{"class":302},"]\n",[271,327,329,331,334,336,338,341,343,345,348],{"class":273,"line":328},3,[271,330,303],{"class":302},[271,332,333],{"class":280},"--poll-timeout SECONDS",[271,335,309],{"class":302},[271,337,312],{"class":302},[271,339,340],{"class":280},"--tick-interval MS",[271,342,309],{"class":302},[271,344,312],{"class":302},[271,346,347],{"class":280},"--watchdog-interval MS",[271,349,325],{"class":302},[271,351,353,355,358,360,362,365,367,369,372],{"class":273,"line":352},4,[271,354,303],{"class":302},[271,356,357],{"class":280},"--admin-port PORT",[271,359,309],{"class":302},[271,361,312],{"class":302},[271,363,364],{"class":280},"--admin-host HOST",[271,366,309],{"class":302},[271,368,312],{"class":302},[271,370,371],{"class":280},"--storage SPECIFIER",[271,373,325],{"class":302},[150,375,376,389],{},[153,377,378],{},[156,379,380,383,386],{},[159,381,382],{},"Flag",[159,384,385],{},"Default",[159,387,388],{},"Description",[169,390,391,406,431,450,463,488,517,539,554,567,580,597],{},[156,392,393,398,403],{},[174,394,395],{},[177,396,397],{},"--tasks",[174,399,400],{},[177,401,402],{},"tasks.json",[174,404,405],{},"Path to the desired-state file",[156,407,408,413,418],{},[174,409,410],{},[177,411,412],{},"--db",[174,414,415],{},[177,416,417],{},"sched.db",[174,419,420,421,427,428,430],{},"SQLite database path — ",[237,422,423,424],{},"only valid with ",[177,425,426],{},"--storage sqlite"," (XOR: a non-sqlite storage with an explicit ",[177,429,412],{}," fails fast)",[156,432,433,438,443],{},[174,434,435],{},[177,436,437],{},"--storage",[174,439,440],{},[177,441,442],{},"sqlite",[174,444,445,446,449],{},"Exactly ",[237,447,448],{},"one"," storage (see below)",[156,451,452,457,460],{},[174,453,454],{},[177,455,456],{},"--lock-ttl",[174,458,459],{},"1800 (30 min)",[174,461,462],{},"Zombie-lock threshold in seconds",[156,464,465,470,473],{},[174,466,467],{},[177,468,469],{},"--lock-heartbeat",[174,471,472],{},"600 (10 min)",[174,474,475,476,483,484,487],{},"Lock refresh cadence for long sync runs, seconds — ",[237,477,478,479,482],{},"must be ",[177,480,481],{},"\u003C lock-ttl"," (enforced at parse; the engine throws too)"," (default: ",[177,485,486],{},"lock-ttl \u002F 3",")",[156,489,490,495,498],{},[174,491,492],{},[177,493,494],{},"--retention-ttl",[174,496,497],{},"2592000 (30 d)",[174,499,500,501,504,505,511,512,487],{},"Retention TTL for regular terminal runs, seconds from ",[177,502,503],{},"finishedAt",". ",[237,506,507,510],{},[177,508,509],{},"0"," = retention off"," — terminal runs are kept forever (archive semantics, see ",[513,514,516],"a",{"href":515},"#retention","Retention",[156,518,519,524,527],{},[174,520,521],{},[177,522,523],{},"--temporary-retention-ttl",[174,525,526],{},"86400 (24 h)",[174,528,529,530,533,534],{},"Retention TTL for ",[177,531,532],{},"temporary"," runs. ",[237,535,536,538],{},[177,537,509],{}," = retention off for the temporary class",[156,540,541,546,549],{},[174,542,543],{},[177,544,545],{},"--poll-timeout",[174,547,548],{},"1500 (25 min)",[174,550,551,552],{},"Async (accepted) run ceiling in seconds — must be ",[177,553,481],{},[156,555,556,561,564],{},[174,557,558],{},[177,559,560],{},"--tick-interval",[174,562,563],{},"1000",[174,565,566],{},"Tick cadence in ms (due-task scan)",[156,568,569,574,577],{},[174,570,571],{},[177,572,573],{},"--watchdog-interval",[174,575,576],{},"60000",[174,578,579],{},"Watchdog cadence in ms (zombie reaping)",[156,581,582,587,590],{},[174,583,584],{},[177,585,586],{},"--admin-port",[174,588,589],{},"—",[174,591,592,593,596],{},"Serve the admin API (",[177,594,595],{},"\u002Fapi\u002F*",") on this port",[156,598,599,604,609],{},[174,600,601],{},[177,602,603],{},"--admin-host",[174,605,606],{},[177,607,608],{},"127.0.0.1",[174,610,611],{},"Bind host for the admin server",[257,613,615],{"id":614},"environment","Environment",[150,617,618,627],{},[153,619,620],{},[156,621,622,625],{},[159,623,624],{},"Env var",[159,626,388],{},[169,628,629,647,657,677,690,702],{},[156,630,631,636],{},[174,632,633],{},[177,634,635],{},"SCHED_ADMIN_KEY",[174,637,638,639,642,643,646],{},"Bearer key for the admin API\u002FUI. Unset → API open (bind private host!). With a key set, the web UI accepts it via the ",[237,640,641],{},"admin key"," field in the header (saved to localStorage) or ",[177,644,645],{},"?token=…"," on the shell URL",[156,648,649,654],{},[174,650,651],{},[177,652,653],{},"DOCKER_HOST",[174,655,656],{},"Override the docker CLI context (used by the docker runner)",[156,658,659,668],{},[174,660,661,664,665,487],{},[177,662,663],{},"MONGO_URL"," (+",[177,666,667],{},"MONGO_DB",[174,669,670,671,504,674,676],{},"Connection string for ",[177,672,673],{},"--storage mongo",[177,675,667],{}," overrides the db name from the URI path",[156,678,679,684],{},[174,680,681],{},[177,682,683],{},"MONGO_RETRY_MS",[174,685,686,687,689],{},"Startup-connect retry budget for ",[177,688,673],{}," (default 30000). The initial connect is retried every 500 ms up to this budget before the daemon fails — a brief mongo restart does not crash-loop the daemon at boot",[156,691,692,697],{},[174,693,694],{},[177,695,696],{},"MYSQL_URL",[174,698,670,699],{},[177,700,701],{},"--storage mysql",[156,703,704,709],{},[174,705,706],{},[177,707,708],{},"PG_URL",[174,710,670,711],{},[177,712,713],{},"--storage postgres",[232,715,716],{},[146,717,718,721,722,725,726,729,730,733],{},[237,719,720],{},"Connection strings live in env \u002F config-volume only — never in arguments.","\nA connstring passed as a flag would leak into the process list (",[177,723,724],{},"ps",", ",[177,727,728],{},"docker inspect","). The startup banner prints the kind + db name only\n(",[177,731,732],{},"storage=mongo db=\u003Cname>","), never the URL or credentials.",[257,735,737,738,487],{"id":736},"storage-selection-storage","Storage selection (",[177,739,437],{},[146,741,742,743,745,746,748,749,751],{},"The daemon supports exactly ",[237,744,448],{}," storage per process — the ",[177,747,437],{},"\nspecifier (XOR with ",[177,750,412],{},", which is the sqlite knob):",[150,753,754,766],{},[153,755,756],{},[156,757,758,761,763],{},[159,759,760],{},"Specifier",[159,762,71],{},[159,764,765],{},"How it's wired",[169,767,768,785,804,820,836],{},[156,769,770,775,780],{},[174,771,772,774],{},[177,773,442],{}," (default)",[174,776,777,778,487],{},"SQLite file (",[177,779,412],{},[174,781,782,783],{},"built into ",[177,784,184],{},[156,786,787,792,797],{},[174,788,789],{},[177,790,791],{},"mongo",[174,793,794],{},[177,795,796],{},"@schedjs\u002Fstorage-mongo",[174,798,799,800,664,802,487],{},"env ",[177,801,663],{},[177,803,667],{},[156,805,806,811,816],{},[174,807,808],{},[177,809,810],{},"mysql",[174,812,813],{},[177,814,815],{},"@schedjs\u002Fstorage-mysql",[174,817,799,818],{},[177,819,696],{},[156,821,822,827,832],{},[174,823,824],{},[177,825,826],{},"postgres",[174,828,829],{},[177,830,831],{},"@schedjs\u002Fstorage-postgres",[174,833,799,834],{},[177,835,708],{},[156,837,838,847,853],{},[174,839,840,843,844],{},[177,841,842],{},"\u003Cnpm-package>"," \u002F ",[177,845,846],{},"\u003C.\u002Fpath>",[174,848,849,852],{},[237,850,851],{},"custom"," BYO module",[174,854,855,856],{},"dynamic import → ",[177,857,858],{},"createStorage(env)",[146,860,861,862,865,866,869,870,873],{},"Built-in kinds (",[177,863,864],{},"mongo|mysql|postgres",") resolve to their ",[177,867,868],{},"@schedjs\u002Fstorage-*","\npackage ",[237,871,872],{},"at runtime"," — the package must be present in the image, otherwise\nstartup fails fast:",[262,875,880],{"className":876,"code":878,"language":879,"meta":267},[877],"language-text","schedd: fatal: --storage mongo: add @schedjs\u002Fstorage-mongo to your image (RUN yarn add @schedjs\u002Fstorage-mongo)\n","text",[177,881,878],{"__ignoreMap":267},[146,883,884,885,888,889,892,893,725,896,725,899,902],{},"A custom module must export ",[177,886,887],{},"createStorage(env): Promise\u003CStorage>"," — the same\nBYO contract as the built-in adapters (",[513,890,71],{"href":891},"storage","). ",[177,894,895],{},".\u002F",[177,897,898],{},"..\u002F",[177,900,901],{},"\u002F","\nprefixes resolve to a filesystem path (relative to the daemon's cwd); anything\nelse is an npm package.",[262,904,906],{"className":264,"code":905,"language":266,"meta":267,"style":267},"MONGO_URL=mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched schedd --tasks tasks.json --storage mongo\n",[177,907,908],{"__ignoreMap":267},[271,909,910,913,916,919,922,926,929,932],{"class":273,"line":274},[271,911,663],{"class":912},"sSC40",[271,914,915],{"class":302},"=",[271,917,918],{"class":284},"mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched",[271,920,921],{"class":277}," schedd",[271,923,925],{"class":924},"sz9Cv"," --tasks",[271,927,928],{"class":284}," tasks.json",[271,930,931],{"class":924}," --storage",[271,933,934],{"class":284}," mongo\n",[257,936,938],{"id":937},"signals","Signals",[150,940,941,951],{},[153,942,943],{},[156,944,945,948],{},[159,946,947],{},"Signal",[159,949,950],{},"Behavior",[169,952,953,964,974],{},[156,954,955,961],{},[174,956,957,960],{},[177,958,959],{},"SIGINT"," (Ctrl+C)",[174,962,963],{},"Graceful stop — engine loops stop, sqlite closes, exit 0",[156,965,966,971],{},[174,967,968],{},[177,969,970],{},"SIGTERM",[174,972,973],{},"Same graceful stop (POSIX; systemd, docker stop)",[156,975,976,982],{},[174,977,978,981],{},[177,979,980],{},"SIGBREAK"," (Ctrl+Break, win32)",[174,983,984],{},"Same graceful stop — added for Windows operators",[146,986,987,988,991,992,995,996,998],{},"On Windows, ",[177,989,990],{},"taskkill"," sends a termination that does ",[237,993,994],{},"not"," always reach a\nconsole process as ",[177,997,970],{}," — the reliable paths are Ctrl+C \u002F Ctrl+Break.",[257,1000,1002],{"id":1001},"what-the-daemon-does-on-start","What the daemon does on start",[1004,1005,1006,1017,1023,1034],"ol",{},[1007,1008,1009,1010,1012,1013,1016],"li",{},"Resolves the storage (",[177,1011,437],{},"); a non-sqlite storage validates its\nconnstring env ",[237,1014,1015],{},"before"," anything starts (missing env → fail-fast).",[1007,1018,1019,1020,1022],{},"Syncs ",[177,1021,402],{}," into storage (desired state; removed tasks get disabled).",[1007,1024,1025,1026,1029,1030,1033],{},"Validates every task's runner is registered — a missing runner ",[237,1027,1028],{},"aborts startup",":\n",[177,1031,1032],{},"task \"greet\": runner \"custom\" not implemented in this build (registered: http, docker)",".",[1007,1035,1036,1037,1040,1041,843,1043,1045],{},"Starts the tick loop (fires due tasks), the watchdog (reaps zombie locks), the\npoll loop (async ",[177,1038,1039],{},"accepted"," runs), and the retention loop (hourly sweep of\nterminal runs past their TTL — ",[177,1042,494],{},[177,1044,523],{},").",[257,1047,516],{"id":1048},"retention",[146,1050,1051,1052,843,1055,843,1058,1061,1062,1064],{},"Terminal runs (",[177,1053,1054],{},"succeeded",[177,1056,1057],{},"failed",[177,1059,1060],{},"cancelled",") are pruned by the retention\nloop (hourly) once they're past their class TTL, measured from ",[177,1063,503],{},":",[1066,1067,1068,1080],"ul",{},[1007,1069,1070,1072,1073,1075,1076,1079],{},[177,1071,532],{}," runs → ",[177,1074,523],{}," (default ",[237,1077,1078],{},"24 h",");",[1007,1081,1082,1083,1075,1085,1045],{},"regular runs → ",[177,1084,494],{},[237,1086,1087],{},"30 d",[146,1089,1090,1091,1096,1097,1100,1101,1103,1104,1107],{},"Set the TTL to ",[237,1092,1093,1095],{},[177,1094,509],{}," to turn retention off for that class"," — run history is kept\nforever. This is the archive mode for deployments that migrate legacy history\ninto sched (books: migrated ",[177,1098,1099],{},"task_runs"," carry old ",[177,1102,503],{}," timestamps, and\nwith the 30 d default the first hourly pass would silently prune everything\nolder than a month — ",[177,1105,1106],{},"--retention-ttl 0 --temporary-retention-ttl 0"," keeps the\narchive).",[232,1109,1110],{},[146,1111,1112,1113,1115],{},"Note: ",[177,1114,509],{}," was added in daemon 0.11.0. Earlier versions had no way to disable\nretention — a migration onto the 30 d default pruned aged history.",[257,1117,1119],{"id":1118},"example","Example",[262,1121,1123],{"className":264,"code":1122,"language":266,"meta":267,"style":267},"SCHED_ADMIN_KEY=dev-key schedd \\\n  --tasks tasks.json \\\n  --db sched.db \\\n  --admin-port 8080\n",[177,1124,1125,1140,1149,1159],{"__ignoreMap":267},[271,1126,1127,1129,1131,1134,1136],{"class":273,"line":274},[271,1128,635],{"class":912},[271,1130,915],{"class":302},[271,1132,1133],{"class":284},"dev-key",[271,1135,921],{"class":277},[271,1137,1139],{"class":1138},"se3Ec"," \\\n",[271,1141,1142,1145,1147],{"class":273,"line":17},[271,1143,1144],{"class":924},"  --tasks",[271,1146,928],{"class":284},[271,1148,1139],{"class":1138},[271,1150,1151,1154,1157],{"class":273,"line":328},[271,1152,1153],{"class":924},"  --db",[271,1155,1156],{"class":284}," sched.db",[271,1158,1139],{"class":1138},[271,1160,1161,1164],{"class":273,"line":352},[271,1162,1163],{"class":924},"  --admin-port",[271,1165,1167],{"class":1166},"s7CZa"," 8080\n",[146,1169,1170,1171,1176,1177,1180,1181,211,1184,1187,1188,1191],{},"Then the admin api answers on ",[513,1172,1173],{"href":1173,"rel":1174},"http:\u002F\u002F127.0.0.1:8080\u002Fapi\u002F",[1175],"nofollow","*. The operator CLI\n(",[177,1178,1179],{},"sched status --admin-url http:\u002F\u002F127.0.0.1:8080\u002Fapi",") and the web UI\n(",[177,1182,1183],{},"npx @schedjs\u002Fui",[177,1185,1186],{},"sched-ui serve --proxy http:\u002F\u002F127.0.0.1:8080",", see\n",[513,1189,117],{"href":1190},"ui",") both speak to it.",[219,1193],{},[222,1195,1197,1198],{"id":1196},"operator-cli-sched","Operator CLI — ",[177,1199,194],{},[146,1201,1202,1204,1205,1208,1209,1212,1213,1216],{},[177,1203,199],{}," — a thin projection of the admin REST API (",[513,1206,113],{"href":1207},"admin-api","):\nstatus, runs, tasks, schedules, trigger, pause\u002Fresume. Zero dependencies\n(",[177,1210,1211],{},"node:fetch"," only); the daemon stays the single owner of state. Machine output\nis ",[177,1214,1215],{},"--json","; tables are for TTY eyes only.",[257,1218,1220],{"id":1219},"install","Install",[262,1222,1224],{"className":264,"code":1223,"language":266,"meta":267,"style":267},"npm install -g @schedjs\u002Fcli\n",[177,1225,1226],{"__ignoreMap":267},[271,1227,1228,1231,1234,1237],{"class":273,"line":274},[271,1229,1230],{"class":277},"npm",[271,1232,1233],{"class":284}," install",[271,1235,1236],{"class":924}," -g",[271,1238,1239],{"class":284}," @schedjs\u002Fcli\n",[257,1241,260],{"id":1242},"usage-1",[262,1244,1247],{"className":1245,"code":1246,"language":879,"meta":267},[877],"sched \u003Ccommand> [args] [--admin-url URL] [--api-key KEY] [--json]\n\nCommands:\n  status                   daemon health + task\u002Fschedule\u002Frun counts + next runs\n  runs [--task T] [--status S] [--limit N] [--offset N]\n  tasks\n  schedules\n  trigger \u003Ctask> [--data JSON]\n  pause \u003Ctask> | pause --schedule \u003Cid>\n  resume \u003Ctask> | resume --schedule \u003Cid>\n  check-worker \u003Curl> [--api-key KEY] [--timeout SECONDS]\n",[177,1248,1246],{"__ignoreMap":267},[146,1250,1251],{},"Global flags:",[150,1253,1254,1267],{},[153,1255,1256],{},[156,1257,1258,1260,1263,1265],{},[159,1259,382],{},[159,1261,1262],{},"Env",[159,1264,385],{},[159,1266,388],{},[169,1268,1269,1293,1309,1322],{},[156,1270,1271,1276,1281,1286],{},[174,1272,1273],{},[177,1274,1275],{},"--admin-url URL",[174,1277,1278],{},[177,1279,1280],{},"SCHED_ADMIN_URL",[174,1282,1283],{},[177,1284,1285],{},"http:\u002F\u002F127.0.0.1:8080\u002Fapi",[174,1287,1288,1289,1292],{},"Admin API base — note the ",[177,1290,1291],{},"\u002Fapi"," mount point is already included",[156,1294,1295,1300,1304,1306],{},[174,1296,1297],{},[177,1298,1299],{},"--api-key KEY",[174,1301,1302],{},[177,1303,635],{},[174,1305,589],{},[174,1307,1308],{},"Bearer key for the admin API",[156,1310,1311,1315,1317,1319],{},[174,1312,1313],{},[177,1314,1215],{},[174,1316,589],{},[174,1318,589],{},[174,1320,1321],{},"Stable machine-readable JSON contract",[156,1323,1324,1338,1340,1342],{},[174,1325,1326,843,1329,725,1332,843,1335],{},[177,1327,1328],{},"-h",[177,1330,1331],{},"--help",[177,1333,1334],{},"-v",[177,1336,1337],{},"--version",[174,1339,589],{},[174,1341,589],{},[174,1343,1344],{},"Help \u002F version",[146,1346,1347,1348,1350,1351,1354,1355,1358],{},"Exit codes: ",[237,1349,509],{}," ok \u002F ",[237,1352,1353],{},"1"," api·network·data error \u002F ",[237,1356,1357],{},"2"," usage.",[146,1360,1361,1364,1365,1367,1368,1372],{},[177,1362,1363],{},"--api-key"," before the command is the admin key; after ",[177,1366,205],{}," it is the\n",[1369,1370,1371],"em",{},"worker's"," key (a different secret — see below).",[257,1374,1376],{"id":1375},"examples","Examples",[262,1378,1380],{"className":264,"code":1379,"language":266,"meta":267,"style":267},"sched status                                   # is my daemon alive? next runs?\nsched runs --status failed --limit 20 --json   # failed runs as JSON\nsched trigger publish-video --data '{\"videoId\":\"v-42\"}'\nsched pause --schedule channel-ada             # pause one channel's schedule, not the task\nsched resume sync-channel-stats\n",[177,1381,1382,1393,1418,1441,1457],{"__ignoreMap":267},[271,1383,1384,1386,1389],{"class":273,"line":274},[271,1385,194],{"class":277},[271,1387,1388],{"class":284}," status",[271,1390,1392],{"class":1391},"s9Tkl","                                   # is my daemon alive? next runs?\n",[271,1394,1395,1397,1400,1403,1406,1409,1412,1415],{"class":273,"line":17},[271,1396,194],{"class":277},[271,1398,1399],{"class":284}," runs",[271,1401,1402],{"class":924}," --status",[271,1404,1405],{"class":284}," failed",[271,1407,1408],{"class":924}," --limit",[271,1410,1411],{"class":1166}," 20",[271,1413,1414],{"class":924}," --json",[271,1416,1417],{"class":1391},"   # failed runs as JSON\n",[271,1419,1420,1422,1425,1428,1431,1435,1438],{"class":273,"line":328},[271,1421,194],{"class":277},[271,1423,1424],{"class":284}," trigger",[271,1426,1427],{"class":284}," publish-video",[271,1429,1430],{"class":924}," --data",[271,1432,1434],{"class":1433},"sbYkP"," '",[271,1436,1437],{"class":284},"{\"videoId\":\"v-42\"}",[271,1439,1440],{"class":1433},"'\n",[271,1442,1443,1445,1448,1451,1454],{"class":273,"line":352},[271,1444,194],{"class":277},[271,1446,1447],{"class":284}," pause",[271,1449,1450],{"class":924}," --schedule",[271,1452,1453],{"class":284}," channel-ada",[271,1455,1456],{"class":1391},"             # pause one channel's schedule, not the task\n",[271,1458,1460,1462,1465],{"class":273,"line":1459},5,[271,1461,194],{"class":277},[271,1463,1464],{"class":284}," resume",[271,1466,1467],{"class":284}," sync-channel-stats\n",[146,1469,1470,1473,1474,1477,1478,1477,1481,1484,1485,1488],{},[177,1471,1472],{},"status"," composes one view: ",[177,1475,1476],{},"\u002Fhealth"," + ",[177,1479,1480],{},"\u002Ftasks",[177,1482,1483],{},"\u002Fschedules"," + a bounded\nfailed-runs fetch, and lists the five soonest ",[177,1486,1487],{},"nextRunAt"," schedules.",[257,1490,1492],{"id":1491},"powershell-note","PowerShell note",[146,1494,1495,1496,1499,1500,1503,1504,1507,1508,1511],{},"Windows PowerShell 5.1 pipes UTF-16 by default — ",[177,1497,1498],{},"ConvertFrom-Json"," can garble\nUTF-8 JSON from ",[177,1501,1502],{},"sched --json",". Use ",[177,1505,1506],{},"pwsh"," (PS 7, native UTF-8) or ",[177,1509,1510],{},"chcp 65001","\nin cmd. Quote paths with spaces in examples.",[257,1513,1515],{"id":1514},"check-worker-conformance-validator","check-worker — conformance validator",[146,1517,1518,1519,1522],{},"Validates that an HTTP envelope worker (",[513,1520,27],{"href":1521},"protocol",") speaks the\nwire contract correctly — a fake-sched client that sends exactly the envelopes\nsched sends and checks the answers. Never touches the daemon or the admin api.",[262,1524,1526],{"className":264,"code":1525,"language":266,"meta":267,"style":267},"sched check-worker http:\u002F\u002F127.0.0.1:8081 --api-key $SCHED_API_KEY --timeout 30\n",[177,1527,1528],{"__ignoreMap":267},[271,1529,1530,1532,1535,1538,1541,1544,1547],{"class":273,"line":274},[271,1531,194],{"class":277},[271,1533,1534],{"class":284}," check-worker",[271,1536,1537],{"class":284}," http:\u002F\u002F127.0.0.1:8081",[271,1539,1540],{"class":924}," --api-key",[271,1542,1543],{"class":912}," $SCHED_API_KEY",[271,1545,1546],{"class":924}," --timeout",[271,1548,1549],{"class":1166}," 30\n",[146,1551,1552],{},"Six scenarios, each PASS\u002FFAIL:",[150,1554,1555,1568],{},[153,1556,1557],{},[156,1558,1559,1562,1565],{},[159,1560,1561],{},"#",[159,1563,1564],{},"Scenario",[159,1566,1567],{},"Check",[169,1569,1570,1583,1599,1610,1624,1635],{},[156,1571,1572,1574,1577],{},[174,1573,1353],{},[174,1575,1576],{},"Sync success",[174,1578,1579,1580],{},"POST ping → 200 ",[177,1581,1582],{},"{status:\"succeeded\"}",[156,1584,1585,1587,1590],{},[174,1586,1357],{},[174,1588,1589],{},"Sync failure",[174,1591,1592,1593,211,1596],{},"POST with ",[177,1594,1595],{},"data.fail",[177,1597,1598],{},"{status:\"failed\", error}",[156,1600,1601,1604,1607],{},[174,1602,1603],{},"3",[174,1605,1606],{},"Async lifecycle",[174,1608,1609],{},"POST long → 202 accepted → GET statusUrl → running (progress grows) → succeeded, timeout trap",[156,1611,1612,1615,1618],{},[174,1613,1614],{},"4",[174,1616,1617],{},"Auth",[174,1619,1620,1621,1623],{},"only with ",[177,1622,1363],{},": no key → non-2xx, with key → 2xx (skipped otherwise)",[156,1625,1626,1629,1632],{},[174,1627,1628],{},"5",[174,1630,1631],{},"Run-id idempotency",[174,1633,1634],{},"two dispatches with the same run id → identical envelope",[156,1636,1637,1640,1643],{},[174,1638,1639],{},"6",[174,1641,1642],{},"Dirty input",[174,1644,1645],{},"garbage body → worker answers 4xx\u002F500 and stays alive (re-ping works)",[146,1647,1648,1649,1652,1653,1655,1656,1033],{},"Verdict: ",[177,1650,1651],{},"N\u002FN PASS",", exit 0 all-green \u002F 1 a scenario failed \u002F 2 usage.\n",[177,1654,1215],{}," prints ",[177,1657,1658],{},"{ ok, pass, fail, scenarios: [{name, pass, skipped, detail}] }",[146,1660,1661,1662,1665,1666,1669,1670,1673,1674,1677,1678,1681,1682,1685,1686,1045],{},"Worker contract for scenarios 1–5: ",[177,1663,1664],{},"POST"," with ",[177,1667,1668],{},"content-type: application\u002Fjson",",\n",[177,1671,1672],{},"x-sched-run-id"," (the idempotency key), optional ",[177,1675,1676],{},"x-sched-api-key",", body\n",[177,1679,1680],{},"{ task: { name, config }, data }"," — exactly what the HTTP runner dispatches\n(see ",[513,1683,37],{"href":1684},"runners\u002Fhttp"," and the examples in ",[177,1687,1688],{},"examples\u002Fworkers\u002F",[1690,1691,1692],"style",{},"html pre.shiki code .sYn-s, html code.shiki .sYn-s{--shiki-light:#E2931D;--shiki-default:#59873A;--shiki-dark:#80A665}html pre.shiki code .sftqT, html code.shiki .sftqT{--shiki-light:#90A4AE;--shiki-default:#393A34;--shiki-dark:#DBD7CAEE}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);backg