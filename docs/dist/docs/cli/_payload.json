712},"e_XVIl1_-UgRxfoi9RJGciEUgBt-opYUKI34RI549Nk",[1720,1722],{"title":129,"path":130,"stem":131,"description":1721,"children":-1},"Product MCP — AI control plane over the admin API (list\u002Fget tasks & runs, trigger\u002Fpause\u002Fresume, delete)",{"title":137,"path":138,"stem":139,"description":1723,"children":-1},"Docker stack, security, deployment",1789905804032]