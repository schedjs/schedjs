escription":1703,"extension":1704,"links":1705,"meta":1706,"navigation":1707,"path":125,"seo":1708,"stem":126,"__hash__":1709},"docs\u002Fdocs\u002F12.cli.md",{"type":138,"value":139,"toc":1688},"minimark",[140,144,201,213,216,223,226,251,256,369,607,611,709,729,735,747,854,869,877,898,930,934,980,994,998,1041,1044,1060,1083,1103,1111,1115,1163,1187,1189,1195,1212,1216,1235,1238,1244,1247,1340,1354,1368,1372,1463,1484,1488,1507,1511,1518,1545,1548,1641,1654,1684],[141,142,143],"p",{},"Two binaries, one product:",[145,146,147,163],"table",{},[148,149,150],"thead",{},[151,152,153,157,160],"tr",{},[154,155,156],"th",{},"Binary",[154,158,159],{},"Package",[154,161,162],{},"Role",[164,165,166,183],"tbody",{},[151,167,168,175,180],{},[169,170,171],"td",{},[172,173,174],"code",{},"schedd",[169,176,177],{},[172,178,179],{},"@schedjs\u002Fdaemon",[169,181,182],{},"the process server (SQLite + tasks.json + runners + engine + optional admin api)",[151,184,185,190,195],{},[169,186,187],{},[172,188,189],{},"sched",[169,191,192],{},[172,193,194],{},"@schedjs\u002Fcli",[169,196,197,198],{},"the operator CLI — a thin client of the admin api (status\u002Fruns\u002Ftasks\u002Fschedules\u002Ftrigger\u002Fpause\u002Fresume) + ",[172,199,200],{},"check-worker",[141,202,203,204,206,207,209,210,212],{},"The daemon's binary was renamed ",[172,205,189],{}," → ",[172,208,174],{}," (docker\u002Fdockerd precedent) so\nthe operator CLI could take the ",[172,211,189],{}," name. A global install of both packages\nno longer collides.",[214,215],"hr",{},[217,218,220,221],"h1",{"id":219},"daemon-schedd","Daemon — ",[172,222,174],{},[141,224,225],{},"A single process: SQLite storage + tasks.json desired state + per-task runners +\nengine loops + optional admin server.",[227,228,229],"blockquote",{},[141,230,231,235,236,238,239,242,243,246,247,250],{},[232,233,234],"strong",{},"Node 24 requirement."," ",[172,237,174],{}," requires Node >= 24 (",[172,240,241],{},"engines","): ",[172,244,245],{},"node:sqlite","\nis stable there, so the one-line ",[172,248,249],{},"ExperimentalWarning: SQLite …"," that Node 22\nprinted on every start is gone.",[252,253,255],"h2",{"id":254},"usage","Usage",[257,258,263],"pre",{"className":259,"code":260,"language":261,"meta":262,"style":262},"language-bash shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","schedd [--tasks tasks.json] [--db sched.db] [--lock-ttl SECONDS]\n       [--lock-heartbeat SECONDS] [--retention-ttl SECONDS] [--temporary-retention-ttl SECONDS]\n       [--poll-timeout SECONDS] [--tick-interval MS] [--watchdog-interval MS]\n       [--admin-port PORT] [--admin-host HOST] [--storage SPECIFIER]\n","bash","",[172,264,265,293,321,345],{"__ignoreMap":262},[266,267,270,273,277,281,284,287,290],"span",{"class":268,"line":269},"line",1,[266,271,174],{"class":272},"sYn-s",[266,274,276],{"class":275},"sftqT"," [--tasks ",[266,278,280],{"class":279},"sTbE_","tasks.json]",[266,282,283],{"class":275}," [--db ",[266,285,286],{"class":279},"sched.db]",[266,288,289],{"class":275}," [--lock-ttl ",[266,291,292],{"class":279},"SECONDS]\n",[266,294,295,299,302,305,308,311,313,315,318],{"class":268,"line":12},[266,296,298],{"class":297},"soVBu","       [",[266,300,301],{"class":275},"--lock-heartbeat SECONDS",[266,303,304],{"class":297},"]",[266,306,307],{"class":297}," [",[266,309,310],{"class":275},"--retention-ttl SECONDS",[266,312,304],{"class":297},[266,314,307],{"class":297},[266,316,317],{"class":275},"--temporary-retention-ttl SECONDS",[266,319,320],{"class":297},"]\n",[266,322,324,326,329,331,333,336,338,340,343],{"class":268,"line":323},3,[266,325,298],{"class":297},[266,327,328],{"class":275},"--poll-timeout SECONDS",[266,330,304],{"class":297},[266,332,307],{"class":297},[266,334,335],{"class":275},"--tick-interval MS",[266,337,304],{"class":297},[266,339,307],{"class":297},[266,341,342],{"class":275},"--watchdog-interval MS",[266,344,320],{"class":297},[266,346,348,350,353,355,357,360,362,364,367],{"class":268,"line":347},4,[266,349,298],{"class":297},[266,351,352],{"class":275},"--admin-port PORT",[266,354,304],{"class":297},[266,356,307],{"class":297},[266,358,359],{"class":275},"--admin-host HOST",[266,361,304],{"class":297},[266,363,307],{"class":297},[266,365,366],{"class":275},"--storage SPECIFIER",[266,368,320],{"class":297},[145,370,371,384],{},[148,372,373],{},[151,374,375,378,381],{},[154,376,377],{},"Flag",[154,379,380],{},"Default",[154,382,383],{},"Description",[164,385,386,401,426,445,458,483,512,534,549,562,575,592],{},[151,387,388,393,398],{},[169,389,390],{},[172,391,392],{},"--tasks",[169,394,395],{},[172,396,397],{},"tasks.json",[169,399,400],{},"Path to the desired-state file",[151,402,403,408,413],{},[169,404,405],{},[172,406,407],{},"--db",[169,409,410],{},[172,411,412],{},"sched.db",[169,414,415,416,422,423,425],{},"SQLite database path — ",[232,417,418,419],{},"only valid with ",[172,420,421],{},"--storage sqlite"," (XOR: a non-sqlite storage with an explicit ",[172,424,407],{}," fails fast)",[151,427,428,433,438],{},[169,429,430],{},[172,431,432],{},"--storage",[169,434,435],{},[172,436,437],{},"sqlite",[169,439,440,441,444],{},"Exactly ",[232,442,443],{},"one"," storage (see below)",[151,446,447,452,455],{},[169,448,449],{},[172,450,451],{},"--lock-ttl",[169,453,454],{},"1800 (30 min)",[169,456,457],{},"Zombie-lock threshold in seconds",[151,459,460,465,468],{},[169,461,462],{},[172,463,464],{},"--lock-heartbeat",[169,466,467],{},"600 (10 min)",[169,469,470,471,478,479,482],{},"Lock refresh cadence for long sync runs, seconds — ",[232,472,473,474,477],{},"must be ",[172,475,476],{},"\u003C lock-ttl"," (enforced at parse; the engine throws too)"," (default: ",[172,480,481],{},"lock-ttl \u002F 3",")",[151,484,485,490,493],{},[169,486,487],{},[172,488,489],{},"--retention-ttl",[169,491,492],{},"2592000 (30 d)",[169,494,495,496,499,500,506,507,482],{},"Retention TTL for regular terminal runs, seconds from ",[172,497,498],{},"finishedAt",". ",[232,501,502,505],{},[172,503,504],{},"0"," = retention off"," — terminal runs are kept forever (archive semantics, see ",[508,509,511],"a",{"href":510},"#retention","Retention",[151,513,514,519,522],{},[169,515,516],{},[172,517,518],{},"--temporary-retention-ttl",[169,520,521],{},"86400 (24 h)",[169,523,524,525,528,529],{},"Retention TTL for ",[172,526,527],{},"temporary"," runs. ",[232,530,531,533],{},[172,532,504],{}," = retention off for the temporary class",[151,535,536,541,544],{},[169,537,538],{},[172,539,540],{},"--poll-timeout",[169,542,543],{},"1500 (25 min)",[169,545,546,547],{},"Async (accepted) run ceiling in seconds — must be ",[172,548,476],{},[151,550,551,556,559],{},[169,552,553],{},[172,554,555],{},"--tick-interval",[169,557,558],{},"1000",[169,560,561],{},"Tick cadence in ms (due-task scan)",[151,563,564,569,572],{},[169,565,566],{},[172,567,568],{},"--watchdog-interval",[169,570,571],{},"60000",[169,573,574],{},"Watchdog cadence in ms (zombie reaping)",[151,576,577,582,585],{},[169,578,579],{},[172,580,581],{},"--admin-port",[169,583,584],{},"—",[169,586,587,588,591],{},"Serve the admin API (",[172,589,590],{},"\u002Fapi\u002F*",") on this port",[151,593,594,599,604],{},[169,595,596],{},[172,597,598],{},"--admin-host",[169,600,601],{},[172,602,603],{},"127.0.0.1",[169,605,606],{},"Bind host for the admin server",[252,608,610],{"id":609},"environment","Environment",[145,612,613,622],{},[148,614,615],{},[151,616,617,620],{},[154,618,619],{},"Env var",[154,621,383],{},[164,623,624,642,652,672,685,697],{},[151,625,626,631],{},[169,627,628],{},[172,629,630],{},"SCHED_ADMIN_KEY",[169,632,633,634,637,638,641],{},"Bearer key for the admin API\u002FUI. Unset → API open (bind private host!). With a key set, the web UI accepts it via the ",[232,635,636],{},"admin key"," field in the header (saved to localStorage) or ",[172,639,640],{},"?token=…"," on the shell URL",[151,643,644,649],{},[169,645,646],{},[172,647,648],{},"DOCKER_HOST",[169,650,651],{},"Override the docker CLI context (used by the docker runner)",[151,653,654,663],{},[169,655,656,659,660,482],{},[172,657,658],{},"MONGO_URL"," (+",[172,661,662],{},"MONGO_DB",[169,664,665,666,499,669,671],{},"Connection string for ",[172,667,668],{},"--storage mongo",[172,670,662],{}," overrides the db name from the URI path",[151,673,674,679],{},[169,675,676],{},[172,677,678],{},"MONGO_RETRY_MS",[169,680,681,682,684],{},"Startup-connect retry budget for ",[172,683,668],{}," (default 30000). The initial connect is retried every 500 ms up to this budget before the daemon fails — a brief mongo restart does not crash-loop the daemon at boot",[151,686,687,692],{},[169,688,689],{},[172,690,691],{},"MYSQL_URL",[169,693,665,694],{},[172,695,696],{},"--storage mysql",[151,698,699,704],{},[169,700,701],{},[172,702,703],{},"PG_URL",[169,705,665,706],{},[172,707,708],{},"--storage postgres",[227,710,711],{},[141,712,713,716,717,720,721,724,725,728],{},[232,714,715],{},"Connection strings live in env \u002F config-volume only — never in arguments.","\nA connstring passed as a flag would leak into the process list (",[172,718,719],{},"ps",", ",[172,722,723],{},"docker inspect","). The startup banner prints the kind + db name only\n(",[172,726,727],{},"storage=mongo db=\u003Cname>","), never the URL or credentials.",[252,730,732,733,482],{"id":731},"storage-selection-storage","Storage selection (",[172,734,432],{},[141,736,737,738,740,741,743,744,746],{},"The daemon supports exactly ",[232,739,443],{}," storage per process — the ",[172,742,432],{},"\nspecifier (XOR with ",[172,745,407],{},", which is the sqlite knob):",[145,748,749,761],{},[148,750,751],{},[151,752,753,756,758],{},[154,754,755],{},"Specifier",[154,757,66],{},[154,759,760],{},"How it's wired",[164,762,763,780,799,815,831],{},[151,764,765,770,775],{},[169,766,767,769],{},[172,768,437],{}," (default)",[169,771,772,773,482],{},"SQLite file (",[172,774,407],{},[169,776,777,778],{},"built into ",[172,779,179],{},[151,781,782,787,792],{},[169,783,784],{},[172,785,786],{},"mongo",[169,788,789],{},[172,790,791],{},"@schedjs\u002Fstorage-mongo",[169,793,794,795,659,797,482],{},"env ",[172,796,658],{},[172,798,662],{},[151,800,801,806,811],{},[169,802,803],{},[172,804,805],{},"mysql",[169,807,808],{},[172,809,810],{},"@schedjs\u002Fstorage-mysql",[169,812,794,813],{},[172,814,691],{},[151,816,817,822,827],{},[169,818,819],{},[172,820,821],{},"postgres",[169,823,824],{},[172,825,826],{},"@schedjs\u002Fstorage-postgres",[169,828,794,829],{},[172,830,703],{},[151,832,833,842,848],{},[169,834,835,838,839],{},[172,836,837],{},"\u003Cnpm-package>"," \u002F ",[172,840,841],{},"\u003C.\u002Fpath>",[169,843,844,847],{},[232,845,846],{},"custom"," BYO module",[169,849,850,851],{},"dynamic import → ",[172,852,853],{},"createStorage(env)",[141,855,856,857,860,861,864,865,868],{},"Built-in kinds (",[172,858,859],{},"mongo|mysql|postgres",") resolve to their ",[172,862,863],{},"@schedjs\u002Fstorage-*","\npackage ",[232,866,867],{},"at runtime"," — the package must be present in the image, otherwise\nstartup fails fast:",[257,870,875],{"className":871,"code":873,"language":874,"meta":262},[872],"language-text","schedd: fatal: --storage mongo: add @schedjs\u002Fstorage-mongo to your image (RUN yarn add @schedjs\u002Fstorage-mongo)\n","text",[172,876,873],{"__ignoreMap":262},[141,878,879,880,883,884,887,888,720,891,720,894,897],{},"A custom module must export ",[172,881,882],{},"createStorage(env): Promise\u003CStorage>"," — the same\nBYO contract as the built-in adapters (",[508,885,66],{"href":886},"storage","). ",[172,889,890],{},".\u002F",[172,892,893],{},"..\u002F",[172,895,896],{},"\u002F","\nprefixes resolve to a filesystem path (relative to the daemon's cwd); anything\nelse is an npm package.",[257,899,901],{"className":259,"code":900,"language":261,"meta":262,"style":262},"MONGO_URL=mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched schedd --tasks tasks.json --storage mongo\n",[172,902,903],{"__ignoreMap":262},[266,904,905,908,911,914,917,921,924,927],{"class":268,"line":269},[266,906,658],{"class":907},"sSC40",[266,909,910],{"class":297},"=",[266,912,913],{"class":279},"mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched",[266,915,916],{"class":272}," schedd",[266,918,920],{"class":919},"sz9Cv"," --tasks",[266,922,923],{"class":279}," tasks.json",[266,925,926],{"class":919}," --storage",[266,928,929],{"class":279}," mongo\n",[252,931,933],{"id":932},"signals","Signals",[145,935,936,946],{},[148,937,938],{},[151,939,940,943],{},[154,941,942],{},"Signal",[154,944,945],{},"Behavior",[164,947,948,959,969],{},[151,949,950,956],{},[169,951,952,955],{},[172,953,954],{},"SIGINT"," (Ctrl+C)",[169,957,958],{},"Graceful stop — engine loops stop, sqlite closes, exit 0",[151,960,961,966],{},[169,962,963],{},[172,964,965],{},"SIGTERM",[169,967,968],{},"Same graceful stop (POSIX; systemd, docker stop)",[151,970,971,977],{},[169,972,973,976],{},[172,974,975],{},"SIGBREAK"," (Ctrl+Break, win32)",[169,978,979],{},"Same graceful stop — added for Windows operators",[141,981,982,983,986,987,990,991,993],{},"On Windows, ",[172,984,985],{},"taskkill"," sends a termination that does ",[232,988,989],{},"not"," always reach a\nconsole process as ",[172,992,965],{}," — the reliable paths are Ctrl+C \u002F Ctrl+Break.",[252,995,997],{"id":996},"what-the-daemon-does-on-start","What the daemon does on start",[999,1000,1001,1012,1018,1029],"ol",{},[1002,1003,1004,1005,1007,1008,1011],"li",{},"Resolves the storage (",[172,1006,432],{},"); a non-sqlite storage validates its\nconnstring env ",[232,1009,1010],{},"before"," anything starts (missing env → fail-fast).",[1002,1013,1014,1015,1017],{},"Syncs ",[172,1016,397],{}," into storage (desired state; removed tasks get disabled).",[1002,1019,1020,1021,1024,1025,1028],{},"Validates every task's runner is registered — a missing runner ",[232,1022,1023],{},"aborts startup",":\n",[172,1026,1027],{},"task \"greet\": runner \"custom\" not implemented in this build (registered: http, docker)",".",[1002,1030,1031,1032,1035,1036,838,1038,1040],{},"Starts the tick loop (fires due tasks), the watchdog (reaps zombie locks), the\npoll loop (async ",[172,1033,1034],{},"accepted"," runs), and the retention loop (hourly sweep of\nterminal runs past their TTL — ",[172,1037,489],{},[172,1039,518],{},").",[252,1042,511],{"id":1043},"retention",[141,1045,1046,1047,838,1050,838,1053,1056,1057,1059],{},"Terminal runs (",[172,1048,1049],{},"succeeded",[172,1051,1052],{},"failed",[172,1054,1055],{},"cancelled",") are pruned by the retention\nloop (hourly) once they're past their class TTL, measured from ",[172,1058,498],{},":",[1061,1062,1063,1075],"ul",{},[1002,1064,1065,1067,1068,1070,1071,1074],{},[172,1066,527],{}," runs → ",[172,1069,518],{}," (default ",[232,1072,1073],{},"24 h",");",[1002,1076,1077,1078,1070,1080,1040],{},"regular runs → ",[172,1079,489],{},[232,1081,1082],{},"30 d",[141,1084,1085,1086,1091,1092,1095,1096,1098,1099,1102],{},"Set the TTL to ",[232,1087,1088,1090],{},[172,1089,504],{}," to turn retention off for that class"," — run history is kept\nforever. This is the archive mode for deployments that migrate legacy history\ninto sched (books: migrated ",[172,1093,1094],{},"task_runs"," carry old ",[172,1097,498],{}," timestamps, and\nwith the 30 d default the first hourly pass would silently prune everything\nolder than a month — ",[172,1100,1101],{},"--retention-ttl 0 --temporary-retention-ttl 0"," keeps the\narchive).",[227,1104,1105],{},[141,1106,1107,1108,1110],{},"Note: ",[172,1109,504],{}," was added in daemon 0.11.0. Earlier versions had no way to disable\nretention — a migration onto the 30 d default pruned aged history.",[252,1112,1114],{"id":1113},"example","Example",[257,1116,1118],{"className":259,"code":1117,"language":261,"meta":262,"style":262},"SCHED_ADMIN_KEY=dev-key schedd \\\n  --tasks tasks.json \\\n  --db sched.db \\\n  --admin-port 8080\n",[172,1119,1120,1135,1144,1154],{"__ignoreMap":262},[266,1121,1122,1124,1126,1129,1131],{"class":268,"line":269},[266,1123,630],{"class":907},[266,1125,910],{"class":297},[266,1127,1128],{"class":279},"dev-key",[266,1130,916],{"class":272},[266,1132,1134],{"class":1133},"se3Ec"," \\\n",[266,1136,1137,1140,1142],{"class":268,"line":12},[266,1138,1139],{"class":919},"  --tasks",[266,1141,923],{"class":279},[266,1143,1134],{"class":1133},[266,1145,1146,1149,1152],{"class":268,"line":323},[266,1147,1148],{"class":919},"  --db",[266,1150,1151],{"class":279}," sched.db",[266,1153,1134],{"class":1133},[266,1155,1156,1159],{"class":268,"line":347},[266,1157,1158],{"class":919},"  --admin-port",[266,1160,1162],{"class":1161},"s7CZa"," 8080\n",[141,1164,1165,1166,1171,1172,1175,1176,206,1179,1182,1183,1186],{},"Then the admin api answers on ",[508,1167,1168],{"href":1168,"rel":1169},"http:\u002F\u002F127.0.0.1:8080\u002Fapi\u002F",[1170],"nofollow","*. The operator CLI\n(",[172,1173,1174],{},"sched status --admin-url http:\u002F\u002F127.0.0.1:8080\u002Fapi",") and the web UI\n(",[172,1177,1178],{},"npx @schedjs\u002Fui",[172,1180,1181],{},"sched-ui serve --proxy http:\u002F\u002F127.0.0.1:8080",", see\n",[508,1184,112],{"href":1185},"ui",") both speak to it.",[214,1188],{},[217,1190,1192,1193],{"id":1191},"operator-cli-sched","Operator CLI — ",[172,1194,189],{},[141,1196,1197,1199,1200,1203,1204,1207,1208,1211],{},[172,1198,194],{}," — a thin projection of the admin REST API (",[508,1201,108],{"href":1202},"admin-api","):\nstatus, runs, tasks, schedules, trigger, pause\u002Fresume. Zero dependencies\n(",[172,1205,1206],{},"node:fetch"," only); the daemon stays the single owner of state. Machine output\nis ",[172,1209,1210],{},"--json","; tables are for TTY eyes only.",[252,1213,1215],{"id":1214},"install","Install",[257,1217,1219],{"className":259,"code":1218,"language":261,"meta":262,"style":262},"npm install -g @schedjs\u002Fcli\n",[172,1220,1221],{"__ignoreMap":262},[266,1222,1223,1226,1229,1232],{"class":268,"line":269},[266,1224,1225],{"class":272},"npm",[266,1227,1228],{"class":279}," install",[266,1230,1231],{"class":919}," -g",[266,1233,1234],{"class":279}," @schedjs\u002Fcli\n",[252,1236,255],{"id":1237},"usage-1",[257,1239,1242],{"className":1240,"code":1241,"language":874,"meta":262},[872],"sched \u003Ccommand> [args] [--admin-url URL] [--api-key KEY] [--json]\n\nCommands:\n  status                   daemon health + task\u002Fschedule\u002Frun counts + next runs\n  runs [--task T] [--status S] [--limit N] [--offset N]\n  tasks\n  schedules\n  trigger \u003Ctask> [--data JSON]\n  pause \u003Ctask> | pause --schedule \u003Cid>\n  resume \u003Ctask> | resume --schedule \u003Cid>\n  check-worker \u003Curl> [--api-key KEY] [--timeout SECONDS]\n",[172,1243,1241],{"__ignoreMap":262},[141,1245,1246],{},"Global flags:",[145,1248,1249,1262],{},[148,1250,1251],{},[151,1252,1253,1255,1258,1260],{},[154,1254,377],{},[154,1256,1257],{},"Env",[154,1259,380],{},[154,1261,383],{},[164,1263,1264,1288,1304,1317],{},[151,1265,1266,1271,1276,1281],{},[169,1267,1268],{},[172,1269,1270],{},"--admin-url URL",[169,1272,1273],{},[172,1274,1275],{},"SCHED_ADMIN_URL",[169,1277,1278],{},[172,1279,1280],{},"http:\u002F\u002F127.0.0.1:8080\u002Fapi",[169,1282,1283,1284,1287],{},"Admin API base — note the ",[172,1285,1286],{},"\u002Fapi"," mount point is already included",[151,1289,1290,1295,1299,1301],{},[169,1291,1292],{},[172,1293,1294],{},"--api-key KEY",[169,1296,1297],{},[172,1298,630],{},[169,1300,584],{},[169,1302,1303],{},"Bearer key for the admin API",[151,1305,1306,1310,1312,1314],{},[169,1307,1308],{},[172,1309,1210],{},[169,1311,584],{},[169,1313,584],{},[169,1315,1316],{},"Stable machine-readable JSON contract",[151,1318,1319,1333,1335,1337],{},[169,1320,1321,838,1324,720,1327,838,1330],{},[172,1322,1323],{},"-h",[172,1325,1326],{},"--help",[172,1328,1329],{},"-v",[172,1331,1332],{},"--version",[169,1334,584],{},[169,1336,584],{},[169,1338,1339],{},"Help \u002F version",[141,1341,1342,1343,1345,1346,1349,1350,1353],{},"Exit codes: ",[232,1344,504],{}," ok \u002F ",[232,1347,1348],{},"1"," api·network·data error \u002F ",[232,1351,1352],{},"2"," usage.",[141,1355,1356,1359,1360,1362,1363,1367],{},[172,1357,1358],{},"--api-key"," before the command is the admin key; after ",[172,1361,200],{}," it is the\n",[1364,1365,1366],"em",{},"worker's"," key (a different secret — see below).",[252,1369,1371],{"id":1370},"examples","Examples",[257,1373,1375],{"className":259,"code":1374,"language":261,"meta":262,"style":262},"sched status                                   # is my daemon alive? next runs?\nsched runs --status failed --limit 20 --json   # failed runs as JSON\nsched trigger publish-video --data '{\"videoId\":\"v-42\"}'\nsched pause --schedule channel-ada             # pause one channel's schedule, not the task\nsched resume sync-channel-stats\n",[172,1376,1377,1388,1413,1436,1452],{"__ignoreMap":262},[266,1378,1379,1381,1384],{"class":268,"line":269},[266,1380,189],{"class":272},[266,1382,1383],{"class":279}," status",[266,1385,1387],{"class":1386},"s9Tkl","                                   # is my daemon alive? next runs?\n",[266,1389,1390,1392,1395,1398,1401,1404,1407,1410],{"class":268,"line":12},[266,1391,189],{"class":272},[266,1393,1394],{"class":279}," runs",[266,1396,1397],{"class":919}," --status",[266,1399,1400],{"class":279}," failed",[266,1402,1403],{"class":919}," --limit",[266,1405,1406],{"class":1161}," 20",[266,1408,1409],{"class":919}," --json",[266,1411,1412],{"class":1386},"   # failed runs as JSON\n",[266,1414,1415,1417,1420,1423,1426,1430,1433],{"class":268,"line":323},[266,1416,189],{"class":272},[266,1418,1419],{"class":279}," trigger",[266,1421,1422],{"class":279}," publish-video",[266,1424,1425],{"class":919}," --data",[266,1427,1429],{"class":1428},"sbYkP"," '",[266,1431,1432],{"class":279},"{\"videoId\":\"v-42\"}",[266,1434,1435],{"class":1428},"'\n",[266,1437,1438,1440,1443,1446,1449],{"class":268,"line":347},[266,1439,189],{"class":272},[266,1441,1442],{"class":279}," pause",[266,1444,1445],{"class":919}," --schedule",[266,1447,1448],{"class":279}," channel-ada",[266,1450,1451],{"class":1386},"             # pause one channel's schedule, not the task\n",[266,1453,1455,1457,1460],{"class":268,"line":1454},5,[266,1456,189],{"class":272},[266,1458,1459],{"class":279}," resume",[266,1461,1462],{"class":279}," sync-channel-stats\n",[141,1464,1465,1468,1469,1472,1473,1472,1476,1479,1480,1483],{},[172,1466,1467],{},"status"," composes one view: ",[172,1470,1471],{},"\u002Fhealth"," + ",[172,1474,1475],{},"\u002Ftasks",[172,1477,1478],{},"\u002Fschedules"," + a bounded\nfailed-runs fetch, and lists the five soonest ",[172,1481,1482],{},"nextRunAt"," schedules.",[252,1485,1487],{"id":1486},"powershell-note","PowerShell note",[141,1489,1490,1491,1494,1495,1498,1499,1502,1503,1506],{},"Windows PowerShell 5.1 pipes UTF-16 by default — ",[172,1492,1493],{},"ConvertFrom-Json"," can garble\nUTF-8 JSON from ",[172,1496,1497],{},"sched --json",". Use ",[172,1500,1501],{},"pwsh"," (PS 7, native UTF-8) or ",[172,1504,1505],{},"chcp 65001","\nin cmd. Quote paths with spaces in examples.",[252,1508,1510],{"id":1509},"check-worker-conformance-validator","check-worker — conformance validator",[141,1512,1513,1514,1517],{},"Validates that an HTTP envelope worker (",[508,1515,22],{"href":1516},"protocol",") speaks the\nwire contract correctly — a fake-sched client that sends exactly the envelopes\nsched sends and checks the answers. Never touches the daemon or the admin api.",[257,1519,1521],{"className":259,"code":1520,"language":261,"meta":262,"style":262},"sched check-worker http:\u002F\u002F127.0.0.1:8081 --api-key $SCHED_API_KEY --timeout 30\n",[172,1522,1523],{"__ignoreMap":262},[266,1524,1525,1527,1530,1533,1536,1539,1542],{"class":268,"line":269},[266,1526,189],{"class":272},[266,1528,1529],{"class":279}," check-worker",[266,1531,1532],{"class":279}," http:\u002F\u002F127.0.0.1:8081",[266,1534,1535],{"class":919}," --api-key",[266,1537,1538],{"class":907}," $SCHED_API_KEY",[266,1540,1541],{"class":919}," --timeout",[266,1543,1544],{"class":1161}," 30\n",[141,1546,1547],{},"Six scenarios, each PASS\u002FFAIL:",[145,1549,1550,1563],{},[148,1551,1552],{},[151,1553,1554,1557,1560],{},[154,1555,1556],{},"#",[154,1558,1559],{},"Scenario",[154,1561,1562],{},"Check",[164,1564,1565,1578,1594,1605,1619,1630],{},[151,1566,1567,1569,1572],{},[169,1568,1348],{},[169,1570,1571],{},"Sync success",[169,1573,1574,1575],{},"POST ping → 200 ",[172,1576,1577],{},"{status:\"succeeded\"}",[151,1579,1580,1582,1585],{},[169,1581,1352],{},[169,1583,1584],{},"Sync failure",[169,1586,1587,1588,206,1591],{},"POST with ",[172,1589,1590],{},"data.fail",[172,1592,1593],{},"{status:\"failed\", error}",[151,1595,1596,1599,1602],{},[169,1597,1598],{},"3",[169,1600,1601],{},"Async lifecycle",[169,1603,1604],{},"POST long → 202 accepted → GET statusUrl → running (progress grows) → succeeded, timeout trap",[151,1606,1607,1610,1613],{},[169,1608,1609],{},"4",[169,1611,1612],{},"Auth",[169,1614,1615,1616,1618],{},"only with ",[172,1617,1358],{},": no key → non-2xx, with key → 2xx (skipped otherwise)",[151,1620,1621,1624,1627],{},[169,1622,1623],{},"5",[169,1625,1626],{},"Run-id idempotency",[169,1628,1629],{},"two dispatches with the same run id → identical envelope",[151,1631,1632,1635,1638],{},[169,1633,1634],{},"6",[169,1636,1637],{},"Dirty input",[169,1639,1640],{},"garbage body → worker answers 4xx\u002F500 and stays alive (re-ping works)",[141,1642,1643,1644,1647,1648,1650,1651,1028],{},"Verdict: ",[172,1645,1646],{},"N\u002FN PASS",", exit 0 all-green \u002F 1 a scenario failed \u002F 2 usage.\n",[172,1649,1210],{}," prints ",[172,1652,1653],{},"{ ok, pass, fail, scenarios: [{name, pass, skipped, detail}] }",[141,1655,1656,1657,1660,1661,1664,1665,1668,1669,1672,1673,1676,1677,1680,1681,1040],{},"Worker contract for scenarios 1–5: ",[172,1658,1659],{},"POST"," with ",[172,1662,1663],{},"content-type: application\u002Fjson",",\n",[172,1666,1667],{},"x-sched-run-id"," (the idempotency key), optional ",[172,1670,1671],{},"x-sched-api-key",", body\n",[172,1674,1675],{},"{ task: { name, config }, data }"," — exactly what the HTTP runner dispatches\n(see ",[508,1678,32],{"href":1679},"runners\u002Fhttp"," and the examples in ",[172,1682,1683],{},"examples\u002Fworkers\u002F",[1685,1686,1687],"style",{},"html pre.shiki code .sYn-s, html code.shiki .sYn-s{--shiki-light:#E2931D;--shiki-default:#59873A;--shiki-dark:#80A665}html pre.shiki code .sftqT, html code.shiki .sftqT{--shiki-light:#90A4AE;--shiki-default:#393A34;--shiki-dark:#DBD7CAEE}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decorati