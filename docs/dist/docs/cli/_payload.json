er.",[236,237,238],"blockquote",{},[150,239,240,244,245,247,248,251,252,255,256,259],{},[241,242,243],"strong",{},"Node 24 requirement."," ",[181,246,183],{}," requires Node >= 24 (",[181,249,250],{},"engines","): ",[181,253,254],{},"node:sqlite","\nis stable there, so the one-line ",[181,257,258],{},"ExperimentalWarning: SQLite …"," that Node 22\nprinted on every start is gone.",[261,262,264],"h2",{"id":263},"usage","Usage",[266,267,272],"pre",{"className":268,"code":269,"language":270,"meta":271,"style":271},"language-bash shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","schedd [--tasks tasks.json] [--db sched.db] [--lock-ttl SECONDS]\n       [--lock-heartbeat SECONDS] [--retention-ttl SECONDS] [--temporary-retention-ttl SECONDS]\n       [--poll-timeout SECONDS] [--tick-interval MS] [--watchdog-interval MS]\n       [--admin-port PORT] [--admin-host HOST] [--storage SPECIFIER]\n","bash","",[181,273,274,302,330,354],{"__ignoreMap":271},[275,276,279,282,286,290,293,296,299],"span",{"class":277,"line":278},"line",1,[275,280,183],{"class":281},"sYn-s",[275,283,285],{"class":284},"sftqT"," [--tasks ",[275,287,289],{"class":288},"sTbE_","tasks.json]",[275,291,292],{"class":284}," [--db ",[275,294,295],{"class":288},"sched.db]",[275,297,298],{"class":284}," [--lock-ttl ",[275,300,301],{"class":288},"SECONDS]\n",[275,303,304,308,311,314,317,320,322,324,327],{"class":277,"line":21},[275,305,307],{"class":306},"soVBu","       [",[275,309,310],{"class":284},"--lock-heartbeat SECONDS",[275,312,313],{"class":306},"]",[275,315,316],{"class":306}," [",[275,318,319],{"class":284},"--retention-ttl SECONDS",[275,321,313],{"class":306},[275,323,316],{"class":306},[275,325,326],{"class":284},"--temporary-retention-ttl SECONDS",[275,328,329],{"class":306},"]\n",[275,331,333,335,338,340,342,345,347,349,352],{"class":277,"line":332},3,[275,334,307],{"class":306},[275,336,337],{"class":284},"--poll-timeout SECONDS",[275,339,313],{"class":306},[275,341,316],{"class":306},[275,343,344],{"class":284},"--tick-interval MS",[275,346,313],{"class":306},[275,348,316],{"class":306},[275,350,351],{"class":284},"--watchdog-interval MS",[275,353,329],{"class":306},[275,355,357,359,362,364,366,369,371,373,376],{"class":277,"line":356},4,[275,358,307],{"class":306},[275,360,361],{"class":284},"--admin-port PORT",[275,363,313],{"class":306},[275,365,316],{"class":306},[275,367,368],{"class":284},"--admin-host HOST",[275,370,313],{"class":306},[275,372,316],{"class":306},[275,374,375],{"class":284},"--storage SPECIFIER",[275,377,329],{"class":306},[154,379,380,393],{},[157,381,382],{},[160,383,384,387,390],{},[163,385,386],{},"Flag",[163,388,389],{},"Default",[163,391,392],{},"Description",[173,394,395,410,435,454,467,492,521,543,558,571,584,601],{},[160,396,397,402,407],{},[178,398,399],{},[181,400,401],{},"--tasks",[178,403,404],{},[181,405,406],{},"tasks.json",[178,408,409],{},"Path to the desired-state file",[160,411,412,417,422],{},[178,413,414],{},[181,415,416],{},"--db",[178,418,419],{},[181,420,421],{},"sched.db",[178,423,424,425,431,432,434],{},"SQLite database path — ",[241,426,427,428],{},"only valid with ",[181,429,430],{},"--storage sqlite"," (XOR: a non-sqlite storage with an explicit ",[181,433,416],{}," fails fast)",[160,436,437,442,447],{},[178,438,439],{},[181,440,441],{},"--storage",[178,443,444],{},[181,445,446],{},"sqlite",[178,448,449,450,453],{},"Exactly ",[241,451,452],{},"one"," storage (see below)",[160,455,456,461,464],{},[178,457,458],{},[181,459,460],{},"--lock-ttl",[178,462,463],{},"1800 (30 min)",[178,465,466],{},"Zombie-lock threshold in seconds",[160,468,469,474,477],{},[178,470,471],{},[181,472,473],{},"--lock-heartbeat",[178,475,476],{},"600 (10 min)",[178,478,479,480,487,488,491],{},"Lock refresh cadence for long sync runs, seconds — ",[241,481,482,483,486],{},"must be ",[181,484,485],{},"\u003C lock-ttl"," (enforced at parse; the engine throws too)"," (default: ",[181,489,490],{},"lock-ttl \u002F 3",")",[160,493,494,499,502],{},[178,495,496],{},[181,497,498],{},"--retention-ttl",[178,500,501],{},"2592000 (30 d)",[178,503,504,505,508,509,515,516,491],{},"Retention TTL for regular terminal runs, seconds from ",[181,506,507],{},"finishedAt",". ",[241,510,511,514],{},[181,512,513],{},"0"," = retention off"," — terminal runs are kept forever (archive semantics, see ",[517,518,520],"a",{"href":519},"#retention","Retention",[160,522,523,528,531],{},[178,524,525],{},[181,526,527],{},"--temporary-retention-ttl",[178,529,530],{},"86400 (24 h)",[178,532,533,534,537,538],{},"Retention TTL for ",[181,535,536],{},"temporary"," runs. ",[241,539,540,542],{},[181,541,513],{}," = retention off for the temporary class",[160,544,545,550,553],{},[178,546,547],{},[181,548,549],{},"--poll-timeout",[178,551,552],{},"1500 (25 min)",[178,554,555,556],{},"Async (accepted) run ceiling in seconds — must be ",[181,557,485],{},[160,559,560,565,568],{},[178,561,562],{},[181,563,564],{},"--tick-interval",[178,566,567],{},"1000",[178,569,570],{},"Tick cadence in ms (due-task scan)",[160,572,573,578,581],{},[178,574,575],{},[181,576,577],{},"--watchdog-interval",[178,579,580],{},"60000",[178,582,583],{},"Watchdog cadence in ms (zombie reaping)",[160,585,586,591,594],{},[178,587,588],{},[181,589,590],{},"--admin-port",[178,592,593],{},"—",[178,595,596,597,600],{},"Serve the admin API (",[181,598,599],{},"\u002Fapi\u002F*",") on this port",[160,602,603,608,613],{},[178,604,605],{},[181,606,607],{},"--admin-host",[178,609,610],{},[181,611,612],{},"127.0.0.1",[178,614,615],{},"Bind host for the admin server",[261,617,619],{"id":618},"environment","Environment",[154,621,622,631],{},[157,623,624],{},[160,625,626,629],{},[163,627,628],{},"Env var",[163,630,392],{},[173,632,633,651,661,681,694,706],{},[160,634,635,640],{},[178,636,637],{},[181,638,639],{},"SCHED_ADMIN_KEY",[178,641,642,643,646,647,650],{},"Bearer key for the admin API\u002FUI. Unset → API open (bind private host!). With a key set, the web UI accepts it via the ",[241,644,645],{},"admin key"," field in the header (saved to localStorage) or ",[181,648,649],{},"?token=…"," on the shell URL",[160,652,653,658],{},[178,654,655],{},[181,656,657],{},"DOCKER_HOST",[178,659,660],{},"Override the docker CLI context (used by the docker runner)",[160,662,663,672],{},[178,664,665,668,669,491],{},[181,666,667],{},"MONGO_URL"," (+",[181,670,671],{},"MONGO_DB",[178,673,674,675,508,678,680],{},"Connection string for ",[181,676,677],{},"--storage mongo",[181,679,671],{}," overrides the db name from the URI path",[160,682,683,688],{},[178,684,685],{},[181,686,687],{},"MONGO_RETRY_MS",[178,689,690,691,693],{},"Startup-connect retry budget for ",[181,692,677],{}," (default 30000). The initial connect is retried every 500 ms up to this budget before the daemon fails — a brief mongo restart does not crash-loop the daemon at boot",[160,695,696,701],{},[178,697,698],{},[181,699,700],{},"MYSQL_URL",[178,702,674,703],{},[181,704,705],{},"--storage mysql",[160,707,708,713],{},[178,709,710],{},[181,711,712],{},"PG_URL",[178,714,674,715],{},[181,716,717],{},"--storage postgres",[236,719,720],{},[150,721,722,725,726,729,730,733,734,737],{},[241,723,724],{},"Connection strings live in env \u002F config-volume only — never in arguments.","\nA connstring passed as a flag would leak into the process list (",[181,727,728],{},"ps",", ",[181,731,732],{},"docker inspect","). The startup banner prints the kind + db name only\n(",[181,735,736],{},"storage=mongo db=\u003Cname>","), never the URL or credentials.",[261,739,741,742,491],{"id":740},"storage-selection-storage","Storage selection (",[181,743,441],{},[150,745,746,747,749,750,752,753,755],{},"The daemon supports exactly ",[241,748,452],{}," storage per process — the ",[181,751,441],{},"\nspecifier (XOR with ",[181,754,416],{},", which is the sqlite knob):",[154,757,758,770],{},[157,759,760],{},[160,761,762,765,767],{},[163,763,764],{},"Specifier",[163,766,75],{},[163,768,769],{},"How it's wired",[173,771,772,789,808,824,840],{},[160,773,774,779,784],{},[178,775,776,778],{},[181,777,446],{}," (default)",[178,780,781,782,491],{},"SQLite file (",[181,783,416],{},[178,785,786,787],{},"built into ",[181,788,188],{},[160,790,791,796,801],{},[178,792,793],{},[181,794,795],{},"mongo",[178,797,798],{},[181,799,800],{},"@schedjs\u002Fstorage-mongo",[178,802,803,804,668,806,491],{},"env ",[181,805,667],{},[181,807,671],{},[160,809,810,815,820],{},[178,811,812],{},[181,813,814],{},"mysql",[178,816,817],{},[181,818,819],{},"@schedjs\u002Fstorage-mysql",[178,821,803,822],{},[181,823,700],{},[160,825,826,831,836],{},[178,827,828],{},[181,829,830],{},"postgres",[178,832,833],{},[181,834,835],{},"@schedjs\u002Fstorage-postgres",[178,837,803,838],{},[181,839,712],{},[160,841,842,851,857],{},[178,843,844,847,848],{},[181,845,846],{},"\u003Cnpm-package>"," \u002F ",[181,849,850],{},"\u003C.\u002Fpath>",[178,852,853,856],{},[241,854,855],{},"custom"," BYO module",[178,858,859,860],{},"dynamic import → ",[181,861,862],{},"createStorage(env)",[150,864,865,866,869,870,873,874,877],{},"Built-in kinds (",[181,867,868],{},"mongo|mysql|postgres",") resolve to their ",[181,871,872],{},"@schedjs\u002Fstorage-*","\npackage ",[241,875,876],{},"at runtime"," — the package must be present in the image, otherwise\nstartup fails fast:",[266,879,884],{"className":880,"code":882,"language":883,"meta":271},[881],"language-text","schedd: fatal: --storage mongo: add @schedjs\u002Fstorage-mongo to your image (RUN yarn add @schedjs\u002Fstorage-mongo)\n","text",[181,885,882],{"__ignoreMap":271},[150,887,888,889,892,893,896,897,729,900,729,903,906],{},"A custom module must export ",[181,890,891],{},"createStorage(env): Promise\u003CStorage>"," — the same\nBYO contract as the built-in adapters (",[517,894,75],{"href":895},"storage","). ",[181,898,899],{},".\u002F",[181,901,902],{},"..\u002F",[181,904,905],{},"\u002F","\nprefixes resolve to a filesystem path (relative to the daemon's cwd); anything\nelse is an npm package.",[266,908,910],{"className":268,"code":909,"language":270,"meta":271,"style":271},"MONGO_URL=mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched schedd --tasks tasks.json --storage mongo\n",[181,911,912],{"__ignoreMap":271},[275,913,914,917,920,923,926,930,933,936],{"class":277,"line":278},[275,915,667],{"class":916},"sSC40",[275,918,919],{"class":306},"=",[275,921,922],{"class":288},"mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched",[275,924,925],{"class":281}," schedd",[275,927,929],{"class":928},"sz9Cv"," --tasks",[275,931,932],{"class":288}," tasks.json",[275,934,935],{"class":928}," --storage",[275,937,938],{"class":288}," mongo\n",[261,940,942],{"id":941},"signals","Signals",[154,944,945,955],{},[157,946,947],{},[160,948,949,952],{},[163,950,951],{},"Signal",[163,953,954],{},"Behavior",[173,956,957,968,978],{},[160,958,959,965],{},[178,960,961,964],{},[181,962,963],{},"SIGINT"," (Ctrl+C)",[178,966,967],{},"Graceful stop — engine loops stop, sqlite closes, exit 0",[160,969,970,975],{},[178,971,972],{},[181,973,974],{},"SIGTERM",[178,976,977],{},"Same graceful stop (POSIX; systemd, docker stop)",[160,979,980,986],{},[178,981,982,985],{},[181,983,984],{},"SIGBREAK"," (Ctrl+Break, win32)",[178,987,988],{},"Same graceful stop — added for Windows operators",[150,990,991,992,995,996,999,1000,1002],{},"On Windows, ",[181,993,994],{},"taskkill"," sends a termination that does ",[241,997,998],{},"not"," always reach a\nconsole process as ",[181,1001,974],{}," — the reliable paths are Ctrl+C \u002F Ctrl+Break.",[261,1004,1006],{"id":1005},"what-the-daemon-does-on-start","What the daemon does on start",[1008,1009,1010,1021,1027,1038],"ol",{},[1011,1012,1013,1014,1016,1017,1020],"li",{},"Resolves the storage (",[181,1015,441],{},"); a non-sqlite storage validates its\nconnstring env ",[241,1018,1019],{},"before"," anything starts (missing env → fail-fast).",[1011,1022,1023,1024,1026],{},"Syncs ",[181,1025,406],{}," into storage (desired state; removed tasks get disabled).",[1011,1028,1029,1030,1033,1034,1037],{},"Validates every task's runner is registered — a missing runner ",[241,1031,1032],{},"aborts startup",":\n",[181,1035,1036],{},"task \"greet\": runner \"custom\" not implemented in this build (registered: http, docker)",".",[1011,1039,1040,1041,1044,1045,847,1047,1049],{},"Starts the tick loop (fires due tasks), the watchdog (reaps zombie locks), the\npoll loop (async ",[181,1042,1043],{},"accepted"," runs), and the retention loop (hourly sweep of\nterminal runs past their TTL — ",[181,1046,498],{},[181,1048,527],{},").",[261,1051,520],{"id":1052},"retention",[150,1054,1055,1056,847,1059,847,1062,1065,1066,1068],{},"Terminal runs (",[181,1057,1058],{},"succeeded",[181,1060,1061],{},"failed",[181,1063,1064],{},"cancelled",") are pruned by the retention\nloop (hourly) once they're past their class TTL, measured from ",[181,1067,507],{},":",[1070,1071,1072,1084],"ul",{},[1011,1073,1074,1076,1077,1079,1080,1083],{},[181,1075,536],{}," runs → ",[181,1078,527],{}," (default ",[241,1081,1082],{},"24 h",");",[1011,1085,1086,1087,1079,1089,1049],{},"regular runs → ",[181,1088,498],{},[241,1090,1091],{},"30 d",[150,1093,1094,1095,1100,1101,1104,1105,1107,1108,1111],{},"Set the TTL to ",[241,1096,1097,1099],{},[181,1098,513],{}," to turn retention off for that class"," — run history is kept\nforever. This is the archive mode for deployments that migrate legacy history\ninto sched (books: migrated ",[181,1102,1103],{},"task_runs"," carry old ",[181,1106,507],{}," timestamps, and\nwith the 30 d default the first hourly pass would silently prune everything\nolder than a month — ",[181,1109,1110],{},"--retention-ttl 0 --temporary-retention-ttl 0"," keeps the\narchive).",[236,1113,1114],{},[150,1115,1116,1117,1119],{},"Note: ",[181,1118,513],{}," was added in daemon 0.11.0. Earlier versions had no way to disable\nretention — a migration onto the 30 d default pruned aged history.",[261,1121,1123],{"id":1122},"example","Example",[266,1125,1127],{"className":268,"code":1126,"language":270,"meta":271,"style":271},"SCHED_ADMIN_KEY=dev-key schedd \\\n  --tasks tasks.json \\\n  --db sched.db \\\n  --admin-port 8080\n",[181,1128,1129,1144,1153,1163],{"__ignoreMap":271},[275,1130,1131,1133,1135,1138,1140],{"class":277,"line":278},[275,1132,639],{"class":916},[275,1134,919],{"class":306},[275,1136,1137],{"class":288},"dev-key",[275,1139,925],{"class":281},[275,1141,1143],{"class":1142},"se3Ec"," \\\n",[275,1145,1146,1149,1151],{"class":277,"line":21},[275,1147,1148],{"class":928},"  --tasks",[275,1150,932],{"class":288},[275,1152,1143],{"class":1142},[275,1154,1155,1158,1161],{"class":277,"line":332},[275,1156,1157],{"class":928},"  --db",[275,1159,1160],{"class":288}," sched.db",[275,1162,1143],{"class":1142},[275,1164,1165,1168],{"class":277,"line":356},[275,1166,1167],{"class":928},"  --admin-port",[275,1169,1171],{"class":1170},"s7CZa"," 8080\n",[150,1173,1174,1175,1180,1181,1184,1185,215,1188,1191,1192,1195],{},"Then the admin api answers on ",[517,1176,1177],{"href":1177,"rel":1178},"http:\u002F\u002F127.0.0.1:8080\u002Fapi\u002F",[1179],"nofollow","*. The operator CLI\n(",[181,1182,1183],{},"sched status --admin-url http:\u002F\u002F127.0.0.1:8080\u002Fapi",") and the web UI\n(",[181,1186,1187],{},"npx @schedjs\u002Fui",[181,1189,1190],{},"sched-ui serve --proxy http:\u002F\u002F127.0.0.1:8080",", see\n",[517,1193,121],{"href":1194},"ui",") both speak to it.",[223,1197],{},[226,1199,1201,1202],{"id":1200},"operator-cli-sched","Operator CLI — ",[181,1203,198],{},[150,1205,1206,1208,1209,1212,1213,1216,1217,1220],{},[181,1207,203],{}," — a thin projection of the admin REST API (",[517,1210,117],{"href":1211},"admin-api","):\nstatus, runs, tasks, schedules, trigger, pause\u002Fresume. Zero dependencies\n(",[181,1214,1215],{},"node:fetch"," only); the daemon stays the single owner of state. Machine output\nis ",[181,1218,1219],{},"--json","; tables are for TTY eyes only.",[261,1222,1224],{"id":1223},"install","Install",[266,1226,1228],{"className":268,"code":1227,"language":270,"meta":271,"style":271},"npm install -g @schedjs\u002Fcli\n",[181,1229,1230],{"__ignoreMap":271},[275,1231,1232,1235,1238,1241],{"class":277,"line":278},[275,1233,1234],{"class":281},"npm",[275,1236,1237],{"class":288}," install",[275,1239,1240],{"class":928}," -g",[275,1242,1243],{"class":288}," @schedjs\u002Fcli\n",[261,1245,264],{"id":1246},"usage-1",[266,1248,1251],{"className":1249,"code":1250,"language":883,"meta":271},[881],"sched \u003Ccommand> [args] [--admin-url URL] [--api-key KEY] [--json]\n\nCommands:\n  status                   daemon health + queue state + task\u002Fschedule\u002Frun counts\n  runs [--task T] [--status S] [--limit N] [--offset N]\n       [--since TIME] [--until TIME] [--runner R]\n  cancel \u003Cid...>           bulk-cancel runs (partial result; exit 1 on any failure)\n  retry \u003Cid...>            bulk-retry finished runs (partial result; exit 1 on any failure)\n  tasks\n  schedules\n  trigger \u003Ctask> [--data JSON]\n  pause \u003Ctask> | pause --schedule \u003Cid>\n  resume \u003Ctask> | resume --schedule \u003Cid>\n  check-worker \u003Curl> [--api-key KEY] [--timeout SECONDS]\n",[181,1252,1250],{"__ignoreMap":271},[150,1254,1255,1258,1259,729,1262,729,1265,729,1268,1271,1272,847,1275,1278,1279,1282,1283,905,1285,1287,1288,1291,1292,1295,1296,729,1299,729,1302,729,1305,1308,1309,1312,1313,896,1317,1319,1320,1324,1325,1328],{},[181,1256,1257],{},"runs"," filters: ",[181,1260,1261],{},"task",[181,1263,1264],{},"status",[181,1266,1267],{},"limit",[181,1269,1270],{},"offset"," plus the R4 window\n",[181,1273,1274],{},"--since",[181,1276,1277],{},"--until"," and the exact ",[181,1280,1281],{},"--runner"," match. ",[181,1284,1274],{},[181,1286,1277],{},"\naccept ",[241,1289,1290],{},"ISO-8601"," or a ",[241,1293,1294],{},"relative form"," — ",[181,1297,1298],{},"30m",[181,1300,1301],{},"24h",[181,1303,1304],{},"7d",[181,1306,1307],{},"2w"," (\"that\nlong ago\"); the relative form is resolved by the CLI, and the admin API always\nreceives ISO-8601. The window is on ",[181,1310,1311],{},"startedAt",", both bounds inclusive (see\n",[517,1314,1316],{"href":1315},"runs#filtering-run-history","Runs → Filtering",[181,1318,1219],{}," echoes the ",[1321,1322,1323],"em",{},"resolved","\nfilter, so ",[181,1326,1327],{},"--since 24h"," shows the exact ISO bound that was queried.",[150,1330,1331],{},"Global flags:",[154,1333,1334,1347],{},[157,1335,1336],{},[160,1337,1338,1340,1343,1345],{},[163,1339,386],{},[163,1341,1342],{},"Env",[163,1344,389],{},[163,1346,392],{},[173,1348,1349,1373,1389,1402],{},[160,1350,1351,1356,1361,1366],{},[178,1352,1353],{},[181,1354,1355],{},"--admin-url URL",[178,1357,1358],{},[181,1359,1360],{},"SCHED_ADMIN_URL",[178,1362,1363],{},[181,1364,1365],{},"http:\u002F\u002F127.0.0.1:8080\u002Fapi",[178,1367,1368,1369,1372],{},"Admin API base — note the ",[181,1370,1371],{},"\u002Fapi"," mount point is already included",[160,1374,1375,1380,1384,1386],{},[178,1376,1377],{},[181,1378,1379],{},"--api-key KEY",[178,1381,1382],{},[181,1383,639],{},[178,1385,593],{},[178,1387,1388],{},"Bearer key for the admin API",[160,1390,1391,1395,1397,1399],{},[178,1392,1393],{},[181,1394,1219],{},[178,1396,593],{},[178,1398,593],{},[178,1400,1401],{},"Stable machine-readable JSON contract",[160,1403,1404,1418,1420,1422],{},[178,1405,1406,847,1409,729,1412,847,1415],{},[181,1407,1408],{},"-h",[181,1410,1411],{},"--help",[181,1413,1414],{},"-v",[181,1416,1417],{},"--version",[178,1419,593],{},[178,1421,593],{},[178,1423,1424],{},"Help \u002F version",[150,1426,1427,1428,1430,1431,1434,1435,1438],{},"Exit codes: ",[241,1429,513],{}," ok \u002F ",[241,1432,1433],{},"1"," api·network·data error \u002F ",[241,1436,1437],{},"2"," usage.",[150,1440,1441,847,1444,1447,1448,1451,1452,1455,1456,1459,1460,1462,1463,1465],{},[181,1442,1443],{},"cancel",[181,1445,1446],{},"retry"," take one or more run ids and return a ",[241,1449,1450],{},"partial result","\n(",[181,1453,1454],{},"{ ok, failed }",", reason ∈ ",[181,1457,1458],{},"not-found | already-terminal | not-cancellable",").\nExit code ",[241,1461,1433],{}," whenever at least one id failed, ",[241,1464,513],{}," only on a fully clean\nbatch — so a partial batch never reads as success to a shell.",[150,1467,1468,1471,1472,1474,1475,1478],{},[181,1469,1470],{},"--api-key"," before the command is the admin key; after ",[181,1473,209],{}," it is the\n",[1321,1476,1477],{},"worker's"," key (a different secret — see below).",[261,1480,1482],{"id":1481},"examples","Examples",[266,1484,1486],{"className":268,"code":1485,"language":270,"meta":271,"style":271},"sched status                                   # is my daemon alive? queue paused? next runs?\nsched runs --status failed --limit 20 --json   # failed runs as JSON\nsched runs --since 24h --until 2h --runner docker   # what fell over in the last 22 hours, docker only\nsched cancel r-1 r-2 r-3                       # bulk-cancel a mixed batch\nsched trigger publish-video --data '{\"videoId\":\"v-42\"}'\nsched pause --schedule channel-ada             # pause one channel's schedule, not the task\nsched resume sync-channel-stats\n",[181,1487,1488,1499,1524,1551,1570,1594,1611],{"__ignoreMap":271},[275,1489,1490,1492,1495],{"class":277,"line":278},[275,1491,198],{"class":281},[275,1493,1494],{"class":288}," status",[275,1496,1498],{"class":1497},"s9Tkl","                                   # is my daemon alive? queue paused? next runs?\n",[275,1500,1501,1503,1506,1509,1512,1515,1518,1521],{"class":277,"line":21},[275,1502,198],{"class":281},[275,1504,1505],{"class":288}," runs",[275,1507,1508],{"class":928}," --status",[275,1510,1511],{"class":288}," failed",[275,1513,1514],{"class":928}," --limit",[275,1516,1517],{"class":1170}," 20",[275,1519,1520],{"class":928}," --json",[275,1522,1523],{"class":1497},"   # failed runs as JSON\n",[275,1525,1526,1528,1530,