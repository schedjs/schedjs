237,238],"blockquote",{},[150,239,240,244,245,247,248,251,252,255,256,259],{},[241,242,243],"strong",{},"Node 24 requirement."," ",[181,246,183],{}," requires Node >= 24 (",[181,249,250],{},"engines","): ",[181,253,254],{},"node:sqlite","\nis stable there, so the one-line ",[181,257,258],{},"ExperimentalWarning: SQLite …"," that Node 22\nprinted on every start is gone.",[261,262,264],"h2",{"id":263},"usage","Usage",[266,267,272],"pre",{"className":268,"code":269,"language":270,"meta":271,"style":271},"language-bash shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","schedd [--tasks tasks.json] [--db sched.db] [--lock-ttl SECONDS]\n       [--lock-heartbeat SECONDS] [--retention-ttl SECONDS] [--temporary-retention-ttl SECONDS]\n       [--poll-timeout SECONDS] [--tick-interval MS] [--watchdog-interval MS]\n       [--admin-port PORT] [--admin-host HOST] [--storage SPECIFIER]\n","bash","",[181,273,274,302,330,354],{"__ignoreMap":271},[275,276,279,282,286,290,293,296,299],"span",{"class":277,"line":278},"line",1,[275,280,183],{"class":281},"sYn-s",[275,283,285],{"class":284},"sftqT"," [--tasks ",[275,287,289],{"class":288},"sTbE_","tasks.json]",[275,291,292],{"class":284}," [--db ",[275,294,295],{"class":288},"sched.db]",[275,297,298],{"class":284}," [--lock-ttl ",[275,300,301],{"class":288},"SECONDS]\n",[275,303,304,308,311,314,317,320,322,324,327],{"class":277,"line":21},[275,305,307],{"class":306},"soVBu","       [",[275,309,310],{"class":284},"--lock-heartbeat SECONDS",[275,312,313],{"class":306},"]",[275,315,316],{"class":306}," [",[275,318,319],{"class":284},"--retention-ttl SECONDS",[275,321,313],{"class":306},[275,323,316],{"class":306},[275,325,326],{"class":284},"--temporary-retention-ttl SECONDS",[275,328,329],{"class":306},"]\n",[275,331,333,335,338,340,342,345,347,349,352],{"class":277,"line":332},3,[275,334,307],{"class":306},[275,336,337],{"class":284},"--poll-timeout SECONDS",[275,339,313],{"class":306},[275,341,316],{"class":306},[275,343,344],{"class":284},"--tick-interval MS",[275,346,313],{"class":306},[275,348,316],{"class":306},[275,350,351],{"class":284},"--watchdog-interval MS",[275,353,329],{"class":306},[275,355,357,359,362,364,366,369,371,373,376],{"class":277,"line":356},4,[275,358,307],{"class":306},[275,360,361],{"class":284},"--admin-port PORT",[275,363,313],{"class":306},[275,365,316],{"class":306},[275,367,368],{"class":284},"--admin-host HOST",[275,370,313],{"class":306},[275,372,316],{"class":306},[275,374,375],{"class":284},"--storage SPECIFIER",[275,377,329],{"class":306},[154,379,380,393],{},[157,381,382],{},[160,383,384,387,390],{},[163,385,386],{},"Flag",[163,388,389],{},"Default",[163,391,392],{},"Description",[173,394,395,410,435,454,467,492,521,543,558,571,584,601],{},[160,396,397,402,407],{},[178,398,399],{},[181,400,401],{},"--tasks",[178,403,404],{},[181,405,406],{},"tasks.json",[178,408,409],{},"Path to the desired-state file",[160,411,412,417,422],{},[178,413,414],{},[181,415,416],{},"--db",[178,418,419],{},[181,420,421],{},"sched.db",[178,423,424,425,431,432,434],{},"SQLite database path — ",[241,426,427,428],{},"only valid with ",[181,429,430],{},"--storage sqlite"," (XOR: a non-sqlite storage with an explicit ",[181,433,416],{}," fails fast)",[160,436,437,442,447],{},[178,438,439],{},[181,440,441],{},"--storage",[178,443,444],{},[181,445,446],{},"sqlite",[178,448,449,450,453],{},"Exactly ",[241,451,452],{},"one"," storage (see below)",[160,455,456,461,464],{},[178,457,458],{},[181,459,460],{},"--lock-ttl",[178,462,463],{},"1800 (30 min)",[178,465,466],{},"Zombie-lock threshold in seconds",[160,468,469,474,477],{},[178,470,471],{},[181,472,473],{},"--lock-heartbeat",[178,475,476],{},"600 (10 min)",[178,478,479,480,487,488,491],{},"Lock refresh cadence for long sync runs, seconds — ",[241,481,482,483,486],{},"must be ",[181,484,485],{},"\u003C lock-ttl"," (enforced at parse; the engine throws too)"," (default: ",[181,489,490],{},"lock-ttl \u002F 3",")",[160,493,494,499,502],{},[178,495,496],{},[181,497,498],{},"--retention-ttl",[178,500,501],{},"2592000 (30 d)",[178,503,504,505,508,509,515,516,491],{},"Retention TTL for regular terminal runs, seconds from ",[181,506,507],{},"finishedAt",". ",[241,510,511,514],{},[181,512,513],{},"0"," = retention off"," — terminal runs are kept forever (archive semantics, see ",[517,518,520],"a",{"href":519},"#retention","Retention",[160,522,523,528,531],{},[178,524,525],{},[181,526,527],{},"--temporary-retention-ttl",[178,529,530],{},"86400 (24 h)",[178,532,533,534,537,538],{},"Retention TTL for ",[181,535,536],{},"temporary"," runs. ",[241,539,540,542],{},[181,541,513],{}," = retention off for the temporary class",[160,544,545,550,553],{},[178,546,547],{},[181,548,549],{},"--poll-timeout",[178,551,552],{},"1500 (25 min)",[178,554,555,556],{},"Async (accepted) run ceiling in seconds — must be ",[181,557,485],{},[160,559,560,565,568],{},[178,561,562],{},[181,563,564],{},"--tick-interval",[178,566,567],{},"1000",[178,569,570],{},"Tick cadence in ms (due-task scan)",[160,572,573,578,581],{},[178,574,575],{},[181,576,577],{},"--watchdog-interval",[178,579,580],{},"60000",[178,582,583],{},"Watchdog cadence in ms (zombie reaping)",[160,585,586,591,594],{},[178,587,588],{},[181,589,590],{},"--admin-port",[178,592,593],{},"—",[178,595,596,597,600],{},"Serve the admin API (",[181,598,599],{},"\u002Fapi\u002F*",") on this port",[160,602,603,608,613],{},[178,604,605],{},[181,606,607],{},"--admin-host",[178,609,610],{},[181,611,612],{},"127.0.0.1",[178,614,615],{},"Bind host for the admin server",[261,617,619],{"id":618},"environment","Environment",[154,621,622,631],{},[157,623,624],{},[160,625,626,629],{},[163,627,628],{},"Env var",[163,630,392],{},[173,632,633,651,661,681,694,706],{},[160,634,635,640],{},[178,636,637],{},[181,638,639],{},"SCHED_ADMIN_KEY",[178,641,642,643,646,647,650],{},"Bearer key for the admin API\u002FUI. Unset → API open (bind private host!). With a key set, the web UI accepts it via the ",[241,644,645],{},"admin key"," field in the header (saved to localStorage) or ",[181,648,649],{},"?token=…"," on the shell URL",[160,652,653,658],{},[178,654,655],{},[181,656,657],{},"DOCKER_HOST",[178,659,660],{},"Override the docker CLI context (used by the docker runner)",[160,662,663,672],{},[178,664,665,668,669,491],{},[181,666,667],{},"MONGO_URL"," (+",[181,670,671],{},"MONGO_DB",[178,673,674,675,508,678,680],{},"Connection string for ",[181,676,677],{},"--storage mongo",[181,679,671],{}," overrides the db name from the URI path",[160,682,683,688],{},[178,684,685],{},[181,686,687],{},"MONGO_RETRY_MS",[178,689,690,691,693],{},"Startup-connect retry budget for ",[181,692,677],{}," (default 30000). The initial connect is retried every 500 ms up to this budget before the daemon fails — a brief mongo restart does not crash-loop the daemon at boot",[160,695,696,701],{},[178,697,698],{},[181,699,700],{},"MYSQL_URL",[178,702,674,703],{},[181,704,705],{},"--storage mysql",[160,707,708,713],{},[178,709,710],{},[181,711,712],{},"PG_URL",[178,714,674,715],{},[181,716,717],{},"--storage postgres",[236,719,720],{},[150,721,722,725,726,729,730,733,734,737],{},[241,723,724],{},"Connection strings live in env \u002F config-volume only — never in arguments.","\nA connstring passed as a flag would leak into the process list (",[181,727,728],{},"ps",", ",[181,731,732],{},"docker inspect","). The startup banner prints the kind + db name only\n(",[181,735,736],{},"storage=mongo db=\u003Cname>","), never the URL or credentials.",[261,739,741,742,491],{"id":740},"storage-selection-storage","Storage selection (",[181,743,441],{},[150,745,746,747,749,750,752,753,755],{},"The daemon supports exactly ",[241,748,452],{}," storage per process — the ",[181,751,441],{},"\nspecifier (XOR with ",[181,754,416],{},", which is the sqlite knob):",[154,757,758,770],{},[157,759,760],{},[160,761,762,765,767],{},[163,763,764],{},"Specifier",[163,766,75],{},[163,768,769],{},"How it's wired",[173,771,772,789,808,824,840],{},[160,773,774,779,784],{},[178,775,776,778],{},[181,777,446],{}," (default)",[178,780,781,782,491],{},"SQLite file (",[181,783,416],{},[178,785,786,787],{},"built into ",[181,788,188],{},[160,790,791,796,801],{},[178,792,793],{},[181,794,795],{},"mongo",[178,797,798],{},[181,799,800],{},"@schedjs\u002Fstorage-mongo",[178,802,803,804,668,806,491],{},"env ",[181,805,667],{},[181,807,671],{},[160,809,810,815,820],{},[178,811,812],{},[181,813,814],{},"mysql",[178,816,817],{},[181,818,819],{},"@schedjs\u002Fstorage-mysql",[178,821,803,822],{},[181,823,700],{},[160,825,826,831,836],{},[178,827,828],{},[181,829,830],{},"postgres",[178,832,833],{},[181,834,835],{},"@schedjs\u002Fstorage-postgres",[178,837,803,838],{},[181,839,712],{},[160,841,842,851,857],{},[178,843,844,847,848],{},[181,845,846],{},"\u003Cnpm-package>"," \u002F ",[181,849,850],{},"\u003C.\u002Fpath>",[178,852,853,856],{},[241,854,855],{},"custom"," BYO module",[178,858,859,860],{},"dynamic import → ",[181,861,862],{},"createStorage(env)",[150,864,865,866,869,870,873,874,877],{},"Built-in kinds (",[181,867,868],{},"mongo|mysql|postgres",") resolve to their ",[181,871,872],{},"@schedjs\u002Fstorage-*","\npackage ",[241,875,876],{},"at runtime"," — the package must be present in the image, otherwise\nstartup fails fast:",[266,879,884],{"className":880,"code":882,"language":883,"meta":271},[881],"language-text","schedd: fatal: --storage mongo: add @schedjs\u002Fstorage-mongo to your image (RUN yarn add @schedjs\u002Fstorage-mongo)\n","text",[181,885,882],{"__ignoreMap":271},[150,887,888,889,892,893,896,897,729,900,729,903,906],{},"A custom module must export ",[181,890,891],{},"createStorage(env): Promise\u003CStorage>"," — the same\nBYO contract as the built-in adapters (",[517,894,75],{"href":895},"storage","). ",[181,898,899],{},".\u002F",[181,901,902],{},"..\u002F",[181,904,905],{},"\u002F","\nprefixes resolve to a filesystem path (relative to the daemon's cwd); anything\nelse is an npm package.",[266,908,910],{"className":268,"code":909,"language":270,"meta":271,"style":271},"MONGO_URL=mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched schedd --tasks tasks.json --storage mongo\n",[181,911,912],{"__ignoreMap":271},[275,913,914,917,920,923,926,930,933,936],{"class":277,"line":278},[275,915,667],{"class":916},"sSC40",[275,918,919],{"class":306},"=",[275,921,922],{"class":288},"mongodb:\u002F\u002Fuser:pass@db.internal:27017\u002Fsched",[275,924,925],{"class":281}," schedd",[275,927,929],{"class":928},"sz9Cv"," --tasks",[275,931,932],{"class":288}," tasks.json",[275,934,935],{"class":928}," --storage",[275,937,938],{"class":288}," mongo\n",[261,940,942],{"id":941},"signals","Signals",[154,944,945,955],{},[157,946,947],{},[160,948,949,952],{},[163,950,951],{},"Signal",[163,953,954],{},"Behavior",[173,956,957,968,978],{},[160,958,959,965],{},[178,960,961,964],{},[181,962,963],{},"SIGINT"," (Ctrl+C)",[178,966,967],{},"Graceful stop — engine loops stop, sqlite closes, exit 0",[160,969,970,975],{},[178,971,972],{},[181,973,974],{},"SIGTERM",[178,976,977],{},"Same graceful stop (POSIX; systemd, docker stop)",[160,979,980,986],{},[178,981,982,985],{},[181,983,984],{},"SIGBREAK"," (Ctrl+Break, win32)",[178,987,988],{},"Same graceful stop — added for Windows operators",[150,990,991,992,995,996,999,1000,1002],{},"On Windows, ",[181,993,994],{},"taskkill"," sends a termination that does ",[241,997,998],{},"not"," always reach a\nconsole process as ",[181,1001,974],{}," — the reliable paths are Ctrl+C \u002F Ctrl+Break.",[261,1004,1006],{"id":1005},"what-the-daemon-does-on-start","What the daemon does on start",[1008,1009,1010,1021,1027,1038],"ol",{},[1011,1012,1013,1014,1016,1017,1020],"li",{},"Resolves the storage (",[181,1015,441],{},"); a non-sqlite storage validates its\nconnstring env ",[241,1018,1019],{},"before"," anything starts (missing env → fail-fast).",[1011,1022,1023,1024,1026],{},"Syncs ",[181,1025,406],{}," into storage (desired state; removed tasks get disabled).",[1011,1028,1029,1030,1033,1034,1037],{},"Validates every task's runner is registered — a missing runner ",[241,1031,1032],{},"aborts startup",":\n",[181,1035,1036],{},"task \"greet\": runner \"custom\" not implemented in this build (registered: http, docker)",".",[1011,1039,1040,1041,1044,1045,847,1047,1049],{},"Starts the tick loop (fires due tasks), the watchdog (reaps zombie locks), the\npoll loop (async ",[181,1042,1043],{},"accepted"," runs), and the retention loop (hourly sweep of\nterminal runs past their TTL — ",[181,1046,498],{},[181,1048,527],{},").",[261,1051,520],{"id":1052},"retention",[150,1054,1055,1056,847,1059,847,1062,1065,1066,1068],{},"Terminal runs (",[181,1057,1058],{},"succeeded",[181,1060,1061],{},"failed",[181,1063,1064],{},"cancelled",") are pruned by the retention\nloop (hourly) once they're past their class TTL, measured from ",[181,1067,507],{},":",[1070,1071,1072,1084],"ul",{},[1011,1073,1074,1076,1077,1079,1080,1083],{},[181,1075,536],{}," runs → ",[181,1078,527],{}," (default ",[241,1081,1082],{},"24 h",");",[1011,1085,1086,1087,1079,1089,1049],{},"regular runs → ",[181,1088,498],{},[241,1090,1091],{},"30 d",[150,1093,1094,1095,1100,1101,1104,1105,1107,1108,1111],{},"Set the TTL to ",[241,1096,1097,1099],{},[181,1098,513],{}," to turn retention off for that class"," — run history is kept\nforever. This is the archive mode for deployments that migrate legacy history\ninto sched (books: migrated ",[181,1102,1103],{},"task_runs"," carry old ",[181,1106,507],{}," timestamps, and\nwith the 30 d default the first hourly pass would silently prune everything\nolder than a month — ",[181,1109,1110],{},"--retention-ttl 0 --temporary-retention-ttl 0"," keeps the\narchive).",[236,1113,1114],{},[150,1115,1116,1117,1119],{},"Note: ",[181,1118,513],{}," was added in daemon 0.11.0. Earlier versions had no way to disable\nretention — a migration onto the 30 d default pruned aged history.",[261,1121,1123],{"id":1122},"example","Example",[266,1125,1127],{"className":268,"code":1126,"language":270,"meta":271,"style":271},"SCHED_ADMIN_KEY=dev-key schedd \\\n  --tasks tasks.json \\\n  --db sched.db \\\n  --admin-port 8080\n",[181,1128,1129,1144,1153,1163],{"__ignoreMap":271},[275,1130,1131,1133,1135,1138,1140],{"class":277,"line":278},[275,1132,639],{"class":916},[275,1134,919],{"class":306},[275,1136,1137],{"class":288},"dev-key",[275,1139,925],{"class":281},[275,1141,1143],{"class":1142},"se3Ec"," \\\n",[275,1145,1146,1149,1151],{"class":277,"line":21},[275,1147,1148],{"class":928},"  --tasks",[275,1150,932],{"class":288},[275,1152,1143],{"class":1142},[275,1154,1155,1158,1161],{"class":277,"line":332},[275,1156,1157],{"class":928},"  --db",[275,1159,1160],{"class":288}," sched.db",[275,1162,1143],{"class":1142},[275,1164,1165,1168],{"class":277,"line":356},[275,1166,1167],{"class":928},"  --admin-port",[275,1169,1171],{"class":1170},"s7CZa"," 8080\n",[150,1173,1174,1175,1180,1181,1184,1185,215,1188,1191,1192,1195],{},"Then the admin api answers on ",[517,1176,1177],{"href":1177,"rel":1178},"http:\u002F\u002F127.0.0.1:8080\u002Fapi\u002F",[1179],"nofollow","*. The operator CLI\n(",[181,1182,1183],{},"sched status --admin-url http:\u002F\u002F127.0.0.1:8080\u002Fapi",") and the web UI\n(",[181,1186,1187],{},"npx @schedjs\u002Fui",[181,1189,1190],{},"sched-ui serve --proxy http:\u002F\u002F127.0.0.1:8080",", see\n",[517,1193,121],{"href":1194},"ui",") both speak to it.",[223,1197],{},[226,1199,1201,1202],{"id":1200},"operator-cli-sched","Operator CLI — ",[181,1203,198],{},[150,1205,1206,1208,1209,1212,1213,1216,1217,1220],{},[181,1207,203],{}," — a thin projection of the admin REST API (",[517,1210,117],{"href":1211},"admin-api","):\nstatus, runs, tasks, schedules, trigger, pause\u002Fresume. Zero dependencies\n(",[181,1214,1215],{},"node:fetch"," only); the daemon stays the single owner of state. Machine output\nis ",[181,1218,1219],{},"--json","; tables are for TTY eyes only.",[261,1222,1224],{"id":1223},"install","Install",[266,1226,1228],{"className":268,"code":1227,"language":270,"meta":271,"style":271},"npm install -g @schedjs\u002Fcli\n",[181,1229,1230],{"__ignoreMap":271},[275,1231,1232,1235,1238,1241],{"class":277,"line":278},[275,1233,1234],{"class":281},"npm",[275,1236,1237],{"class":288}," install",[275,1239,1240],{"class":928}," -g",[275,1242,1243],{"class":288}," @schedjs\u002Fcli\n",[261,1245,264],{"id":1246},"usage-1",[266,1248,1251],{"className":1249,"code":1250,"language":883,"meta":271},[881],"sched \u003Ccommand> [args] [--admin-url URL] [--api-key KEY] [--json]\n\nCommands:\n  status                   daemon health + task\u002Fschedule\u002Frun counts + next runs\n  runs [--task T] [--status S] [--limit N] [--offset N]\n  tasks\n  schedules\n  trigger \u003Ctask> [--data JSON]\n  pause \u003Ctask> | pause --schedule \u003Cid>\n  resume \u003Ctask> | resume --schedule \u003Cid>\n  check-worker \u003Curl> [--api-key KEY] [--timeout SECONDS]\n",[181,1252,1250],{"__ignoreMap":271},[150,1254,1255],{},"Global flags:",[154,1257,1258,1271],{},[157,1259,1260],{},[160,1261,1262,1264,1267,1269],{},[163,1263,386],{},[163,1265,1266],{},"Env",[163,1268,389],{},[163,1270,392],{},[173,1272,1273,1297,1313,1326],{},[160,1274,1275,1280,1285,1290],{},[178,1276,1277],{},[181,1278,1279],{},"--admin-url URL",[178,1281,1282],{},[181,1283,1284],{},"SCHED_ADMIN_URL",[178,1286,1287],{},[181,1288,1289],{},"http:\u002F\u002F127.0.0.1:8080\u002Fapi",[178,1291,1292,1293,1296],{},"Admin API base — note the ",[181,1294,1295],{},"\u002Fapi"," mount point is already included",[160,1298,1299,1304,1308,1310],{},[178,1300,1301],{},[181,1302,1303],{},"--api-key KEY",[178,1305,1306],{},[181,1307,639],{},[178,1309,593],{},[178,1311,1312],{},"Bearer key for the admin API",[160,1314,1315,1319,1321,1323],{},[178,1316,1317],{},[181,1318,1219],{},[178,1320,593],{},[178,1322,593],{},[178,1324,1325],{},"Stable machine-readable JSON contract",[160,1327,1328,1342,1344,1346],{},[178,1329,1330,847,1333,729,1336,847,1339],{},[181,1331,1332],{},"-h",[181,1334,1335],{},"--help",[181,1337,1338],{},"-v",[181,1340,1341],{},"--version",[178,1343,593],{},[178,1345,593],{},[178,1347,1348],{},"Help \u002F version",[150,1350,1351,1352,1354,1355,1358,1359,1362],{},"Exit codes: ",[241,1353,513],{}," ok \u002F ",[241,1356,1357],{},"1"," api·network·data error \u002F ",[241,1360,1361],{},"2"," usage.",[150,1364,1365,1368,1369,1371,1372,1376],{},[181,1366,1367],{},"--api-key"," before the command is the admin key; after ",[181,1370,209],{}," it is the\n",[1373,1374,1375],"em",{},"worker's"," key (a different secret — see below).",[261,1378,1380],{"id":1379},"examples","Examples",[266,1382,1384],{"className":268,"code":1383,"language":270,"meta":271,"style":271},"sched status                                   # is my daemon alive? next runs?\nsched runs --status failed --limit 20 --json   # failed runs as JSON\nsched trigger publish-video --data '{\"videoId\":\"v-42\"}'\nsched pause --schedule channel-ada             # pause one channel's schedule, not the task\nsched resume sync-channel-stats\n",[181,1385,1386,1397,1422,1445,1461],{"__ignoreMap":271},[275,1387,1388,1390,1393],{"class":277,"line":278},[275,1389,198],{"class":281},[275,1391,1392],{"class":288}," status",[275,1394,1396],{"class":1395},"s9Tkl","                                   # is my daemon alive? next runs?\n",[275,1398,1399,1401,1404,1407,1410,1413,1416,1419],{"class":277,"line":21},[275,1400,198],{"class":281},[275,1402,1403],{"class":288}," runs",[275,1405,1406],{"class":928}," --status",[275,1408,1409],{"class":288}," failed",[275,1411,1412],{"class":928}," --limit",[275,1414,1415],{"class":1170}," 20",[275,1417,1418],{"class":928}," --json",[275,1420,1421],{"class":1395},"   # failed runs as JSON\n",[275,1423,1424,1426,1429,1432,1435,1439,1442],{"class":277,"line":332},[275,1425,198],{"class":281},[275,1427,1428],{"class":288}," trigger",[275,1430,1431],{"class":288}," publish-video",[275,1433,1434],{"class":928}," --data",[275,1436,1438],{"class":1437},"sbYkP"," '",[275,1440,1441],{"class":288},"{\"videoId\":\"v-42\"}",[275,1443,1444],{"class":1437},"'\n",[275,1446,1447,1449,1452,1455,1458],{"class":277,"line":356},[275,1448,198],{"class":281},[275,1450,1451],{"class":288}," pause",[275,1453,1454],{"class":928}," --schedule",[275,1456,1457],{"class":288}," channel-ada",[275,1459,1460],{"class":1395},"             # pause one channel's schedule, not the task\n",[275,1462,1464,1466,1469],{"class":277,"line":1463},5,[275,1465,198],{"class":281},[275,1467,1468],{"class":288}," resume",[275,1470,1471],{"class":288}," sync-channel-stats\n",[150,1473,1474,1477,1478,1481,1482,1481,1485,1488,1489,1492],{},[181,1475,1476],{},"status"," composes one view: ",[181,1479,1480],{},"\u002Fhealth"," + ",[181,1483,1484],{},"\u002Ftasks",[181,1486,1487],{},"\u002Fschedules"," + a bounded\nfailed-runs fetch, and lists the five soonest ",[181,1490,1491],{},"nextRunAt"," schedules.",[261,1494,1496],{"id":1495},"powershell-note","PowerShell note",[150,1498,1499,1500,1503,1504,1507,1508,1511,1512,1515],{},"Windows PowerShell 5.1 pipes UTF-16 by default — ",[181,1501,1502],{},"ConvertFrom-Json"," can garble\nUTF-8 JSON from ",[181,1505,1506],{},"sched --json",". Use ",[181,1509,1510],{},"pwsh"," (PS 7, native UTF-8) or ",[181,1513,1514],{},"chcp 65001","\nin cmd. Quote paths with spaces in examples.",[261,1517,1519],{"id":1518},"check-worker-conformance-validator","check-worker — conformance validator",[150,1521,1522,1523,1526],{},"Validates that an HTTP envelope worker (",[517,1524,31],{"href":1525},"protocol",") speaks the\nwire contract correctly — a fake-sched client that sends exactly the envelopes\nsched sends and checks the answers. Never touches the daemon or the admin api.",[266,1528,1530],{"className":268,"code":1529,"language":270,"meta":271,"style":271},"sched check-worker http:\u002F\u002F127.0.0.1:8081 --api-key $SCHED_API_KEY --timeout 30\n",[181,1531,1532],{"__ignoreMap":271},[275,1533,1534,1536,1539,1542,1545,1548,1551],{"class":277,"line":278},[275,1535,198],{"class":281},[275,1537,1538],{"class":288}," check-worker",[275,1540,1541],{"class":288}," http:\u002F\u002F127.0.0.1:8081",[275,1543,1544],{"class":928}," --api-key",[275,1546,1547],{"class":916}," $SCHED_API_KEY",[275,1549,1550],{"class":928}," --timeout",[275,1552,1553],{"class":1170}," 30\n",[150,1555,1556],{},"Six scenarios, each PASS\u002FFAIL:",[154,1558,1559,1572],{},[157,1560,1561],{},[160,1562,1563,1566,1569],{},[163,1564,1565],{},"#",[163,1567,1568],{},"Scenario",[163,1570,1571],{},"Check",[173,1573,1574,1587,1603,1614,1628,1639],{},[160,1575,1576,1578,1581],{},[178,1577,1357],{},[178,1579,1580],{},"Sync success",[178,1582,1583,1584],{},"POST ping → 200 ",[181,1585,1586],{},"{status:\"succeeded\"}",[160,1588,1589,1591,1594],{},[178,1590,1361],{},[178,1592,1593],{},"Sync failure",[178,1595,1596,1597,215,1600],{},"POST with ",[181,1598,1599],{},"data.fail",[181,1601,1602],{},"{status:\"failed\", error}",[160,1604,1605,1608,1611],{},[178,1606,1607],{},"3",[178,1609,1610],{},"Async lifecycle",[178,1612,1613],{},"POST long → 202 accepted → GET statusUrl → running (progress grows) → succeeded, timeout trap",[160,1615,1616,1619,1622],{},[178,1617,1618],{},"4",[178,1620,1621],{},"Auth",[178,1623,1624,1625,1627],{},"only with ",[181,1626,1367],{},": no key → non-2xx, with key → 2xx (skipped otherwise)",[160,1629,1630,1633,1636],{},[178,1631,1632],{},"5",[178,1634,1635],{},"Run-id idempotency",[178,1637,1638],{},"two dispatches with the same run id → identical envelope",[160,1640,1641,1644,1647],{},[178,1642,1643],{},"6",[178,1645,1646],{},"Dirty input",[178,1648,1649],{},"garbage body → worker answers 4xx\u002F500 and stays alive (re-ping works)",[150,1651,1652,1653,1656,1657,1659,1660,1037],{},"Verdict: ",[181,1654,1655],{},"N\u002FN PASS",", exit 0 all-green \u002F 1 a scenario failed \u002F 2 usage.\n",[181,1658,1219],{}," prints ",[181,1661,1662],{},"{ ok, pass, fail, scenarios: [{name, pass, skipped, detail}] }",[150,1664,1665,1666,1669,1670,1673,1674,1677,1678,1681,1682,1685,1686,1689,1690,1049],{},"Worker contract for scenarios 1–5: ",[181,1667,1668],{},"POST"," with ",[181,1671,1672],{},"content-type: application\u002Fjson",",\n",[181,1675,1676],{},"x-sched-run-id"," (the idempotency key), optional ",[181,1679,1680],{},"x-sched-api-key",", body\n",[181,1683,1684],{},"{ task: { name, config }, data }"," — exactly what the HTTP runner dispatches\n(see ",[517,1687,41],{"href":1688},"runners\u002Fhttp"," and the examples in ",[181,1691,1692],{},"examples\u002Fworkers\u002F",[1694,1695,1696],"style",{},"html pre.shiki code .sYn-s, html code.shiki .sYn-s{--shiki-light:#E2931D;--shiki-default:#59873A;--shiki-dark:#80A665}html pre.shiki code .sftqT, html code.shiki .sftqT{--shiki-light:#90A4AE;--shiki-default:#393A34;--shiki-dark:#DBD7CAEE}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weigh