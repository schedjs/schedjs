he\nfamily stop holds the schedule, 🟡 ",[157,711,712],{},"paused (schedule)"," when only this instance is\npaused, ▶ ",[157,715,716],{},"active",". The two levels are shown separately so «снял паузу, а оно\nмолчит» never happens — ",[157,719,720],{},"resume"," on a schedule held by the task still shows 🔴\nuntil ",[157,723,720],{}," is called on the task.",[150,726,727,730,731,734,735,738,739,742,743,745],{},[154,728,729],{},"Runtime rows"," — a schedule whose task is runtime-only (",[157,732,733],{},"fileManaged=false",", e.g.\ncreated via the API, not ",[157,736,737],{},"tasks.json",") shows a ",[157,740,741],{},"runtime"," badge next to the task name.\nFile-managed rows (from ",[157,744,737],{},") have no badge.",[150,747,748,751,752,755,756,758,759,762,763,766,767,246,770,166,773,776,777,780,781,784],{},[154,749,750],{},"Manage schedules"," — the ",[157,753,754],{},"+ new"," button opens a form (task picker from ",[157,757,678],{},", kind cron\u002Finterval\u002Fonce + value, tz, data JSON, externalId, dedupKey,\nretry JSON, priority); it POSTs ",[157,760,761],{},"\u002Fschedules"," (a ",[157,764,765],{},"dedupKey"," makes the second save an\nupsert, not a duplicate). Each row has ",[154,768,769],{},"pause \u002F resume",[154,771,772],{},"edit",[157,774,775],{},"PATCH \u002Fschedules\u002F:id"," — the rule\u002Ftz\u002Fdata\u002Fpolicy change in place, ",[157,778,779],{},"nextRunAt"," recomputes\non a rule change) and ",[154,782,783],{},"delete"," with a confirm (runs are kept — the audit\nsurvives).",[150,786,787,628,790,246,792,246,794,796,797,800,801,804,805,808,809,812,813,816,817,820,821,824],{},[154,788,789],{},"Pagination",[157,791,613],{},[157,793,633],{},[157,795,636],{},") has a\nfooter: ",[157,798,799],{},"‹ prev"," \u002F page-size select (10\u002F25\u002F50\u002F100) \u002F row range \u002F ",[157,802,803],{},"next ›",". Lists are\nfetched with ",[157,806,807],{},"limit + 1"," rows to detect whether a next page exists (the probe row is\ntrimmed), so ",[154,810,811],{},"next"," is disabled on the last page and ",[154,814,815],{},"prev"," on the first. Changing\nthe page size resets to the first page. Page size defaults to 50 (set the ",[157,818,819],{},"limit","\nattribute); the current page offset is the ",[157,822,823],{},"offset"," attribute — set both to start the\nlist elsewhere.",[288,826,828],{"id":827},"_4-custom-ui","4. Custom UI",[150,830,831,833,834,836],{},[157,832,169],{}," exposes the same REST surface the components use — health, runs,\ntasks, schedules, plus trigger \u002F pause \u002F resume \u002F delete. See ",[162,835,117],{"href":164},".",[288,838,840],{"id":839},"auth-sched_admin_key","Auth (SCHED_ADMIN_KEY)",[150,842,843,844,846,847,850],{},"With a key set on the daemon, the shell prompts for it in the header (saved to\nlocalStorage) — or pass ",[157,845,418],{}," on the URL, or set ",[157,848,849],{},"el.token"," on components.",[288,852,854],{"id":853},"embedded-apps-no-daemon","Embedded apps (no daemon)",[150,856,857],{},"An embedded engine can mount the admin api itself and use any UI mode:",[293,859,863],{"className":860,"code":861,"language":862,"meta":298,"style":298},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { createEngine, createInternalRunner, createSqliteStorage } from '@schedjs\u002Fcore';\nimport { createAdminApi } from '@schedjs\u002Fadmin-api';\n\nconst engine = createEngine({ \u002F* … *\u002F });\nconst admin = createAdminApi({ engine, storage, auth: { apiKey: '…' } });\n\n\u002F\u002F in your http server, mount \u002Fsched\u002Fapi → admin.handleRequest(req, res)\n","ts",[157,864,865,907,928,934,965,1018,1023],{"__ignoreMap":298},[302,866,867,871,874,878,881,884,886,889,892,895,898,901,904],{"class":304,"line":305},[302,868,870],{"class":869},"siDh9","import",[302,872,873],{"class":441}," {",[302,875,877],{"class":876},"sSC40"," createEngine",[302,879,880],{"class":441},",",[302,882,883],{"class":876}," createInternalRunner