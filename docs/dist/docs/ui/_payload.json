],{},"Run deletion in ",[153,608,609],{},"\u003Csched-runs>"," is two-step: the row's ",[150,612,613],{},"del"," button arms to ",[150,616,617],{},"sure?","\nand only a second click within 3s deletes (auto-disarms on timeout or refresh) — a\nstray click can't wipe a run.",[146,620,621,624,625,242,627,242,630,633,634,637,638,641,642,645,646,648],{},[150,622,623],{},"Auto-refresh"," — every list (",[153,626,609],{},[153,628,629],{},"\u003Csched-tasks>",[153,631,632],{},"\u003Csched-schedules>",")\npolls the admin api on the ",[153,635,636],{},"refreshMs"," interval (property, or the ",[153,639,640],{},"refresh-ms","\nattribute; default 5000 ms) so live fields — run status\u002Fprogress, next-run and\nlast-run times, fail counts — stay current; set ",[153,643,644],{},"refreshMs=0"," to disable polling.\nThe shell sets this from the ",[153,647,417],{}," query override.",[146,650,651,654,655,372,657,659,660,663,664,667,668,671,672,675],{},[150,652,653],{},"Last status"," — ",[153,656,632],{},[153,658,629],{}," show a ",[153,661,662],{},"last status","\ncolumn (✔ succeeded \u002F ✘ failed \u002F ⊘ cancelled) so you can see how the most recent\nrun ended at a glance. The value comes from the server (",[153,665,666],{},"lastRunStatus"," in\n",[153,669,670],{},"GET \u002Fschedules"," \u002F ",[153,673,674],{},"GET \u002Ftasks","), resolved in one pass — the browser does not\nfetch the run per row.",[146,677,678,681,682,684,685,688,689,242,692,697,698,701,702,705,706,709,710,713,714,717,718,720],{},[150,679,680],{},"Schedules are first-class"," (schedule-as-entity) — ",[153,683,632],{}," lists each\nschedule row: ",[153,686,687],{},"task",", rule, ",[153,690,691],{},"tz",[150,693,694],{},[153,695,696],{},"data"," (the per-tenant parameters), next run,\nlast run + status, and the ",[150,699,700],{},"effective pause status",": 🔴 ",[153,703,704],{},"paused (task)"," when the\nfamily stop holds the schedule, 🟡 ",[153,707,708],{},"paused (schedule)"," when only this instance is\npaused, ▶ ",[153,711,712],{},"active",". The two levels are shown separately so «снял паузу, а оно\nмолчит» never happens — ",[153,715,716],{},"resume"," on a schedule held by the task still shows 🔴\nuntil ",[153,719,716],{}," is called on the task.",[146,722,723,726,727,730,731,734,735,738,739,741],{},[150,724,725],{},"Runtime rows"," — a schedule whose task is runtime-only (",[153,728,729],{},"fileManaged=false",", e.g.\ncreated via the API, not ",[153,732,733],{},"tasks.json",") shows a ",[153,736,737],{},"runtime"," badge next to the task name.\nFile-managed rows (from ",[153,740,733],{},") have no badge.",[146,743,744,747,748,751,752,754,755,758,759,762,763,242,766,162,769,772,773,776,777,780],{},[150,745,746],{},"Manage schedules"," — the ",[153,749,750],{},"+ new"," button opens a form (task picker from ",[153,753,674],{},", kind cron\u002Finterval\u002Fonce + value, tz, data JSON, externalId, dedupKey,\nretry JSON, priority); it POSTs ",[153,756,757],{},"\u002Fschedules"," (a ",[153,760,761],{},"dedupKey"," makes the second save an\nupsert, not a duplicate). Each row has ",[150,764,765],{},"pause \u002F resume",[150,767,768],{},"edit",[153,770,771],{},"PATCH \u002Fschedules\u002F:id"," — the rule\u002Ftz\u002Fdata\u002Fpolicy change in place, ",[153,774,775],{},"nextRunAt"," recomputes\non a rule change) and ",[150,778,779],{},"delete"," with a confirm (runs are kept — the audit\nsurvives).",[146,782,783,624,786,242,788,242,790,792,793,796,797,800,801,804,805,808,809,812,813,816,817,820],{},[150,784,785],{},"Pagination",[153,787,609],{},[153,789,629],{},[153,791,632],{},") has a\nfooter: ",[153,794,795],{},"‹ prev"," \u002F page-size select (10\u002F25\u002F50\u002F100) \u002F row range \u002F ",[153,798,799],{},"next ›",". Lists are\nfetched with ",[153,802,803],{},"limit + 1"," rows to detect whether a next page exists (the probe row is\ntrimmed), so ",[150,806,807],{},"next"," is disabled on the last page and ",[150,810,811],{},"prev"," on the first. Changing\nthe page size resets to the first page. Page size defaults to 50 (set the ",[153,814,815],{},"limit","\nattribute); the current page offset is the ",[153,818,819],{},"offset"," attribute — set both to start the\nlist elsewhere.",[284,822,824],{"id":823},"_4-custom-ui","4. Custom UI",[146,826,827,829,830,832],{},[153,828,165],{}," exposes the same REST surface the components use — health, runs,\ntasks, schedules, plus trigger \u002F pause \u002F resume \u002F delete. See ",[158,831,113],{"href":160},".",[284,834,836],{"id":835},"auth-sched_admin_key","Auth (SCHED_ADMIN_KEY)",[146,838,839,840,842,843,846],{},"With a key set on the daemon, the shell prompts for it in the header (saved to\nlocalStorage) — or pass ",[153,841,414],{}," on the URL, or set ",[153,844,845],{},"el.token"," on components.",[284,848,850],{"id":849},"embedded-apps-no-daemon","Embedded apps (no daemon)",[146,852,853],{},"An embedded engine can mount the admin api itself and use any UI mode:",[289,855,859],{"className":856,"code":857,"language":858,"meta":294,"style":294},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { createEngine, createInternalRunner, createSqliteStorage } from '@schedjs\u002Fcore';\nimport { createAdminApi } from '@schedjs\u002Fadmin-api';\n\nconst engine = createEngine({ \u002F* … *\u002F });\nconst admin = createAdminApi({ engine, storage, auth: { apiKey: '…' } });\n\n\u002F\u002F in your http server, mount \u002Fsched\u002Fapi → admin.handleRequest(req, res)\n","ts",[153,860,861,903,924,930,961,1014,1019],{"__ignoreMap":294},[298,862,863,867,870,874,877,880,882,885,888,891,894,897,900],{"class":300,"line":301},[298,864,866],{"class":865},"siDh9","import",[298,868,869],{"class":437}," {",[298,871,873],{"class":872},"sSC40"," createEngine",[298,875,876],{"class":437},",",[298,878,879],{"class":872}," createInternalRunner",[298,881,876],{"class":437},[298,883,884],{"class":872}," createSqliteStorage",[298,886,887],{"class":437}