,660],{},"spawn error (executable missing) → ",[194,661,647],{},[159,663,665,666,227],{"id":664},"stdio-contract-envelope-true","Stdio contract (",[194,667,668],{},"envelope: true",[150,670,671,672,411],{},"Opt-in protocol mode for workers that want to report progress and results\nstructurally. The worker speaks the ",[154,673,675],{"href":674},"..\u002Fprotocol#stdio-transport","stdio transport",[576,677,678,692,705,717],{},[579,679,680,683,684,687,688,691],{},[209,681,682],{},"request"," — one JSON envelope ",[194,685,686],{},"{ \"task\": { \"name\", \"config\" }, \"data\" }"," on ",[209,689,690],{},"stdin","\n(then EOF)",[579,693,694,697,698,701,702],{},[209,695,696],{},"progress"," — NDJSON lines on ",[209,699,700],{},"stdout",": intermediate\n",[194,703,704],{},"{ \"status\": \"running\", \"progress\": 42 }",[579,706,707,710,711,713,714],{},[209,708,709],{},"result"," — one terminal line on ",[209,712,700],{},":\n",[194,715,716],{},"{ \"status\": \"succeeded\"|\"failed\"|\"cancelled\", \"result\", \"error\", \"progress\", \"log\", \"artifacts\" }",[579,718,719,722,723,726],{},[209,720,721],{},"logs"," — anything else on ",[209,724,725],{},"stderr"," (never stdout — stdout is the protocol channel)",[150,728,729],{},"A worker that opted in but exits without a terminal envelope is a broken worker: the run\nfails with a clear protocol error, never silently passes.",[150,731,732,733,736,737,740],{},"Reference implementation: ",[194,734,735],{},"examples\u002Fstdio-worker.mjs"," (in the repo's ",[194,738,739],{},"examples\u002Fworkers\u002F",").",[382,742,744],{"className":384,"code":743,"language":386,"meta":387,"style":387},"{\n  \"tasks\": [\n    {\n      \"name\": \"export-captions\",\n      \"schedules\": [{ \"cron\": \"0 9 * * *\" }],\n      \"runner\": \"process\",\n      \"config\": {\n        \"command\": [\"node\", \"\u002Fopt\u002Fworkers\u002Fcaptions.mjs\"],\n        \"envelope\": true,\n        \"data\": { \"videoId\": \"v-42\", \"language\": \"en\" }\n