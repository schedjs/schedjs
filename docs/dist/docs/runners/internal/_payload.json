tle":137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":61,"body":146,"description":1147,"extension":1148,"links":1149,"meta":1150,"navigation":283,"path":62,"seo":1151,"stem":63,"__hash__":1152},"docs\u002Fdocs\u002F07.runners\u002F06.internal.md",{"type":147,"value":148,"toc":1141},"minimark",[149,171,179,184,201,223,227,234,565,629,636,640,1070,1085,1089,1095,1137],[150,151,152,153,157,158,161,162,165,166,170],"p",{},"The ",[154,155,156],"strong",{},"internal runner"," executes handlers ",[154,159,160],{},"in the same process"," as the engine —\na plain TypeScript\u002FJavaScript function per task. No HTTP server, no Docker, no\nseparate daemon process. This is the ",[154,163,164],{},"embedded mode"," (\"Shape 1\"): ",[167,168,169],"code",{},"@schedjs\u002Fcore","\nbecomes a library inside your app, and the scheduler is just a few lines of setup.",[150,172,173,174,178],{},"The platform guarantees stay intact — retries, run history, alerts, zombie-lock\nreaping all work exactly as with the HTTP runner. Embedded mode is ",[175,176,177],"em",{},"not"," a\nregression to fire-and-forget job queues: every run is recorded, every failure is\nsurfaced.",[180,181,183],"h2",{"id":182},"when-to-use-it","When to use it",[185,186,187,191,194],"ul",{},[188,189,190],"li",{},"You want scheduled jobs inside your existing app process (a server, a CLI, a service).",[188,192,193],{},"Your jobs are functions, not external workers — no need for HTTP\u002FDocker plumbing.",[188,195,196,197,200],{},"You want the \"install in 60 seconds\" story: ",[167,198,199],{},"npm i @schedjs\u002Fcore",", a SQLite file, done.",[150,202,203,204,206,207,212,213,217,218,222],{},"When ",[154,205,177],{},": long-running jobs that must survive process restarts, or jobs that need\nto run outside your process — use the ",[208,209,211],"a",{"href":210},"..\u002Fcli","daemon"," with the ",[208,214,216],{"href":215},"http","HTTP"," \u002F\n",[208,219,221],{"href":220},"docker","Docker"," runners instead.",[180,224,226],{"id":225},"handlers","Handlers",[150,228,229,230,233],{},"A handler is a function ",[167,231,232],{},"(data, ctx) => result",":",[235,236,241],"pre",{"className":237,"code":238,"language":239,"meta":240,"style":240},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { createInternalRunner } from '@schedjs\u002Fcore';\n\nconst runner = createInternalRunner({\n  handlers: {\n    generateThumbnail: async (data, ctx) => {\n      ctx.log('thumbnail: started');\n      ctx.setProgress(50);\n      const out = await renderThumbnail((data as { videoId: string }).videoId);\n      ctx.setProgress(100);\n      return { output: out }; \u002F\u002F → run.result\n    },\n    transcode: async (data) => {\n      throw new Error('ffmpeg not found'); \u002F\u002F → run failed, error recorded\n    },\n  },\n});\n","ts","",[167,242,243,279,285,308,320,353,379,399,449,467,488,494,514,544,549,555],{"__ignoreMap":240},[244,245,248,252,256,260,263,266,270,273,276],"span",{"class":246,"line":247},"line",1,[244,249,251],{"class":250},"siDh9","import",[244,253,255],{"class":254},"soVBu"," {",[244,257,259],{"class":258},"sSC40"," createInternalRunner",[244,261,262],{"class":254}," }",[244,264,265],{"class":250}," from",[244,267,269],{"class":268},"sbYkP"," '",[244,271,169],{"class":272},"sTbE_",[244,274,275],{"class":268},"'",[244,277,278],{"class":254},";\n",[244,280,281],{"class":246,"line":21},[244,282,284],{"emptyLinePlaceholder":283},true,"\n",[244,286,288,292,295,298,301,305],{"class":246,"line":287},3,[244,289,291],{"class":290},"s5Kfy","const",[244,293,294],{"class":258}," runner",[244,296,297],{"class":254}," =",[244,299,259],{"class":300},"sljsM",[244,302,304],{"class":303},"snCua","(",[244,306,307],{"class":254},"{\n",[244,309,311,315,317],{"class":246,"line