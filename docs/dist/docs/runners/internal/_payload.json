title":137,"path":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":57,"body":142,"description":1143,"extension":1144,"links":1145,"meta":1146,"navigation":279,"path":58,"seo":1147,"stem":59,"__hash__":1148},"docs\u002Fdocs\u002F06.runners\u002F06.internal.md",{"type":143,"value":144,"toc":1137},"minimark",[145,167,175,180,197,219,223,230,561,625,632,636,1066,1081,1085,1091,1133],[146,147,148,149,153,154,157,158,161,162,166],"p",{},"The ",[150,151,152],"strong",{},"internal runner"," executes handlers ",[150,155,156],{},"in the same process"," as the engine —\na plain TypeScript\u002FJavaScript function per task. No HTTP server, no Docker, no\nseparate daemon process. This is the ",[150,159,160],{},"embedded mode"," (\"Shape 1\"): ",[163,164,165],"code",{},"@schedjs\u002Fcore","\nbecomes a library inside your app, and the scheduler is just a few lines of setup.",[146,168,169,170,174],{},"The platform guarantees stay intact — retries, run history, alerts, zombie-lock\nreaping all work exactly as with the HTTP runner. Embedded mode is ",[171,172,173],"em",{},"not"," a\nregression to fire-and-forget job queues: every run is recorded, every failure is\nsurfaced.",[176,177,179],"h2",{"id":178},"when-to-use-it","When to use it",[181,182,183,187,190],"ul",{},[184,185,186],"li",{},"You want scheduled jobs inside your existing app process (a server, a CLI, a service).",[184,188,189],{},"Your jobs are functions, not external workers — no need for HTTP\u002FDocker plumbing.",[184,191,192,193,196],{},"You want the \"install in 60 seconds\" story: ",[163,194,195],{},"npm i @schedjs\u002Fcore",", a SQLite file, done.",[146,198,199,200,202,203,208,209,213,214,218],{},"When ",[150,201,173],{},": long-running jobs that must survive process restarts, or jobs that need\nto run outside your process — use the ",[204,205,207],"a",{"href":206},"..\u002Fcli","daemon"," with the ",[204,210,212],{"href":211},"http","HTTP"," \u002F\n",[204,215,217],{"href":216},"docker","Docker"," runners instead.",[176,220,222],{"id":221},"handlers","Handlers",[146,224,225,226,229],{},"A handler is a function ",[163,227,228],{},"(data, ctx) => result",":",[231,232,237],"pre",{"className":233,"code":234,"language":235,"meta":236,"style":236},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { createInternalRunner } from '@schedjs\u002Fcore';\n\nconst runner = createInternalRunner({\n  handlers: {\n    generateThumbnail: async (data, ctx) => {\n      ctx.log('thumbnail: started');\n      ctx.setProgress(50);\n      const out = await renderThumbnail((data as { videoId: string }).videoId);\n      ctx.setProgress(100);\n      return { output: out }; \u002F\u002F → run.result\n    },\n    transcode: async (data) => {\n      throw new Error('ffmpeg not found'); \u002F\u002F → run failed, error recorded\n    },\n  },\n});\n","ts","",[163,238,239,275,281,304,316,349,375,395,445,463,484,490,510,540,545,551],{"__ignoreMap":236},[240,241,244,248,252,256,259,262,266,269,272],"span",{"class":242,"line":243},"line",1,[240,245,247],{"class":246},"siDh9","import",[240,249,251],{"class":250},"soVBu"," {",[240,253,255],{"class":254},"sSC40"," createInternalRunner",[240,257,258],{"class":250}," }",[240,260,261],{"class":246}," from",[240,263,265],{"class":264},"sbYkP"," '",[240,267,165],{"class":268},"sTbE_",[240,270,271],{"class":264},"'",[240,273,274],{"class":250},";\n",[240,276,277],{"class":242,"line":17},[240,278,280],{"emptyLinePlaceholder":279},true,"\n",[240,282,284,288,291,294,297,301],{"class":242,"line":283},3,[240,285,287],{"class":286},"s5Kfy","const",[240,289,290],{"class":254}," runner",[240,292,293],{"class":250}," =",[240,295,255],{"class":296},"sljsM",[240,298,300],{"class":299},"snCua","(",[240,302,303],{"class":250},"{\n",[240,305,307,311,313],{"class":242,"line":306},4,[240,308,310],{"class":309},"suXOh","  handlers",[240,312,229],{"class":250},[240,314,315],{"class"