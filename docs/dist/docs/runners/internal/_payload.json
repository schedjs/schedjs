,"title":52,"body":137,"description":1138,"extension":1139,"links":1140,"meta":1141,"navigation":274,"path":53,"seo":1142,"stem":54,"__hash__":1143},"docs\u002Fdocs\u002F06.runners\u002F06.internal.md",{"type":138,"value":139,"toc":1132},"minimark",[140,162,170,175,192,214,218,225,556,620,627,631,1061,1076,1080,1086,1128],[141,142,143,144,148,149,152,153,156,157,161],"p",{},"The ",[145,146,147],"strong",{},"internal runner"," executes handlers ",[145,150,151],{},"in the same process"," as the engine —\na plain TypeScript\u002FJavaScript function per task. No HTTP server, no Docker, no\nseparate daemon process. This is the ",[145,154,155],{},"embedded mode"," (\"Shape 1\"): ",[158,159,160],"code",{},"@schedjs\u002Fcore","\nbecomes a library inside your app, and the scheduler is just a few lines of setup.",[141,163,164,165,169],{},"The platform guarantees stay intact — retries, run history, alerts, zombie-lock\nreaping all work exactly as with the HTTP runner. Embedded mode is ",[166,167,168],"em",{},"not"," a\nregression to fire-and-forget job queues: every run is recorded, every failure is\nsurfaced.",[171,172,174],"h2",{"id":173},"when-to-use-it","When to use it",[176,177,178,182,185],"ul",{},[179,180,181],"li",{},"You want scheduled jobs inside your existing app process (a server, a CLI, a service).",[179,183,184],{},"Your jobs are functions, not external workers — no need for HTTP\u002FDocker plumbing.",[179,186,187,188,191],{},"You want the \"install in 60 seconds\" story: ",[158,189,190],{},"npm i @schedjs\u002Fcore",", a SQLite file, done.",[141,193,194,195,197,198,203,204,208,209,213],{},"When ",[145,196,168],{},": long-running jobs that must survive process restarts, or jobs that need\nto run outside your process — use the ",[199,200,202],"a",{"href":201},"..\u002Fcli","daemon"," with the ",[199,205,207],{"href":206},"http","HTTP"," \u002F\n",[199,210,212],{"href":211},"docker","Docker"," runners instead.",[171,215,217],{"id":216},"handlers","Handlers",[141,