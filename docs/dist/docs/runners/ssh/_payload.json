path":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":49,"body":142,"description":807,"extension":808,"links":809,"meta":810,"navigation":811,"path":50,"seo":812,"stem":51,"__hash__":813},"docs\u002Fdocs\u002F06.runners\u002F04.ssh.md",{"type":143,"value":144,"toc":800},"minimark",[145,165,170,369,373,386,666,685,692,696,713,716,723,727,772,776,796],[146,147,148,149,153,154,159,160,164],"p",{},"The SSH runner executes a remote command per run over an SSH connection (",[150,151,152],"code",{},"ssh2","),\ncaptures stdout+stderr, and maps the exit code to the run status — the same sync\nmapping as the ",[155,156,158],"a",{"href":157},"docker","Docker"," and ",[155,161,163],{"href":162},"process","Process"," runners, but on a remote host.",[166,167,169],"h2",{"id":168},"config","Config",[171,172,173,192],"table",{},[174,175,176],"thead",{},[177,178,179,183,186,189],"tr",{},[180,181,182],"th",{},"Field",[180,184,185],{},"Type",[180,187,188],{},"Default",[180,190,191],{},"Description",[193,194,195,216,232,248,264,289,306,331,346],"tbody",{},[177,196,197,203,206,209],{},[198,199,200],"td",{},[150,201,202],{},"host",[198,204,205],{},"string",[198,207,208],{},"—",[198,210,211,215],{},[212,213,214],"strong",{},"Required."," Remote host",[177,217,218,223,226,229],{},[198,219,220],{},[150,221,222],{},"port",[198,224,225],{},"number",[198,227,228],{},"22",[198,230,231],{},"SSH port",[177,233,234,239,241,243],{},[198,235,236],{},[150,237,238],{},"username",[198,240,205],{},[198,242,208],{},[198,244,245,247],{},[212,246,214],{}," Remote user",[177,249,250,255,257,259],{},[198,251,252],{},[150,253,254],{},"command",[198,256,205],{},[198,258,208],{},[198,260,261,263],{},[212,262,214],{}," The remote shell command (POSIX sh on the far side)",[177,265,266,271,274,276],{},[198,267,268],{},[150,269,270],{},"auth",[198,272,273],{},"object",[198,275,208],{},[198,277,278,280,281,284,285,288],{},[212,279,214],{}," Exactly one of ",[150,282,283],{},"keyFromEnv"," \u002F ",[150,286,287],{},"passwordFromEnv"," — see below",[177,290,291,296,301,303],{},[198,292,293],{},[150,294,295],{},"fingerprints",[198,297,205,298],{},[299,300],"span",{},[198,302,208],{},[198,304,305],{},"Host-key pins — see below",[177,307,308,313,315,318],{},[198,309,310],{},[150,311,312],{},"timeoutMs",[198,314,225],{},[198,316,317],{},"300000 (5 min)",[198,319,320,323,324,327,328],{},[212,321,322],{},"Command"," (exec) timeout → ",[150,325,326],{},"cancelled",". Connect is bounded separately by the ssh2 handshake (15 s) → ",[150,329,330],{},"failed",[177,332,333,338,340,343],{},[198,334,335],{},[150,336,337],{},"maxLogKb",[198,339,225],{},[198,341,342],{},"10",[198,344,345],{},"Ring-buffer log cap",[177,347,348,353,357,359],{},[198,349,350],{},[150,351,352],{},"allowedTools",[198,354,205,355],{},[299,356],{},[198,358,208],{},[198,360,361,362,364,365],{},"Sandbox: commands this task may run on the remote host (first token of ",[150,363,254],{},") — see ",[155,366,368],{"href":367},"..\u002Fsecurity","Security",[166,370,372],{"id":371},"secrets-never-live-in-tasksjson","Secrets never live in tasks.json",[146,374,375,378,379,381,382,385],{},[150,376,377],{},"tasks.json"," is the desired state in git — private keys and passwords do not belong\nthere. ",[150,380,270],{}," references ",[212,383,384],{},"env vars"," of the daemon process:",[387,388,393],"pre",{"className":389,"code":390,"language":391,"meta":392,"style":392},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{\n  \"tasks\": [\n    {\n      \"name\": \"restart-nginx\",\n      \"schedules\": [{ \"cron\": \"0 4 * * *\" }],\n      \"runner\": \"ssh\",\n      \"config\": {\n        \"host\": \"vds.example\",\n        \"username\": \"root\",\n        \"command\": \"systemctl restart nginx && systemctl is-active nginx\",\n        \"auth\": { \"keyFromEnv\": \"SCHED_SSH_KEY_PRD\" },\n        \"fingerprints\": [\"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=\"]\n      }\n    }\n  ]\n}\n","json","",[150,394,395,403,422,428,455,490,511,525,546,566,585,618,642,648,654,660],{"__ignoreMap":392},[299,396,399],{"class":397,"line":398},"line",1,[299,400,402],{"class":401},"soVBu","{\n",[299,404,405,409,413,416,419],{"class":397,"line":17},[299,406,408],{"class":407},"s4Jsk","  \"",[299,410,412],{"class":411},"sLorS","tasks",[299,414,415],{"class":407},"\"",[299,417,418],{"class":401},":",[299,420,421],{"class":401}," [\n",[299,423,425],{"class":397,"line":424},3,[299,426,427],{"class":401},"    {\n",[299,429,431,434,438,440,442,446,450,452],{"class":397,"line":430},4,[299,432,433],{"class":407},"      \"",[299,435,437],{"class":436},"sa2tF","name",[299,439,415],{"class":407},[299,441,418],{"class":401},[299,443,445],{"class":444},"sbYkP"," \"",[299,447,449],{"class":448},"sTbE_","restart-nginx",[299,451,415],{"class":444},[299,453,454],{"class":401},",\n",[299,456,458,460,463,465,467,470,472,476,478,480,482,485,487],{"class":397,"line":457},5,[299,459,433],{"class":407},[299,461,462],{"class":436},"schedules",[299,464,415],{"class":407},[299,466,418],{"class":401},[299,468,469],{"class":401}," [{",[299,471,445],{"class":407},[299,473,475],{"class":474},"skNjk","cron",[299,477,415],{"class":407},[299,479,418],{"class":401},[299,481,445],{"class":444},[299,483,484],{"class":448},"0 4 * * *",[299,486,415],{"class":444},[299,488,489],{"class":401}," }],\n",[299,491,493,495,498,500,502,504,507,509],{"class":397,"line":492},6,[299,494,433],{"class":407},[299,496,497],{"class":436},"runner",[299,499,415],{"class":407},[299,501,418],{"class":401},[299,503,445],{"class":444},[299,505,506],{"class":448},"ssh",[299,508,415],{"class":444},[299,510,454],{"class":401},[299,512,514,516,518,520,522],{"class":397,"line":513},7,[299,515,433],{"class":407},[299,517,168],{"class":436},[299,519,415],{"class":407},[299,521,418],{"class":401},[299,523,524],{"class":401}," {\n",[299,526,528,531,533,535,537,539,542,544],{"class":397,"line":527},8,[299,529,530],{"class":407},"        \"",[299,532,202],{"class":474},[299,534,415],{"class":407},[299,536,418],{"class":401},[299,538,445],{"class":444},[299,540,541],{"class":448},"vds.example",[299,543,415],{"class":444},[299,545,454],{"class":401},[299,547,549,551,553,555,557,559,562,564],{"class":397,"line":548},9,[299,550,530],{"class":407},[299,552,238],{"class":474},[299,554,415],{"class":407},[299,556,418],{"class":401},[299,558,445],{"class":444},[299,560,561],{"class":448},"root",[299,563,415],{"class":444},[299,565,454],{"class":401},[299,567,568,570,572,574,576,578,581,583],{"class":397,"line":120},[299,569,530],{"class":407},[299,571,254],{"class":474},[299,573,415],{"class":407},[299,575,418],{"class":401},[299,577,445],{"class":444},[299,579,580],{"class":448},"systemctl restart nginx && systemctl is-active nginx",[299,582,415],{"class":444},[299,584,454],{"class":401},[299,586,588,590,592,594,596,599,601,604,606,608,610,613,615],{"class":397,"line":587},11,[299,589,530],{"class":407},[299,591,270],{"class":474},[299,593,415],{"class":407},[299,595,418],{"class":401},[299,597,598],{"class":401}," {",[299,600,445],{"class":407},[299,602,283],{"class":603},"suXOh",[299,605,415],{"class":407},[299,607,418],{"class":401},[299,609,445],{"class":444},[299,611,612],{"class":448},"SCHED_SSH_KEY_PRD",[299,614,415],{"class":444},[299,616,617],{"class":401}," },\n",[299,619,621,623,625,627,629,632,634,637,639],{"class":397,"line":620},12,[299,622,530],{"class":407},[299,624,295],{"class":474},[299,626,415],{"class":407},[299,628,418],{"class":401},[299,630,631],{"class":401}," [",[299,633,415],{"class":444},[299,635,636],{"class":448},"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=",[299,638,415],{"class":444},[299,640,641],{"class":401},"]\n",[299,643,645],{"class":397,"line":644},13,[299,646,647],{"class":401},"      }\n",[299,649,651],{"class":397,"line":650},14,[299,652,653],{"class":401},"    }\n",[299,655,657],{"class":397,"line":656},15,[299,658,659],{"class":401},"  ]\n",[299,661,663],{"class":397,"line":662},16,[299,664,665],{"class":401},"}\n",[667,668,669,680],"ul",{},[670,671,672,675,676,679],"li",{},[150,673,674],{},"keyFromEnv: \"SCHED_SSH_KEY_PRD\""," — the env var holds the PEM private key\n(",[150,677,678],{},"-----BEGIN OPENSSH PRIVATE KEY-----…",")",[670,681,682,684],{},[150,683,287],{}," — the env var holds the password",[146,686,687,688,691],{},"A missing env var is a fail-fast: rejected at load time (",[150,689,690],{},"validateConfig","), never\nreached at dispatch. Both sources set at once is a config error.",[166,693,695],{"id":694},"host-key-pins","Host-key pins",[146,697,698,700,701,704,705,708,709,712],{},[150,699,295],{}," is an array of the remote host's public-key fingerprints —\n",[150,702,703],{},"SHA256:\u003Cbase64>"," (what ",[150,706,707],{},"ssh-keyscan -t ed25519 \u003Chost>"," prints), bare base64, or hex.\nA host whose key is not pinned ",[212,710,711],{},"fails the run"," — this deliberately overrides the\nssh2 default of accepting any host key.",[146,714,715],{},"Omitted\u002Fempty = accept any host key. That is a convenience for trusted networks,\nnot a production posture.",[146,717,718,719,722],{},"On mismatch the run fails with an error that names the pins and the received\nfingerprint — e.g. ",[150,720,721],{},"Host key verification failed: received \u003Cfp>, expected one of [\u003Cpin1>, …]"," — so you can tell which pin is stale when several are configured.",[166,724,726],{"id":725},"exit-code-mapping","Exit-code mapping",[667,728,729,739,750,758,767],{},[670,730,731,734,735,738],{},[150,732,733],{},"0"," → ",[150,736,737],{},"succeeded"," (stdout+stderr captured into the run log)",[670,740,741,734,744,746,747],{},[150,742,743],{},"!=0",[150,745,330],{}," ",[150,748,749],{},"exit N: \u003Ctail>",[670,751,752,753,755,756],{},"command timeout (",[150,754,312],{},") → ",[150,757,326],{},[670,759,760,761,763,764,766],{},"connect timeout (ssh2 handshake, fixed 15 s) → ",[150,762,330],{}," — two different\ntimeouts: ",[150,765,312],{}," bounds the exec phase only, reachability is the handshake's",[670,768,769,770],{},"connect\u002Fexec error (unreachable, bad auth, fingerprint mismatch) → ",[150,771,330],{},[166,773,775],{"id":774},"security-notes","Security notes",[667,777,778,781,784,787],{},[670,779,780],{},"The daemon's ssh private keys are read from env — protect them like any other\nsecret (service account, file perms, secret manager feeding env).",[670,782,783],{},"The remote command runs through the remote shell — the operator writes it, the\nsame trust boundary as a cron line on that host.",[670,785,786],{},"One connection per run; the connection is closed after every run regardless of\noutcome.",[670,788,789,790,792,793,795],{},"Sandbox ceiling is enforced at load too: a task whose command's first token is\noutside the runner ",[150,791,352],{}," fails in ",[150,794,690],{}," (fail-fast before\nany run), matching process\u002Fdocker\u002Fmcp — not only at run time.",[797,798,799],"style",{},"html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html pre.shiki code .s4Jsk, html code.shiki .s4Jsk{--shiki-light:#39ADB5;--shiki-default:#99841877;--shiki-dark:#B8A96577}html pre.shiki code .sLorS, html code.shiki .sLorS{--shiki-light:#9C3EDA;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sa2tF, html code.shiki .sa2tF{--shiki-light:#E2931D;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sbYkP, html code.shiki .sbYkP{--shiki-light:#39ADB5;--shiki-default:#B5695977;--shiki-dark:#C98A7D77}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .skNjk, html code.shiki .skNjk{--shiki-light:#F76D47;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .suXOh, html code.shiki .suXOh{--shiki-light:#E53935;--shiki-default:#99