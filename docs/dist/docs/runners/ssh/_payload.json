"body":137,"description":802,"extension":803,"links":804,"meta":805,"navigation":806,"path":45,"seo":807,"stem":46,"__hash__":808},"docs\u002Fdocs\u002F06.runners\u002F04.ssh.md",{"type":138,"value":139,"toc":795},"minimark",[140,160,165,364,368,381,661,680,687,691,708,711,718,722,767,771,791],[141,142,143,144,148,149,154,155,159],"p",{},"The SSH runner executes a remote command per run over an SSH connection (",[145,146,147],"code",{},"ssh2","),\ncaptures stdout+stderr, and maps the exit code to the run status — the same sync\nmapping as the ",[150,151,153],"a",{"href":152},"docker","Docker"," and ",[150,156,158],{"href":157},"process","Process"," runners, but on a remote host.",[161,162,164],"h2",{"id":163},"config","Config",[166,167,168,187],"table",{},[169,170,171],"thead",{},[172,173,174,178,181,184],"tr",{},[175,176,177],"th",{},"Field",[175,179,180],{},"Type",[175,182,183],{},"Default",[175,185,186],{},"Description",[188,189,190,211,227,243,259,284,301,326,341],"tbody",{},[172,191,192,198,201,204],{},[193,194,195],"td",{},[145,196,197],{},"host",[193,199,200],{},"string",[193,202,203],{},"—",[193,205,206,210],{},[207,208,209],"strong",{},"Required."," Remote host",[172,212,213,218,221,224],{},[193,214,215],{},[145,216,217],{},"port",[193,219,220],{},"number",[193,222,223],{},"22",[193,225,226],{},"SSH port",[172,228,229,234,236,238],{},[193,230,231],{},[145,232,233],{},"username",[193,235,200],{},[193,237,203],{},[193,239,240,242],{},[207,241,209],{}," Remote user",[172,244,245,250,252,254],{},[193,246,247],{},[145,248,249],{},"command",[193,251,200],{},[193,253,203],{},[193,255,256,258],{},[207,257,209],{}," The remote shell command (POSIX sh on the far side)",[172,260,261,266,269,271],{},[193,262,263],{},[145,264,265],{},"auth",[193,267,268],{},"object",[193,270,203],{},[193,272,273,275,276,279,280,283],{},[207,274,209],{}," Exactly one of ",[145,277,278],{},"keyFromEnv"," \u002F ",[145,281,282],{},"passwordFromEnv"," — see below",[172,285,286,291,296,298],{},[193,287,288],{},[145,289,290],{},"fingerprints",[193,292,200,293],{},[294,295],"span",{},[193,297,203],{},[193,299,300],{},"Host-key pins — see below",[172,302,303,308,310,313],{},[193,304,305],{},[145,306,307],{},"timeoutMs",[193,309,220],{},[193,311,312],{},"300000 (5 min)",[193,314,315,318,319,322,323],{},[207,316,317],{},"Command"," (exec) timeout → ",[145,320,321],{},"cancelled",". Connect is bounded separately by the ssh2 handshake (15 s) → ",[145,324,325],{},"failed",[172,327,328,333,335,338],{},[193,329,330],{},[145,331,332],{},"maxLogKb",[193,334,220],{},[193,336,337],{},"10",[193,339,340],{},"Ring-buffer log cap",[172,342,343,348,352,354],{},[193,344,345],{},[145,346,347],{},"allowedTools",[193,349,200,350],{},[294,351],{},[193,353,203],{},[193,355,356,357,359,360],{},"Sandbox: commands this task may run on the remote host (first token of ",[145,358,249],{},") — see ",[150,361,363],{"href":362},"..\u002Fsecurity","Security",[161,365,367],{"id":366},"secrets-never-live-in-tasksjson","Secrets never live in tasks.json",[141,369,370,373,374,376,377,380],{},[145,371,372],{},"tasks.json"," is the desired state in git — private keys and passwords do not belong\nthere. ",[145,375,265],{}," references ",[207,378,379],{},"env vars"," of the daemon process:",[382,383,388],"pre",{"className":384,"code":385,"language":386,"meta":387,"style":387},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{\n  \"tasks\": [\n    {\n      \"name\": \"restart-nginx\",\n      \"schedules\": [{ \"cron\": \"0 4 * * *\" }],\n      \"runner\": \"ssh\",\n      \"config\": {\n        \"host\": \"vds.example\",\n        \"username\": \"root\",\n        \"command\": \"systemctl restart nginx && systemctl is-active nginx\",\n        \"auth\": { \"keyFromEnv\": \"SCHED_SSH_KEY_PRD\" },\n        \"fingerprints\": [\"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=\"]\n      }\n    }\n  ]\n}\n","json","",[145,389,390,398,417,423,450,485,506,520,541,561,580,613,637,643,649,655],{"__ignoreMap":387},[294,391,394],{"class":392,"line":393},"line",1,[294,395,397],{"class":396},"soVBu","{\n",[294,399,400,404,408,411,414],{"class":392,"line":12},[294,401,403],{"class":402},"s4Jsk","  \"",[294,405,407],{"class":406},"sLorS","tasks",[294,409,410],{"class":402},"\"",[294,412,413],{"class":396},":",[294,415,416],{"class":396}," [\n",[294,418,420],{"class":392,"line":419},3,[294,421,422],{"class":396},"    {\n",[294,424,426,429,433,435,437,441,445,447],{"class":392,"line":425},4,[294,427,428],{"class":402},"      \"",[294,430,432],{"class":431},"sa2tF","name",[294,434,410],{"class":402},[294,436,413],{"class":396},[294,438,440],{"class":439},"sbYkP"," \"",[294,442,444],{"class":443},"sTbE_","restart-nginx",[294,446,410],{"class":439},[294,448,449],{"class":396},",\n",[294,451,453,455,458,460,462,465,467,471,473,475,477,480,482],{"class":392,"line":452},5,[294,454,428],{"class":402},[294,456,457],{"class":431},"schedules",[294,459,410],{"class":402},[294,461,413],{"class":396},[294,463,464],{"class":396}," [{",[294,466,440],{"class":402},[294,468,470],{"class":469},"skNjk","cron",[294,472,410],{"class":402},[294,474,413],{"class":396},[294,476,440],{"class":439},[294,478,479],{"class":443},"0 4 * * *",[294,481,410],{"class":439},[294,483,484],{"class":396}," }],\n",[294,486,488,490,493,495,497,499,502,504],{"class":392,"line":487},6,[294,489,428],{"class":402},[294,491,492],{"class":431},"runner",[294,494,410],{"class":402},[294,496,413],{"class":396},[294,498,440],{"class":439},[294,500,501],{"class":443},"ssh",[294,503,410],{"class":439},[294,505,449],{"class":396},[294,507,509,511,513,515,517],{"class":392,"line":508},7,[294,510,428],{"class":402},[294,512,163],{"class":431},[294,514,410],{"class":402},[294,516,413],{"class":396},[294,518,519],{"class":396}," {\n",[294,521,523,526,528,530,532,534,537,539],{"class":392,"line":522},8,[294,524,525],{"class":402},"        \"",[294,527,197],{"class":469},[294,529,410],{"class":402},[294,531,413],{"class":396},[294,533,440],{"class":439},[294,535,536],{"class":443},"vds.example",[294,538,410],{"class":439},[294,540,449],{"class":396},[294,542,544,546,548,550,552,554,557,559],{"class":392,"line":543},9,[294,545,525],{"class":402},[294,547,233],{"class":469},[294,549,410],{"class":402},[294,551,413],{"class":396},[294,553,440],{"class":439},[294,555,556],{"class":443},"root",[294,558,410],{"class":439},[294,560,449],{"class":396},[294,562,563,565,567,569,571,573,576,578],{"class":392,"line":115},[294,564,525],{"class":402},[294,566,249],{"class":469},[294,568,410],{"class":402},[294,570,413],{"class":396},[294,572,440],{"class":439},[294,574,575],{"class":443},"systemctl restart nginx && systemctl is-active nginx",[294,577,410],{"class":439},[294,579,449],{"class":396},[294,581,583,585,587,589,591,594,596,599,601,603,605,608,610],{"class":392,"line":582},11,[294,584,525],{"class":402},[294,586,265],{"class":469},[294,588,410],{"class":402},[294,590,413],{"class":396},[294,592,593],{"class":396}," {",[294,595,440],{"class":402},[294,597,278],{"class":598},"suXOh",[294,600,410],{"class":402},[294,602,413],{"class":396},[294,604,440],{"class":439},[294,606,607],{"class":443},"SCHED_SSH_KEY_PRD",[294,609,410],{"class":439},[294,611,612],{"class":396}," },\n",[294,614,616,618,620,622,624,627,629,632,634],{"class":392,"line":615},12,[294,617,525],{"class":402},[294,619,290],{"class":469},[294,621,410],{"class":402},[294,623,413],{"class":396},[294,625,626],{"class":396}," [",[294,628,410],{"class":439},[294,630,631],{"class":443},"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=",[294,633,410],{"class":439},[294,635,636],{"class":396},"]\n",[294,638,640],{"class":392,"line":639},13,[294,641,642],{"class":396},"      }\n",[294,644,646],{"class":392,"line":645},14,[294,647,648],{"class":396},"    }\n",[294,650,652],{"class":392,"line":651},15,[294,653,654],{"class":396},"  ]\n",[294,656,658],{"class":392,"line":657},16,[294,659,660],{"class":396},"}\n",[662,663,664,675],"ul",{},[665,666,667,670,671,674],"li",{},[145,668,669],{},"keyFromEnv: \"SCHED_SSH_KEY_PRD\""," — the env var holds the PEM private key\n(",[145,672,673],{},"-----BEGIN OPENSSH PRIVATE KEY-----…",")",[665,676,677,679],{},[145,678,282],{}," — the env var holds the password",[141,681,682,683,686],{},"A missing env var is a fail-fast: rejected at load time (",[145,684,685],{},"validateConfig","), never\nreached at dispatch. Both sources set at once is a config error.",[161,688,690],{"id":689},"host-key-pins","Host-key pins",[141,692,693,695,696,699,700,703,704,707],{},[145,694,290],{}," is an array of the remote host's public-key fingerprints —\n",[145,697,698],{},"SHA256:\u003Cbase64>"," (what ",[145,701,702],{},"ssh-keyscan -t ed25519 \u003Chost>"," prints), bare base64, or hex.\nA host whose key is not pinned ",[207,705,706],{},"fails the run"," — this deliberately overrides the\nssh2 default of accepting any host key.",[141,709,710],{},"Omitted\u002Fempty = accept any host key. That is a convenience for trusted networks,\nnot a production posture.",[141,712,713,714,717],{},"On mismatch the run fails with an error that names the pins and the received\nfingerprint — e.g. ",[145,715,716],{},"Host key verification failed: received \u003Cfp>, expected one of [\u003Cpin1>, …]"," — so you can tell which pin is stale when several are configured.",[161,719,721],{"id":720},"exit-code-mapping","Exit-code mapping",[662,723,724,734,745,753,762],{},[665,725,726,729,730,733],{},[145,727,728],{},"0"," → ",[145,731,732],{},"succeeded"," (stdout+stderr captured into the run log)",[665,735,736,729,739,741,742],{},[145,737,738],{},"!=0",[145,740,325],{}," ",[145,743,744],{},"exit N: \u003Ctail>",[665,746,747,748,750,751],{},"command timeout (",[145,749,307],{},") → ",[145,752,321],{},[665,754,755,756,758,759,761],{},"connect timeout (ssh2 handshake, fixed 15 s) → ",[145,757,325],{}," — two different\ntimeouts: ",[145,760,307],{}," bounds the exec phase only, reachability is the handshake's",[665,763,764,765],{},"connect\u002Fexec error (unreachable, bad auth, fingerprint mismatch) → ",[145,766,325],{},[161,768,770],{"id":769},"security-notes","Security notes",[662,772,773,776,779,782],{},[665,774,775],{},"The daemon's ssh private keys are read from env — protect them like any other\nsecret (service account, file perms, secret manager feeding env).",[665,777,778],{},"The remote command runs through the remote shell — the operator writes it, the\nsame trust boundary as a cron line on that host.",[665,780,781],{},"One connection per run; the connection is closed after every run regardless of\noutcome.",[665,783,784,785,787,788,790],{},"Sandbox ceiling is enforced at load too: a task whose command's first token is\noutside the runner ",[145,786,347],{}," fails in ",[145,789,685],{}," (fail-fast before\nany run), matching process\u002Fdocker\u002Fmcp — not only at run time.",[792,793,794],"style",{},"html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html pre.shiki code .s4Jsk, html code.shiki .s4Jsk{--shiki-light:#39ADB5;--shiki-default:#99841877;--shiki-dark:#B8A96577}html pre.shiki code .sLorS, html code.shiki .sLorS{--shiki-light:#9C3EDA;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sa2tF, html code.shiki .sa2tF{--shiki-light:#E2931D;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sbYkP, html code.shiki .sbYkP{--shiki-light:#39ADB5;--shiki-default:#B5695977;--shiki-dark:#C98A7D77}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .skNjk, html code.shiki .skNjk{--shiki-light:#F76D47;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .suXOh, html code.shiki .suXOh{--shiki-light:#E53935;--shiki-default:#998418;--shiki-dark:#B8A965}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":387,"searchDepth":12,"depth":12,"links":796},[797,798,799,800,801],{"id":163,"depth":12,"text":164},{"id":366,"depth":12,"text":367},{"id":689,"depth":12,"text":690},{"id":720,"depth":12,"text":721},{"id":769,"depth":12,"text":770},"Run remote commands over SSH","md",null,{},true,{"title":44,"description":802},"di5zo5WBo7WgNSLkYpYTNjjtVG98Q6ynpnvL9cZOU1E",[810,812],{"title":40,"path":41,"stem":42,"description":811,"children":-1},"Run local commands as tasks",{"title":48,"path":49,"stem":50,"description":813,"children":-1},"Call a tool on an MCP server (stdio or Streamable HTTP)",1787817621354]