th":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":53,"body":146,"description":811,"extension":812,"links":813,"meta":814,"navigation":815,"path":54,"seo":816,"stem":55,"__hash__":817},"docs\u002Fdocs\u002F07.runners\u002F04.ssh.md",{"type":147,"value":148,"toc":804},"minimark",[149,169,174,373,377,390,670,689,696,700,717,720,727,731,776,780,800],[150,151,152,153,157,158,163,164,168],"p",{},"The SSH runner executes a remote command per run over an SSH connection (",[154,155,156],"code",{},"ssh2","),\ncaptures stdout+stderr, and maps the exit code to the run status — the same sync\nmapping as the ",[159,160,162],"a",{"href":161},"docker","Docker"," and ",[159,165,167],{"href":166},"process","Process"," runners, but on a remote host.",[170,171,173],"h2",{"id":172},"config","Config",[175,176,177,196],"table",{},[178,179,180],"thead",{},[181,182,183,187,190,193],"tr",{},[184,185,186],"th",{},"Field",[184,188,189],{},"Type",[184,191,192],{},"Default",[184,194,195],{},"Description",[197,198,199,220,236,252,268,293,310,335,350],"tbody",{},[181,200,201,207,210,213],{},[202,203,204],"td",{},[154,205,206],{},"host",[202,208,209],{},"string",[202,211,212],{},"—",[202,214,215,219],{},[216,217,218],"strong",{},"Required."," Remote host",[181,221,222,227,230,233],{},[202,223,224],{},[154,225,226],{},"port",[202,228,229],{},"number",[202,231,232],{},"22",[202,234,235],{},"SSH port",[181,237,238,243,245,247],{},[202,239,240],{},[154,241,242],{},"username",[202,244,209],{},[202,246,212],{},[202,248,249,251],{},[216,250,218],{}," Remote user",[181,253,254,259,261,263],{},[202,255,256],{},[154,257,258],{},"command",[202,260,209],{},[202,262,212],{},[202,264,265,267],{},[216,266,218],{}," The remote shell command (POSIX sh on the far side)",[181,269,270,275,278,280],{},[202,271,272],{},[154,273,274],{},"auth",[202,276,277],{},"object",[202,279,212],{},[202,281,282,284,285,288,289,292],{},[216,283,218],{}," Exactly one of ",[154,286,287],{},"keyFromEnv"," \u002F ",[154,290,291],{},"passwordFromEnv"," — see below",[181,294,295,300,305,307],{},[202,296,297],{},[154,298,299],{},"fingerprints",[202,301,209,302],{},[303,304],"span",{},[202,306,212],{},[202,308,309],{},"Host-key pins — see below",[181,311,312,317,319,322],{},[202,313,314],{},[154,315,316],{},"timeoutMs",[202,318,229],{},[202,320,321],{},"300000 (5 min)",[202,323,324,327,328,331,332],{},[216,325,326],{},"Command"," (exec) timeout → ",[154,329,330],{},"cancelled",". Connect is bounded separately by the ssh2 handshake (15 s) → ",[154,333,334],{},"failed",[181,336,337,342,344,347],{},[202,338,339],{},[154,340,341],{},"maxLogKb",[202,343,229],{},[202,345,346],{},"10",[202,348,349],{},"Ring-buffer log cap",[181,351,352,357,361,363],{},[202,353,354],{},[154,355,356],{},"allowedTools",[202,358,209,359],{},[303,360],{},[202,362,212],{},[202,364,365,366,368,369],{},"Sandbox: commands this task may run on the remote host (first token of ",[154,367,258],{},") — see ",[159,370,372],{"href":371},"..\u002Fsecurity","Security",[170,374,376],{"id":375},"secrets-never-live-in-tasksjson","Secrets never live in tasks.json",[150,378,379,382,383,385,386,389],{},[154,380,381],{},"tasks.json"," is the desired state in git — private keys and passwords do not belong\nthere. ",[154,384,274],{}," references ",[216,387,388],{},"env vars"," of the daemon process:",[391,392,397],"pre",{"className":393,"code":394,"language":395,"meta":396,"style":396},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{\n  \"tasks\": [\n    {\n      \"name\": \"restart-nginx\",\n      \"schedules\": [{ \"cron\": \"0 4 * * *\" }],\n      \"runner\": \"ssh\",\n      \"config\": {\n        \"host\": \"vds.example\",\n        \"username\": \"root\",\n        \"command\": \"systemctl restart nginx && systemctl is-active nginx\",\n        \"auth\": { \"keyFromEnv\": \"SCHED_SSH_KEY_PRD\" },\n        \"fingerprints\": [\"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=\"]\n      }\n    }\n  ]\n}\n","json","",[154,398,399,407,426,432,459,494,515,529,550,570,589,622,646,652,658,664],{"__ignoreMap":396},[303,400,403],{"class":401,"line":402},"line",1,[303,404,406],{"class":405},"soVBu","{\n",[303,408,409,413,417,420,423],{"class":401,"line":21},[303,410,412],{"class":411},"s4Jsk","  \"",[303,414,416],{"class":415},"sLorS","tasks",[303,418,419],{"class":411},"\"",[303,421,422],{"class":405},":",[303,424,425],{"class":405}," [\n",[303,427,429],{"class":401,"line":428},3,[303,430,431],{"class":405},"    {\n",[303,433,435,438,442,444,446,450,454,456],{"class":401,"line":434},4,[303,436,437],{"class":411},"      \"",[303,439,441],{"class":440},"sa2tF","name",[303,443,419],{"class":411},[303,445,422],{"class":405},[303,447,449],{"class":448},"sbYkP"," \"",[303,451,453],{"class":452},"sTbE_","restart-nginx",[303,455,419],{"class":448},[303,457,458],{"class":405},",\n",[303,460,462,464,467,469,471,474,476,480,482,484,486,489,491],{"class":401,"line":461},5,[303,463,437],{"class":411},[303,465,466],{"class":440},"schedules",[303,468,419],{"class":411},[303,470,422],{"class":405},[303,472,473],{"class":405}," [{",[303,475,449],{"class":411},[303,477,479],{"class":478},"skNjk","cron",[303,481,419],{"class":411},[303,483,422],{"class":405},[303,485,449],{"class":448},[303,487,488],{"class":452},"0 4 * * *",[303,490,419],{"class":448},[303,492,493],{"class":405}," }],\n",[303,495,497,499,502,504,506,508,511,513],{"class":401,"line":496},6,[303,498,437],{"class":411},[303,500,501],{"class":440},"runner",[303,503,419],{"class":411},[303,505,422],{"class":405},[303,507,449],{"class":448},[303,509,510],{"class":452},"ssh",[303,512,419],{"class":448},[303,514,458],{"class":405},[303,516,518,520,522,524,526],{"class":401,"line":517},7,[303,519,437],{"class":411},[303,521,172],{"class":440},[303,523,419],{"class":411},[303,525,422],{"class":405},[303,527,528],{"class":405}," {\n",[303,530,532,535,537,539,541,543,546,548],{"class":401,"line":531},8,[303,533,534],{"class":411},"        \"",[303,536,206],{"class":478},[303,538,419],{"class":411},[303,540,422],{"class":405},[303,542,449],{"class":448},[303,544,545],{"class":452},"vds.example",[303,547,419],{"class":448},[303,549,458],{"class":405},[303,551,553,555,557,559,561,563,566,568],{"class":401,"line":552},9,[303,554,534],{"class":411},[303,556,242],{"class":478},[303,558,419],{"class":411},[303,560,422],{"class":405},[303,562,449],{"class":448},[303,564,565],{"class":452},"root",[303,567,419],{"class":448},[303,569,458],{"class":405},[303,571,572,574,576,578,580,582,585,587],{"class":401,"line":124},[303,573,534],{"class":411},[303,575,258],{"class":478},[303,577,419],{"class":411},[303,579,422],{"class":405},[303,581,449],{"class":448},[303,583,584],{"class":452},"systemctl restart nginx && systemctl is-active nginx",[303,586,419],{"class":448},[303,588,458],{"class":405},[303,590,592,594,596,598,600,603,605,608,610,612,614,617,619],{"class":401,"line":591},11,[303,593,534],{"class":411},[303,595,274],{"class":478},[303,597,419],{"class":411},[303,599,422],{"class":405},[303,601,602],{"class":405}," {",[303,604,449],{"class":411},[303,606,287],{"class":607},"suXOh",[303,609,419],{"class":411},[303,611,422],{"class":405},[303,613,449],{"class":448},[303,615,616],{"class":452},"SCHED_SSH_KEY_PRD",[303,618,419],{"class":448},[303,620,621],{"class":405}," },\n",[303,623,625,627,629,631,633,636,638,641,643],{"class":401,"line":624},12,[303,626,534],{"class":411},[303,628,299],{"class":478},[303,630,419],{"class":411},[303,632,422],{"class":405},[303,634,635],{"class":405}," [",[303,637,419],{"class":448},[303,639,640],{"class":452},"SHA256:qIMWQ8C7H7yPK2dXk2HFGZ9nXq0cQv3VKoHzJ2pKx8M=",[303,642,419],{"class":448},[303,644,645],{"class":405},"]\n",[303,647,649],{"class":401,"line":648},13,[303,650,651],{"class":405},"      }\n",[303,653,655],{"class":401,"line":654},14,[303,656,657],{"class":405},"    }\n",[303,659,661],{"class":401,"line":660},15,[303,662,663],{"class":405},"  ]\n",[303,665,667],{"class":401,"line":666},16,[303,668,669],{"class":405},"}\n",[671,672,673,684],"ul",{},[674,675,676,679,680,683],"li",{},[154,677,678],{},"keyFromEnv: \"SCHED_SSH_KEY_PRD\""," — the env var holds the PEM private key\n(",[154,681,682],{},"-----BEGIN OPENSSH PRIVATE KEY-----…",")",[674,685,686,688],{},[154,687,291],{}," — the env var holds the password",[150,690,691,692,695],{},"A missing env var is a fail-fast: rejected at load time (",[154,693,694],{},"validateConfig","), never\nreached at dispatch. Both sources set at once is a config error.",[170,697,699],{"id":698},"host-key-pins","Host-key pins",[150,701,702,704,705,708,709,712,713,716],{},[154,703,299],{}," is an array of the remote host's public-key fingerprints —\n",[154,706,707],{},"SHA256:\u003Cbase64>"," (what ",[154,710,711],{},"ssh-keyscan -t ed25519 \u003Chost>"," prints), bare base64, or hex.\nA host whose key is not pinned ",[216,714,715],{},"fails the run"," — this deliberately overrides the\nssh2 default of accepting any host key.",[150,718,719],{},"Omitted\u002Fempty = accept any host key. That is a convenience for trusted networks,\nnot a production posture.",[150,721,722,723,726],{},"On mismatch the run fails with an error that names the pins and the received\nfingerprint — e.g. ",[154,724,725],{},"Host key verification failed: received \u003Cfp>, expected one of [\u003Cpin1>, …]"," — so you can tell which pin is stale when several are configured.",[170,728,730],{"id":729},"exit-code-mapping","Exit-code mapping",[671,732,733,743,754,762,771],{},[674,734,735,738,739,742],{},[154,736,737],{},"0"," → ",[154,740,741],{},"succeeded"," (stdout+stderr captured into the run log)",[674,744,745,738,748,750,751],{},[154,746,747],{},"!=0",[154,749,334],{}," ",[154,752,753],{},"exit N: \u003Ctail>",[674,755,756,757,759,760],{},"command timeout (",[154,758,316],{},") → ",[154,761,330],{},[674,763,764,765,767,768,770],{},"connect timeout (ssh2 handshake, fixed 15 s) → ",[154,766,334],{}," — two different\ntimeouts: ",[154,769,316],{}," bounds the exec phase only, reachability is the handshake's",[674,772,773,774],{},"connect\u002Fexec error (unreachable, bad auth, fingerprint mismatch) → ",[154,775,334],{},[170,777,779],{"id":778},"security-notes","Security notes",[671,781,782,785,788,791],{},[674,783,784],{},"The daemon's ssh private keys are read from env — protect them like any other\nsecret (service account, file perms, secret manager feeding env).",[674,786,787],{},"The remote command runs through the remote shell — the operator writes it, the\nsame trust boundary as a cron line on that host.",[674,789,790],{},"One connection per run; the connection is closed after every run regardless of\noutcome.",[674,792,793,794,796,797,799],{},"Sandbox ceiling is enforced at load too: a task whose command's first token is\noutside the runner ",[154,795,356],{}," fails in ",[154,798,694],{}," (fail-fast before\nany run), matching process\u002Fdocker\u002Fmcp — not only at run time.",[801,802,803],"style",{},"html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html pre.shiki code .s4Jsk, html code.shiki .s4Jsk{--shiki-light:#39ADB5;--shiki-default:#99841877;--shiki-dark:#B8A96577}html pre.shiki code .sLorS, html code.shiki .sLorS{--shiki-light:#9C3EDA;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sa2tF, html code.shiki .sa2tF{--shiki-light:#E2931D;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .sbYkP, html code.shiki .sbYkP{--shiki-light:#39ADB5;--shiki-default:#B5695977;--shiki-dark:#C98A7D77}html pre.shiki code .sTbE_, html code.shiki .sTbE_{--shiki-light:#91B859;--shiki-default:#B56959;--shiki-dark:#C98A7D}html pre.shiki code .skNjk, html code.shiki .skNjk{--shiki-light:#F76D47;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .suXOh, html code.shiki .suXOh{--shiki-light:#E53935;--shiki-default:#998418;--shiki-dark:#B8A965}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":396,"searchDepth":21,"depth":21,"links":805},[806,807,808,809,810],{"id":172,"depth":21,"text":173},{"id":375,"depth":21,"text":376},{"id":698,"depth":21,"text":699},{"id":729,"depth":21,"text":730},{"id":778,"depth":21,"text":779},"Run remote commands over SSH","md",null,{},true,{"title":53,"description":811},"kKYW8zK5UIo5WRSJ3q-lEsft5Fdlt0HBpoeJ3b0pv94",[819,821],{"title":49,"path":50,"stem":51,"description":820,"children":-1},"Run local commands as tasks",{"title":57,"path":58,"stem":59,"description":8