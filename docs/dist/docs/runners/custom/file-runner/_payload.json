orage","docs\u002F07.storage\u002Findex",[70,72,94],{"title":71,"path":67,"stem":68},"Overview",{"title":73,"icon":74,"path":75,"stem":76,"children":77,"page":64},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F07.storage\u002F01.adapters",[78,82,86,90],{"title":79,"path":80,"stem":81},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F07.storage\u002F01.adapters\u002F01.sqlite",{"title":83,"path":84,"stem":85},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F07.storage\u002F01.adapters\u002F02.mysql",{"title":87,"path":88,"stem":89},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F07.storage\u002F01.adapters\u002F03.postgres",{"title":91,"path":92,"stem":93},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F07.storage\u002F01.adapters\u002F04.mongo",{"title":95,"path":96,"stem":97,"children":98},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F07.storage\u002F09.custom",[99],{"title":100,"path":101,"stem":102},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F07.storage\u002Fcustom\u002F01.memory-storage",{"title":104,"path":105,"stem":106},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F08.logging",{"title":108,"path":109,"stem":110},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F09.admin-api",{"title":112,"path":113,"stem":114,"order":115,"badge":116},"Admin UI","\u002Fdocs\u002Fui","docs\u002F10.ui",10,{"label":117,"color":118},"PRE","warning",{"title":120,"path":121,"stem":122},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F11.mcp",{"title":124,"path":125,"stem":126},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F12.cli",{"title":128,"path":129,"stem":130},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F13.self-hosting",{"title":132,"path":133,"stem":134},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":136,"title":61,"body":137,"description":2198,"extension":2199,"links":2200,"meta":2201,"navigation":308,"path":62,"seo":2202,"stem":63,"__hash__":2203},"docs\u002Fdocs\u002F06.runners\u002Fcustom\u002F01.file-runner.md",{"type":138,"value":139,"toc":2196},"minimark",[140,158,2192],[141,142,143,144,148,149,153,154,157],"p",{},"The complete reference — a ",[145,146,147],"strong",{},"file-drop"," runner: ",[150,151,152],"code",{},"run()"," drops a job file into a directory,\nany process (in any language) picks it up and writes back a result file. Zero dependencies —\nfilesystem only, so it runs anywhere. The same code lives in\n",[150,155,156],{},"packages\u002Fcore\u002Ftest\u002Fhelpers\u002Ffile-runner.ts",":",[159,160,165],"pre",{"className":161,"code":162,"language":163,"meta":164,"style":164},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport type { RunOutcome, Runner, RunnerRunHooks } from '..\u002F..\u002Fsrc\u002Fengine.js';\nimport type { TaskRecord } from '..\u002F..\u002Fsrc\u002Ftypes.js';\n\nexport interface FileRunnerOptions {\n  \u002F** Inbox directory where job files are dropped. Config `dir` wins over this. Default: cwd. *\u002F\n  dir?: string;\n  \u002F** Filesystem poll interval. Default: 250ms. *\u002F\n  pollMs?: number;\n  \u002F** How long `run` waits for the result file before failing. Default: 30s. *\u002F\n  timeoutMs?: number;\n}\n\nconst sleep = (ms: number) => new Promise\u003Cvoid>((resolve) => setTimeout(resolve, ms));\n\n\u002F**\n * File-drop runner: reference implementation for the \"Custom runners\" docs page.\n *\n * `run()` drops `\u003Cdir>\u002Fjob-\u003CrunId>.json` (task config + runId + startedAt — any\n * process, any language can pick it up), then polls the filesystem until a\n * worker writes `\u003Cdir>\u002F\u003CrunId>.result.json` (terminal outcome) or the timeout\n * fires. Workers report live progress by writing `\u003Cdir>\u002F\u003CrunId>.progress.json`\n * with a `progress` number — the runner forwards it via `hooks.onProgress`.\n *\n * Cancellation: on `signal.abort` the runner deletes the job file and rejects\n * with an `AbortError` (the engine maps it to a `cancelled` run). No external\n * dependencies — filesystem only, so it runs anywhere and tests on tmp dirs.\n *\u002F\nexport function createFileRunner(options: FileRunnerOptions = {}): Runner {\n  const resolveDir = (task: { name: string; config?: unknown }): string => {\n    const cfg = (task.config ?? {}) as { dir?: string };\n    const dir = cfg.dir ?? options.dir ?? process.cwd();\n    if (!existsSync(dir)) throw new Error(`file runner: dir \"${dir}\" does not exist (task \"${task.name}\")`);\n    return dir;\n  };\n\n  return {\n    validateConfig(task) {\n      resolveDir(task); \u002F\u002F throws → daemon aborts startup with a clear error\n    },\n\n    async run(task: TaskRecord, runId: string, startedAt: Date, hooks?: RunnerRunHooks): Promise\u003CRunOutcome> {\n      const dir = resolveDir(task);\n      if (hooks?.signal?.aborted) {\n        return { status: 'cancelled', error: 'aborted before dispatch' };\n      }\n\n      const jobFile = join(dir, `job-${runId}.json`);\n      writeFileSync(\n        jobFile,\n        JSON.stringify(\n          { runId, taskName: task.name, config: task.config ?? null, startedAt: startedAt.toISOString() },\n          null,\n          2,\n        ),\n      );\n\n      const resultFile = join(dir, `${runId}.result.json`);\n      const progressFile = join(dir, `${runId}.progress.json`);\n      const timeoutMs = options.timeoutMs ?? 30_000;\n      const pollMs = options.pollMs ?? 250;\n      const deadline = Date.now() + timeoutMs;\n\n      try {\n        while (Date.now() \u003C deadline) {\n          if (hooks?.signal?.aborted) throw abortError();\n\n          if (existsSync(progressFile)) {\n            try {\n              const { progress } = JSON.parse(readFileSync(progressFile, 'utf8')) as { progress?: number };\n              if (typeof progress === 'number') await hooks?.onProgress?.(progress);\n            } catch {\n              \u002F* malformed progress file — ignore, keep polling *\u002F\n            }\n            rmSync(progressFile);\n          }\n\n          if (existsSync(resultFile)) {\n            let body: Record\u003Cstring, unknown>;\n            try {\n              body = JSON.parse(readFileSync(resultFile, 'utf8')) as Record\u003Cstring, unknown>;\n            } catch {\n              return { status: 'failed', error: `result file ${resultFile} is not valid JSON` };\n            }\n            rmSync(resultFile);\n            if (body.status === 'succeeded') {\n              return {\n                status: 'succeeded',\n                result: body.result,\n                log: typeof body.log === 'string' ? body.log : null,\n              };\n            }\n            return {\n              status: 'failed',\n              error: typeof body.error === 'string' ? body.error : 'worker reported failure',\n              result: body.result,\n            };\n          }\n\n          await sleep(pollMs);\n        }\n        return { status: 'failed', error: `file runner: no result file after ${timeoutMs}ms (${resultFile})` };\n      } finally {\n        if (existsSync(jobFile)) rmSync(jobFile); \u002F\u002F cleanup: abort, timeout, or terminal result\n      }\n    },\n  };\n}\n\nfunction abortError(): Error {\n  const err = new Error('aborted');\n  err.name = 'AbortError';\n  return err;\n}\n","ts","",[150,166,167,220,242,278,303,310,327,334,352,358,372,378,392,398,403,481,486,492,498,504,510,516,522,528,534,539,545,551,557,563,592,641,688,728,797,807,813,818,826,841,858,864,869,930,950,978,1015,1021,1026,1066,1075,1084,1097,1155,1163,1172,1180,1188,1193,1228,1263,1287,1311,1337,1342,1350,1375,1405,1410,1429,1437,1494,1540,1551,1557,1563,1577,