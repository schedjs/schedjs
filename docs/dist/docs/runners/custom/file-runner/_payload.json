1,"stem":72},"File runner","\u002Fdocs\u002Frunners\u002Fcustom\u002Ffile-runner","docs\u002F07.runners\u002Fcustom\u002F01.file-runner",false,{"title":75,"path":76,"stem":77,"children":78},"Storage","\u002Fdocs\u002Fstorage","docs\u002F08.storage\u002Findex",[79,81,103],{"title":80,"path":76,"stem":77},"Overview",{"title":82,"icon":83,"path":84,"stem":85,"children":86,"page":73},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F08.storage\u002F01.adapters",[87,91,95,99],{"title":88,"path":89,"stem":90},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F08.storage\u002F01.adapters\u002F01.sqlite",{"title":92,"path":93,"stem":94},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F08.storage\u002F01.adapters\u002F02.mysql",{"title":96,"path":97,"stem":98},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F08.storage\u002F01.adapters\u002F03.postgres",{"title":100,"path":101,"stem":102},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F08.storage\u002F01.adapters\u002F04.mongo",{"title":104,"path":105,"stem":106,"children":107},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F08.storage\u002F09.custom",[108],{"title":109,"path":110,"stem":111},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F08.storage\u002Fcustom\u002F01.memory-storage",{"title":113,"path":114,"stem":115},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F09.logging",{"title":117,"path":118,"stem":119},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F10.admin-api",{"title":121,"path":122,"stem":123,"order":124,"badge":125},"Admin UI","\u002Fdocs\u002Fui","docs\u002F11.ui",10,{"label":126,"color":127},"PRE","warning",{"title":129,"path":130,"stem":131},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F12.mcp",{"title":133,"path":134,"stem":135},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F13.cli",{"title":137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":70,"body":146,"description":2207,"extension":2208,"links":2209,"meta":2210,"navigation":317,"path":71,"seo":2211,"stem":72,"__hash__":2212},"docs\u002Fdocs\u002F07.runners\u002Fcustom\u002F01.file-runner.md",{"type":147,"value":148,"toc":2205},"minimark",[149,167,2201],[150,151,152,153,157,158,162,163,166],"p",{},"The complete reference — a ",[154,155,156],"strong",{},"file-drop"," runner: ",[159,160,161],"code",{},"run()"," drops a job file into a directory,\nany process (in any language) picks it up and writes back a result file. Zero dependencies —\nfilesystem only, so it runs anywhere. The same code lives in\n",[159,164,165],{},"packages\u002Fcore\u002Ftest\u002Fhelpers\u002Ffile-runner.ts",":",[168,169,174],"pre",{"className":170,"code":171,"language":172,"meta":173,"style":173},"language-ts shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","import { existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport type { RunOutcome, Runner, RunnerRunHooks } from '..\u002F..\u002Fsrc\u002Fengine.js';\nimport type { TaskRecord } from '..\u002F..\u002Fsrc\u002Ftypes.js';\n\nexport interface FileRunnerOptions {\n  \u002F** Inbox directory where job files are dropped. Config `dir` wins over this. Default: cwd. *\u002F\n  dir?: string;\n  \u002F** Filesystem poll interval. Default: 250ms. *\u002F\n  pollMs?: number;\n  \u002F** How long `run` waits for the result file before failing. Default: 30s. *\u002F\n  timeoutMs?: number;\n}\n\nconst sleep = (ms: number) => new Promise\u003Cvoid>((resolve) => setTimeout(resolve, ms));\n\n\u002F**\n * File-drop runner: reference implementation for the \"Custom runners\" docs page.\n *\n * `run()` drops `\u003Cdir>\u002Fjob-\u003CrunId>.json` (task config + runId + startedAt — any\n * process, any language can pick it up), then polls the filesystem until a\n * worker writes `\u003Cdir>\u002F\u003CrunId>.result.json` (terminal outcome) or the timeout\n * fires. Workers report live progress by writing `\u003Cdir>\u002F\u003CrunId>.progress.json`\n * with a `progress` number — the runner forwards it via `hooks.onProgress`.\n *\n * Cancellation: on `signal.abort` the runner deletes the job file and rejects\n * with an `AbortError` (the engine maps it to a `cancelled` run). No external\n * dependencies — filesystem only, so it runs anywhere and tests on tmp dirs.\n *\u002F\nexport function createFileRunner(options: FileRunnerOptions = {}): Runner {\n  const resolveDir = (task: { name: string; config?: unknown }): string => {\n    const cfg = (task.config ?? {}) as { dir?: string };\n    const dir = cfg.dir ?? options.dir ?? process.cwd();\n    if (!existsSync(dir)) throw new Error(`file runner: dir \"${dir}\" does not exist (task \"${task.name}\")`);\n    return dir;\n  };\n\n  return {\n    validateConfig(task) {\n      resolveDir(task); \u002F\u002F throws → daemon aborts startup with a clear error\n    },\n\n    async run(task: TaskRecord, runId: string, startedAt: Date, hooks?: RunnerRunHooks): Promise\u003CRunOutcome> {\n      const dir = resolveDir(task);\n      if (hooks?.signal?.aborted) {\n        return { status: 'cancelled', error: 'aborted before dispatch' };\n      }\n\n      const jobFile = join(dir, `job-${runId}.json`);\n      writeFileSync(\n        jobFile,\n        JSON.stringify(\n          { runId, taskName: task.name, config: task.config ?? null, startedAt: startedAt.toISOString() },\n          null,\n          2,\n        ),\n      );\n\n      const resultFile = join(dir, `${runId}.result.json`);\n      const progressFile = join(dir, `${runId}.progress.json`);\n      const timeoutMs = options.timeoutMs ?? 30_000;\n      const pollMs = options.pollMs ?? 250;\n      const deadline = Date.now() + timeoutMs;\n\n      try {\n        while (Date.now() \u003C deadline) {\n          if (hooks?.signal?.aborted) throw abortError();\n\n          if (existsSync(progressFile)) {\n            try {\n              const { progress } = JSON.parse(readFileSync(progressFile, 'utf8')) as { progress?: number };\n              if (typeof progress === 'number') await hooks?.onProgress?.(progress);\n            } catch {\n              \u002F* malformed progress file — ignore, keep polling *\u002F\n            }\n            rmSync(progressFile);\n          }\n\n          if (existsSync(resultFile)) {\n            let body: Record\u003Cstring, unknown>;\n            try {\n              body = JSON.parse(readFileSync(resultFile, 'utf8')) as Record\u003Cstring, unknown>;\n            } catch {\n              return { status: 'failed', error: `result file ${resultFile} is not valid JSON` };\n            }\n            rmSync(resultFile);\n            if (body.status === 'succeeded') {\n              return {\n                status: 'succeeded',\n                result: body.result,\n                log: typeof body.log === 'string' ? body.log : null,\n              };\n            }\n            return {\n              status: 'failed',\n              error: typeof body.error === 'string' ? body.error : 'worker reported failure',\n              result: body.result,\n            };\n          }\n\n          await sleep(pollMs);\n        }\n        return { status: 'failed', error: `file runner: no result file after ${timeoutMs}ms (${resultFile})` };\n      } finally {\n        if (existsSync(jobFile)) rmSync(jobFile); \u002F\u002F cleanup: abort, timeout, or terminal result\n      }\n    },\n  };\n}\n\nfunction abortError(): Error {\n  const err = new Error('aborted');\n  err.name = 'AbortError';\n  return err;\n}\n","ts","",[159,175,176,229,251,287,312,319,336,343,361,367,381,387,401,407,412,490,495,501,507,513,519,525,531,537,543,548,554,560