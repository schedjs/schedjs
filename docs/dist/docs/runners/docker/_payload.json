:137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":45,"body":146,"description":1112,"extension":1113,"links":1114,"meta":1115,"navigation":948,"path":46,"seo":1116,"stem":47,"__hash__":1117},"docs\u002Fdocs\u002F07.runners\u002F02.docker.md",{"type":147,"value":148,"toc":1101},"minimark",[149,162,167,414,418,421,470,474,525,542,550,563,571,623,742,748,752,768,824,844,850,871,885,1082,1086,1097],[150,151,152,153,157,158,161],"p",{},"The Docker runner spawns a container per run via the ",[154,155,156],"code",{},"docker"," CLI (",[154,159,160],{},"docker run --rm","),\ncaptures output, and maps the exit code to the run status.",[163,164,166],"h2",{"id":165},"config","Config",[168,169,170,189],"table",{},[171,172,173],"thead",{},[174,175,176,180,183,186],"tr",{},[177,178,179],"th",{},"Field",[177,181,182],{},"Type",[177,184,185],{},"Default",[177,187,188],{},"Description",[190,191,192,217,242,270,286,305,327,355,370,395],"tbody",{},[174,193,194,200,203,206],{},[195,196,197],"td",{},[154,198,199],{},"image",[195,201,202],{},"string",[195,204,205],{},"—",[195,207,208,212,213,216],{},[209,210,211],"strong",{},"Required."," Image name (may include a tag: ",[154,214,215],{},"alpine:3.20",")",[174,218,219,224,226,229],{},[195,220,221],{},[154,222,223],{},"tag",[195,225,202],{},[195,227,228],{},"image tag",[195,230,231,232,235,236,239,240,216],{},"Explicit tag (",[154,233,234],{},"alpine"," + ",[154,237,238],{},"tag: \"3.20\""," → ",[154,241,215],{},[174,243,244,249,254,256],{},[195,245,246],{},[154,247,248],{},"command",[195,250,202,251],{},[252,253],"span",{},[195,255,205],{},[195,257,258,259,239,262,265,266,269],{},"Override the container command: ",[154,260,261],{},"command[0]",[154,263,264],{},"--entrypoint",", ",[154,267,268],{},"command[1..]"," → argv after the image",[174,271,272,277,281,283],{},[195,273,274],{},[154,275,276],{},"args",[195,278,202,279],{},[252,280],{},[195,282,205],{},[195,284,285],{},"Extra arguments",[174,287,288,293,296,298],{},[195,289,290],{},[154,291,292],{},"env",[195,294,295],{},"object",[195,297,205],{},[195,299,300,301,304],{},"Static env vars (win over ",[154,302,303],{},"data","-derived vars)",[174,306,307,311,314,316],{},[195,308,309],{},[154,310,303],{},[195,312,313],{},"unknown",[195,315,205],{},[195,317,318,319,322,323,326],{},"Run parameters → ",[154,320,321],{},"SCREAMING_SNAKE"," env vars + ",[154,324,325],{},"SCHED_DATA"," (JSON)",[174,328,329,334,337,340],{},[195,330,331],{},[154,332,333],{},"timeoutMs",[195,335,336],{},"number",[195,338,339],{},"300000 (5 min)",[195,341,342,343,346,347,350,351,354],{},"Timeout: SIGTERM → 10s grace → SIGKILL → ",[154,344,345],{},"cancelled",". ",[154,348,349],{},"-1"," = ",[209,352,353],{},"no timeout"," — the container runs until it exits or is cancelled by the operator (matching the task-level run-deadline semantics)",[174,356,357,362,364,367],{},[195,358,359],{},[154,360,361],{},"maxLogKb",[195,363,336],{},[195,365,366],{},"10",[195,368,369],{},"Ring-buffer log cap",[174,371,372,377,381,383],{},[195,373,374],{},[154,375,376],{},"allowedTools",[195,378,202,379],{},[252,380],{},[195,382,205],{},[195,384,385,386,389,390],{},"Sandbox: images\u002Fcommands this task may run (",[154,387,388],{},"image@command"," specs) — see ",[391,392,394],"a",{"href":393},"..\u002Fsecurity","Security",[174,396,397,402,405,408],{},[195,398,399],{},[154,400,401],{},"envelope",[195,403,404],{},"boolean",[195,406,407],{},"false",[195,409,410,413],{},[209,411,412],{},"Experimental."," Stdio contract — see below",[163,415,417],{"id":416},"environment","Environment",[150,419,420],{},"Every container gets:",[422,423,424,431,437],"ul",{},[425,426,427,430],"li",{},[154,428,429],{},"SCHED_RUN_ID"," — the run id",[425,432,433,436],{},[154,434,435],{},"SCHED_TASK_NAME"," — the task name",[425,438,439,441,442,444,445,448,449,452,453,455,456,458,459,462,463,239,466,469],{},[154,440,303],{}," → each top-level key as ",[154,443,321],{}," env var (",[154,446,447],{},"{ \"userId\": 42 }"," →\n",[154,450,451],{},"USER_ID=42",") plus ",[154,454,325],{}," with the full JSON. Static ",[154,457,292],{}," wins over data-derived vars.\nTwo data keys that map to the same env var (",[154,460,461],{},"fooBar"," and ",[154,464,465],{},"foo_bar",[154,467,468],{},"FOO_BAR",") are an error:\nconfig validation fails fast at load time, and a run that slips through fails instead of\nsilently last-write-wins.",[163,471,473],{"id":472},"exit-codes","Exit codes",[168,475,476,486],{},[171,477,478],{},[174,479,480,483],{},[177,481,482],{},"Exit",[177,484,485],{},"Result",[190,487,488,500,515],{},[174,489,490,495],{},[195,491,492],{},[154,493,494],{},"0",[195,496,497],{},[154,498,499],{},"succeeded",[174,501,502,505],{},[195,503,504],{},"non-zero",[195,506,507,510,511,514],{},[154,508,509],{},"failed"," with ",[154,512,513],{},"exit N"," + tail of the log",[174,516,517,520],{},[195,518,519],{},"timeout",[195,521,522,523],{},"SIGTERM → SIGKILL → ",[154,524,345],{},[150,526,527,530,531,533,534,537,538,541],{},[154,528,529],{},"config.timeoutMs: -1"," disables the container timeout entirely — the process\nruns until it exits on its own or is cancelled manually. (Before daemon 0.11.0 a\n",[154,532,349],{}," was passed straight into ",[154,535,536],{},"setTimeout"," and killed the container instantly\nwith ",[154,539,540],{},"timeout after -1ms",".)",[163,543,545,546,549],{"id":544},"stdio-contract-envelope-true-experimental","Stdio contract (",[154,547,548],{},"envelope: true",") — experimental",[551,552,553],"blockquote",{},[150,554,555,557,558,562],{},[209,556,412],{}," The ",[391,559,561],{"href":560},"process","process runner"," ships a reference worker for the\nstdio contract; a container image that speaks it is not published yet. Enable it\nwhen your own image implements the contract (see below) — exit-code mode remains\nthe default and is unchanged.",[150,564,565,566,570],{},"Opt-in protocol mode for containers that want to report progress and results\nstructurally. The container speaks the ",[391,567,569],{"href":568},"..\u002Fprotocol#stdio-transport","stdio transport",":",[422,572,573,591,604,613],{},[425,574,575,578,579,582,583,586,587,590],{},[209,576,577],{},"request"," — one JSON envelope ",[154,580,581],{},"{ \"task\": { \"name\", \"config\" }, \"data\" }"," on\n",[209,584,585],{},"stdin"," (",[154,588,589],{},"docker run -i",", attached automatically), then EOF",[425,592,593,596,597,600,601],{},[209,594,595],{},"progress"," — NDJSON lines on ",[209,598,599],{},"stdout",": intermediate\n",[154,602,603],{},"{ \"status\": \"running\", \"progress\": 42 }",[425,605,606,609,610,612],{},[209,607,608],{},"result"," — one terminal line on ",[209,611,599],{}," (same envelope shape as the process\nrunner \u002F HTTP runner)",[425,614,615,618,619,622],{},[209,616,617],{},"logs"," — anything else on ",[209,620,621],{},"stderr"," (never stdout — stdout is the protocol)",[624,625,630],"pre",{"className":626,"code":627,"language":628,"meta":629,"style":629},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"runner\": \"docker\", \"config\": { \"image\": \"registry\u002Fmy-worker\", \"envelope\": true, \"data\": { \"videoId\": \"v-42\" } } }\n","json","",[154,631,632],{"__ignoreMap":629},[252,633,636,640,644,648,651,653,656,659,661,664,666,668,670,672,675,677,680,682,684,686,689,691,693,695,697,699,701,705,707,709,711,713,715,717,719,723,725,727,729,732,734,737,739],{"class":634,"line":635},"line",1,[252,637,639],{"class":638},"soVBu","{",[252,641,643],{"class":642},"s4Jsk"," \"",[252,645,647],{"class":646},"sLorS","runner",[252,649,650],{"class":642},"\"",[252,652,570],{"class":638},[252,654,643],{"class":655},"sbYkP",[252,657,156],{"class":658},"sTbE_",[252,660,650],{"class":655},[252,662,663],{"class":638},",",[252,665,643],{"class":642},[252,667,165],{"class":646},[252,669,650],{"class":642},[252,671,570],{"class":638},[252,673,674],{"class":638}," {",[252,676,643],{"class":642},[252,678,199],{"class":679},"sa2tF",[252,681,650],{"class":642},[252,683,570],{"class":638},[252,685,643],{"class":655},[252,687,688],{"class":658},"registry\u002Fmy-worker",[252,690,650],{"class":655},[252,692,663],{"class":638},[252,694,643],{"class":642},[252,696,401],{"class":679},[252,698,650],{"class":642},[252,700,570],{"class":638},[252,702,704],{"class":703},"s8XtY"," true",[252,706,663],{"class":638},[252,708,643],{"class":642},[252,710,303],{"class":679},[252,712,650],{"class":642},[252,714,570],{"class":638},[252,716,674],{"class":638},[252,718,643],{"class":642},[252,720,722],{"class":721},"skNjk","videoId",[252,724,650],{"class":642},[252,726,570],{"class":638},[252,728,643],{"class":655},[252,730,731],{"class":658},"v-42",[252,733,650],{"class":655},[252,735,736],{"class":638}," }",[252,738,736],{"class":638},[252,740,741],{"class":638}," }\n",[150,743,744,745,747],{},"A container that opted in but exits without a terminal envelope is a broken worker: the\nrun fails with a clear protocol error. A container without ",[154,746,401],{}," keeps the plain\nexit-code mapping — the two modes never mix.",[163,749,751],{"id":750},"private-registries-auth","Private registries (auth)",[150,753,754,755,586,758,760,761,764,765,570],{},"The runner spawns the ",[209,756,757],{},"docker CLI",[154,759,160],{},"), not the docker HTTP API — so\nCLI credential resolution applies. ",[154,762,763],{},"docker run"," pulls an image that is not present\nlocally, and that implicit pull authenticates exactly like ",[154,766,767],{},"docker pull",[422,769,770,792,810,817],{},[425,771,772,775,776,779,780,783,784,787,788,791],{},[209,773,774],{},"The CLI must exist in the daemon's image."," The official ",[154,777,778],{},"sched-daemon"," image\nships ",[154,781,782],{},"docker-cli"," (added 2026-08-22 after books' T2 finding); a custom\u002Fcomposed\nimage that drops it needs ",[154,785,786],{},"apk add docker-cli"," (alpine) — otherwise every\ndocker task fails with ",[154,789,790],{},"ENOENT"," at spawn.",[425,793,794,797,798,801,802,805,806,809],{},[154,795,796],{},"$DOCKER_CONFIG\u002Fconfig.json"," (default ",[154,799,800],{},"~\u002F.docker\u002Fconfig.json",") — mount it into the\ndaemon's container (",[154,803,804],{},"\u002Froot\u002F.docker\u002Fconfig.json",") or point ",[154,807,808],{},"DOCKER_CONFIG"," at a volume.",[425,811,812,813,816],{},"The same file that ",[154,814,815],{},"docker login"," writes — no sched-side config, no env creds.",[425,818,819,820,823],{},"Works unchanged behind a read-only docker-socket proxy (",[154,821,822],{},"DOCKER_HOST","): credentials\nare a CLI-side concern, the proxy passes the pull through.",[150,825,826,827,586,830,833,834,837,838,840,841,843],{},"The image allowlist is matched ",[209,828,829],{},"by name\u002Fcommand string only",[154,831,832],{},"image[@command]",");\nregistry auth never affects allowlist matching or tag resolution (default ",[154,835,836],{},":latest",",\nexplicit ",[154,839,223],{}," wins — pure string logic). The actual tag dereference happens at pull\ntime inside the docker daemon, which is exactly where the credentials apply. A pull\nthat fails auth surfaces as a run failure (",[154,842,763],{}," exits non-zero with the\nregistry's 401 in the log).",[163,845,847,848,216],{"id":846},"security-sandbox-allowedtools","Security: sandbox (",[154,849,376],{},[150,851,852,853,855,856,859,860,862,863,866,867,870],{},"The runner is constrained by the sandbox ceiling — pass ",[154,854,376],{}," when\ncreating the runner (or set it in the daemon build \u002F tasks.json ",[154,857,858],{},"runners"," block,\nsee ",[391,861,394],{"href":393},"). Exact names and trailing wildcards are supported:\n",[154,864,865],{},"allowedTools: ['alpine:*', 'ghcr.io\u002Fmy-org\u002F*']",". A task whose image\u002Fcommand is\nnot allowed