,240],{},"python*",", ",[172,243,244],{},"alpine:*",[172,246,247],{},"read_*","). Leading wildcards are not supported. What a\n\"tool\" means is per runner:",[250,251,252,268],"table",{},[253,254,255],"thead",{},[256,257,258,262,265],"tr",{},[259,260,261],"th",{},"Runner",[259,263,264],{},"Tool identity",[259,266,267],{},"Example",[269,270,271,292,311,330],"tbody",{},[256,272,273,281,287],{},[274,275,276],"td",{},[277,278,280],"a",{"href":279},"runners\u002Fprocess","process",[274,282,283,286],{},[172,284,285],{},"argv[0]"," (the executable)",[274,288,289],{},[172,290,291],{},"[\"node\", \"python*\"]",[256,293,294,300,306],{},[274,295,296],{},[277,297,299],{"href":298},"runners\u002Fssh","ssh",[274,301,302,303],{},"first token of ",[172,304,305],{},"config.command",[274,307,308],{},[172,309,310],{},"[\"backup.sh\", \"systemctl*\"]",[256,312,313,319,325],{},[274,314,315],{},[277,316,318],{"href":317},"runners\u002Fdocker","docker",[274,320,321,324],{},[172,322,323],{},"image@command"," (both dimensions)",[274,326,327],{},[172,328,329],{},"[\"alpine@echo\", \"registry\u002F*\"]",[256,331,332,338,343],{},[274,333,334],{},[277,335,337],{"href":336},"runners\u002Fmcp","mcp",[274,339,340],{},[172,341,342],{},"server:tool",[274,344,345],{},[172,346,347],{},"[\"node:read_*\", \"https:\u002F\u002Fmcp.example.com:*\"]",[349,350,352,353],"h3",{"id":351},"docker-imagecommand","Docker: ",[172,354,323],{},[141,356,357,358,361,362,365,366,369,370,373],{},"Docker restricts ",[145,359,360],{},"two"," dimensions — image and explicit entrypoint — in one\nspec, separated by ",[172,363,364],{},"@"," (image tags use ",[172,367,368],{},":",", so ",[172,371,372],{},"image:cmd"," would be ambiguous):",[375,376,381],"pre",{"className":377,"code":378,"language":379,"meta":380,"style":380},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"allowedTools\": [\"alpine@echo\", \"alpine\", \"*@echo\"] }\n","json","",[172,382,383],{"__ignoreMap":380},[384,385,3