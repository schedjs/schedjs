ol spec format",[150,233,234,235,242,243,246,247,250,251,250,254,257],{},"Uniform pattern language: ",[154,236,237,238,241],{},"exact match or trailing-",[181,239,240],{},"*"," prefix"," (",[181,244,245],{},"node",",\n",[181,248,249],{},"python*",", ",[181,252,253],{},"alpine:*",[181,255,256],{},"read_*","). Leading wildcards are not supported. What a\n\"tool\" means is per runner:",[259,260,261,277],"table",{},[262,263,264],"thead",{},[265,266,267,271,274],"tr",{},[268,269,270],"th",{},"Runner",[268,272,273],{},"Tool identity",[268,275,276],{},"Example",[278,279,280,301,320,339],"tbody",{},[265,281,282,290,296],{},[283,284,285],"td",{},[286,287,289],"a",{"href":288},"runners\u002Fprocess","process",[283,291,292,295],{},[181,293,294],{},"argv[0]"," (the executable)",[283,297,298],{},[181,299,300],{},"[\"node\", \"python*\"]",[265,302,303,309,315],{},[283,304,305],{},[286,306,308],{"href":307},"runners\u002Fssh","ssh",[283,310,311,312],{},"first token of ",[181,313,314],{},"config.command",[283,316,317],{},[181,318,319],{},"[\"backup.sh\", \"systemctl*\"]",[265,321,322,328,334],{},[283,323,324],{},[286,325,327],{"href":326},"runners\u002Fdocker","docker",[283,329,330,333],{},[181,331,332],{},"image@command"," (both dimensions)",[283,335,336],{},[181,337,338],{},"[\"alpine@echo\", \"registry\u002F*\"]",[265,340,341,347,352],{},[283,342,343],{},[286,344,346],{"href":345},"runners\u002Fmcp","mcp",[283,348,349],{},[181,350,351],{},"server:tool",[283,353,354],{},[181,355,356],{},"[\"node:read_*\", \"https:\u002F\u002Fmcp.example.com:*\"]",[358,359,361,362],"h3",{"id":360},"docker-imagecommand","Docker: ",[181,363,332],{},[150,365,366,367,370,371,374,375,378,379,382],{},"Docker restricts ",[154,368,369],{},"two"," dimensions — image and explicit entrypoint — in one\nspec, separated by ",[181,372,373],{},"@"," (image tags use ",[181,376,377],{},":",", so ",[181,380,381],{},"image:cmd"," would be ambiguous):",[384,385,390],"pre",{"className":386,"code":387,"language":388,"me