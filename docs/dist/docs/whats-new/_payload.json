docs\u002Frunners\u002Fcustom\u002Ffile-runner","docs\u002F07.runners\u002Fcustom\u002F01.file-runner",false,{"title":75,"path":76,"stem":77,"children":78},"Storage","\u002Fdocs\u002Fstorage","docs\u002F08.storage\u002Findex",[79,81,103],{"title":80,"path":76,"stem":77},"Overview",{"title":82,"icon":83,"path":84,"stem":85,"children":86,"page":73},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F08.storage\u002F01.adapters",[87,91,95,99],{"title":88,"path":89,"stem":90},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F08.storage\u002F01.adapters\u002F01.sqlite",{"title":92,"path":93,"stem":94},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F08.storage\u002F01.adapters\u002F02.mysql",{"title":96,"path":97,"stem":98},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F08.storage\u002F01.adapters\u002F03.postgres",{"title":100,"path":101,"stem":102},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F08.storage\u002F01.adapters\u002F04.mongo",{"title":104,"path":105,"stem":106,"children":107},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F08.storage\u002F09.custom",[108],{"title":109,"path":110,"stem":111},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F08.storage\u002Fcustom\u002F01.memory-storage",{"title":113,"path":114,"stem":115},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F09.logging",{"title":117,"path":118,"stem":119},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F10.admin-api",{"title":121,"path":122,"stem":123,"order":124,"badge":125},"Admin UI","\u002Fdocs\u002Fui","docs\u002F11.ui",10,{"label":126,"color":127},"PRE","warning",{"title":129,"path":130,"stem":131},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F12.mcp",{"title":133,"path":134,"stem":135},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F13.cli",{"title":137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":5,"body":146,"description":1335,"extension":1336,"links":1337,"meta":1338,"navigation":1339,"path":6,"seo":1340,"stem":7,"__hash__":1341},"docs\u002Fdocs\u002F00.whats-new.md",{"type":147,"value":148,"toc":1319},"minimark",[149,153,173,178,296,300,421,425,707,711,832,836,904,908,938,942,990,994,997,1040,1044,1088,1092,1143,1147,1189,1193,1229,1233],[150,151,5],"h1",{"id":152},"whats-new",[154,155,156,157,161,162,172],"p",{},"Version history for sched, newest first. Versioning is ",[158,159,160],"strong",{},"per-package"," (monorepo),\nso each wave lists the version matrix it shipped. The full, commit-level history\nlives in the repository ",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fgithub.com\u002Fschedjs\u002Fschedjs\u002Fblob\u002Fmain\u002FCHANGELOG.md",[167],"nofollow",[169,170,171],"code",{},"CHANGELOG.md",".",[174,175,177],"h2",{"id":176},"_2026-11-19-overlap-policy-boot-grace-lock-truth-core-0590-storage-mongo-063-storage-mysql-062-storage-postgres-062-admin-api-060-mcp-063-ui-042-daemon-0140-cli-033","2026-11-19 — overlap policy, boot grace, lock truth (core 0.59.0 \u002F storage-mongo 0.6.3 \u002F storage-mysql 0.6.2 \u002F storage-postgres 0.6.2 \u002F admin-api 0.6.0 \u002F mcp 0.6.3 \u002F ui 0.4.2 \u002F daemon 0.14.0 \u002F cli 0.3.3)",[179,180,181,226,254,272],"ul",{},[182,183,184,190,191,195,196,198,199,202,203,206,207,210,211,214,215,218,219,222,223,172],"li",{},[158,185,186,189],{},[169,187,188],{},"onOverlap"," — one task never runs twice."," Schedule-fired runs were already\nserialized by the atomic schedule lock, but a ",[192,193,194],"em",{},"manual"," run (API, dashboard, a\nretry) takes no lock, so a due slot used to start a parallel copy. ",[169,197,188],{},"\ndecides: ",[169,200,201],{},"skip"," (default — drop the slot, one ",[169,204,205],{},"overlap-skipped"," event per\nseries), ",[169,208,209],{},"queue"," (play it after the live run ends, no ",[169,212,213],{},"missed-slot"," alarm),\n",[169,216,217],{},"cancel"," (stop the live run first). Resolved like ",[169,220,221],{},"retry","\u002F",[169,224,225],{},"priority",[182,227,228,238,239,242,243,246,247,249,250,253],{},[158,229,230,233,234,237],{},[169,231,232],{},"startupGraceMs"," \u002F ",[169,235,236],{},"--startup-grace SECONDS"," — a reboot is not a failure\nstorm."," For the first N ms of ticking, overdue catch-up slots are held back\n(",[169,240,241],{},"startup-deferred",") instead of fired at once: a host whose scheduler boots\nbefore its apps no longer turns every overdue slot into ",[169,244,245],{},"run.failed"," +\n",[169,248,213],{},". Slots stay due — nothing is skipped. Default ",[169,251,252],{},"0"," = off.",[182,255,256,259,260,263,264,267,268,271],{},[158,257,258],{},"A long async run keeps its lock."," The poll loop now refreshes the schedule\nlock every ",[169,261,262],{},"lockHeartbeatMs",", the way the sync heartbeat does, so a run living\npast ",[169,265,266],{},"lockTtlMs"," (with ",[169,269,270],{},"timeoutMs: -1"," disabling the poll ceiling) no longer\ngets a parallel copy from the zombie watchdog.",[182,273,274,283,284,287,288,291,292,295],{},[158,275,276,279,280],{},[169,277,278],{},"Storage.refreshScheduleLock"," returns ",[169,281,282],{},"boolean"," — ",[169,285,286],{},"true"," = extended,\n",[169,289,290],{},"false"," = nothing to extend. The engine reports ",[169,293,294],{},"lock-refresh-missed"," once per\nrun when the lock is gone under a live run. Custom adapters should return it.",[174,297,299],{"id":298},"_2026-10-31-disable-reason-sync-un-parks-a-returned-rule-core-0570-storage-mongo-061-storage-mysql-060-storage-postgres-060-admin-api-050-mcp-061-ui-041-daemon-0134-cli-031","2026-10-31 — disable reason, sync un-parks a returned rule (core 0.57.0 \u002F storage-mongo 0.6.1 \u002F storage-mysql 0.6.0 \u002F storage-postgres 0.6.0 \u002F admin-api 0.5.0 \u002F mcp 0.6.1 \u002F ui 0.4.1 \u002F daemon 0.13.4 \u002F cli 0.3.1)",[179,301,302,347,375,412],{},[182,303,304,310,311,314,315,318,319,322,323,326,327,330,331,334,335,338,339,342,343,346],{},[158,305,306,309],{},[169,307,308],{},"disabled"," now says WHY."," New field ",[169,312,313],{},"disabledBy: 'sync' | 'operator'","\n(",[169,316,317],{},"disabled_by"," column; ",[169,320,321],{},"null"," on legacy rows) on both tasks and schedules.\n",[169,324,325],{},"syncTasks"," marks a rule it parked because it left ",[169,328,329],{},"tasks.json"," with\n",[169,332,333],{},"disabledBy: 'sync'",", and an operator stop (",[169,336,337],{},"disableTask"," \u002F a hand-written\n",[169,340,341],{},"disabled: true",") with ",[169,344,345],{},"'operator'",". Unmarked rows count as operator intent —\nthe safe default.",[182,348,349,355,356,359,360,362,363,366,367,370,371,374],{},[158,350,351,352,354],{},"A rule that returns to ",[169,353,329],{}," ticks again."," Sync clears ",[192,357,358],{},"only its\nown"," ",[169,361,308],{}," mark when the rule comes back, and recomputes ",[169,364,365],{},"nextRunAt"," from\nnow (no catch-up burst). An operator stop survives any number of\nremove\u002Fre-add cycles. Before this, a rule that briefly left the file stayed\nparked ",[158,368,369],{},"forever"," while the list and the boot log (",[169,372,373],{},"6 rule(s)",") looked\nhealthy — the failure that silently stopped a whole fleet for 23 hours.",[182,376,377,383,384,387,388,391,392,395,396,398,399,402,403,407,408,172],{},[158,378,379,382],{},[169,380,381],{},"effectiveStatus"," cannot lie any more."," It gained ",[169,385,386],{},"'disabled'"," (the\nschedule or its task is disabled) and it beats the pause values: a parked row\nis never reported as ",[169,389,390],{},"'active'",". The dashboard renders ⛔ and ",[169,393,394],{},"sched schedules","\nprints ",[169,397,308],{}," in the PAUSED column instead of a green-looking ",[169,400,401],{},"no",". See\n",[163,404,406],{"href":405},"tasks#sync-semantics","tasks → Sync semantics"," and\n",[163,409,411],{"href":410},"admin-api#get-schedules","admin-api → GET \u002Fschedules",[182,413,414,417,418,172],{},[158,415,416],{},"Additive migrations only:"," sqlite adds the column on open, mysql\u002Fpostgres\nrun migration 9, mongo is schemaless. Zombie rows parked by pre-0.57.0\nreleases carry no mark and need one manual ",[169,419,420],{},"enableTask",[174,422,424],{"id":423},"_2026-09-21-queue-control-run-window-bulk-runs-core-0560-storage-mongo-060-storage-mysql-050-storage-postgres-050-admin-api-040-mcp-060-daemon-0133-cli-030","2026-09-21 — queue control, run window, bulk runs (core 0.56.0 \u002F storage-mongo 0.6.0 \u002F storage-mysql 0.5.0 \u002F storage-postgres 0.5.0 \u002F admin-api 0.4.0 \u002F mcp 0.6.0 \u002F daemon 0.13.3 \u002F cli 0.3.0)",[179,426,427,496,554,611,663],{},[182,428,429,359,432,435,436,439,440,233,443,446,447,449,450,453,454,457,458,461,462,465,466,469,470,472,473,476,477,439,480,483,484,487,488,491,492,495],{},[158,430,431],{},"Pause the whole queue without stopping the daemon.",[169,433,434],{},"engine.pause()"," \u002F\n",[169,437,438],{},"resume()"," (",[169,441,442],{},"isPaused()",[169,444,445],{},"getPauseInfo()",") freezes claiming and nothing else:\n",[169,448,329],{}," sync, retention\u002Fprune, the async poll loop and alerts for runs\nalready in flight keep going, so a pause is a queue brake, not ",[169,451,452],{},"docker stop",".\nBoot frozen with ",[169,455,456],{},"createDaemon({ startPaused: true })"," or\n",[169,459,460],{},"SCHED_START_PAUSED=1"," (there is deliberately no ",[169,463,464],{},"--start-paused"," flag — one\nswitch, and compose\u002FPortainer can pass an env where a flag cannot be appended).\nRelease is ",[158,467,468],{},"skip, not catch-up",": a recurring slot that came due during the\npause moves to its next future slot with no ",[169,471,213],{}," alert, while overdue\n",[169,474,475],{},"once","\u002Fdelayed runs and pending retries play exactly once. Events\n",[169,478,479],{},"queue-paused",[169,481,482],{},"{ pausedAt, startPaused }",") and ",[169,485,486],{},"queue-resumed"," — the latter\ncarries the answer to \"what did I miss\": ",[169,489,490],{},"{ pausedMs, skippedSchedules, deferredRuns }"," (see ",[163,493,137],{"href":494},"self-hosting#pausing-the-queue",").",[182,497,498,359,501,504,505,508,509,504,512,515,516,519,520,523,524,527,528,531,532,233,535,538,539,233,542,545,546,549,550,553],{},[158,499,500],{},"Queue control plane.",[169,502,503],{},"GET \u002Fqueue"," → ",[169,506,507],{},"{ paused, pausedAt, startPaused }",",\n",[169,510,511],{},"POST \u002Fqueue\u002Fpause|resume",[169,513,514],{},"200"," and ",[158,517,518],{},"idempotent"," (never ",[169,521,522],{},"409"," — \"bring\nthe queue to this state\", not a conditional write); ",[169,525,526],{},"sched status"," prints a\n",[169,529,530],{},"queue:"," line (",[169,533,534],{},"active",[169,536,537],{},"paused (since …, start-paused)","); MCP gains\n",[169,540,541],{},"pause_queue",[169,543,544],{},"resume_queue"," (mutations, off under ",[169,547,548],{},"--readonly","). Queue state\nstays out of the open ",[169,551,552],{},"GET \u002Fhealth",": liveness answers liveness.",[182,555,556,562,565,566,569,570,573,574,283,577,580,581,584,585,588,589,222,592,595,596,599,602,603,606,607,610],{},[158,557,558,559,172],{},"Run filters — ",[169,560,561],{},"RunFilter += since \u002F until \u002F runner",[169,563,564],{},"GET \u002Fruns?since=&until=&runner="," (ISO-8601 on the wire;\n",[169,567,568],{},"sched runs --since 24h --until 2h --runner docker"," resolves the relative form\nclient-side), plus a fail-fast ",[158,571,572],{},"400"," on an unparseable timestamp or an\nunknown ",[169,575,576],{},"status",[169,578,579],{},"?status=bogus"," used to return an empty list, which reads as\n\"no failures\" over curl\u002FMCP. The window is on ",[169,582,583],{},"startedAt",", both bounds\ninclusive, because that is the column ",[169,586,587],{},"listRuns"," orders by and it never drops\n",[169,590,591],{},"queued",[169,593,594],{},"running"," rows; the stated price is that a long run started ",[192,597,598],{},"before",[169,600,601],{},"since"," is not listed even when it failed inside the window. Backed by\n",[169,604,605],{},"idx_runs_started"," in every adapter — idempotent DDL on open in sqlite, a v8\nmigration in mysql\u002Fpostgres, and mongo reuses its existing ",[169,608,609],{},"{ startedAt: -1 }","\nindex (walked in reverse).",[182,612,613,359,616,330,619,622,623,626,627,630,631,634,635,637,638,641,642,645,646,233,649,652,653,656,657,233,660,172],{},[158,614,615],{},"Bulk cancel \u002F retry.",[169,617,618],{},"POST \u002Fruns\u002Fbulk\u002Fcancel|retry",[169,620,621],{},"{ ids: [...] }"," returns a ",[158,624,625],{},"partial"," result ",[169,628,629],{},"{ ok, failed: [{ id, reason }] }","\n— never atomic, so one racing cancel cannot block the other 99 — with reasons\n",[169,632,633],{},"not-found | already-terminal | not-cancellable",", a ",[169,636,572],{}," on an empty\u002Funknown\nbody and ",[158,639,640],{},"422"," past 100 ids (a 5000-run operation is ",[169,643,644],{},"prune","). The CLI takes\nthe same batch: ",[169,647,648],{},"sched cancel \u003Cid...>",[169,650,651],{},"retry \u003Cid...>"," exits ",[158,654,655],{},"1"," whenever\nany id failed. MCP stays deliberate: no bulk tools — an agent loops\n",[169,658,659],{},"cancel_run",[169,661,662],{},"retry_run",[182,664,665,672,673,233,676,233,678,233,681,684,685,688,689,233,691,693,694,696,697,435,700,703,704,172],{},[158,666,667,668,671],{},"The same operations in the browser (",[169,669,670],{},"@schedjs\u002Fui"," 0.4.0)."," The runs table\ngrew a filter row (",[169,674,675],{},"task",[169,677,601],{},[169,679,680],{},"until",[169,682,683],{},"runner",", window on\n",[169,686,687],{},"started_at",") that survives pagination, per-row checkboxes with header\n",[158,690,217],{},[158,692,221],{}," over ",[169,695,618],{}," — the result line is\npartial and honest (ok count plus every failed id with its reason, failed ids\nstay ticked) — and a queue widget in the header (",[169,698,699],{},"queue: active",[169,701,702],{},"queue: paused (since …)",") with one pause\u002Fresume button. See\n",[163,705,121],{"href":706},"ui#runs-filters",[174,708,710],{"id":709},"_2026-09-20-streak-alerts-core-0550-admin-api-033-mcp-052-daemon-0132-cli-020","2026-09-20 — streak alerts (core 0.55.0 \u002F admin-api 0.3.3 \u002F mcp 0.5.2 \u002F daemon 0.13.2 \u002F cli 0.2.0)",[179,712,713,753,804],{},[182,714,715,721,722,724,725,728,729,732,733,736,737,740,741,744,745,748,749,752],{},[158,716,717,720],{},[169,718,719],{},"alerts.onStreak"," — one alert per incident, not one per run."," A task that\nkeeps failing sends a single ",[169,723,245],{}," when the streak reaches\n",[169,726,727],{},"onStreak"," consecutive failures (payload carries ",[169,730,731],{},"consecutiveFailures","); the\nfailures inside the streak stay silent, a success breaks the streak, and the\nnext incident alerts again. The recovery signal (\"it let go\") is a\n",[169,734,735],{},"run.succeeded"," payload carrying ",[169,738,739],{},"previousFailures"," — how many failures the\nsuccess ended (send it by adding ",[169,742,743],{},"'succeeded'"," to ",[169,746,747],{},"on","). Default\n",[169,750,751],{},"onStreak: 1"," = every terminal failure alerts, i.e. exactly the behaviour\nbefore this option, so an existing deployment is not silently re-tuned.",[182,754,755,765,766,768,769,772,773,776,777,780,781,784,785,787,788,791,792,795,796,799,800,803],{},[158,756,757,760,761,764],{},[169,758,759],{},"FAILS"," column in ",[169,762,763],{},"sched tasks"," and in the admin UI."," How many failed\ncompletions a task has, without a single reminder: ",[169,767,727],{}," suppresses the\nrepeats, the human views keep the count visible (zero prints as ",[169,770,771],{},"—","). The\nnumber is ",[158,774,775],{},"cumulative"," — every failure of the row's life, not \"how many runs\nin a row are red\" — and it is the ",[158,778,779],{},"effective"," count: the task row ",[158,782,783],{},"plus its\nschedule rows",", so a schedule-driven task (whose runtime state lives on the\nschedule and whose task row never moves) no longer reads ",[169,786,771],{}," while it is red.\nThe CLI aggregates by sweeping ",[169,789,790],{},"GET \u002Fschedules","; ",[169,793,794],{},"\u003Csched-tasks>"," does the same\nin the browser. ",[169,797,798],{},"--json"," and the REST payloads are unchanged (they pass the\nraw task records through, ",[169,801,802],{},"failCount"," included).",[182,805,806,811,812,815,816,818,819,822,823,222,825,222,828,831],{},[158,807,808,810],{},[169,809,329],{}," alert validation, root block included."," The top-level ",[169,813,814],{},"alerts","\nblock is now validated by the same rules as the per-task blocks (it used to be\ncast through unchecked): ",[169,817,727],{}," must be an integer ≥ 1, ",[169,820,821],{},"onSyncFailed"," a\nboolean, ",[169,824,747],{},[169,826,827],{},"onMissed",[169,829,830],{},"webhook"," as before — a typo fails at load instead of\nsilently changing what alerts.",[174,833,835],{"id":834},"in-development-inputschema-core","In development — inputSchema (core)",[179,837,838],{},[182,839,840,849,850,853,854,222,857,860,861,864,865,860,868,222,871,860,874,860,877,860,880,407,883,886,887,889,890,435,893,233,896,899,900,903],{},[158,841,842,845,846],{},[169,843,844],{},"inputSchema"," in ",[169,847,848],{},"TaskDefinition"," — declare the shape of run ",[169,851,852],{},"data","\n(tenant parameters) as a JSON Schema subset: types, ",[169,855,856],{},"min",[169,858,859],{},"max",", ",[169,862,863],{},"minLength","\u002F\n",[169,866,867],{},"maxLength",[169,869,870],{},"minItems",[169,872,873],{},"maxItems",[169,875,876],{},"enum",[169,878,879],{},"required",[169,881,882],{},"default",[169,884,885],{},"description",". The engine validates ",[169,888,852],{}," at ",[169,891,892],{},"create_schedule",[169,894,895],{},"update_schedule",[169,897,898],{},"run_once"," (400 with detailed issues), applies defaults,\nand the admin UI \u002F MCP render forms from the schema (trigger.dev model).\n",[169,901,902],{},"input_schema"," is persisted on the task row (sqlite v0.9, mysql\u002Fpg v7; mongo\nis schemaless).",[174,905,907],{"id":906},"_2026-08-26-cancel-on-poll-timeout-wave-core-0530-daemon-0121","2026-08-26 — cancel-on-poll-timeout wave (core 0.53.0 \u002F daemon 0.12.1)",[179,909,910],{},[182,911,912,915,916,919,920,923,924,926,927,930,931,934,935,937],{},[158,913,914],{},"Cancel-on-timeout"," — a poll\u002Frun timeout is no longer a silent stop-polling:\nwhen the accepted envelope advertised a ",[169,917,918],{},"cancelUrl",", sched POSTs ",[169,921,922],{},"{ runId }","\nto the worker ",[158,925,598],{}," failing the timed-out run, so the worker halts at the\nnext stage boundary instead of finishing destructive work after the ",[169,928,929],{},"failed","\nverdict was recorded. A failed cancel signal is appended to the run error\n(",[169,932,933],{},"cancel signal failed: \u003Creason>","). Workers without a ",[169,936,918],{}," keep the\nlegacy stop-polling semantics.",[174,939,941],{"id":940},"_2026-08-25-sync-health-release-hardening-core-0520-daemon-0120-storage-mongo-051","2026-08-25 — sync health + release hardening (core 0.52.0 \u002F daemon 0.12.0 \u002F storage-mongo 0.5.1)",[179,943,944,960,974],{},[182,945,946,953,954,956,957,959],{},[158,947,948,949,952],{},"Sync-health alerts (",[169,950,951],{},"sync.failed",")"," — the daemon reports tasks.json sync\nfailures over the alerts webhook (",[169,955,821],{},", default on): a dead storage\npool means nothing schedules, so ",[169,958,245],{}," alerts can never fire — sync\nhealth is the scheduler's own heartbeat. Fires once per failure streak\n(dedupe), resets on heal. Prod lesson 2026-08-24.",[182,961,962,965,966,969,970,973],{},[158,963,964],{},"Mongo reconnect ownership"," — the adapter, not the driver's SDAM, owns\nreconnection: connection-class errors force a fresh topology\n(",[169,967,968],{},"client.close()"," + ",[169,971,972],{},"client.connect()",") and retry (bounded, 2×).",[182,975,976,283,979,982,983,985,986,989],{},[158,977,978],{},"Release hardening",[169,980,981],{},"--retention-ttl 0"," truly means \"retention off\"\n(previously ",[169,984,252],{}," was falsy-dropped and the default TTL applied); ",[169,987,988],{},"yarn publish:check"," verifies artifacts reached the registry after publish; public\ndocs cleanup (README quick start, LICENSE MIT, CONTRIBUTING).",[174,991,993],{"id":992},"_2026-08-23-prod-cutover-fixes-daemon-0110-core-050x-storage-mongo-050","2026-08-23 — prod-cutover fixes (daemon 0.11.0 \u002F core 0.50.x \u002F storage-mongo 0.5.0)",[154,995,996],{},"First wave driven by production findings from a real deployment:",[179,998,999,1008,1020,1027,1033],{},[182,1000,1001,1004,1005,495],{},[158,1002,1003],{},"Crash resilience"," — engine error boundary around dispatches; admin API\ncatches handler errors; Mongo storage reconnects (",[169,1006,1007],{},"MONGO_RETRY_MS",[182,1009,1010,1013,1014,233,1017,1019],{},[158,1011,1012],{},"Sort indexes"," on ",[169,1015,1016],{},"name",[169,1018,583],{}," for run listing.",[182,1021,1022,1026],{},[158,1023,1024],{},[169,1025,270],{}," = no timeout (per-task run deadline contract).",[182,1028,1029,1032],{},[158,1030,1031],{},"Log coercion"," — run logs normalized to strings.",[182,1034,1035,1039],{},[158,1036,1037],{},[169,1038,981],{}," = retention off.",[174,1041,1043],{"id":1042},"_2026-08-22-dispatch-view-daemon-image-from-npm-daemon-010x-core-0490-storage-040","2026-08-22 — dispatch view + daemon image from npm (daemon 0.10.x \u002F core 0.49.0 \u002F storage-* 0.4.0)",[179,1045,1046,1058,1075],{},[182,1047,1048,283,1051,233,1054,1057],{},[158,1049,1050],{},"Dispatch view",[169,1052,1053],{},"triggerTask",[169,1055,1056],{},"retryRun"," apply per-run data\u002Fbody\noverrides the same way scheduled dispatches do.",[182,1059,1060,1066,1067,1070,1071,1074],{},[158,1061,1062,1065],{},[169,1063,1064],{},"--storage"," bridge"," — the daemon selects its storage adapter from the CLI\n(",[169,1068,1069],{},"--storage mongo|mysql|postgres|\u003Ccustom module>","); credentials come from env,\nnever from process arguments. BYO adapters via ",[169,1072,1073],{},"createStorage(env)"," helpers.",[182,1076,1077,283,1080,1083,1084,1087],{},[158,1078,1079],{},"Official Docker image built from npm",[169,1081,1082],{},"FROM @sched\u002Fdaemon"," composition,\n",[169,1085,1086],{},"docker-cli"," included (Docker runner works inside the container).",[174,1089,1091],{"id":1090},"_2026-08-21-cancellation-that-reaches-the-worker-core-047048-daemon-0709","2026-08-21 — cancellation that reaches the worker (core 0.47–0.48 \u002F daemon 0.7–0.9)",[179,1093,1094,1115,1137],{},[182,1095,1096,1101,1102,1105,1106,744,1109,1111,1112,1114],{},[158,1097,1098,1100],{},[169,1099,918],{}," channel"," — async workers can opt into receiving a cancel\nsignal: sched ",[169,1103,1104],{},"POST","s ",[169,1107,1108],{},"{runId}",[169,1110,918],{}," before finishing the run as\ncancelled. Without ",[169,1113,918],{},": legacy stop-polling (documented).",[182,1116,1117,283,1120,1123,1124,233,1127,1130,1131,233,1134,495],{},[158,1118,1119],{},"Cancel observability",[169,1121,1122],{},"[cancel]"," log lines (",[169,1125,1126],{},"cancel-sent",[169,1128,1129],{},"cancel-ack","\n\u002F ",[169,1132,1133],{},"cancel-failed",[169,1135,1136],{},"cancel-no-channel",[182,1138,1139,1142],{},[158,1140,1141],{},"Dispatcher fix"," — the daemon forwards cancel to the per-task runner\n(previously the signal never left the daemon when the runner was wrapped).",[174,1144,1146],{"id":1145},"_2026-08-20-run-deadlines-http-runner-hardening-core-045046-daemon-060","2026-08-20 — run deadlines + HTTP runner hardening (core 0.45–0.46 \u002F daemon 0.6.0)",[179,1148,1149,1173],{},[182,1150,1151,439,1154,1157,1158,1161,1162,1165,1166,1169,1170,495],{},[158,1152,1153],{},"Per-task run deadline",[169,1155,1156],{},"timeoutMs","): ",[169,1159,1160],{},"-1"," = never auto-terminate (default\nwhen absent), ",[169,1163,1164],{},">0"," = forced failure after N ms, ",[169,1167,1168],{},"absent"," = legacy. Storage\nschema migration to v6 (",[169,1171,1172],{},"timeout_ms",[182,1174,1175,1177,1178,1180,1181,1184,1185,1188],{},[158,1176,41],{},": envelope responses from broken workers → run ",[169,1179,929],{}," (not\nsilent success); relative ",[169,1182,1183],{},"statusUrl"," resolves against ",[169,1186,1187],{},"config.url","; transient\npoll errors (network \u002F 5xx \u002F 408 \u002F 429) retried (2 × 500 ms).",[174,1190,1192],{"id":1191},"_2026-08-18-control-plane-cli-admin-api-010-cli-010-daemon-03x","2026-08-18 — control plane + CLI (admin-api 0.1.0 \u002F cli 0.1.0 \u002F daemon 0.3.x)",[179,1194,1195,1202,1215],{},[182,1196,1197,1198,1201],{},"Admin REST control plane extracted into ",[169,1199,1200],{},"@sched\u002Fadmin-api"," (OpenAPI spec,\ntyped client).",[182,1203,1204,1205,439,1208,1210,1211,1214],{},"Operator CLI ",[169,1206,1207],{},"@sched\u002Fcli",[169,1209,526],{},"), ",[169,1212,1213],{},"schedd"," entry junction-safe.",[182,1216,1217,1218,1221,1222,1225,1226,495],{},"Node engine floor raised to ",[169,1219,1220],{},">= 24"," in the daemon wave (",[169,1223,1224],{},">= 22.5"," in core for\n",[169,1227,1228],{},"node:sqlite",[174,1230,1232],{"id":1231},"earlier-foundations","Earlier — foundations",[179,1234,1235,1248,1254,1261,1272,1285,1300,1309],{},[182,1236,1237,439,1240,1243,1244,1247],{},[158,1238,1239],{},"Engine",[169,1241,1242],{},"@sched\u002Fcore","): queue-based execution, retries with backoff,\npriority, run history, ",[169,1245,1246],{},"onRunFinal"," alerts, lock\u002Fheartbeat, live-sync\nrecovery, internal\u002Fprocess runners.",[182,1249,1250,1253],{},[158,1251,1252],{},"Storages",": SQLite (default), MariaDB\u002FMySQL, PostgreSQL, MongoDB — split\ninto per-adapter packages with a shared contract suite.",[182,1255,1256,439,1258,1260],{},[158,1257,117],{},[169,1259,1200],{},"): tasks\u002Fruns\u002Fschedules REST, Bearer auth,\ntriggered-by forwarding.",[182,1262,1263,439,1265,1268,1269,1271],{},[158,1264,129],{},[169,1266,1267],{},"@sched\u002Fmcp","): 9 tools over the admin API, stdio + Streamable\nHTTP, ",[169,1270,548],{}," guard.",[182,1273,1274,439,1277,1280,1281,1284],{},[158,1275,1276],{},"Web UI",[169,1278,1279],{},"@sched\u002Fui","): standalone ",[169,1282,1283],{},"sched-ui serve",", embeddable web\ncomponents.",[182,1286,1287,1289,1290,1292,1293,1296,1297,495],{},[158,1288,31],{},": request\u002Fresponse envelope, async runs via ",[169,1291,1183],{},"\npolling, idempotency via ",[169,1294,1295],{},"x-sched-run-id",", outbound auth (",[169,1298,1299],{},"x-sched-api-key",[182,1301,1302,791,1305,1308],{},[158,1303,1304],{},"Docker \u002F SSH \u002F process runners",[169,1306,1307],{},"config.network"," for Docker runner.",[182,1310,1311,1314,1315,1318],{},[158,1312,1313],{},"Docs",": Docus 5 site, ",[169,1316,1317],{},"llms.txt"," for AI agents, self-hosting + security guides.",{"title":1320,"searchDepth":21,"depth":21,"links":1321},"",[1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334],{"id":176,"depth":21,"text":177},{"id":298,"depth":21,"text":299},{"id":423,"depth":21,"text":424},{"id":709,"depth":21,"text":710},{"id":834,"depth":21,"text":835},{"id":906,"depth":21,"text":907},{"id":940,"depth":21,"text":941},{"id":992,"depth":21,"text":993},{"id":1042,"depth":21,"text":1043},{"id":1090,"depth":21,"text":1091},{"id":1145,"depth":21,"text":1146},{"id":1191,"depth":21,"text":1192},{"id":1231,"depth":21,"text":1232},"Version history — release notes for every sched wave, newest first","md",null,{},{"order":8},{"title":5,"description":1335},"MqvtnSIs9l2R8j42eyAsDWlkuobr0B7vVFCiOtLZOrI",[1337,1343],{"title":10,"path":11,"stem":12,"description":1344,"children":-1},"What sched is and how it works",1795093692623]