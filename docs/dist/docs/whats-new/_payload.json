":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":5,"body":142,"description":688,"extension":689,"links":690,"meta":691,"navigation":692,"path":6,"seo":693,"stem":7,"__hash__":694},"docs\u002Fdocs\u002F00.whats-new.md",{"type":143,"value":144,"toc":676},"minimark",[145,149,169,174,248,252,283,287,339,343,346,392,396,440,444,496,500,543,547,584,588],[146,147,5],"h1",{"id":148},"whats-new",[150,151,152,153,157,158,168],"p",{},"Version history for sched, newest first. Versioning is ",[154,155,156],"strong",{},"per-package"," (monorepo),\nso each wave lists the version matrix it shipped. The full, commit-level history\nlives in the repository ",[159,160,164],"a",{"href":161,"rel":162},"https:\u002F\u002Fgithub.com\u002Fschedjs\u002Fschedjs\u002Fblob\u002Fmain\u002FCHANGELOG.md",[163],"nofollow",[165,166,167],"code",{},"CHANGELOG.md",".",[170,171,173],"h2",{"id":172},"in-development-inputschema-core","In development — inputSchema (core)",[175,176,177],"ul",{},[178,179,180,189,190,193,194,197,198,201,202,205,206,201,209,197,212,201,215,201,218,201,221,224,225,228,229,231,232,235,236,239,240,243,244,247],"li",{},[154,181,182,185,186],{},[165,183,184],{},"inputSchema"," in ",[165,187,188],{},"TaskDefinition"," — declare the shape of run ",[165,191,192],{},"data","\n(tenant parameters) as a JSON Schema subset: types, ",[165,195,196],{},"min","\u002F",[165,199,200],{},"max",", ",[165,203,204],{},"minLength","\u002F\n",[165,207,208],{},"maxLength",[165,210,211],{},"minItems",[165,213,214],{},"maxItems",[165,216,217],{},"enum",[165,219,220],{},"required",[165,222,223],{},"default"," and\n",[165,226,227],{},"description",". The engine validates ",[165,230,192],{}," at ",[165,233,234],{},"create_schedule"," \u002F\n",[165,237,238],{},"update_schedule"," \u002F ",[165,241,242],{},"run_once"," (400 with detailed issues), applies defaults,\nand the admin UI \u002F MCP render forms from the schema (trigger.dev model).\n",[165,245,246],{},"input_schema"," is persisted on the task row (sqlite v0.9, mysql\u002Fpg v7; mongo\nis schemaless).",[170,249,251],{"id":250},"_2026-08-26-cancel-on-poll-timeout-wave-core-0530-daemon-0121","2026-08-26 — cancel-on-poll-timeout wave (core 0.53.0 \u002F daemon 0.12.1)",[175,253,254],{},[178,255,256,259,260,263,264,267,268,271,272,275,276,279,280,282],{},[154,257,258],{},"Cancel-on-timeout"," — a poll\u002Frun timeout is no longer a silent stop-polling:\nwhen the accepted envelope advertised a ",[165,261,262],{},"cancelUrl",", sched POSTs ",[165,265,266],{},"{ runId }","\nto the worker ",[154,269,270],{},"before"," failing the timed-out run, so the worker halts at the\nnext stage boundary instead of finishing destructive work after the ",[165,273,274],{},"failed","\nverdict was recorded. A failed cancel signal is appended to the run error\n(",[165,277,278],{},"cancel signal failed: \u003Creason>","). Workers without a ",[165,281,262],{}," keep the\nlegacy stop-polling semantics.",[170,284,286],{"id":285},"_2026-08-25-sync-health-release-hardening-core-0520-daemon-0120-storage-mongo-051","2026-08-25 — sync health + release hardening (core 0.52.0 \u002F daemon 0.12.0 \u002F storage-mongo 0.5.1)",[175,288,289,307,321],{},[178,290,291,298,299,302,303,306],{},[154,292,293,294,297],{},"Sync-health alerts (",[165,295,296],{},"sync.failed",")"," — the daemon reports tasks.json sync\nfailures over the alerts webhook (",[165,300,301],{},"onSyncFailed",", default on): a dead storage\npool means nothing schedules, so ",[165,304,305],{},"run.failed"," alerts can never fire — sync\nhealth is the scheduler's own heartbeat. Fires once per failure streak\n(dedupe), resets on heal. Prod lesson 2026-08-24.",[178,308,309,312,313,316,317,320],{},[154,310,311],{},"Mongo reconnect ownership"," — the adapter, not the driver's SDAM, owns\nreconnection: connection-class errors force a fresh topology\n(",[165,314,315],{},"client.close()"," + ",[165,318,319],{},"client.connect()",") and retry (bounded, 2×).",[178,322,323,326,327,330,331,334,335,338],{},[154,324,325],{},"Release hardening"," — ",[165,328,329],{},"--retention-ttl 0"," truly means \"retention off\"\n(previously ",[165,332,333],{},"0"," was falsy-dropped and the default TTL applied); ",[165,336,337],{},"yarn publish:check"," verifies artifacts reached the registry after publish; public\ndocs cleanup (README quick start, LICENSE MIT, CONTRIBUTING).",[170,340,342],{"id":341},"_2026-08-23-prod-cutover-fixes-daemon-0110-core-050x-storage-mongo-050","2026-08-23 — prod-cutover fixes (daemon 0.11.0 \u002F core 0.50.x \u002F storage-mongo 0.5.0)",[150,344,345],{},"First wave driven by production findings from a real deployment:",[175,347,348,358,371,379,385],{},[178,349,350,353,354,357],{},[154,351,352],{},"Crash resilience"," — engine error boundary around dispatches; admin API\ncatches handler errors; Mongo storage reconnects (",[165,355,356],{},"MONGO_RETRY_MS",").",[178,359,360,363,364,239,367,370],{},[154,361,362],{},"Sort indexes"," on ",[165,365,366],{},"name",[165,368,369],{},"startedAt"," for run listing.",[178,372,373,378],{},[154,374,375],{},[165,376,377],{},"timeoutMs: -1"," = no timeout (per-task run deadline contract).",[178,380,381,384],{},[154,382,383],{},"Log coercion"," — run logs normalized to strings.",[178,386,387,391],{},[154,388,389],{},[165,390,329],{}," = retention off.",[170,393,395],{"id":394},"_2026-08-22-dispatch-view-daemon-image-from-npm-daemon-010x-core-0490-storage-040","2026-08-22 — dispatch view + daemon image from npm (daemon 0.10.x \u002F core 0.49.0 \u002F storage-* 0.4.0)",[175,397,398,410,427],{},[178,399,400,326,403,239,406,409],{},[154,401,402],{},"Dispatch view",[165,404,405],{},"triggerTask",[165,407,408],{},"retryRun"," apply per-run data\u002Fbody\noverrides the same way scheduled dispatches do.",[178,411,412,418,419,422,423,426],{},[154,413,414,417],{},[165,415,416],{},"--storage"," bridge"," — the daemon selects its storage adapter from the CLI\n(",[165,420,421],{},"--storage mongo|mysql|postgres|\u003Ccustom module>","); credentials come from env,\nnever from process arguments. BYO adapters via ",[165,424,425],{},"createStorage(env)"," helpers.",[178,428,429,326,432,435,436,439],{},[154,430,431],{},"Official Docker image built from npm",[165,433,434],{},"FROM @sched\u002Fdaemon"," composition,\n",[165,437,438],{},"docker-cli"," included (Docker runner works inside the container).",[170,441,443],{"id":442},"_2026-08-21-cancellation-that-reaches-the-worker-core-047048-daemon-0709","2026-08-21 — cancellation that reaches the worker (core 0.47–0.48 \u002F daemon 0.7–0.9)",[175,445,446,468,490],{},[178,447,448,453,454,457,458,461,462,464,465,467],{},[154,449,450,452],{},[165,451,262],{}," channel"," — async workers can opt into receiving a cancel\nsignal: sched ",[165,455,456],{},"POST","s ",[165,459,460],{},"{runId}"," to ",[165,463,262],{}," before finishing the run as\ncancelled. Without ",[165,466,262],{},": legacy stop-polling (documented).",[178,469,470,326,473,476,477,239,480,483,484,239,487,357],{},[154,471,472],{},"Cancel observability",[165,474,475],{},"[cancel]"," log lines (",[165,478,479],{},"cancel-sent",[165,481,482],{},"cancel-ack","\n\u002F ",[165,485,486],{},"cancel-failed",[165,488,489],{},"cancel-no-channel",[178,491,492,495],{},[154,493,494],{},"Dispatcher fix"," — the daemon forwards cancel to the per-task runner\n(previously the signal never left the daemon when the runner was wrapped).",[170,497,499],{"id":498},"_2026-08-20-run-deadlines-http-runner-hardening-core-045046-daemon-060","2026-08-20 — run deadlines + HTTP runner hardening (core 0.45–0.46 \u002F daemon 0.6.0)",[175,501,502,527],{},[178,503,504,507,508,511,512,515,516,519,520,523,524,357],{},[154,505,506],{},"Per-task run deadline"," (",[165,509,510],{},"timeoutMs","): ",[165,513,514],{},"-1"," = never auto-terminate (default\nwhen absent), ",[165,517,518],{},">0"," = forced failure after N ms, ",[165,521,522],{},"absent"," = legacy. Storage\nschema migration to v6 (",[165,525,526],{},"timeout_ms",[178,528,529,531,532,534,535,538,539,542],{},[154,530,37],{},": envelope responses from broken workers → run ",[165,533,274],{}," (not\nsilent success); relative ",[165,536,537],{},"statusUrl"," resolves against ",[165,540,541],{},"config.url","; transient\npoll errors (network \u002F 5xx \u002F 408 \u002F 429) retried (2 × 500 ms).",[170,544,546],{"id":545},"_2026-08-18-control-plane-cli-admin-api-010-cli-010-daemon-03x","2026-08-18 — control plane + CLI (admin-api 0.1.0 \u002F cli 0.1.0 \u002F daemon 0.3.x)",[175,548,549,556,570],{},[178,550,551,552,555],{},"Admin REST control plane extracted into ",[165,553,554],{},"@sched\u002Fadmin-api"," (OpenAPI spec,\ntyped client).",[178,557,558,559,507,562,565,566,569],{},"Operator CLI ",[165,560,561],{},"@sched\u002Fcli",[165,563,564],{},"sched status","), ",[165,567,568],{},"schedd"," entry junction-safe.",[178,571,572,573,576,577,580,581,357],{},"Node engine floor raised to ",[165,574,575],{},">= 24"," in the daemon wave (",[165,578,579],{},">= 22.5"," in core for\n",[165,582,583],{},"node:sqlite",[170,585,587],{"id":586},"earlier-foundations","Earlier — foundations",[175,589,590,603,609,616,628,641,656,666],{},[178,591,592,507,595,598,599,602],{},[154,593,594],{},"Engine",[165,596,597],{},"@sched\u002Fcore","): queue-based execution, retries with backoff,\npriority, run history, ",[165,600,601],{},"onRunFinal"," alerts, lock\u002Fheartbeat, live-sync\nrecovery, internal\u002Fprocess runners.",[178,604,605,608],{},[154,606,607],{},"Storages",": SQLite (default), MariaDB\u002FMySQL, PostgreSQL, MongoDB — split\ninto per-adapter packages with a shared contract suite.",[178,610,611,507,613,615],{},[154,612,113],{},[165,614,554],{},"): tasks\u002Fruns\u002Fschedules REST, Bearer auth,\ntriggered-by forwarding.",[178,617,618,507,620,623,624,627],{},[154,619,125],{},[165,621,622],{},"@sched\u002Fmcp","): 9 tools over the admin API, stdio + Streamable\nHTTP, ",[165,625,626],{},"--readonly"," guard.",[178,629,630,507,633,636,637,640],{},[154,631,632],{},"Web UI",[165,634,635],{},"@sched\u002Fui","): standalone ",[165,638,639],{},"sched-ui serve",", embeddable web\ncomponents.",[178,642,643,645,646,648,649,652,653,357],{},[154,644,27],{},": request\u002Fresponse envelope, async runs via ",[165,647,537],{},"\npolling, idempotency via ",[165,650,651],{},"x-sched-run-id",", outbound auth (",[165,654,655],{},"x-sched-api-key",[178,657,658,661,662,665],{},[154,659,660],{},"Docker \u002F SSH \u002F process runners","; ",[165,663,664],{},"config.network"," for Docker runner.",[178,667,668,671,672,675],{},[154,669,670],{},"Docs",": Docus 5 site, ",[165,673,674],{},"llms.txt"," for AI agents, self-hosting + security guides.",{"title":677,"searchDepth":17,"depth":17,"links":678},"",[679,680,681,682,683,684,685,686,687],{"id":172,"depth":17,"text":173},{"id":250,"depth":17,"text":251},{"id":285,"depth":17,"text":286},{"id":341,"depth":17,"text":342},{"id":394,"depth":17,"text":395},{"id":442,"depth":17,"text":443},{"id":498,"depth":17,"text":499},{"id":545,"depth":17,"text":546},{"id":586,"depth":17,"text":587},"Version history — release notes for every sched wave, newest first","md",null,{},{"order":8},{"title":5,"description":688},"rfDd6lr7Ptb8xfpaOWGDkAlFsw5bjqcYgDvavS21lQU",[690,696],{"title":10,"path":11,"stem":12,"description":697,"children":-1},"What sched is and how it works",1788099637036]