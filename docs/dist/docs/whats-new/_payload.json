docs\u002Frunners\u002Fcustom\u002Ffile-runner","docs\u002F07.runners\u002Fcustom\u002F01.file-runner",false,{"title":75,"path":76,"stem":77,"children":78},"Storage","\u002Fdocs\u002Fstorage","docs\u002F08.storage\u002Findex",[79,81,103],{"title":80,"path":76,"stem":77},"Overview",{"title":82,"icon":83,"path":84,"stem":85,"children":86,"page":73},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F08.storage\u002F01.adapters",[87,91,95,99],{"title":88,"path":89,"stem":90},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F08.storage\u002F01.adapters\u002F01.sqlite",{"title":92,"path":93,"stem":94},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F08.storage\u002F01.adapters\u002F02.mysql",{"title":96,"path":97,"stem":98},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F08.storage\u002F01.adapters\u002F03.postgres",{"title":100,"path":101,"stem":102},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F08.storage\u002F01.adapters\u002F04.mongo",{"title":104,"path":105,"stem":106,"children":107},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F08.storage\u002F09.custom",[108],{"title":109,"path":110,"stem":111},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F08.storage\u002Fcustom\u002F01.memory-storage",{"title":113,"path":114,"stem":115},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F09.logging",{"title":117,"path":118,"stem":119},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F10.admin-api",{"title":121,"path":122,"stem":123,"order":124,"badge":125},"Admin UI","\u002Fdocs\u002Fui","docs\u002F11.ui",10,{"label":126,"color":127},"PRE","warning",{"title":129,"path":130,"stem":131},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F12.mcp",{"title":133,"path":134,"stem":135},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F13.cli",{"title":137,"path":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":5,"body":146,"description":1056,"extension":1057,"links":1058,"meta":1059,"navigation":1060,"path":6,"seo":1061,"stem":7,"__hash__":1062},"docs\u002Fdocs\u002F00.whats-new.md",{"type":147,"value":148,"toc":1042},"minimark",[149,153,173,178,426,430,552,556,625,629,659,663,712,716,719,763,767,811,815,866,870,912,916,952,956],[150,151,5],"h1",{"id":152},"whats-new",[154,155,156,157,161,162,172],"p",{},"Version history for sched, newest first. Versioning is ",[158,159,160],"strong",{},"per-package"," (monorepo),\nso each wave lists the version matrix it shipped. The full, commit-level history\nlives in the repository ",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fgithub.com\u002Fschedjs\u002Fschedjs\u002Fblob\u002Fmain\u002FCHANGELOG.md",[167],"nofollow",[169,170,171],"code",{},"CHANGELOG.md",".",[174,175,177],"h2",{"id":176},"in-development-queue-control-run-window-bulk-runs-core-storage-admin-api-cli-mcp","In development — queue control, run window, bulk runs (core \u002F storage \u002F admin-api \u002F cli \u002F mcp)",[179,180,181,255,313,373],"ul",{},[182,183,184,187,188,191,192,195,196,199,200,203,204,207,208,211,212,215,216,219,220,223,224,227,228,231,232,235,236,195,239,242,243,246,247,250,251,254],"li",{},[158,185,186],{},"Pause the whole queue without stopping the daemon."," ",[169,189,190],{},"engine.pause()"," \u002F\n",[169,193,194],{},"resume()"," (",[169,197,198],{},"isPaused()"," \u002F ",[169,201,202],{},"getPauseInfo()",") freezes claiming and nothing else:\n",[169,205,206],{},"tasks.json"," sync, retention\u002Fprune, the async poll loop and alerts for runs\nalready in flight keep going, so a pause is a queue brake, not ",[169,209,210],{},"docker stop",".\nBoot frozen with ",[169,213,214],{},"createDaemon({ startPaused: true })"," or\n",[169,217,218],{},"SCHED_START_PAUSED=1"," (there is deliberately no ",[169,221,222],{},"--start-paused"," flag — one\nswitch, and compose\u002FPortainer can pass an env where a flag cannot be appended).\nRelease is ",[158,225,226],{},"skip, not catch-up",": a recurring slot that came due during the\npause moves to its next future slot with no ",[169,229,230],{},"missed-slot"," alert, while overdue\n",[169,233,234],{},"once","\u002Fdelayed runs and pending retries play exactly once. Events\n",[169,237,238],{},"queue-paused",[169,240,241],{},"{ pausedAt, startPaused }",") and ",[169,244,245],{},"queue-resumed"," — the latter\ncarries the answer to \"what did I miss\": ",[169,248,249],{},"{ pausedMs, skippedSchedules, deferredRuns }"," (see ",[163,252,137],{"href":253},"self-hosting#pausing-the-queue",").",[182,256,257,187,260,263,264,267,268,263,271,274,275,278,279,282,283,286,287,290,291,199,294,297,298,199,301,304,305,308,309,312],{},[158,258,259],{},"Queue control plane.",[169,261,262],{},"GET \u002Fqueue"," → ",[169,265,266],{},"{ paused, pausedAt, startPaused }",",\n",[169,269,270],{},"POST \u002Fqueue\u002Fpause|resume",[169,272,273],{},"200"," and ",[158,276,277],{},"idempotent"," (never ",[169,280,281],{},"409"," — \"bring\nthe queue to this state\", not a conditional write); ",[169,284,285],{},"sched status"," prints a\n",[169,288,289],{},"queue:"," line (",[169,292,293],{},"active",[169,295,296],{},"paused (since …, start-paused)","); MCP gains\n",[169,299,300],{},"pause_queue",[169,302,303],{},"resume_queue"," (mutations, off under ",[169,306,307],{},"--readonly","). Queue state\nstays out of the open ",[169,310,311],{},"GET \u002Fhealth",": liveness answers liveness.",[182,314,315,321,324,325,328,329,332,333,336,337,340,341,344,345,348,349,352,353,356,357,361,364,365,368,369,372],{},[158,316,317,318,172],{},"Run filters — ",[169,319,320],{},"RunFilter += since \u002F until \u002F runner",[169,322,323],{},"GET \u002Fruns?since=&until=&runner="," (ISO-8601 on the wire;\n",[169,326,327],{},"sched runs --since 24h --until 2h --runner docker"," resolves the relative form\nclient-side), plus a fail-fast ",[158,330,331],{},"400"," on an unparseable timestamp or an\nunknown ",[169,334,335],{},"status"," — ",[169,338,339],{},"?status=bogus"," used to return an empty list, which reads as\n\"no failures\" over curl\u002FMCP. The window is on ",[169,342,343],{},"startedAt",", both bounds\ninclusive, because that is the column ",[169,346,347],{},"listRuns"," orders by and it never drops\n",[169,350,351],{},"queued","\u002F",[169,354,355],{},"running"," rows; the stated price is that a long run started ",[358,359,360],"em",{},"before",[169,362,363],{},"since"," is not listed even when it failed inside the window. Backed by\n",[169,366,367],{},"idx_runs_started"," in every adapter — idempotent DDL on open in sqlite, a v8\nmigration in mysql\u002Fpostgres, and mongo reuses its existing ",[169,370,371],{},"{ startedAt: -1 }","\nindex (walked in reverse).",[182,374,375,187,378,381,382,385,386,389,390,393,394,397,398,400,401,404,405,408,409,199,412,415,416,419,420,199,423,172],{},[158,376,377],{},"Bulk cancel \u002F retry.",[169,379,380],{},"POST \u002Fruns\u002Fbulk\u002Fcancel|retry"," with\n",[169,383,384],{},"{ ids: [...] }"," returns a ",[158,387,388],{},"partial"," result ",[169,391,392],{},"{ ok, failed: [{ id, reason }] }","\n— never atomic, so one racing cancel cannot block the other 99 — with reasons\n",[169,395,396],{},"not-found | already-terminal | not-cancellable",", a ",[169,399,331],{}," on an empty\u002Funknown\nbody and ",[158,402,403],{},"422"," past 100 ids (a 5000-run operation is ",[169,406,407],{},"prune","). The CLI takes\nthe same batch: ",[169,410,411],{},"sched cancel \u003Cid...>",[169,413,414],{},"retry \u003Cid...>"," exits ",[158,417,418],{},"1"," whenever\nany id failed. MCP stays deliberate: no bulk tools — an agent loops\n",[169,421,422],{},"cancel_run",[169,424,425],{},"retry_run",[174,427,429],{"id":428},"in-development-streak-alerts-core-cli","In development — streak alerts (core \u002F cli)",[179,431,432,473,524],{},[182,433,434,440,441,444,445,448,449,452,453,456,457,460,461,464,465,468,469,472],{},[158,435,436,439],{},[169,437,438],{},"alerts.onStreak"," — one alert per incident, not one per run."," A task that\nkeeps failing sends a single ",[169,442,443],{},"run.failed"," when the streak reaches\n",[169,446,447],{},"onStreak"," consecutive failures (payload carries ",[169,450,451],{},"consecutiveFailures","); the\nfailures inside the streak stay silent, a success breaks the streak, and the\nnext incident alerts again. The recovery signal («отпустило») is a\n",[169,454,455],{},"run.succeeded"," payload carrying ",[169,458,459],{},"previousFailures"," — how many failures the\nsuccess ended (send it by adding ",[169,462,463],{},"'succeeded'"," to ",[169,466,467],{},"on","). Default\n",[169,470,471],{},"onStreak: 1"," = every terminal failure alerts, i.e. exactly the behaviour\nbefore this option, so an existing deployment is not silently re-tuned.",[182,474,475,485,486,488,489,492,493,496,497,500,501,504,505,507,508,511,512,515,516,519,520,523],{},[158,476,477,480,481,484],{},[169,478,479],{},"FAILS"," column in ",[169,482,483],{},"sched tasks"," and in the admin UI."," How many failed\ncompletions a task has, without a single reminder: ",[169,487,447],{}," suppresses the\nrepeats, the human views keep the count visible (zero prints as ",[169,490,491],{},"—","). The\nnumber is ",[158,494,495],{},"cumulative"," — every failure of the row's life, not \"how many runs\nin a row are red\" — and it is the ",[158,498,499],{},"effective"," count: the task row ",[158,502,503],{},"plus its\nschedule rows",", so a schedule-driven task (whose runtime state lives on the\nschedule and whose task row never moves) no longer reads ",[169,506,491],{}," while it is red.\nThe CLI aggregates by sweeping ",[169,509,510],{},"GET \u002Fschedules","; ",[169,513,514],{},"\u003Csched-tasks>"," does the same\nin the browser. ",[169,517,518],{},"--json"," and the REST payloads are unchanged (they pass the\nraw task records through, ",[169,521,522],{},"failCount"," included).",[182,525,526,531,532,535,536,538,539,542,543,352,545,352,548,551],{},[158,527,528,530],{},[169,529,206],{}," alert validation, root block included."," The top-level ",[169,533,534],{},"alerts","\nblock is now validated by the same rules as the per-task blocks (it used to be\ncast through unchecked): ",[169,537,447],{}," must be an integer ≥ 1, ",[169,540,541],{},"onSyncFailed"," a\nboolean, ",[169,544,467],{},[169,546,547],{},"onMissed",[169,549,550],{},"webhook"," as before — a typo fails at load instead of\nsilently changing what alerts.",[174,553,555],{"id":554},"in-development-inputschema-core","In development — inputSchema (core)",[179,557,558],{},[182,559,560,569,570,573,574,352,577,580,581,584,585,580,588,352,591,580,594,580,597,580,600,603,604,607,608,610,611,191,614,199,617,620,621,624],{},[158,561,562,565,566],{},[169,563,564],{},"inputSchema"," in ",[169,567,568],{},"TaskDefinition"," — declare the shape of run ",[169,571,572],{},"data","\n(tenant parameters) as a JSON Schema subset: types, ",[169,575,576],{},"min",[169,578,579],{},"max",", ",[169,582,583],{},"minLength","\u002F\n",[169,586,587],{},"maxLength",[169,589,590],{},"minItems",[169,592,593],{},"maxItems",[169,595,596],{},"enum",[169,598,599],{},"required",[169,601,602],{},"default"," and\n",[169,605,606],{},"description",". The engine validates ",[169,609,572],{}," at ",[169,612,613],{},"create_schedule",[169,615,616],{},"update_schedule",[169,618,619],{},"run_once"," (400 with detailed issues), applies defaults,\nand the admin UI \u002F MCP render forms from the schema (trigger.dev model).\n",[169,622,623],{},"input_schema"," is persisted on the task row (sqlite v0.9, mysql\u002Fpg v7; mongo\nis schemaless).",[174,626,628],{"id":627},"_2026-08-26-cancel-on-poll-timeout-wave-core-0530-daemon-0121","2026-08-26 — cancel-on-poll-timeout wave (core 0.53.0 \u002F daemon 0.12.1)",[179,630,631],{},[182,632,633,636,637,640,641,644,645,647,648,651,652,655,656,658],{},[158,634,635],{},"Cancel-on-timeout"," — a poll\u002Frun timeout is no longer a silent stop-polling:\nwhen the accepted envelope advertised a ",[169,638,639],{},"cancelUrl",", sched POSTs ",[169,642,643],{},"{ runId }","\nto the worker ",[158,646,360],{}," failing the timed-out run, so the worker halts at the\nnext stage boundary instead of finishing destructive work after the ",[169,649,650],{},"failed","\nverdict was recorded. A failed cancel signal is appended to the run error\n(",[169,653,654],{},"cancel signal failed: \u003Creason>","). Workers without a ",[169,657,639],{}," keep the\nlegacy stop-polling semantics.",[174,660,662],{"id":661},"_2026-08-25-sync-health-release-hardening-core-0520-daemon-0120-storage-mongo-051","2026-08-25 — sync health + release hardening (core 0.52.0 \u002F daemon 0.12.0 \u002F storage-mongo 0.5.1)",[179,664,665,681,695],{},[182,666,667,674,675,677,678,680],{},[158,668,669,670,673],{},"Sync-health alerts (",[169,671,672],{},"sync.failed",")"," — the daemon reports tasks.json sync\nfailures over the alerts webhook (",[169,676,541],{},", default on): a dead storage\npool means nothing schedules, so ",[169,679,443],{}," alerts can never fire — sync\nhealth is the scheduler's own heartbeat. Fires once per failure streak\n(dedupe), resets on heal. Prod lesson 2026-08-24.",[182,682,683,686,687,690,691,694],{},[158,684,685],{},"Mongo reconnect ownership"," — the adapter, not the driver's SDAM, owns\nreconnection: connection-class errors force a fresh topology\n(",[169,688,689],{},"client.close()"," + ",[169,692,693],{},"client.connect()",") and retry (bounded, 2×).",[182,696,697,336,700,703,704,707,708,711],{},[158,698,699],{},"Release hardening",[169,701,702],{},"--retention-ttl 0"," truly means \"retention off\"\n(previously ",[169,705,706],{},"0"," was falsy-dropped and the default TTL applied); ",[169,709,710],{},"yarn publish:check"," verifies artifacts reached the registry after publish; public\ndocs cleanup (README quick start, LICENSE MIT, CONTRIBUTING).",[174,713,715],{"id":714},"_2026-08-23-prod-cutover-fixes-daemon-0110-core-050x-storage-mongo-050","2026-08-23 — prod-cutover fixes (daemon 0.11.0 \u002F core 0.50.x \u002F storage-mongo 0.5.0)",[154,717,718],{},"First wave driven by production findings from a real deployment:",[179,720,721,730,742,750,756],{},[182,722,723,726,727,254],{},[158,724,725],{},"Crash resilience"," — engine error boundary around dispatches; admin API\ncatches handler errors; Mongo storage reconnects (",[169,728,729],{},"MONGO_RETRY_MS",[182,731,732,735,736,199,739,741],{},[158,733,734],{},"Sort indexes"," on ",[169,737,738],{},"name",[169,740,343],{}," for run listing.",[182,743,744,749],{},[158,745,746],{},[169,747,748],{},"timeoutMs: -1"," = no timeout (per-task run deadline contract).",[182,751,752,755],{},[158,753,754],{},"Log coercion"," — run logs normalized to strings.",[182,757,758,762],{},[158,759,760],{},[169,761,702],{}," = retention off.",[174,764,766],{"id":765},"_2026-08-22-dispatch-view-daemon-image-from-npm-daemon-010x-core-0490-storage-040","2026-08-22 — dispatch view + daemon image from npm (daemon 0.10.x \u002F core 0.49.0 \u002F storage-* 0.4.0)",[179,768,769,781,798],{},[182,770,771,336,774,199,777,780],{},[158,772,773],{},"Dispatch view",[169,775,776],{},"triggerTask",[169,778,779],{},"retryRun"," apply per-run data\u002Fbody\noverrides the same way scheduled dispatches do.",[182,782,783,789,790,793,794,797],{},[158,784,785,788],{},[169,786,787],{},"--storage"," bridge"," — the daemon selects its storage adapter from the CLI\n(",[169,791,792],{},"--storage mongo|mysql|postgres|\u003Ccustom module>","); credentials come from env,\nnever from process arguments. BYO adapters via ",[169,795,796],{},"createStorage(env)"," helpers.",[182,799,800,336,803,806,807,810],{},[158,801,802],{},"Official Docker image built from npm",[169,804,805],{},"FROM @sched\u002Fdaemon"," composition,\n",[169,808,809],{},"docker-cli"," included (Docker runner works inside the container).",[174,812,814],{"id":813},"_2026-08-21-cancellation-that-reaches-the-worker-core-047048-daemon-0709","2026-08-21 — cancellation that reaches the worker (core 0.47–0.48 \u002F daemon 0.7–0.9)",[179,816,817,838,860],{},[182,818,819,824,825,828,829,464,832,834,835,837],{},[158,820,821,823],{},[169,822,639],{}," channel"," — async workers can opt into receiving a cancel\nsignal: sched ",[169,826,827],{},"POST","s ",[169,830,831],{},"{runId}",[169,833,639],{}," before finishing the run as\ncancelled. Without ",[169,836,639],{},": legacy stop-polling (documented).",[182,839,840,336,843,846,847,199,850,853,854,199,857,254],{},[158,841,842],{},"Cancel observability",[169,844,845],{},"[cancel]"," log lines (",[169,848,849],{},"cancel-sent",[169,851,852],{},"cancel-ack","\n\u002F ",[169,855,856],{},"cancel-failed",[169,858,859],{},"cancel-no-channel",[182,861,862,865],{},[158,863,864],{},"Dispatcher fix"," — the daemon forwards cancel to the per-task runner\n(previously the signal never left the daemon when the runner was wrapped).",[174,867,869],{"id":868},"_2026-08-20-run-deadlines-http-runner-hardening-core-045046-daemon-060","2026-08-20 — run deadlines + HTTP runner hardening (core 0.45–0.46 \u002F daemon 0.6.0)",[179,871,872,896],{},[182,873,874,195,877,880,881,884,885,888,889,892,893,254],{},[158,875,876],{},"Per-task run deadline",[169,878,879],{},"timeoutMs","): ",[169,882,883],{},"-1"," = never auto-terminate (default\nwhen absent), ",[169,886,887],{},">0"," = forced failure after N ms, ",[169,890,891],{},"absent"," = legacy. Storage\nschema migration to v6 (",[169,894,895],{},"timeout_ms",[182,897,898,900,901,903,904,907,908,911],{},[158,899,41],{},": envelope responses from broken workers → run ",[169,902,650],{}," (not\nsilent success); relative ",[169,905,906],{},"sta