":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":5,"body":146,"description":1224,"extension":1225,"links":1226,"meta":1227,"navigation":1228,"path":6,"seo":1229,"stem":7,"__hash__":1230},"docs\u002Fdocs\u002F00.whats-new.md",{"type":147,"value":148,"toc":1209},"minimark",[149,153,173,178,302,306,594,598,720,724,792,796,826,830,879,883,886,930,934,978,982,1033,1037,1079,1083,1119,1123],[150,151,5],"h1",{"id":152},"whats-new",[154,155,156,157,161,162,172],"p",{},"Version history for sched, newest first. Versioning is ",[158,159,160],"strong",{},"per-package"," (monorepo),\nso each wave lists the version matrix it shipped. The full, commit-level history\nlives in the repository ",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fgithub.com\u002Fschedjs\u002Fschedjs\u002Fblob\u002Fmain\u002FCHANGELOG.md",[167],"nofollow",[169,170,171],"code",{},"CHANGELOG.md",".",[174,175,177],"h2",{"id":176},"_2026-10-31-disable-reason-sync-un-parks-a-returned-rule-core-0570-storage-mongo-061-storage-mysql-060-storage-postgres-060-admin-api-050-mcp-061-ui-041-daemon-0134-cli-031","2026-10-31 — disable reason, sync un-parks a returned rule (core 0.57.0 \u002F storage-mongo 0.6.1 \u002F storage-mysql 0.6.0 \u002F storage-postgres 0.6.0 \u002F admin-api 0.5.0 \u002F mcp 0.6.1 \u002F ui 0.4.1 \u002F daemon 0.13.4 \u002F cli 0.3.1)",[179,180,181,227,256,293],"ul",{},[182,183,184,190,191,194,195,198,199,202,203,206,207,210,211,214,215,218,219,222,223,226],"li",{},[158,185,186,189],{},[169,187,188],{},"disabled"," now says WHY."," New field ",[169,192,193],{},"disabledBy: 'sync' | 'operator'","\n(",[169,196,197],{},"disabled_by"," column; ",[169,200,201],{},"null"," on legacy rows) on both tasks and schedules.\n",[169,204,205],{},"syncTasks"," marks a rule it parked because it left ",[169,208,209],{},"tasks.json"," with\n",[169,212,213],{},"disabledBy: 'sync'",", and an operator stop (",[169,216,217],{},"disableTask"," \u002F a hand-written\n",[169,220,221],{},"disabled: true",") with ",[169,224,225],{},"'operator'",". Unmarked rows count as operator intent —\nthe safe default.",[182,228,229,235,236,240,241,243,244,247,248,251,252,255],{},[158,230,231,232,234],{},"A rule that returns to ",[169,233,209],{}," ticks again."," Sync clears ",[237,238,239],"em",{},"only its\nown"," ",[169,242,188],{}," mark when the rule comes back, and recomputes ",[169,245,246],{},"nextRunAt"," from\nnow (no catch-up burst). An operator stop survives any number of\nremove\u002Fre-add cycles. Before this, a rule that briefly left the file stayed\nparked ",[158,249,250],{},"forever"," while the list and the boot log (",[169,253,254],{},"6 rule(s)",") looked\nhealthy — the failure that silently stopped a whole fleet for 23 hours.",[182,257,258,264,265,268,269,272,273,276,277,279,280,283,284,288,289,172],{},[158,259,260,263],{},[169,261,262],{},"effectiveStatus"," cannot lie any more."," It gained ",[169,266,267],{},"'disabled'"," (the\nschedule or its task is disabled) and it beats the pause values: a parked row\nis never reported as ",[169,270,271],{},"'active'",". The dashboard renders ⛔ and ",[169,274,275],{},"sched schedules","\nprints ",[169,278,188],{}," in the PAUSED column instead of a green-looking ",[169,281,282],{},"no",". See\n",[163,285,287],{"href":286},"tasks#sync-semantics","tasks → Sync semantics"," and\n",[163,290,292],{"href":291},"admin-api#get-schedules","admin-api → GET \u002Fschedules",[182,294,295,298,299,172],{},[158,296,297],{},"Additive migrations only:"," sqlite adds the column on open, mysql\u002Fpostgres\nrun migration 9, mongo is schemaless. Zombie rows parked by pre-0.57.0\nreleases carry no mark and need one manual ",[169,300,301],{},"enableTask",[174,303,305],{"id":304},"_2026-09-21-queue-control-run-window-bulk-runs-core-0560-storage-mongo-060-storage-mysql-050-storage-postgres-050-admin-api-040-mcp-060-daemon-0133-cli-030","2026-09-21 — queue control, run window, bulk runs (core 0.56.0 \u002F storage-mongo 0.6.0 \u002F storage-mysql 0.5.0 \u002F storage-postgres 0.5.0 \u002F admin-api 0.4.0 \u002F mcp 0.6.0 \u002F daemon 0.13.3 \u002F cli 0.3.0)",[179,307,308,379,437,496,548],{},[182,309,310,240,313,316,317,320,321,324,325,328,329,331,332,335,336,339,340,343,344,347,348,351,352,355,356,359,360,320,363,366,367,370,371,374,375,378],{},[158,311,312],{},"Pause the whole queue without stopping the daemon.",[169,314,315],{},"engine.pause()"," \u002F\n",[169,318,319],{},"resume()"," (",[169,322,323],{},"isPaused()"," \u002F ",[169,326,327],{},"getPauseInfo()",") freezes claiming and nothing else:\n",[169,330,209],{}," sync, retention\u002Fprune, the async poll loop and alerts for runs\nalready in flight keep going, so a pause is a queue brake, not ",[169,333,334],{},"docker stop",".\nBoot frozen with ",[169,337,338],{},"createDaemon({ startPaused: true })"," or\n",[169,341,342],{},"SCHED_START_PAUSED=1"," (there is deliberately no ",[169,345,346],{},"--start-paused"," flag — one\nswitch, and compose\u002FPortainer can pass an env where a flag cannot be appended).\nRelease is ",[158,349,350],{},"skip, not catch-up",": a recurring slot that came due during the\npause moves to its next future slot with no ",[169,353,354],{},"missed-slot"," alert, while overdue\n",[169,357,358],{},"once","\u002Fdelayed runs and pending retries play exactly once. Events\n",[169,361,362],{},"queue-paused",[169,364,365],{},"{ pausedAt, startPaused }",") and ",[169,368,369],{},"queue-resumed"," — the latter\ncarries the answer to \"what did I miss\": ",[169,372,373],{},"{ pausedMs, skippedSchedules, deferredRuns }"," (see ",[163,376,137],{"href":377},"self-hosting#pausing-the-queue",").",[182,380,381,240,384,387,388,391,392,387,395,398,399,402,403,406,407,410,411,414,415,324,418,421,422,324,425,428,429,432,433,436],{},[158,382,383],{},"Queue control plane.",[169,385,386],{},"GET \u002Fqueue"," → ",[169,389,390],{},"{ paused, pausedAt, startPaused }",",\n",[169,393,394],{},"POST \u002Fqueue\u002Fpause|resume",[169,396,397],{},"200"," and ",[158,400,401],{},"idempotent"," (never ",[169,404,405],{},"409"," — \"bring\nthe queue to this state\", not a conditional write); ",[169,408,409],{},"sched status"," prints a\n",[169,412,413],{},"queue:"," line (",[169,416,417],{},"active",[169,419,420],{},"paused (since …, start-paused)","); MCP gains\n",[169,423,424],{},"pause_queue",[169,426,427],{},"resume_queue"," (mutations, off under ",[169,430,431],{},"--readonly","). Queue state\nstays out of the open ",[169,434,435],{},"GET \u002Fhealth",": liveness answers liveness.",[182,438,439,445,448,449,452,453,456,457,460,461,464,465,468,469,472,473,476,477,480,481,484,487,488,491,492,495],{},[158,440,441,442,172],{},"Run filters — ",[169,443,444],{},"RunFilter += since \u002F until \u002F runner",[169,446,447],{},"GET \u002Fruns?since=&until=&runner="," (ISO-8601 on the wire;\n",[169,450,451],{},"sched runs --since 24h --until 2h --runner docker"," resolves the relative form\nclient-side), plus a fail-fast ",[158,454,455],{},"400"," on an unparseable timestamp or an\nunknown ",[169,458,459],{},"status"," — ",[169,462,463],{},"?status=bogus"," used to return an empty list, which reads as\n\"no failures\" over curl\u002FMCP. The window is on ",[169,466,467],{},"startedAt",", both bounds\ninclusive, because that is the column ",[169,470,471],{},"listRuns"," orders by and it never drops\n",[169,474,475],{},"queued","\u002F",[169,478,479],{},"running"," rows; the stated price is that a long run started ",[237,482,483],{},"before",[169,485,486],{},"since"," is not listed even when it failed inside the window. Backed by\n",[169,489,490],{},"idx_runs_started"," in every adapter — idempotent DDL on open in sqlite, a v8\nmigration in mysql\u002Fpostgres, and mongo reuses its existing ",[169,493,494],{},"{ startedAt: -1 }","\nindex (walked in reverse).",[182,497,498,240,501,210,504,507,508,511,512,515,516,519,520,522,523,526,527,530,531,324,534,537,538,541,542,324,545,172],{},[158,499,500],{},"Bulk cancel \u002F retry.",[169,502,503],{},"POST \u002Fruns\u002Fbulk\u002Fcancel|retry",[169,505,506],{},"{ ids: [...] }"," returns a ",[158,509,510],{},"partial"," result ",[169,513,514],{},"{ ok, failed: [{ id, reason }] }","\n— never atomic, so one racing cancel cannot block the other 99 — with reasons\n",[169,517,518],{},"not-found | already-terminal | not-cancellable",", a ",[169,521,455],{}," on an empty\u002Funknown\nbody and ",[158,524,525],{},"422"," past 100 ids (a 5000-run operation is ",[169,528,529],{},"prune","). The CLI takes\nthe same batch: ",[169,532,533],{},"sched cancel \u003Cid...>",[169,535,536],{},"retry \u003Cid...>"," exits ",[158,539,540],{},"1"," whenever\nany id failed. MCP stays deliberate: no bulk tools — an agent loops\n",[169,543,544],{},"cancel_run",[169,546,547],{},"retry_run",[182,549,550,557,558,324,561,324,563,324,566,569,570,573,574,324,577,580,581,583,584,316,587,590,591,172],{},[158,551,552,553,556],{},"The same operations in the browser (",[169,554,555],{},"@schedjs\u002Fui"," 0.4.0)."," The runs table\ngrew a filter row (",[169,559,560],{},"task",[169,562,486],{},[169,564,565],{},"until",[169,567,568],{},"runner",", window on\n",[169,571,572],{},"started_at",") that survives pagination, per-row checkboxes with header\n",[158,575,576],{},"cancel",[158,578,579],{},"retry"," over ",[169,582,503],{}," — the result line is\npartial and honest (ok count plus every failed id with its reason, failed ids\nstay ticked) — and a queue widget in the header (",[169,585,586],{},"queue: active",[169,588,589],{},"queue: paused (since …)",") with one pause\u002Fresume button. See\n",[163,592,121],{"href":593},"ui#runs-filters",[174,595,597],{"id":596},"_2026-09-20-streak-alerts-core-0550-admin-api-033-mcp-052-daemon-0132-cli-020","2026-09-20 — streak alerts (core 0.55.0 \u002F admin-api 0.3.3 \u002F mcp 0.5.2 \u002F daemon 0.13.2 \u002F cli 0.2.0)",[179,599,600,641,692],{},[182,601,602,608,609,612,613,616,617,620,621,624,625,628,629,632,633,636,637,640],{},[158,603,604,607],{},[169,605,606],{},"alerts.onStreak"," — one alert per incident, not one per run."," A task that\nkeeps failing sends a single ",[169,610,611],{},"run.failed"," when the streak reaches\n",[169,614,615],{},"onStreak"," consecutive failures (payload carries ",[169,618,619],{},"consecutiveFailures","); the\nfailures inside the streak stay silent, a success breaks the streak, and the\nnext incident alerts again. The recovery signal (\"it let go\") is a\n",[169,622,623],{},"run.succeeded"," payload carrying ",[169,626,627],{},"previousFailures"," — how many failures the\nsuccess ended (send it by adding ",[169,630,631],{},"'succeeded'"," to ",[169,634,635],{},"on","). Default\n",[169,638,639],{},"onStreak: 1"," = every terminal failure alerts, i.e. exactly the behaviour\nbefore this option, so an existing deployment is not silently re-tuned.",[182,642,643,653,654,656,657,660,661,664,665,668,669,672,673,675,676,679,680,683,684,687,688,691],{},[158,644,645,648,649,652],{},[169,646,647],{},"FAILS"," column in ",[169,650,651],{},"sched tasks"," and in the admin UI."," How many failed\ncompletions a task has, without a single reminder: ",[169,655,615],{}," suppresses the\nrepeats, the human views keep the count visible (zero prints as ",[169,658,659],{},"—","). The\nnumber is ",[158,662,663],{},"cumulative"," — every failure of the row's life, not \"how many runs\nin a row are red\" — and it is the ",[158,666,667],{},"effective"," count: the task row ",[158,670,671],{},"plus its\nschedule rows",", so a schedule-driven task (whose runtime state lives on the\nschedule and whose task row never moves) no longer reads ",[169,674,659],{}," while it is red.\nThe CLI aggregates by sweeping ",[169,677,678],{},"GET \u002Fschedules","; ",[169,681,682],{},"\u003Csched-tasks>"," does the same\nin the browser. ",[169,685,686],{},"--json"," and the REST payloads are unchanged (they pass the\nraw task records through, ",[169,689,690],{},"failCount"," included).",[182,693,694,699,700,703,704,706,707,710,711,476,713,476,716,719],{},[158,695,696,698],{},[169,697,209],{}," alert validation, root block included."," The top-level ",[169,701,702],{},"alerts","\nblock is now validated by the same rules as the per-task blocks (it used to be\ncast through unchecked): ",[169,705,615],{}," must be an integer ≥ 1, ",[169,708,709],{},"onSyncFailed"," a\nboolean, ",[169,712,635],{},[169,714,715],{},"onMissed",[169,717,718],{},"webhook"," as before — a typo fails at load instead of\nsilently changing what alerts.",[174,721,723],{"id":722},"in-development-inputschema-core","In development — inputSchema (core)",[179,725,726],{},[182,727,728,737,738,741,742,476,745,748,749,752,753,748,756,476,759,748,762,748,765,748,768,288,771,774,775,777,778,316,781,324,784,787,788,791],{},[158,729,730,733,734],{},[169,731,732],{},"inputSchema"," in ",[169,735,736],{},"TaskDefinition"," — declare the shape of run ",[169,739,740],{},"data","\n(tenant parameters) as a JSON Schema subset: types, ",[169,743,744],{},"min",[169,746,747],{},"max",", ",[169,750,751],{},"minLength","\u002F\n",[169,754,755],{},"maxLength",[169,757,758],{},"minItems",[169,760,761],{},"maxItems",[169,763,764],{},"enum",[169,766,767],{},"required",[169,769,770],{},"default",[169,772,773],{},"description",". The engine validates ",[169,776,740],{}," at ",[169,779,780],{},"create_schedule",[169,782,783],{},"update_schedule",[169,785,786],{},"run_once"," (400 with detailed issues), applies defaults,\nand the admin UI \u002F MCP render forms from the schema (trigger.dev model).\n",[169,789,790],{},"input_schema"," is persisted on the task row (sqlite v0.9, mysql\u002Fpg v7; mongo\nis schemaless).",[174,793,795],{"id":794},"_2026-08-26-cancel-on-poll-timeout-wave-core-0530-daemon-0121","2026-08-26 — cancel-on-poll-timeout wave (core 0.53.0 \u002F daemon 0.12.1)",[179,797,798],{},[182,799,800,803,804,807,808,811,812,814,815,818,819,822,823,825],{},[158,801,802],{},"Cancel-on-timeout"," — a poll\u002Frun timeout is no longer a silent stop-polling:\nwhen the accepted envelope advertised a ",[169,805,806],{},"cancelUrl",", sched POSTs ",[169,809,810],{},"{ runId }","\nto the worker ",[158,813,483],{}," failing the timed-out run, so the worker halts at the\nnext stage boundary instead of finishing destructive work after the ",[169,816,817],{},"failed","\nverdict was recorded. A failed cancel signal is appended to the run error\n(",[169,820,821],{},"cancel signal failed: \u003Creason>","). Workers without a ",[169,824,806],{}," keep the\nlegacy stop-polling semantics.",[174,827,829],{"id":828},"_2026-08-25-sync-health-release-hardening-core-0520-daemon-0120-storage-mongo-051","2026-08-25 — sync health + release hardening (core 0.52.0 \u002F daemon 0.12.0 \u002F storage-mongo 0.5.1)",[179,831,832,848,862],{},[182,833,834,841,842,844,845,847],{},[158,835,836,837,840],{},"Sync-health alerts (",[169,838,839],{},"sync.failed",")"," — the daemon reports tasks.json sync\nfailures over the alerts webhook (",[169,843,709],{},", default on): a dead storage\npool means nothing schedules, so ",[169,846,611],{}," alerts can never fire — sync\nhealth is the scheduler's own heartbeat. Fires once per failure streak\n(dedupe), resets on heal. Prod lesson 2026-08-24.",[182,849,850,853,854,857,858,861],{},[158,851,852],{},"Mongo reconnect ownership"," — the adapter, not the driver's SDAM, owns\nreconnection: connection-class errors force a fresh topology\n(",[169,855,856],{},"client.close()"," + ",[169,859,860],{},"client.connect()",") and retry (bounded, 2×).",[182,863,864,460,867,870,871,874,875,878],{},[158,865,866],{},"Release hardening",[169,868,869],{},"--retention-ttl 0"," truly means \"retention off\"\n(previously ",[169,872,873],{},"0"," was falsy-dropped and the default TTL applied); ",[169,876,877],{},"yarn publish:check"," verifies artifacts reached the registry after publish; public\ndocs cleanup (README quick start, LICENSE MIT, CONTRIBUTING).",[174,880,882],{"id":881},"_2026-08-23-prod-cutover-fixes-daemon-0110-core-050x-storage-mongo-050","2026-08-23 — prod-cutover fixes (daemon 0.11.0 \u002F core 0.50.x \u002F storage-mongo 0.5.0)",[154,884,885],{},"First wave driven by production findings from a real deployment:",[179,887,888,897,909,917,923],{},[182,889,890,893,894,378],{},[158,891,892],{},"Crash resilience"," — engine error boundary around dispatches; admin API\ncatches handler errors; Mongo storage reconnects (",[169,895,896],{},"MONGO_RETRY_MS",[182,898,899,902,903,324,906,908],{},[158,900,901],{},"Sort indexes"," on ",[169,904,905],{},"name",[169,907,467],{}," for run listing.",[182,910,911,916],{},[158,912,913],{},[169,914,915],{},"timeoutMs: -1"," = no timeout (per-task run deadline contract).",[182,918,919,922],{},[158,920,921],{},"Log coercion"," — run logs normalized to strings.",[182,924,925,929],{},[158,926,927],{},[169,928,869],{}," = retention off.",[174,931,933],{"id":932},"_2026-08-22-dispatch-view-daemon-image-from-npm-daemon-010x-core-0490-storage-040","2026-08-22 — dispatch view + daemon image from npm (daemon 0.10.x \u002F core 0.49.0 \u002F storage-* 0.4.0)",[179,935,936,948,965],{},[182,937,938,460,941,324,944,947],{},[158,939,940],{},"Dispatch view",[169,942,943],{},"triggerTask",[169,945,946],{},"retryRun"," apply per-run data\u002Fbody\noverrides the same way scheduled dispatches do.",[182,949,950,956,957,960,961,964],{},[158,951,952,955],{},[169,953,954],{},"--storage"," bridge"," — the daemon selects its storage adapter from the CLI\n(",[169,958,959],{},"--storage mongo|mysql|postgres|\u003Ccustom module>","); credentials come from env,\nnever from process arguments. BYO adapters via ",[169,962,963],{},"createStorage(env)"," helpers.",[182,966,967,460,970,973,974,977],{},[158,968,969],{},"Official Docker image built from npm",[169,971,972],{},"FROM @sched\u002Fdaemon"," composition,\n",[169,975,976],{},"docker-cli"," included (Docker runner works inside the container).",[174,979,981],{"id":980},"_2026-08-21-cancellation-that-reaches-the-worker-core-047048-daemon-0709","2026-08-21 — cancellation that reaches the worker (core 0.47–0.48 \u002F daemon 0.7–0.9)",[179,983,984,1005,1027],{},[182,985,986,991,992,995,996,632,999,1001,1002,1004],{},[158,987,988,990],{},[169,989,806],{}," channel"," — async workers can opt into receiving a cancel\nsignal: sched ",[169,993,994],{},"POST","s ",[169,997,998],{},"{runId}",[169,1000,806],{}," before finishing the run as\ncancelled. Without ",[169,1003,806],{},": legacy stop-polling (documented).",[182,1006,1007,460,1010,1013,1014,324,1017,1020,1021,324,1024,378],{},[158,1008,1009],{},"Cancel observability",[169,1011,1012],{},"[cancel]"," log lines (",[169,1015,1016],{},"cancel-sent",[169,1018,1019],{},"cancel-ack","\n\u002F ",[169,1022,1023],{},"cancel-failed",[169,1025,1026],{},"cancel-no-channel",[182,1028,1029,1032],{},[158,1030,1031],{},"Dispatcher fix"," — the daemon forwards cancel to the per-task runner\n(previously the signal never left the daemon when the runner was wrapped).",[174,1034,1036],{"id":1035},"_2026-08-20-run-deadlines-http-runner-hardening-core-045046-daemon-060","2026-08-20 — run deadlines + HTTP runner hardening (core 0.45–0.46 \u002F daemon 0.6.0)",[179,1038,1039,1063],{},[182,1040,1041,320,1044,1047,1048,1051,1052,1055,1056,1059,1060,378],{},[158,1042,1043],{},"Per-task run deadline",[169,1045,1046],{},"timeoutMs","): ",[169,1049,1050],{},"-1"," = never auto-terminate (default\nwhen absent), ",[169,1053,1054],{},">0"," = forced failure after N ms, ",[169,1057,1058],{},"absent"," = legacy. Storage\nschema migration to v6 (",[169,1061,1062],{},"timeout_ms",[182,1064,1065,1067,1068,1070,1071,1074,1075,1078],{},[158,1066,41],{},": envelope responses from broken workers → run ",[169,1069,817],{}," (not\nsilent success); relative ",[169,1072,1073],{},"statusUrl"," resolves against ",[169,1076,1077],{},"config.url","; transient\npoll errors (network \u002F 5xx \u002F 408 \u002F 429) retried (2 × 500 ms).",[174,1080,1082],{"id":1081},"_2026-08-18-control-plane-cli-admin-api-010-cli-010-daemon-03x","2026-08-18 — control plane + CLI (admin-api 0.1.0 \u002F cli 0.1.0 \u002F daemon 0.3.x)",[179,1084,1085,1092,1105],{},[182,1086,1087,1088,1091],{},"Admin REST control plane extracted into ",[169,1089,1090],{},"@sched\u002Fadmin-api"," (OpenAPI spec,\ntyped client).",[182,1093,1094,1095,320,1098,1100,1101,1104],{},"Operator CLI ",[169,1096,1097],{},"@sched\u002Fcli",[169,1099,409],{},"), ",[169,1102,1103],{},"schedd"," entry junction-safe.",[182,1106,1107,1108,1111,1112,1115,1116,378],{},"Node engine floor raised to ",[169,1109,1110],{},">= 24"," in the daemon wave (",[169,1113,1114],{},">= 22.5"," in core for\n",[169,1117,1118],{},"node:sqlite",[174,1120,1122],{"id":1121},"earlier-foundations","Earlier — foundations",[179,1124,1125,1138,1144,1151,1162,1175,1190,1199],{},[182,1126,1127,320,1130,1133,1134,1137],{},[158,1128,1129],{},"Engine",[169,1131,1132],{},"@sched\u002Fcore","): queue-based execution, retries with backoff,\npriority, run history, ",[169,1135,1136],{},"onRunFinal"," alerts, lock\u002Fheartbeat, live-sync\nrecovery, internal\u002Fprocess runners.",[182,1139,1140,1143],{},[158,1141,1142],{},"Storages",": SQLite (default), MariaDB\u002FMySQL, PostgreSQL, MongoDB — split\ninto per-adapter packages with a shared contract suite.",[182,1145,1146,320,1148,1150],{},[158,1147,117],{},[169,1149,1090],{},"): tasks\u002Fruns\u002Fschedules REST, Bearer auth,\ntriggered-by forwarding.",[182,1152,1153,320,1155,1158,1159,1161],{},[158,1154,129],{},[169,1156,1157],{},"@sched\u002Fmcp","): 9 tools over the admin API, stdio + Streamable\nHTTP, ",[169,1160,431],{}," guard.",[182,1163,1164,320,1167,1170,1171,1174],{},[158,1165,1166],{},"Web UI",[169,1168,1169],{},"@sched\u002Fui","): standalone ",[169,1172,1173],{},"sched-ui serve",", embeddable web\ncomponents.",[182,1176,1177,1179,1180,1182,1183,1186,1187,378],{},[158,1178,31],{},": request\u002Fresponse envelope, async runs via ",[169,1181,1073],{},"\npolling, idempotency via ",[169,1184,1185],{},"x-sched-run-id",", outbound auth (",[169,1188,1189],{},"x-sched-api-key",[182,1191,1192,679,1195,1198],{},[158,1193,1194],{},"Docker \u002F SSH \u002F process runners",[169,1196,1197],{},"config.network"," for Docker runner.",[182,1200,1201,1204,1205,1208],{},[158,1202,1203],{},"Docs",": Docus 5 site, ",[169,1206,1207],{},"llms.txt"," for AI agents, self-hosting + security guides.",{"title":1210,"searchDepth":21,"depth":21,"links":1211},"",[1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223],{"id":176,"depth":21,"text":177},{"id":304,"depth":21,"text":305},{"id":596,"depth":21,"text":597},{"id":722,"depth":21,"text":723},{"id":794,"depth":21,"text":795},{"id":828,"depth":21,"text":829},{"id":881,"depth":21,"text":882},{"id":932,"depth":21,"text":933},{"id":980,"depth":21,"text":981},{"id":1035,"depth":21,"text":1036},{"id":1081,"depth":21,"text":1082},{"id":1121,"depth":21,"text":1122},"Version history — release notes for every sched wave, newest first","md",null,{},{"order":8},{"title":5,"description":1224},"eB7kVTZ_F6kQIdRVc6lhlbVL6CocGNqF8Wh3NIw7KwM",[1226,1232],{"title":10,"path":11,"stem":12,"description":1233,"children":-1},"What sched is and how it works",1794139017256]