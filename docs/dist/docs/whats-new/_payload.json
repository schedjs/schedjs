138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":5,"body":146,"description":793,"extension":794,"links":795,"meta":796,"navigation":797,"path":6,"seo":798,"stem":7,"__hash__":799},"docs\u002Fdocs\u002F00.whats-new.md",{"type":147,"value":148,"toc":780},"minimark",[149,153,173,178,280,284,355,359,390,394,444,448,451,497,501,545,549,600,604,647,651,688,692],[150,151,5],"h1",{"id":152},"whats-new",[154,155,156,157,161,162,172],"p",{},"Version history for sched, newest first. Versioning is ",[158,159,160],"strong",{},"per-package"," (monorepo),\nso each wave lists the version matrix it shipped. The full, commit-level history\nlives in the repository ",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fgithub.com\u002Fschedjs\u002Fschedjs\u002Fblob\u002Fmain\u002FCHANGELOG.md",[167],"nofollow",[169,170,171],"code",{},"CHANGELOG.md",".",[174,175,177],"h2",{"id":176},"in-development-streak-alerts-core-cli","In development — streak alerts (core \u002F cli)",[179,180,181,223,250],"ul",{},[182,183,184,190,191,194,195,198,199,202,203,206,207,210,211,214,215,218,219,222],"li",{},[158,185,186,189],{},[169,187,188],{},"alerts.onStreak"," — one alert per incident, not one per run."," A task that\nkeeps failing sends a single ",[169,192,193],{},"run.failed"," when the streak reaches\n",[169,196,197],{},"onStreak"," consecutive failures (payload carries ",[169,200,201],{},"consecutiveFailures","); the\nfailures inside the streak stay silent, a success breaks the streak, and the\nnext incident alerts again. The recovery signal («отпустило») is a\n",[169,204,205],{},"run.succeeded"," payload carrying ",[169,208,209],{},"previousFailures"," — how many failures the\nsuccess ended (send it by adding ",[169,212,213],{},"'succeeded'"," to ",[169,216,217],{},"on","). Default\n",[169,220,221],{},"onStreak: 1"," = every terminal failure alerts, i.e. exactly the behaviour\nbefore this option, so an existing deployment is not silently re-tuned.",[182,224,225,234,235,237,238,241,242,245,246,249],{},[158,226,227,230,231,172],{},[169,228,229],{},"FAILS"," column in ",[169,232,233],{},"sched tasks"," How long a task has been red, without a\nsingle reminder: ",[169,236,197],{}," suppresses the repeats, the CLI keeps the running\ncount visible (zero prints as ",[169,239,240],{},"—","). ",[169,243,244],{},"--json"," is unchanged (",[169,247,248],{},"failCount"," was\nalready in the task record).",[182,251,252,258,259,262,263,265,266,269,270,272,273,272,276,279],{},[158,253,254,257],{},[169,255,256],{},"tasks.json"," alert validation, root block included."," The top-level ",[169,260,261],{},"alerts","\nblock is now validated by the same rules as the per-task blocks (it used to be\ncast through unchecked): ",[169,264,197],{}," must be an integer ≥ 1, ",[169,267,268],{},"onSyncFailed"," a\nboolean, ",[169,271,217],{},"\u002F",[169,274,275],{},"onMissed",[169,277,278],{},"webhook"," as before — a typo fails at load instead of\nsilently changing what alerts.",[174,281,283],{"id":282},"in-development-inputschema-core","In development — inputSchema (core)",[179,285,286],{},[182,287,288,297,298,301,302,272,305,308,309,312,313,308,316,272,319,308,322,308,325,308,328,331,332,335,336,338,339,342,343,346,347,350,351,354],{},[158,289,290,293,294],{},[169,291,292],{},"inputSchema"," in ",[169,295,296],{},"TaskDefinition"," — declare the shape of run ",[169,299,300],{},"data","\n(tenant parameters) as a JSON Schema subset: types, ",[169,303,304],{},"min",[169,306,307],{},"max",", ",[169,310,311],{},"minLength","\u002F\n",[169,314,315],{},"maxLength",[169,317,318],{},"minItems",[169,320,321],{},"maxItems",[169,323,324],{},"enum",[169,326,327],{},"required",[169,329,330],{},"default"," and\n",[169,333,334],{},"description",". The engine validates ",[169,337,300],{}," at ",[169,340,341],{},"create_schedule"," \u002F\n",[169,344,345],{},"update_schedule"," \u002F ",[169,348,349],{},"run_once"," (400 with detailed issues), applies defaults,\nand the admin UI \u002F MCP render forms from the schema (trigger.dev model).\n",[169,352,353],{},"input_schema"," is persisted on the task row (sqlite v0.9, mysql\u002Fpg v7; mongo\nis schemaless).",[174,356,358],{"id":357},"_2026-08-26-cancel-on-poll-timeout-wave-core-0530-daemon-0121","2026-08-26 — cancel-on-poll-timeout wave (core 0.53.0 \u002F daemon 0.12.1)",[179,360,361],{},[182,362,363,366,367,370,371,374,375,378,379,382,383,386,387,389],{},[158,364,365],{},"Cancel-on-timeout"," — a poll\u002Frun timeout is no longer a silent stop-polling:\nwhen the accepted envelope advertised a ",[169,368,369],{},"cancelUrl",", sched POSTs ",[169,372,373],{},"{ runId }","\nto the worker ",[158,376,377],{},"before"," failing the timed-out run, so the worker halts at the\nnext stage boundary instead of finishing destructive work after the ",[169,380,381],{},"failed","\nverdict was recorded. A failed cancel signal is appended to the run error\n(",[169,384,385],{},"cancel signal failed: \u003Creason>","). Workers without a ",[169,388,369],{}," keep the\nlegacy stop-polling semantics.",[174,391,393],{"id":392},"_2026-08-25-sync-health-release-hardening-core-0520-daemon-0120-storage-mongo-051","2026-08-25 — sync health + release hardening (core 0.52.0 \u002F daemon 0.12.0 \u002F storage-mongo 0.5.1)",[179,395,396,412,426],{},[182,397,398,405,406,408,409,411],{},[158,399,400,401,404],{},"Sync-health alerts (",[169,402,403],{},"sync.failed",")"," — the daemon reports tasks.json sync\nfailures over the alerts webhook (",[169,407,268],{},", default on): a dead storage\npool means nothing schedules, so ",[169,410,193],{}," alerts can never fire — sync\nhealth is the scheduler's own heartbeat. Fires once per failure streak\n(dedupe), resets on heal. Prod lesson 2026-08-24.",[182,413,414,417,418,421,422,425],{},[158,415,416],{},"Mongo reconnect ownership"," — the adapter, not the driver's SDAM, owns\nreconnection: connection-class errors force a fresh topology\n(",[169,419,420],{},"client.close()"," + ",[169,423,424],{},"client.connect()",") and retry (bounded, 2×).",[182,427,428,431,432,435,436,439,440,443],{},[158,429,430],{},"Release hardening"," — ",[169,433,434],{},"--retention-ttl 0"," truly means \"retention off\"\n(previously ",[169,437,438],{},"0"," was falsy-dropped and the default TTL applied); ",[169,441,442],{},"yarn publish:check"," verifies artifacts reached the registry after publish; public\ndocs cleanup (README quick start, LICENSE MIT, CONTRIBUTING).",[174,445,447],{"id":446},"_2026-08-23-prod-cutover-fixes-daemon-0110-core-050x-storage-mongo-050","2026-08-23 — prod-cutover fixes (daemon 0.11.0 \u002F core 0.50.x \u002F storage-mongo 0.5.0)",[154,449,450],{},"First wave driven by production findings from a real deployment:",[179,452,453,463,476,484,490],{},[182,454,455,458,459,462],{},[158,456,457],{},"Crash resilience"," — engine error boundary around dispatches; admin API\ncatches handler errors; Mongo storage reconnects (",[169,460,461],{},"MONGO_RETRY_MS",").",[182,464,465,468,469,346,472,475],{},[158,466,467],{},"Sort indexes"," on ",[169,470,471],{},"name",[169,473,474],{},"startedAt"," for run listing.",[182,477,478,483],{},[158,479,480],{},[169,481,482],{},"timeoutMs: -1"," = no timeout (per-task run deadline contract).",[182,485,486,489],{},[158,487,488],{},"Log coercion"," — run logs normalized to strings.",[182,491,492,496],{},[158,493,494],{},[169,495,434],{}," = retention off.",[174,498,500],{"id":499},"_2026-08-22-dispatch-view-daemon-image-from-npm-daemon-010x-core-0490-storage-040","2026-08-22 — dispatch view + daemon image from npm (daemon 0.10.x \u002F core 0.49.0 \u002F storage-* 0.4.0)",[179,502,503,515,532],{},[182,504,505,431,508,346,511,514],{},[158,506,507],{},"Dispatch view",[169,509,510],{},"triggerTask",[169,512,513],{},"retryRun"," apply per-run data\u002Fbody\noverrides the same way scheduled dispatches do.",[182,516,517,523,524,527,528,531],{},[158,518,519,522],{},[169,520,521],{},"--storage"," bridge"," — the daemon selects its storage adapter from the CLI\n(",[169,525,526],{},"--storage mongo|mysql|postgres|\u003Ccustom module>","); credentials come from env,\nnever from process arguments. BYO adapters via ",[169,529,530],{},"createStorage(env)"," helpers.",[182,533,534,431,537,540,541,544],{},[158,535,536],{},"Official Docker image built from npm",[169,538,539],{},"FROM @sched\u002Fdaemon"," composition,\n",[169,542,543],{},"docker-cli"," included (Docker runner works inside the container).",[174,546,548],{"id":547},"_2026-08-21-cancellation-that-reaches-the-worker-core-047048-daemon-0709","2026-08-21 — cancellation that reaches the worker (core 0.47–0.48 \u002F daemon 0.7–0.9)",[179,550,551,572,594],{},[182,552,553,558,559,562,563,214,566,568,569,571],{},[158,554,555,557],{},[169,556,369],{}," channel"," — async workers can opt into receiving a cancel\nsignal: sched ",[169,560,561],{},"POST","s ",[169,564,565],{},"{runId}",[169,567,369],{}," before finishing the run as\ncancelled. Without ",[169,570,369],{},": legacy stop-polling (documented).",[182,573,574,431,577,580,581,346,584,587,588,346,591,462],{},[158,575,576],{},"Cancel observability",[169,578,579],{},"[cancel]"," log lines (",[169,582,583],{},"cancel-sent",[169,585,586],{},"cancel-ack","\n\u002F ",[169,589,590],{},"cancel-failed",[169,592,593],{},"cancel-no-channel",[182,595,596,599],{},[158,597,598],{},"Dispatcher fix"," — the daemon forwards cancel to the per-task runner\n(previously the signal never left the daemon when the runner was wrapped).",[174,601,603],{"id":602},"_2026-08-20-run-deadlines-http-runner-hardening-core-045046-daemon-060","2026-08-20 — run deadlines + HTTP runner hardening (core 0.45–0.46 \u002F daemon 0.6.0)",[179,605,606,631],{},[182,607,608,611,612,615,616,619,620,623,624,627,628,462],{},[158,609,610],{},"Per-task run deadline"," (",[169,613,614],{},"timeoutMs","): ",[169,617,618],{},"-1"," = never auto-terminate (default\nwhen absent), ",[169,621,622],{},">0"," = forced failure after N ms, ",[169,625,626],{},"absent"," = legacy. Storage\nschema migration to v6 (",[169,629,630],{},"timeout_ms",[182,632,633,635,636,638,639,642,643,646],{},[158,634,41],{},": envelope responses from broken workers → run ",[169,637,381],{}," (not\nsilent success); relative ",[169,640,641],{},"statusUrl"," resolves against ",[169,644,645],{},"config.url","; transient\npoll errors (network \u002F 5xx \u002F 408 \u002F 429) retried (2 × 500 ms).",[174,648,650],{"id":649},"_2026-08-18-control-plane-cli-admin-api-010-cli-010-daemon-03x","2026-08-18 — control plane + CLI (admin-api 0.1.0 \u002F cli 0.1.0 \u002F daemon 0.3.x)",[179,652,653,660,674],{},[182,654,655,656,659],{},"Admin REST control plane extracted into ",[169,657,658],{},"@sched\u002Fadmin-api"," (OpenAPI spec,\ntyped client).",[182,661,662,663,611,666,669,670,673],{},"Operator CLI ",[169,664,665],{},"@sched\u002Fcli",[169,667,668],{},"sched status","), ",[169,671,672],{},"schedd"," entry junction-safe.",[182,675,676,677,680,681,684,685,462],{},"Node engine floor raised to ",[169,678,679],{},">= 24"," in the daemon wave (",[169,682,683],{},">= 22.5"," in core for\n",[169,686,687],{},"node:sqlite",[174,689,691],{"id":690},"earlier-foundations","Earlier — foundations",[179,693,694,707,713,720,732,745,760,770],{},[182,695,696,611,699,702,703,706],{},[158,697,698],{},"Engine",[169,700,701],{},"@sched\u002Fcore","): queue-based execution, retries with backoff,\npriority, run history, ",[169,704,705],{},"onRunFinal"," alerts, lock\u002Fheartbeat, live-sync\nrecovery, internal\u002Fprocess runners.",[182,708,709,712],{},[158,710,711],{},"Storages",": SQLite (default), MariaDB\u002FMySQL, PostgreSQL, MongoDB — split\ninto per-adapter packages with a shared contract suite.",[182,714,715,611,717,719],{},[158,716,117],{},[169,718,658],{},"): tasks\u002Fruns\u002Fschedules REST, Bearer auth,\ntriggered-by forwarding.",[182,721,722,611,724,727,728,731],{},[158,723,129],{},[169,725,726],{},"@sched\u002Fmcp","): 9 tools over the admin API, stdio + Streamable\nHTTP, ",[169,729,730],{},"--readonly"," guard.",[182,733,734,611,737,740,741,744],{},[158,735,736],{},"Web UI",[169,738,739],{},"@sched\u002Fui","): standalone ",[169,742,743],{},"sched-ui serve",", embeddable web\ncomponents.",[182,746,747,749,750,752,753,756,757,462],{},[158,748,31],{},": request\u002Fresponse envelope, async runs via ",[169,751,641],{},"\npolling, idempotency via ",[169,754,755],{},"x-sched-run-id",", outbound auth (",[169,758,759],{},"x-sched-api-key",[182,761,762,765,766,769],{},[158,763,764],{},"Docker \u002F SSH \u002F process runners","; ",[169,767,768],{},"config.network"," for Docker runner.",[182,771,772,775,776,779],{},[158,773,774],{},"Docs",": Docus 5 site, ",[169,777,778],{},"llms.txt"," for AI agents, self-hosting + security guides.",{"title":781,"searchDepth":21,"depth":21,"links":782},"",[783,784,785,786,787,788,789,790,791,792],{"id":176,"depth":21,"text":177},{"id":282,"depth":21,"text":283},{"id":357,"depth":21,"text":358},{"id":392,"depth":21,"text":393},{"id":446,"depth":21,"text":447},{"id":499,"depth":21,"text":500},{"id":547,"depth":21,"text":548},{"id":602,"depth":21,"text":603},{"id":649,"depth":21,"text":650},{"id":690,"depth":21,"text":691},"Version history — release notes for every sched wave, newest first","md",null,{},{"order":8},{"title":5,"description":793},"yEeFwqW4sL2L7X4bOYlW-4CBxXIypNARzdtKLjuFV8Y",[795,801],{"title":10,"path":11,"stem":12,"description":802,"children":-1},"What sched is and how it works",1789905804031]