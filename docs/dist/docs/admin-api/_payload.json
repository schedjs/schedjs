":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":117,"body":146,"description":1627,"extension":1628,"links":1629,"meta":1630,"navigation":1631,"path":118,"seo":1632,"stem":119,"__hash__":1633},"docs\u002Fdocs\u002F10.admin-api.md",{"type":147,"value":148,"toc":1612},"minimark",[149,166,176,183,194,345,372,397,402,408,423,476,479,485,554,644,650,674,680,706,711,737,740,746,756,762,766,772,778,825,838,841,847,851,866,872,954,957,963,980,989,1006,1012,1050,1068,1072,1078,1091,1094,1100,1169,1173,1180,1213,1524,1565,1582,1586,1608],[150,151,152,153,157,158,161,162,165],"p",{},"The daemon serves a small JSON API under ",[154,155,156],"code",{},"--admin-port"," (mount point ",[154,159,160],{},"\u002Fapi","). Bearer auth\nis required when ",[154,163,164],{},"SCHED_ADMIN_KEY"," is set:",[167,168,173],"pre",{"className":169,"code":171,"language":172},[170],"language-text","Authorization: Bearer \u003CSCHED_ADMIN_KEY>\n","text",[154,174,171],{"__ignoreMap":175},"",[150,177,178,179,182],{},"Unauthenticated requests get ",[154,180,181],{},"401 { \"error\": \"unauthorized\" }",". When no key is configured,\nthe API is open (bind to a private host in that case).",[150,184,185,193],{},[186,187,188,189,192],"strong",{},"Exception: ",[154,190,191],{},"GET \u002Fhealth"," is always open"," — even with a key configured, the health\nprobe answers without credentials (compose healthchecks \u002F LB probes carry none, and the\npayload has no secrets). Every other route 401s without the key.",[195,196,197,215,230,258,264],"blockquote",{},[150,198,199,202,203,206,207,210,211,214],{},[186,200,201],{},"Machine-readable contract."," An OpenAPI 3.1 spec ships with the server package:\n",[154,204,205],{},"@schedjs\u002Fadmin-api\u002Fopenapi.json"," — generate a client in any language with\n",[154,208,209],{},"openapi-generator"," \u002F ",[154,212,213],{},"kiota"," \u002F fern. The spec is route-parity-tested against the\nrouter (every documented path is exercised; a removed route fails the suite).",[150,216,217,220,221,225,226,229],{},[186,218,219],{},"Download without running anything:"," the same file is served by this docs site at\n",[222,223,224],"a",{"href":224},"\u002Fopenapi.json"," (byte-identical to the package spec, guarded by\n",[154,227,228],{},"packages\u002Fadmin-api\u002Ftest\u002Fts-client-guard.test.ts",").",[150,231,232,235,236,238,239,242,243,246,247,249,250,253,254,257],{},[186,233,234],{},"Verified flavors:"," Python (",[154,237,209],{}," 7.24.0, suite\n24\u002F24 + smoke 19\u002F19 against a live daemon) and TypeScript (",[154,240,241],{},"typescript-axios",",\ncompiles clean under ",[154,244,245],{},"tsc --strict","; pinned spec copies are byte-identical to the\npackage one, guarded by ",[154,248,228],{},"). Two\ngenerator families over one spec — the 3.1 nullable unions\n(",[154,251,252],{},"type: [..., \"null\"]",") map to ",[154,255,256],{},"string | null"," in both.",[150,259,260,263],{},[186,261,262],{},"Generator-compatible shapes:","**",[265,266,267,286,304,317,331],"ul",{},[268,269,270,271,274,275,278,279,278,282,285],"li",{},"Mutations return ",[186,272,273],{},"wrapped"," records — ",[154,276,277],{},"{ task }",", ",[154,280,281],{},"{ run }",[154,283,284],{},"{ schedule }"," —\nsingular GETs return the bare record; the spec declares exactly that.",[268,287,288,291,292,295,296,299,300,303],{},[154,289,290],{},"Schedule"," is a ",[186,293,294],{},"flat output schema"," (kind + optional cron\u002Ftimezone\u002Fms\u002Fat) —\none-shot rules normalize to ",[154,297,298],{},"{ kind: \"once\", at }",", intervals to ",[154,301,302],{},"{ kind: \"interval\", ms }",".",[268,305,306,307,310,311,313,314,229],{},"No ",[154,308,309],{},"const: true"," \u002F no oneOf+discriminator — constructs that make ",[154,312,209],{},"\nemit broken models (string-enums for booleans, ",[154,315,316],{},"actual_instance=None",[268,318,319,322,323,326,327,330],{},[154,320,321],{},"GET \u002Fruns\u002F{id}?logFromOffset=N"," declares the incremental-chunk shape\n(",[154,324,325],{},"logChunk"," + ",[154,328,329],{},"logTotalLength"," alongside the run).",[268,332,333,334,210,337,340,341,344],{},"Unknown top-level body fields on ",[154,335,336],{},"POST \u002Fschedules",[154,338,339],{},"PATCH \u002Fschedules\u002F{id}","\nare rejected with 400 (fail-fast) — a silent-ignored ",[154,342,343],{},"dedupKey"," used to create\na duplicate schedule.",[195,346,347],{},[150,348,349,352,353,356,357,360,361,364,365,367,368,371],{},[186,350,351],{},"Cache control."," Every JSON response is sent with ",[154,354,355],{},"Cache-Control: no-store"," (and the\nartifact proxy with ",[154,358,359],{},"no-cache","), so the browser never serves a cached snapshot of a run.\nThe standalone UI (",[154,362,363],{},"sched-ui serve",") additionally forces ",[154,366,359],{}," on its ",[154,369,370],{},"\u002Fapi\u002F*"," proxy\nresponses. If a browser still shows a stale list, hard-refresh (Ctrl+F5) once.",[195,373,374],{},[150,375,376,377,380,381,384,385,388,389,392,393,396],{},"The same API is available to embedded apps: ",[154,378,379],{},"createAdminApi"," from ",[154,382,383],{},"@schedjs\u002Fadmin-api","\nreturns an ",[154,386,387],{},"AdminApi"," whose ",[154,390,391],{},"handleRequest(req, res)"," you can mount at any path\n(see ",[222,394,121],{"href":395},"ui"," § Embedded apps).",[398,399,401],"h2",{"id":400},"health","Health",[167,403,406],{"className":404,"code":405,"language":172},[170],"GET \u002Fapi\u002Fhealth   → { \"ok\": true, \"uptimeMs\": 1234, \"version\": \"0.16.0\" }\n",[154,407,405],{"__ignoreMap":175},[150,409,410,413,414,416,417,419,420,422],{},[154,411,412],{},"version"," is the daemon's own package version (falls back to ",[154,415,383],{}," for\nembedded hosts — pass ",[154,418,412],{}," to ",[154,421,379],{}," to override).",[167,424,428],{"className":425,"code":426,"language":427,"meta":175,"style":175},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"ok\": true, \"uptimeMs\": 123456 }\n","json",[154,429,430],{"__ignoreMap":175},[431,432,435,439,443,447,450,453,457,460,462,465,467,469,473],"span",{"class":433,"line":434},"line",1,[431,436,438],{"class":437},"soVBu","{",[431,440,442],{"class":441},"s4Jsk"," \"",[431,444,446],{"class":445},"sLorS","ok",[431,448,449],{"class":441},"\"",[431,451,452],{"class":437},":",[431,454,456],{"class":455},"s8XtY"," true",[431,458,459],{"class":437},",",[431,461,442],{"class":441},[431,463,464],{"class":445},"uptimeMs",[431,466,449],{"class":441},[431,468,452],{"class":437},[431,470,472],{"class":471},"s7CZa"," 123456",[431,474,475],{"class":437}," }\n",[398,477,27],{"id":478},"runs",[167,480,483],{"className":481,"code":482,"language":172},[170],"GET \u002Fruns?task=greet&status=failed&limit=20&offset=0\n",[154,484,482],{"__ignoreMap":175},[486,487,488,501],"table",{},[489,490,491],"thead",{},[492,493,494,498],"tr",{},[495,496,497],"th",{},"Query",[495,499,500],{},"Description",[502,503,504,515,541],"tbody",{},[492,505,506,512],{},[507,508,509],"td",{},[154,510,511],{},"task",[507,513,514],{},"filter by task name",[492,516,517,522],{},[507,518,519],{},[154,520,521],{},"status",[507,523,524,525,210,528,210,531,210,534,210,537,540],{},"filter by status (",[154,526,527],{},"queued",[154,529,530],{},"running",[154,532,533],{},"succeeded",[154,535,536],{},"failed",[154,538,539],{},"cancelled",")",[492,542,543,551],{},[507,544,545,278,548],{},[154,546,547],{},"limit",[154,549,550],{},"offset",[507,552,553],{},"pagination",[167,555,557],{"className":425,"code":556,"language":427,"meta":175,"style":175},"{ \"runs\": [ { \"id\": \"...\", \"taskName\": \"greet\", \"status\": \"failed\", ... } ] }\n",[154,558,559],{"__ignoreMap":175},[431,560,561,563,565,567,569,571,574,577,579,583,585,587,590,594,596,598,600,603,605,607,609,612,614,616,618,620,622,624,626,628,630,632,636,639,642],{"class":433,"line":434},[431,562,438],{"class":437},[431,564,442],{"class":441},[431,566,478],{"class":445},[431,568,449],{"class":441},[431,570,452],{"class":437},[431,572,573],{"class":437}," [",[431,575,576],{"class":437}," {",[431,578,442],{"class":441},[431,580,582],{"class":581},"sa2tF","id",[431,584,449],{"class":441},[431,586,452],{"class":437},[431,588,442],{"class":589},"sbYkP",[431,591,593],{"class":592},"sTbE_","...",[431,595,449],{"class":589},[431,597,459],{"class":437},[431,599,442],{"class":441},[431,601,602],{"class":581},"taskName",[431,604,449],{"class":441},[431,606,452],{"class":437},[431,608,442],{"class":589},[431,610,611],{"class":592},"greet",[431,613,449],{"class":589},[431,615,459],{"class":437},[431,617,442],{"class":441},[431,619,521],{"class":581},[431,621,449],{"class":441},[431,623,452],{"class":437},[431,625,442],{"class":589},[431,627,536],{"class":592},[431,629,449],{"class":589},[431,631,459],{"class":437},[431,633,635],{"class":634},"srjyR"," ...",[431,637,638],{"class":437}," }",[431,640,641],{"class":437}," ]",[431,643,475],{"class":437},[167,645,648],{"className":646,"code":647,"language":172},[170],"GET \u002Fruns\u002F:id          → the RunRecord, or 404\nGET \u002Fruns\u002F:id?logFromOffset=N → { run, logChunk, logTotalLength } (incremental log read)\nDELETE \u002Fruns\u002F:id       → delete a finished run (404 unknown, 409 while active — cancel first)\nPOST \u002Fruns\u002F:id\u002Fretry   → re-run a run (404 if unknown, 409 if its task is gone)\nPOST \u002Fruns\u002F:id\u002Fcancel  → cancel an active run (404 unknown, 409 if already finished)\n",[154,649,647],{"__ignoreMap":175},[150,651,652,655,656,659,660,663,664,666,667,670,671,673],{},[154,653,654],{},"GET \u002Fruns\u002F:id?logFromOffset=N"," reads the log ",[186,657,658],{},"incrementally",":\ninstead of the full ",[154,661,662],{},"log"," snapshot, the response carries ",[154,665,325],{}," (the tail\nstarting at offset ",[154,668,669],{},"N",") and ",[154,672,329],{}," (the current total), so a UI can\npoll for growth while a run is still writing:",[167,675,678],{"className":676,"code":677,"language":172},[170],"GET \u002Fruns\u002Fab12cd34?logFromOffset=64\n→ { \"id\": \"ab12cd34\", ..., \"log\": null,\n     \"logChunk\": \"line2\\nline3\", \"logTotalLength\": 21 }\n",[154,679,677],{"__ignoreMap":175},[265,681,682,691,700],{},[268,683,684,685,688,689,229],{},"Offset ",[154,686,687],{},"0"," → the whole log as a chunk (same content as the full ",[154,690,662],{},[268,692,684,693,696,697,699],{},[154,694,695],{},"≥ logTotalLength"," → empty ",[154,698,325],{}," (the UI keeps polling).",[268,701,702,703,705],{},"Without the parameter the response is unchanged (full ",[154,704,662],{}," included).",[707,708,710],"h3",{"id":709},"manual-retry","Manual retry",[150,712,713,716,717,720,721,724,725,728,729,732,733,736],{},[154,714,715],{},"POST \u002Fruns\u002F:id\u002Fretry"," executes the run again through its runner (like the task\nactions below, it does not touch the schedule). The new run: ",[154,718,719],{},"data"," = the\noriginal run's snapshot, ",[154,722,723],{},"retryOf"," = the original id, ",[154,726,727],{},"trigger = 'manual'",",\n",[154,730,731],{},"temporary"," inherited from the original, ",[154,734,735],{},"triggeredBy"," fresh — who retries now\n(null when the body omits it). The original run is left untouched for audit.\nChains are allowed — a retry can itself be retried.",[150,738,739],{},"Accepts an optional JSON body to name the retry actor:",[167,741,744],{"className":742,"code":743,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fretry\nContent-Type: application\u002Fjson\n{ \"triggeredBy\": \"boss@books\" }\n",[154,745,743],{"__ignoreMap":175},[265,747,748],{},[268,749,750,752,753,303],{},[154,751,735],{}," — caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched does not verify it — caller-declared, audit-grade not\nauth-grade. Malformed \u002F non-object body → ",[154,754,755],{},"400",[167,757,760],{"className":758,"code":759,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fretry   → 200 { \"run\": { \"id\": \"ef56…\", \"retryOf\": \"ab12cd34\", \"trigger\": \"manual\", ... } }\n",[154,761,759],{"__ignoreMap":175},[707,763,765],{"id":764},"cancel","Cancel",[150,767,768,771],{},[154,769,770],{},"POST \u002Fruns\u002F:id\u002Fcancel"," stops an active run — the worker is\nreally stopped, not just re-labelled:",[167,773,776],{"className":774,"code":775,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fcancel   → 200 { \"run\": { \"id\": \"ab12cd34\", \"status\": \"cancelled\", ... } }\nPOST \u002Fruns\u002Fab12cd34\u002Fcancel   → 409 (already succeeded\u002Ffailed\u002Fcancelled)\nPOST \u002Fruns\u002Fnope\u002Fcancel       → 404\n",[154,777,775],{"__ignoreMap":175},[265,779,780,805,819],{},[268,781,782,784,785,788,789,792,793,797,798,800,801,804],{},[154,783,527],{}," (async, being polled) → the worker is told to stop first (when the\naccepted envelope advertised a ",[154,786,787],{},"cancelUrl",", sched POSTs ",[154,790,791],{},"{ runId }"," there — see\n",[222,794,796],{"href":795},"protocol#cancel","Runner protocol → Cancel","); then dropped from the poll queue,\nfinished ",[154,799,539],{},", schedule advanced, task lock released. A failed cancel\nsignal is recorded in the run's error (",[154,802,803],{},"cancel signal failed: \u003Creason>",") — the\nworker may still be running.",[268,806,807,809,810,813,814,818],{},[154,808,530],{}," (sync, in flight) → the runner is aborted via ",[154,811,812],{},"hooks.signal","\n(see ",[222,815,817],{"href":816},"runners\u002Fcustom#hookssignal-user-cancel","Custom runners → hooks.signal",");\nthe response is sent after the worker actually stopped.",[268,820,821,822,229],{},"A terminal run cannot be cancelled (",[154,823,824],{},"409",[150,826,827,830,831,834,835,837],{},[154,828,829],{},"DELETE \u002Fruns\u002F:id"," refuses an ",[186,832,833],{},"active"," run (",[154,836,824],{}," — cancel it first); finished\nruns delete normally.",[398,839,23],{"id":840},"tasks",[167,842,845],{"className":843,"code":844,"language":172},[170],"GET \u002Ftasks?limit=&offset=   → { \"tasks\": [...] } (name ASC, limit capped at 1000)\nGET \u002Ftasks\u002F:name            → one task, or 404\nPOST \u002Ftasks                 → create\u002Fupsert a task, returns { task } (201 created \u002F 200 updated)\n",[154,846,844],{"__ignoreMap":175},[707,848,850],{"id":849},"runtime-registration-post-tasks","Runtime registration — POST \u002Ftasks",[150,852,853,854,857,858,861,862,865],{},"Creates a task, or ",[186,855,856],{},"upserts"," an existing one (same semantics as ",[154,859,860],{},"tasks.json"," sync —\nthe body is a full ",[154,863,864],{},"TaskDefinition",", validated eagerly with the same fail-fast rules):",[167,867,870],{"className":868,"code":869,"language":172},[170],"POST \u002Ftasks\nContent-Type: application\u002Fjson\n\n{\n  \"name\": \"generate-thumbnail\",\n  \"runner\": \"http\",\n  \"schedules\": [{ \"cron\": \"0 9 * * *\" }],\n  \"config\": { \"url\": \"http:\u002F\u002Fworker\u002Fthumbnails\", \"method\": \"POST\" }\n}\n\n→ 201\n\n{ \"task\": { \"name\": \"generate-thumbnail\", ..., \"nextRunAt\": \"...\" } }\n",[154,871,869],{"__ignoreMap":175},[265,873,874,881,900,911,944],{},[268,875,876,877,880],{},"No daemon restart needed — the task is live immediately (a second POST with the same\nname updates it in place; schedule change recomputes ",[154,878,879],{},"nextRunAt"," from now).",[268,882,883,884,278,887,278,890,278,893,896,897,899],{},"Runtime state is preserved on upsert: ",[154,885,886],{},"paused",[154,888,889],{},"failCount",[154,891,892],{},"retryCount",[154,894,895],{},"disabled","\nand ",[154,898,879],{}," (unless the schedule changed) are never reset.",[268,901,902,903,905,906,908,909,303],{},"Validation failures → ",[154,904,755],{}," with the same messages ",[154,907,860],{}," uses (fail-fast — a\ntypo must not become silent failed runs). Malformed \u002F non-object body → ",[154,910,755],{},[268,912,913,915,916,920,921,924,925,927,928,932,933,936,937,940,941,303],{},[154,914,860],{}," remains the source of truth for ",[917,918,919],"em",{},"declared"," tasks; a task ",[186,922,923],{},"removed","\nfrom the file gets ",[186,926,895],{}," by the next sync (see\n",[222,929,931],{"href":930},"tasks#sync-semantics","Tasks → Sync semantics","). Runtime-registered tasks\n(",[154,934,935],{},"fileManaged: false",") are ",[186,938,939],{},"never"," disabled by sync — they live until removed\nvia ",[154,942,943],{},"DELETE \u002Ftasks\u002F:name",[268,945,946,947,950,951,229],{},"Embedded callers can register without HTTP: ",[154,948,949],{},"upsertTaskDefinition(storage, def, now)","\n(exported from ",[154,952,953],{},"@schedjs\u002Fcore",[150,955,956],{},"Actions (ad-hoc, do not touch the schedule):",[167,958,961],{"className":959,"code":960,"language":172},[170],"POST \u002Ftasks\u002F:name\u002Frun      → trigger the task now (engine.triggerTask), returns { run }\nDELETE \u002Ftasks\u002F:name        → remove a task (204), unknown → 404 (runtime tasks live until deleted)\nPOST \u002Ftasks\u002F:name\u002Fpause    → pause the task\nPOST \u002Ftasks\u002F:name\u002Fresume   → resume the task\n",[154,962,960],{"__ignoreMap":175},[150,964,965,968,969,972,973,976,977,979],{},[154,966,967],{},"triggerTask"," executes immediately through the runner and records run history — it works\nfor paused\u002Fdisabled tasks too (explicit manual trigger). A manual run updates the task's\n",[154,970,971],{},"lastRunId","\u002F",[154,974,975],{},"lastRunAt"," but never touches the schedule (",[154,978,879],{}," stays put).",[195,981,982],{},[150,983,984,985,988],{},"The call ",[186,986,987],{},"blocks until the run finishes"," for sync runners — the response is the\nterminal run. For long sync runs use a scheduled interval (or an async runner)\nif you need the HTTP call to return promptly.",[150,990,991,994,995,728,998,1001,1002,1005],{},[154,992,993],{},"POST \u002Ftasks\u002F:name\u002Frun"," accepts an optional JSON body to pick the run's retention class,\nname the caller, and override its parameters (otherwise the run is ",[154,996,997],{},"temporary: false",[154,999,1000],{},"triggeredBy: null"," with the task's default ",[154,1003,1004],{},"config.data","):",[167,1007,1010],{"className":1008,"code":1009,"language":172},[170],"POST \u002Ftasks\u002F:name\u002Frun\nContent-Type: application\u002Fjson\n{ \"temporary\": true, \"triggeredBy\": \"boss@books\", \"data\": { \"videoId\": \"v-42\" } }\n",[154,1011,1009],{"__ignoreMap":175},[265,1013,1014,1024,1036,1045],{},[268,1015,1016,1019,1020,229],{},[154,1017,1018],{},"temporary: true"," → short retention class (24h TTL, see ",[222,1021,1023],{"href":1022},"runs#retention","Runs → Retention",[268,1025,1026,1028,1029,1031,1032,1035],{},[154,1027,719],{}," → merged over the task's default ",[154,1030,1004],{}," (",[154,1033,1034],{},"{ ...config.data, ...data }",").\nThe worker is dispatched with the merged payload — the override reaches the\nrun's execution, not just the audit record.",[268,1037,1038,1040,1041,1044],{},[154,1039,735],{}," → caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched is identity-agnostic — it does not verify the value\n(caller-declared, audit-grade not auth-grade); embedded callers pass it to\n",[154,1042,1043],{},"triggerTask(name, { triggeredBy })"," directly.",[268,1046,1047,1048,303],{},"Malformed \u002F non-object body → ",[154,1049,755],{},[195,1051,1052],{},[150,1053,1054,1057,1058,1060,1061,1064,1065,1067],{},[154,1055,1056],{},"POST \u002Ftasks\u002F:name\u002Fschedule"," is ",[186,1059,923],{},": it answers ",[154,1062,1063],{},"404"," pointing at\n",[154,1066,336],{}," below. Imperative schedules are created there — one schedule\nper rule, each with its own data\u002Fpolicy.",[398,1069,1071],{"id":1070},"schedules-schedule-as-entity","Schedules (schedule-as-entity)",[167,1073,1076],{"className":1074,"code":1075,"language":172},[170],"POST   \u002Fschedules                → create\u002Fupsert, { schedule } — 201 created \u002F 200 updated\nGET    \u002Fschedules?limit=&offset= → { schedules } (id ASC, limit capped at 1000)\nGET    \u002Fschedules\u002F:id            → ScheduleRecord | 404\nDELETE \u002Fschedules\u002F:id            → 204 | 404 (remove a schedule; runs keep their history)\nPOST   \u002Fschedules\u002F:id\u002Fpause      → { ok } | 404\nPOST   \u002Fschedules\u002F:id\u002Fresume     → { ok } | 404\n",[154,1077,1075],{"__ignoreMap":175},[150,1079,1080,1081,1084,1085,1087,1088,1090],{},"A ",[186,1082,1083],{},"schedule"," is one firing rule of a task with its own ",[154,1086,719],{},"\u002Fpolicy — the\nentity that replaced the task's single ",[154,1089,1083],{}," field (one task, one\nschedule per channel).",[707,1092,336],{"id":1093},"post-schedules",[167,1095,1098],{"className":1096,"code":1097,"language":172},[170],"POST \u002Fschedules\nContent-Type: application\u002Fjson\n\n{\n  \"taskName\": \"sync-channel-stats\",\n  \"schedule\": {\n    \"cron\": \"0 9 * * *\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"externalId\": \"ada\",\n    \"dedupKey\": \"channel-ada\"\n  }\n}\n\n→ 201\n\n{\n  \"schedule\": {\n    \"id\": \"...uuid...\",\n    \"taskName\": \"sync-channel-stats\",\n    \"schedule\": { \"cron\": \"0 9 * * *\" },\n    \"tz\": \"UTC\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"nextRunAt\": \"...\",\n    \"fileManaged\": false,\n    ...\n  }\n}\n",[154,1099,1097],{"__ignoreMap":175},[265,1101,1102,1127,1146,1157],{},[268,1103,1104,1105,1108,1109,1111,1112,1114,1115,1118,1119,1122,1123,1126],{},"Body: ",[154,1106,1107],{},"{ taskName, schedule: { cron | interval | once, timezone?, data?, externalId?, dedupKey?, retry?, priority? }, tz? }"," — the ",[154,1110,1083],{}," object is the same shape as a\n",[154,1113,860],{}," schedules element. ",[154,1116,1117],{},"tz"," defaults to the ",[186,1120,1121],{},"task's"," timezone; an inner\n",[154,1124,1125],{},"timezone"," on cron overrides it.",[268,1128,1129,1134,1135,1138,1139,1142,1143,1145],{},[186,1130,1131,1133],{},[154,1132,343],{}," is the idempotent upsert handle",": a second POST with the same key updates\nthe existing schedule in place (its id is preserved) and answers ",[154,1136,1137],{},"200","; a fresh schedule\nanswers ",[154,1140,1141],{},"201",". Without a ",[154,1144,343],{}," every POST creates a new schedule.",[268,1147,1148,1149,1151,1152,1154,1155,303],{},"Validation is identical to ",[154,1150,860],{}," (fail-fast): unknown task → ",[154,1153,1063],{},"; a malformed\nschedule, bad tz, invalid policy → ",[154,1156,755],{},[268,1158,1159,1160,1031,1163,1165,1166,303],{},"Created schedules are ",[186,1161,1162],{},"runtime-owned",[154,1164,935],{},") — sync never disables\nthem; remove one with ",[154,1167,1168],{},"DELETE \u002Fschedules\u002F:id",[707,1170,1172],{"id":1171},"get-schedules","GET \u002Fschedules",[150,1174,1175,1176,1179],{},"Returns every schedule as a first-class row: ",[154,1177,1178],{},"id\u002FtaskName\u002Fschedule\u002Ftz\u002Fdata\u002FexternalId\u002F dedupKey\u002FnextRunAt\u002FlastRunAt\u002FlastRunId\u002FfailCount\u002FretryCount\u002Fpriority\u002Fretry\u002Fpaused\u002Fdisabled","\nplus two resolved fields (no N+1 — three reads total):",[265,1181,1182,1192],{},[268,1183,1184,1187,1188,1191],{},[154,1185,1186],{},"lastRunStatus"," — how the schedule's most recent run ended (",[154,1189,1190],{},"null"," when it has no run,\nor its last run fell out of the recent window; listRuns is recent-first, capped at 1000).",[268,1193,1194,1108,1197,1200,1201,1204,1205,1208,1209,1212],{},[154,1195,1196],{},"effectiveStatus",[186,1198,1199],{},"AND-semantics made visible",": ",[154,1202,1203],{},"'paused-task'","\n(the family stop holds), ",[154,1206,1207],{},"'paused-schedule'"," (only this instance), or ",[154,1210,1211],{},"'active'",". The UI\nrenders 🔴 for paused-task and 🟡 for paused-schedule, so «снял паузу, а оно молчит»\nnever happens.",[167,1214,1216],{"className":425,"code":1215,"language":427,"meta":175,"style":175},"{\n  \"schedules\": [\n    { \"id\": \"channel-ada\", \"taskName\": \"sync-channel-stats\", \"schedule\": { \"cron\": \"0 9 * * *\" },\n      \"tz\": \"UTC\", \"data\": { \"channelId\": \"UC-ada\" }, \"nextRunAt\": \"...\", \"lastRunAt\": null,\n      \"lastRunId\": null, \"lastRunStatus\": null, \"failCount\": 0, \"retryCount\": 0,\n      \"priority\": 0, \"retry\": null, \"paused\": false, \"disabled\": false,\n      \"effectiveStatus\": \"active\" }\n  ]\n}\n",[154,1217,1218,1223,1238,1308,1387,1439,1493,1512,1518],{"__ignoreMap":175},[431,1219,1220],{"class":433,"line":434},[431,1221,1222],{"class":437},"{\n",[431,1224,1225,1228,1231,1233,1235],{"class":433,"line":21},[431,1226,1227],{"class":441},"  \"",[431,1229,1230],{"class":445},"schedules",[431,1232,449],{"class":441},[431,1234,452],{"class":437},[431,1236,1237],{"class":437}," [\n",[431,1239,1241,1244,1246,1248,1250,1252,1254,1257,1259,1261,1263,1265,1267,1269,1271,1274,1276,1278,1280,1282,1284,1286,1288,1290,1294,1296,1298,1300,1303,1305],{"class":433,"line":1240},3,[431,1242,1243],{"class":437},"    {",[431,1245,442],{"class":441},[431,1247,582],{"class":581},[431,1249,449],{"class":441},[431,1251,452],{"class":437},[431,1253,442],{"class":589},[431,1255,1256],{"class":592},"channel-ada",[431,1258,449],{"class":589},[431,1260,459],{"class":437},[431,1262,442],{"class":441},[431,1264,602],{"class":581},[431,1266,449],{"class":441},[431,1268,452],{"class":437},[431,1270,442],{"class":589},[431,1272,1273],{"class":592},"sync-channel-stats",[431,1275,449],{"class":589},[431,1277,459],{"class":437},[431,1279,442],{"class":441},[431,1281,1083],{"class":581},[431,1283,449],{"class":441},[431,1285,452],{"class":437},[431,1287,576],{"class":437},[431,1289