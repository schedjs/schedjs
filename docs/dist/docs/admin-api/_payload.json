alse,{"title":71,"path":72,"stem":73,"children":74},"Storage","\u002Fdocs\u002Fstorage","docs\u002F07.storage\u002Findex",[75,77,99],{"title":76,"path":72,"stem":73},"Overview",{"title":78,"icon":79,"path":80,"stem":81,"children":82,"page":69},"Storage adapters","i-custom-database","\u002Fdocs\u002Fstorage\u002Fadapters","docs\u002F07.storage\u002F01.adapters",[83,87,91,95],{"title":84,"path":85,"stem":86},"SQLite (default)","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fsqlite","docs\u002F07.storage\u002F01.adapters\u002F01.sqlite",{"title":88,"path":89,"stem":90},"MySQL \u002F MariaDB","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmysql","docs\u002F07.storage\u002F01.adapters\u002F02.mysql",{"title":92,"path":93,"stem":94},"Postgres","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fpostgres","docs\u002F07.storage\u002F01.adapters\u002F03.postgres",{"title":96,"path":97,"stem":98},"Mongo","\u002Fdocs\u002Fstorage\u002Fadapters\u002Fmongo","docs\u002F07.storage\u002F01.adapters\u002F04.mongo",{"title":100,"path":101,"stem":102,"children":103},"Build your own adapter","\u002Fdocs\u002Fstorage\u002Fcustom","docs\u002F07.storage\u002F09.custom",[104],{"title":105,"path":106,"stem":107},"Memory storage","\u002Fdocs\u002Fstorage\u002Fcustom\u002Fmemory-storage","docs\u002F07.storage\u002Fcustom\u002F01.memory-storage",{"title":109,"path":110,"stem":111},"Logging & observability","\u002Fdocs\u002Flogging","docs\u002F08.logging",{"title":113,"path":114,"stem":115},"Admin API","\u002Fdocs\u002Fadmin-api","docs\u002F09.admin-api",{"title":117,"path":118,"stem":119,"order":120,"badge":121},"Admin UI","\u002Fdocs\u002Fui","docs\u002F10.ui",10,{"label":122,"color":123},"PRE","warning",{"title":125,"path":126,"stem":127},"MCP server","\u002Fdocs\u002Fmcp","docs\u002F11.mcp",{"title":129,"path":130,"stem":131},"CLI & daemon","\u002Fdocs\u002Fcli","docs\u002F12.cli",{"title":133,"path":134,"stem":135},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F13.self-hosting",{"title":137,"path":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":113,"body":142,"description":1623,"extension":1624,"links":1625,"meta":1626,"navigation":1627,"path":114,"seo":1628,"stem":115,"__hash__":1629},"docs\u002Fdocs\u002F09.admin-api.md",{"type":143,"value":144,"toc":1608},"minimark",[145,162,172,179,190,341,368,393,398,404,419,472,475,481,550,640,646,670,676,702,707,733,736,742,752,758,762,768,774,821,834,837,843,847,862,868,950,953,959,976,985,1002,1008,1046,1064,1068,1074,1087,1090,1096,1165,1169,1176,1209,1520,1561,1578,1582,1604],[146,147,148,149,153,154,157,158,161],"p",{},"The daemon serves a small JSON API under ",[150,151,152],"code",{},"--admin-port"," (mount point ",[150,155,156],{},"\u002Fapi","). Bearer auth\nis required when ",[150,159,160],{},"SCHED_ADMIN_KEY"," is set:",[163,164,169],"pre",{"className":165,"code":167,"language":168},[166],"language-text","Authorization: Bearer \u003CSCHED_ADMIN_KEY>\n","text",[150,170,167],{"__ignoreMap":171},"",[146,173,174,175,178],{},"Unauthenticated requests get ",[150,176,177],{},"401 { \"error\": \"unauthorized\" }",". When no key is configured,\nthe API is open (bind to a private host in that case).",[146,180,181,189],{},[182,183,184,185,188],"strong",{},"Exception: ",[150,186,187],{},"GET \u002Fhealth"," is always open"," — even with a key configured, the health\nprobe answers without credentials (compose healthchecks \u002F LB probes carry none, and the\npayload has no secrets). Every other route 401s without the key.",[191,192,193,211,226,254,260],"blockquote",{},[146,194,195,198,199,202,203,206,207,210],{},[182,196,197],{},"Machine-readable contract."," An OpenAPI 3.1 spec ships with the server package:\n",[150,200,201],{},"@schedjs\u002Fadmin-api\u002Fopenapi.json"," — generate a client in any language with\n",[150,204,205],{},"openapi-generator"," \u002F ",[150,208,209],{},"kiota"," \u002F fern. The spec is route-parity-tested against the\nrouter (every documented path is exercised; a removed route fails the suite).",[146,212,213,216,217,221,222,225],{},[182,214,215],{},"Download without running anything:"," the same file is served by this docs site at\n",[218,219,220],"a",{"href":220},"\u002Fopenapi.json"," (byte-identical to the package spec, guarded by\n",[150,223,224],{},"packages\u002Fadmin-api\u002Ftest\u002Fts-client-guard.test.ts",").",[146,227,228,231,232,234,235,238,239,242,243,245,246,249,250,253],{},[182,229,230],{},"Verified flavors:"," Python (",[150,233,205],{}," 7.24.0, suite\n24\u002F24 + smoke 19\u002F19 against a live daemon) and TypeScript (",[150,236,237],{},"typescript-axios",",\ncompiles clean under ",[150,240,241],{},"tsc --strict","; pinned spec copies are byte-identical to the\npackage one, guarded by ",[150,244,224],{},"). Two\ngenerator families over one spec — the 3.1 nullable unions\n(",[150,247,248],{},"type: [..., \"null\"]",") map to ",[150,251,252],{},"string | null"," in both.",[146,255,256,259],{},[182,257,258],{},"Generator-compatible shapes:","**",[261,262,263,282,300,313,327],"ul",{},[264,265,266,267,270,271,274,275,274,278,281],"li",{},"Mutations return ",[182,268,269],{},"wrapped"," records — ",[150,272,273],{},"{ task }",", ",[150,276,277],{},"{ run }",[150,279,280],{},"{ schedule }"," —\nsingular GETs return the bare record; the spec declares exactly that.",[264,283,284,287,288,291,292,295,296,299],{},[150,285,286],{},"Schedule"," is a ",[182,289,290],{},"flat output schema"," (kind + optional cron\u002Ftimezone\u002Fms\u002Fat) —\none-shot rules normalize to ",[150,293,294],{},"{ kind: \"once\", at }",", intervals to ",[150,297,298],{},"{ kind: \"interval\", ms }",".",[264,301,302,303,306,307,309,310,225],{},"No ",[150,304,305],{},"const: true"," \u002F no oneOf+discriminator — constructs that make ",[150,308,205],{},"\nemit broken models (string-enums for booleans, ",[150,311,312],{},"actual_instance=None",[264,314,315,318,319,322,323,326],{},[150,316,317],{},"GET \u002Fruns\u002F{id}?logFromOffset=N"," declares the incremental-chunk shape\n(",[150,320,321],{},"logChunk"," + ",[150,324,325],{},"logTotalLength"," alongside the run).",[264,328,329,330,206,333,336,337,340],{},"Unknown top-level body fields on ",[150,331,332],{},"POST \u002Fschedules",[150,334,335],{},"PATCH \u002Fschedules\u002F{id}","\nare rejected with 400 (fail-fast) — a silent-ignored ",[150,338,339],{},"dedupKey"," used to create\na duplicate schedule.",[191,342,343],{},[146,344,345,348,349,352,353,356,357,360,361,363,364,367],{},[182,346,347],{},"Cache control."," Every JSON response is sent with ",[150,350,351],{},"Cache-Control: no-store"," (and the\nartifact proxy with ",[150,354,355],{},"no-cache","), so the browser never serves a cached snapshot of a run.\nThe standalone UI (",[150,358,359],{},"sched-ui serve",") additionally forces ",[150,362,355],{}," on its ",[150,365,366],{},"\u002Fapi\u002F*"," proxy\nresponses. If a browser still shows a stale list, hard-refresh (Ctrl+F5) once.",[191,369,370],{},[146,371,372,373,376,377,380,381,384,385,388,389,392],{},"The same API is available to embedded apps: ",[150,374,375],{},"createAdminApi"," from ",[150,378,379],{},"@schedjs\u002Fadmin-api","\nreturns an ",[150,382,383],{},"AdminApi"," whose ",[150,386,387],{},"handleRequest(req, res)"," you can mount at any path\n(see ",[218,390,117],{"href":391},"ui"," § Embedded apps).",[394,395,397],"h2",{"id":396},"health","Health",[163,399,402],{"className":400,"code":401,"language":168},[166],"GET \u002Fapi\u002Fhealth   → { \"ok\": true, \"uptimeMs\": 1234, \"version\": \"0.16.0\" }\n",[150,403,401],{"__ignoreMap":171},[146,405,406,409,410,412,413,415,416,418],{},[150,407,408],{},"version"," is the daemon's own package version (falls back to ",[150,411,379],{}," for\nembedded hosts — pass ",[150,414,408],{}," to ",[150,417,375],{}," to override).",[163,420,424],{"className":421,"code":422,"language":423,"meta":171,"style":171},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"ok\": true, \"uptimeMs\": 123456 }\n","json",[150,425,426],{"__ignoreMap":171},[427,428,431,435,439,443,446,449,453,456,458,461,463,465,469],"span",{"class":429,"line":430},"line",1,[427,432,434],{"class":433},"soVBu","{",[427,436,438],{"class":437},"s4Jsk"," \"",[427,440,442],{"class":441},"sLorS","ok",[427,444,445],{"class":437},"\"",[427,447,448],{"class":433},":",[427,450,452],{"class":451},"s8XtY"," true",[427,454,455],{"class":433},",",[427,457,438],{"class":437},[427,459,460],{"class":441},"uptimeMs",[427,462,445],{"class":437},[427,464,448],{"class":433},[427,466,468],{"class":467},"s7CZa"," 123456",[427,470,471],{"class":433}," }\n",[394,473,23],{"id":474},"runs",[163,476,479],{"className":477,"code":478,"language":168},[166],"GET \u002Fruns?task=greet&status=failed&limit=20&offset=0\n",[150,480,478],{"__ignoreMap":171},[482,483,484,497],"table",{},[485,486,487],"thead",{},[488,489,490,494],"tr",{},[491,492,493],"th",{},"Query",[491,495,496],{},"Description",[498,499,500,511,537],"tbody",{},[488,501,502,508],{},[503,504,505],"td",{},[150,506,507],{},"task",[503,509,510],{},"filter by task name",[488,512,513,518],{},[503,514,515],{},[150,516,517],{},"status",[503,519,520,521,206,524,206,527,206,530,206,533,536],{},"filter by status (",[150,522,523],{},"queued",[150,525,526],{},"running",[150,528,529],{},"succeeded",[150,531,532],{},"failed",[150,534,535],{},"cancelled",")",[488,538,539,547],{},[503,540,541,274,544],{},[150,542,543],{},"limit",[150,545,546],{},"offset",[503,548,549],{},"pagination",[163,551,553],{"className":421,"code":552,"language":423,"meta":171,"style":171},"{ \"runs\": [ { \"id\": \"...\", \"taskName\": \"greet\", \"status\": \"failed\", ... } ] }\n",[150,554,555],{"__ignoreMap":171},[427,556,557,559,561,563,565,567,570,573,575,579,581,583,586,590,592,594,596,599,601,603,605,608,610,612,614,616,618,620,622,624,626,628,632,635,638],{"class":429,"line":430},[427,558,434],{"class":433},[427,560,438],{"class":437},[427,562,474],{"class":441},[427,564,445],{"class":437},[427,566,448],{"class":433},[427,568,569],{"class":433}," [",[427,571,572],{"class":433}," {",[427,574,438],{"class":437},[427,576,578],{"class":577},"sa2tF","id",[427,580,445],{"class":437},[427,582,448],{"class":433},[427,584,438],{"class":585},"sbYkP",[427,587,589],{"class":588},"sTbE_","...",[427,591,445],{"class":585},[427,593,455],{"class":433},[427,595,438],{"class":437},[427,597,598],{"class":577},"taskName",[427,600,445],{"class":437},[427,602,448],{"class":433},[427,604,438],{"class":585},[427,606,607],{"class":588},"greet",[427,609,445],{"class":585},[427,611,455],{"class":433},[427,613,438],{"class":437},[427,615,517],{"class":577},[427,617,445],{"class":437},[427,619,448],{"class":433},[427,621,438],{"class":585},[427,623,532],{"class":588},[427,625,445],{"class":585},[427,627,455],{"class":433},[427,629,631],{"class":630},"srjyR"," ...",[427,633,634],{"class":433}," }",[427,636,637],{"class":433}," ]",[427,639,471],{"class":433},[163,641,644],{"className":642,"code":643,"language":168},[166],"GET \u002Fruns\u002F:id          → the RunRecord, or 404\nGET \u002Fruns\u002F:id?logFromOffset=N → { run, logChunk, logTotalLength } (incremental log read)\nDELETE \u002Fruns\u002F:id       → delete a finished run (404 unknown, 409 while active — cancel first)\nPOST \u002Fruns\u002F:id\u002Fretry   → re-run a run (404 if unknown, 409 if its task is gone)\nPOST \u002Fruns\u002F:id\u002Fcancel  → cancel an active run (404 unknown, 409 if already finished)\n",[150,645,643],{"__ignoreMap":171},[146,647,648,651,652,655,656,659,660,662,663,666,667,669],{},[150,649,650],{},"GET \u002Fruns\u002F:id?logFromOffset=N"," reads the log ",[182,653,654],{},"incrementally",":\ninstead of the full ",[150,657,658],{},"log"," snapshot, the response carries ",[150,661,321],{}," (the tail\nstarting at offset ",[150,664,665],{},"N",") and ",[150,668,325],{}," (the current total), so a UI can\npoll for growth while a run is still writing:",[163,671,674],{"className":672,"code":673,"language":168},[166],"GET \u002Fruns\u002Fab12cd34?logFromOffset=64\n→ { \"id\": \"ab12cd34\", ..., \"log\": null,\n     \"logChunk\": \"line2\\nline3\", \"logTotalLength\": 21 }\n",[150,675,673],{"__ignoreMap":171},[261,677,678,687,696],{},[264,679,680,681,684,685,225],{},"Offset ",[150,682,683],{},"0"," → the whole log as a chunk (same content as the full ",[150,686,658],{},[264,688,680,689,692,693,695],{},[150,690,691],{},"≥ logTotalLength"," → empty ",[150,694,321],{}," (the UI keeps polling).",[264,697,698,699,701],{},"Without the parameter the response is unchanged (full ",[150,700,658],{}," included).",[703,704,706],"h3",{"id":705},"manual-retry","Manual retry",[146,708,709,712,713,716,717,720,721,724,725,728,729,732],{},[150,710,711],{},"POST \u002Fruns\u002F:id\u002Fretry"," executes the run again through its runner (like the task\nactions below, it does not touch the schedule). The new run: ",[150,714,715],{},"data"," = the\noriginal run's snapshot, ",[150,718,719],{},"retryOf"," = the original id, ",[150,722,723],{},"trigger = 'manual'",",\n",[150,726,727],{},"temporary"," inherited from the original, ",[150,730,731],{},"triggeredBy"," fresh — who retries now\n(null when the body omits it). The original run is left untouched for audit.\nChains are allowed — a retry can itself be retried.",[146,734,735],{},"Accepts an optional JSON body to name the retry actor:",[163,737,740],{"className":738,"code":739,"language":168},[166],"POST \u002Fruns\u002Fab12cd34\u002Fretry\nContent-Type: application\u002Fjson\n{ \"triggeredBy\": \"boss@books\" }\n",[150,741,739],{"__ignoreMap":171},[261,743,744],{},[264,745,746,748,749,299],{},[150,747,731],{}," — caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched does not verify it — caller-declared, audit-grade not\nauth-grade. Malformed \u002F non-object body → ",[150,750,751],{},"400",[163,753,756],{"className":754,"code":755,"language":168},[166],"POST \u002Fruns\u002Fab12cd34\u002Fretry   → 200 { \"run\": { \"id\": \"ef56…\", \"retryOf\": \"ab12cd34\", \"trigger\": \"manual\", ... } }\n",[150,757,755],{"__ignoreMap":171},[703,759,761],{"id":760},"cancel","Cancel",[146,763,764,767],{},[150,765,766],{},"POST \u002Fruns\u002F:id\u002Fcancel"," stops an active run — the worker is\nreally stopped, not just re-labelled:",[163,769,772],{"className":770,"code":771,"language":168},[166],"POST \u002Fruns\u002Fab12cd34\u002Fcancel   → 200 { \"run\": { \"id\": \"ab12cd34\", \"status\": \"cancelled\", ... } }\nPOST \u002Fruns\u002Fab12cd34\u002Fcancel   → 409 (already succeeded\u002Ffailed\u002Fcancelled)\nPOST \u002Fruns\u002Fnope\u002Fcancel       → 404\n",[150,773,771],{"__ignoreMap":171},[261,775,776,801,815],{},[264,777,778,780,781,784,785,788,789,793,794,796,797,800],{},[150,779,523],{}," (async, being polled) → the worker is told to stop first (when the\naccepted envelope advertised a ",[150,782,783],{},"cancelUrl",", sched POSTs ",[150,786,787],{},"{ runId }"," there — see\n",[218,790,792],{"href":791},"protocol#cancel","Runner protocol → Cancel","); then dropped from the poll queue,\nfinished ",[150,795,535],{},", schedule advanced, task lock released. A failed cancel\nsignal is recorded in the run's error (",[150,798,799],{},"cancel signal failed: \u003Creason>",") — the\nworker may still be running.",[264,802,803,805,806,809,810,814],{},[150,804,526],{}," (sync, in flight) → the runner is aborted via ",[150,807,808],{},"hooks.signal","\n(see ",[218,811,813],{"href":812},"runners\u002Fcustom#hookssignal-user-cancel","Custom runners → hooks.signal",");\nthe response is sent after the worker actually stopped.",[264,816,817,818,225],{},"A terminal run cannot be cancelled (",[150,819,820],{},"409",[146,822,823,826,827,830,831,833],{},[150,824,825],{},"DELETE \u002Fruns\u002F:id"," refuses an ",[182,828,829],{},"active"," run (",[150,832,820],{}," — cancel it first); finished\nruns delete normally.",[394,835,19],{"id":836},"tasks",[163,838,841],{"className":839,"code":840,"language":168},[166],"GET \u002Ftasks?limit=&offset=   → { \"tasks\": [...] } (name ASC, limit capped at 1000)\nGET \u002Ftasks\u002F:name            → one task, or 404\nPOST \u002Ftasks                 → create\u002Fupsert a task, returns { task } (201 created \u002F 200 updated)\n",[150,842,840],{"__ignoreMap":171},[703,844,846],{"id":845},"runtime-registration-post-tasks","Runtime registration — POST \u002Ftasks",[146,848,849,850,853,854,857,858,861],{},"Creates a task, or ",[182,851,852],{},"upserts"," an existing one (same semantics as ",[150,855,856],{},"tasks.json"," sync —\nthe body is a full ",[150,859,860],{},"TaskDefinition",", validated eagerly with the same fail-fast rules):",[163,863,866],{"className":864,"code":865,"language":168},[166],"POST \u002Ftasks\nContent-Type: application\u002Fjson\n\n{\n  \"name\": \"generate-thumbnail\",\n  \"runner\": \"http\",\n  \"schedules\": [{ \"cron\": \"0 9 * * *\" }],\n  \"config\": { \"url\": \"http:\u002F\u002Fworker\u002Fthumbnails\", \"method\": \"POST\" }\n}\n\n→ 201\n\n{ \"task\": { \"name\": \"generate-thumbnail\", ..., \"nextRunAt\": \"...\" } }\n",[150,867,865],{"__ignoreMap":171},[261,869,870,877,896,907,940],{},[264,871,872,873,876],{},"No daemon restart needed — the task is live immediately (a second POST with the same\nname updates it in place; schedule change recomputes ",[150,874,875],{},"nextRunAt"," from now).",[264,878,879,880,274,883,274,886,274,889,892,893,895],{},"Runtime state is preserved on upsert: ",[150,881,882],{},"paused",[150,884,885],{},"failCount",[150,887,888],{},"retryCount",[150,890,891],{},"disabled","\nand ",[150,894,875],{}," (unless the schedule changed) are never reset.",[264,897,898,899,901,902,904,905,299],{},"Validation failures → ",[150,900,751],{}," with the same messages ",[150,903,856],{}," uses (fail-fast — a\ntypo must not become silent failed runs). Malformed \u002F non-object body → ",[150,906,751],{},[264,908,909,911,912,916,917,920,921,923,924,928,929,932,933,936,937,299],{},[150,910,856],{}," remains the source of truth for ",[913,914,915],"em",{},"declared"," tasks; a task ",[182,918,919],{},"removed","\nfrom the file gets ",[182,922,891],{}," by the next sync (see\n",[218,925,927],{"href":926},"tasks#sync-semantics","Tasks → Sync semantics","). Runtime-registered tasks\n(",[150,930,931],{},"fileManaged: false",") are ",[182,934,935],{},"never"," disabled by sync — they live until removed\nvia ",[150,938,939],{},"DELETE \u002Ftasks\u002F:name",[264,941,942,943,946,947,225],{},"Embedded callers can register without HTTP: ",[150,944,945],{},"upsertTaskDefinition(storage, def, now)","\n(exported from ",[150,948,949],{},"@schedjs\u002Fcore",[146,951,952],{},"Actions (ad-hoc, do not touch the schedule):",[163,954,957],{"className":955,"code":956,"language":168},[166],"POST \u002Ftasks\u002F:name\u002Frun      → trigger the task now (engine.triggerTask), returns { run }\nDELETE \u002Ftasks\u002F:name        → remove a task (204), unknown → 404 (runtime tasks live until deleted)\nPOST \u002Ftasks\u002F:name\u002Fpause    → pause the task\nPOST \u002Ftasks\u002F:name\u002Fresume   → resume the task\n",[150,958,956],{"__ignoreMap":171},[146,960,961,964,965,968,969,972,973,975],{},[150,962,963],{},"triggerTask"," executes immediately through the runner and records run history — it works\nfor paused\u002Fdisabled tasks too (explicit manual trigger). A manual run updates the task's\n",[150,966,967],{},"lastRunId","\u002F",[150,970,971],{},"lastRunAt"," but never touches the schedule (",[150,974,875],{}," stays put).",[191,977,978],{},[146,979,980,981,984],{},"The call ",[182,982,983],{},"blocks until the run finishes"," for sync runners — the response is the\nterminal run. For long sync runs use a scheduled interval (or an async runner)\nif you need the HTTP call to return promptly.",[146,986,987,990,991,724,994,997,998,1001],{},[150,988,989],{},"POST \u002Ftasks\u002F:name\u002Frun"," accepts an optional JSON body to pick the run's retention class,\nname the caller, and override its parameters (otherwise the run is ",[150,992,993],{},"temporary: false",[150,995,996],{},"triggeredBy: null"," with the task's default ",[150,999,1000],{},"config.data","):",[163,1003,1006],{"className":1004,"code":1005,"language":168},[166],"POST \u002Ftasks\u002F:name\u002Frun\nContent-Type: application\u002Fjson\n{ \"temporary\": true, \"triggeredBy\": \"boss@books\", \"data\": { \"videoId\": \"v-42\" } }\n",[150,1007,1005],{"__ignoreMap":171},[261,1009,1010,1020,1032,1041],{},[264,1011,1012,1015,1016,225],{},[150,1013,1014],{},"temporary: true"," → short retention class (24h TTL, see ",[218,1017,1019],{"href":1018},"runs#retention","Runs → Retention",[264,1021,1022,1024,1025,1027,1028,1031],{},[150,1023,715],{}," → merged over the task's default ",[150,1026,1000],{}," (",[150,1029,1030],{},"{ ...config.data, ...data }",").\nThe worker is dispatched with the merged payload — the override reaches the\nrun's execution, not just the audit record.",[264,1033,1034,1036,1037,1040],{},[150,1035,731],{}," → caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched is identity-agnostic — it does not verify the value\n(caller-declared, audit-grade not auth-grade); embedded callers pass it to\n",[150,1038,1039],{},"triggerTask(name, { triggeredBy })"," directly.",[264,1042,1043,1044,299],{},"Malformed \u002F non-object body → ",[150,1045,751],{},[191,1047,1048],{},[146,1049,1050,1053,1054,1056,1057,1060,1061,1063],{},[150,1051,1052],{},"POST \u002Ftasks\u002F:name\u002Fschedule"," is ",[182,1055,919],{},": it answers ",[150,1058,1059],{},"404"," pointing at\n",[150,1062,332],{}," below. Imperative schedules are created there — one schedule\nper rule, each with its own data\u002Fpolicy.",[394,1065,1067],{"id":1066},"schedules-schedule-as-entity","Schedules (schedule-as-entity)",[163,1069,1072],{"className":1070,"code":1071,"language":168},[166],"POST   \u002Fschedules                → create\u002Fupsert, { schedule } — 201 created \u002F 200 updated\nGET    \u002Fschedules?limit=&offset= → { schedules } (id ASC, limit capped at 1000)\nGET    \u002Fschedules\u002F:id            → ScheduleRecord | 404\nDELETE \u002Fschedules\u002F:id            → 204 | 404 (remove a schedule; runs keep their history)\nPOST   \u002Fschedules\u002F:id\u002Fpause      → { ok } | 404\nPOST   \u002Fschedules\u002F:id\u002Fresume     → { ok } | 404\n",[150,1073,1071],{"__ignoreMap":171},[146,1075,1076,1077,1080,1081,1083,1084,1086],{},"A ",[182,1078,1079],{},"schedule"," is one firing rule of a task with its own ",[150,1082,715],{},"\u002Fpolicy — the\nentity that replaced the task's single ",[150,1085,1079],{}," field (one task, one\nschedule per channel).",[703,1088,332],{"id":1089},"post-schedules",[163,1091,1094],{"className":1092,"code":1093,"language":168},[166],"POST \u002Fschedules\nContent-Type: application\u002Fjson\n\n{\n  \"taskName\": \"sync-channel-stats\",\n  \"schedule\": {\n    \"cron\": \"0 9 * * *\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"externalId\": \"ada\",\n    \"dedupKey\": \"channel-ada\"\n  }\n}\n\n→ 201\n\n{\n  \"schedule\": {\n    \"id\": \"...uuid...\",\n    \"taskName\": \"sync-channel-stats\",\n    \"schedule\": { \"cron\": \"0 9 * * *\" },\n    \"tz\": \"UTC\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"nextRunAt\": \"...\",\n    \"fileManaged\": false,\n    ...\n  }\n}\n",[150,1095,1093],{"__ignoreMap":171},[261,1097,1098,1123,1142,1153],{},[264,1099,1100,1101,1104,1105,1107,1108,1110,1111,1114,1115,1118,1119,1122],{},"Body: ",[150,1102,1103],{},"{ taskName, schedule: { cron | interval | once, timezone?, data?, externalId?, dedupKey?, retry?, priority? }, tz? }"," — the ",[150,1106,1079],{}," object is the same shape as a\n",[150,1109,856],{}," schedules element. ",[150,1112,1113],{},"tz"," defaults to the ",[182,1116,1117],{},"task's"," timezone; an inner\n",[150,1120,1121],{},"timezone"," on cron overrides it.",[264,1124,1125,1130,1131,1134,1135,1138,1139,1141],{},[182,1126,1127,1129],{},[150,1128,339],{}," is the idempotent upsert handle",": a second POST with the same key updates\nthe existing schedule in place (its id is preserved) and answers ",[150,1132,1133],{},"200","; a fresh schedule\nanswers ",[150,1136,1137],{},"201",". Without a ",[150,1140,339],{}," every POST creates a new schedule.",[264,1143,1144,1145,1147,1148,1150,1151,299],{},"Validation is identical to ",[150,1146,856],{}," (fail-fast): unknown task → ",[150,1149,1059],{},"; a malformed\nschedule, bad tz, invalid policy → ",[150,1152,751],{},[264,1154,1155,1156,1027,1159,1161,1162,299],{},"Created schedules are ",[182,1157,1158],{},"runtime-owned",[150,1160,931],{},") — sync never disables\nthem; remove one with ",[150,1163,1164],{},"DELETE \u002Fschedules\u002F:id",[703,1166,1168],{"id":1167},"get-schedules","GET \u002Fschedules",[146,1170,1171,1172,1175],{},"Returns every schedule as a first-class row: ",[150,1173,1174],{},"id\u002FtaskName\u002Fschedule\u002Ftz\u002Fdata\u002FexternalId\u002F dedupKey\u002FnextRunAt\u002FlastRunAt\u002FlastRunId\u002FfailCount\u002FretryCount\u002Fpriority\u002Fretry\u002Fpaused\u002Fdisabled","\nplus two resolved fields (no N+1 — three reads total):",[261,1177,1178,1188],{},[264,1179,1180,1183,1184,1187],{},[150,1181,1182],{},"lastRunStatus"," — how the schedule's most recent run ended (",[150,1185,1186],{},"null"," when it has no run,\nor its last run fell out of the recent window; listRuns is recent-first, capped at 1000).",[264,1189,1190,1104,1193,1196,1197,1200,1201,1204,1205,1208],{},[150,1191,1192],{},"effectiveStatus",[182,1194,1195],{},"AND-semantics made visible",": ",[150,1198,1199],{},"'paused-task'","\n(the family stop holds), ",[150,1202,1203],{},"'paused-schedule'"," (only this instance), or ",[150,1206,1207],{},"'active'",". The UI\nrenders 🔴 for paused-task and 🟡 for paused-schedule, so «снял паузу, а оно молчит»\nnever happens.",[163,1210,1212],{"className":421,"code":1211,"language":423,"meta":171,"style":171},"{\n  \"schedules\": [\n    { \"id\": \"channel-ada\", \"taskName\": \"sync-channel-stats\", \"schedule\": { \"cron\": \"0 9 * * *\" },\n      \"tz\": \"UTC\", \"data\": { \"channelId\": \"UC-ada\" }, \"nextRunAt\": \"...\", \"lastRunAt\": null,\n      \"lastRunId\": null, \"lastRunStatus\": null, \"failCount\": 0, \"retryCount\": 0,\n      \"priority\": 0, \"retry\": null, \"paused\": false, \"disabled\": false,\n      \"effectiveStatus\": \"active\" }\n  ]\n}\n",[150,1213,1214,1219,1234,1304,1383,1435,1489,1508,1514],{"__ignoreMap":171},[427,1215,1216],{"class":429,"line":430},[427,1217,1218],{"class":433},"{\n",[427,1220,1221,1224,1227,1229,1231],{"class":429,"line":17},[427,1222,1223],{"class":437},"  \"",[427,1225,1226],{"class":441},"schedules",[427,1228,445],{"class":437},[427,1230,448],{"class":433},[427,1232,1233],{"class":433}," [\n",[427,1235,1237,1240,1242,1244,1246,1248,1250,1253,1255,1257,1259,1261,1263,1265,1267,1270,1272,1274,1276,1278,1280,1282,1284,1286,1290,1292,1294,1296,1299,1301],{"class":429,"line":1236},3,[427,1238,1239],{"class":433},"    {",[427,1241,438],{"class":437},[427,1243,578],{"class":577},[427,1245,445],{"class":437},[427,1247,448],{"class":433},[427,1249,438],{"class":585},[427,1251,1252],{"class":588},"channel-ada",[427,1254,445],{"class":585},[427,1256,455],{"class":433},[427,1258,438],{"class":437},[427,1260,598],{"class":577},[427,1262,445],{"class":437},[427,1264,448],{"class":433},[427,1266,438],{"class":585},[427,1268,1269],{"class":588},"sync-channel-stats",[427,1271,445],{"class":585},[427,1273,455],{"class":433},[427,1275,438],{"class":437},[427,1277,1079],{"class":577},[427,1279,445],{"class":437},[427,1281,448],{"class":433},[427,1283,572],{"class":433},[427,1285,438],{"class":437},[427,1287,1289],{"class":1288},"skNjk","cron",[427,1291,445],{"class":437},[427,1293,448],{"