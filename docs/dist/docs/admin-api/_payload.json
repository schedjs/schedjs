body":137,"description":1618,"extension":1619,"links":1620,"meta":1621,"navigation":1622,"path":109,"seo":1623,"stem":110,"__hash__":1624},"docs\u002Fdocs\u002F09.admin-api.md",{"type":138,"value":139,"toc":1603},"minimark",[140,157,167,174,185,336,363,388,393,399,414,467,470,476,545,635,641,665,671,697,702,728,731,737,747,753,757,763,769,816,829,832,838,842,857,863,945,948,954,971,980,997,1003,1041,1059,1063,1069,1082,1085,1091,1160,1164,1171,1204,1515,1556,1573,1577,1599],[141,142,143,144,148,149,152,153,156],"p",{},"The daemon serves a small JSON API under ",[145,146,147],"code",{},"--admin-port"," (mount point ",[145,150,151],{},"\u002Fapi","). Bearer auth\nis required when ",[145,154,155],{},"SCHED_ADMIN_KEY"," is set:",[158,159,164],"pre",{"className":160,"code":162,"language":163},[161],"language-text","Authorization: Bearer \u003CSCHED_ADMIN_KEY>\n","text",[145,165,162],{"__ignoreMap":166},"",[141,168,169,170,173],{},"Unauthenticated requests get ",[145,171,172],{},"401 { \"error\": \"unauthorized\" }",". When no key is configured,\nthe API is open (bind to a private host in that case).",[141,175,176,184],{},[177,178,179,180,183],"strong",{},"Exception: ",[145,181,182],{},"GET \u002Fhealth"," is always open"," — even with a key configured, the health\nprobe answers without credentials (compose healthchecks \u002F LB probes carry none, and the\npayload has no secrets). Every other route 401s without the key.",[186,187,188,206,221,249,255],"blockquote",{},[141,189,190,193,194,197,198,201,202,205],{},[177,191,192],{},"Machine-readable contract."," An OpenAPI 3.1 spec ships with the server package:\n",[145,195,196],{},"@schedjs\u002Fadmin-api\u002Fopenapi.json"," — generate a client in any language with\n",[145,199,200],{},"openapi-generator"," \u002F ",[145,203,204],{},"kiota"," \u002F fern. The spec is route-parity-tested against the\nrouter (every documented path is exercised; a removed route fails the suite).",[141,207,208,211,212,216,217,220],{},[177,209,210],{},"Download without running anything:"," the same file is served by this docs site at\n",[213,214,215],"a",{"href":215},"\u002Fopenapi.json"," (byte-identical to the package spec, guarded by\n",[145,218,219],{},"packages\u002Fadmin-api\u002Ftest\u002Fts-client-guard.test.ts",").",[141,222,223,226,227,229,230,233,234,237,238,240,241,244,245,248],{},[177,224,225],{},"Verified flavors:"," Python (",[145,228,200],{}," 7.24.0, suite\n24\u002F24 + smoke 19\u002F19 against a live daemon) and TypeScript (",[145,231,232],{},"typescript-axios",",\ncompiles clean under ",[145,235,236],{},"tsc --strict","; pinned spec copies are byte-identical to the\npackage one, guarded by ",[145,239,219],{},"). Two\ngenerator families over one spec — the 3.1 nullable unions\n(",[145,242,243],{},"type: [..., \"null\"]",") map to ",[145,246,247],{},"string | null"," in both.",[141,250,251,254],{},[177,252,253],{},"Generator-compatible shapes:","**",[256,257,258,277,295,308,322],"ul",{},[259,260,261,262,265,266,269,270,269,273,276],"li",{},"Mutations return ",[177,263,264],{},"wrapped"," records — ",[145,267,268],{},"{ task }",", ",[145,271,272],{},"{ run }",[145,274,275],{},"{ schedule }"," —\nsingular GETs return the bare record; the spec declares exactly that.",[259,278,279,282,283,286,287,290,291,294],{},[145,280,281],{},"Schedule"," is a ",[177,284,285],{},"flat output schema"," (kind + optional cron\u002Ftimezone\u002Fms\u002Fat) —\none-shot rules normalize to ",[145,288,289],{},"{ kind: \"once\", at }",", intervals to ",[145,292,293],{},"{ kind: \"interval\", ms }",".",[259,296,297,298,301,302,304,305,220],{},"No ",[145,299,300],{},"const: true"," \u002F no oneOf+discriminator — constructs that make ",[145,303,200],{},"\nemit broken models (string-enums for booleans, ",[145,306,307],{},"actual_instance=None",[259,309,310,313,314,317,318,321],{},[145,311,312],{},"GET \u002Fruns\u002F{id}?logFromOffset=N"," declares the incremental-chunk shape\n(",[145,315,316],{},"logChunk"," + ",[145,319,320],{},"logTotalLength"," alongside the run).",[259,323,324,325,201,328,331,332,335],{},"Unknown top-level body fields on ",[145,326,327],{},"POST \u002Fschedules",[145,329,330],{},"PATCH \u002Fschedules\u002F{id}","\nare rejected with 400 (fail-fast) — a silent-ignored ",[145,333,334],{},"dedupKey"," used to create\na duplicate schedule.",[186,337,338],{},[141,339,340,343,344,347,348,351,352,355,356,358,359,362],{},[177,341,342],{},"Cache control."," Every JSON response is sent with ",[145,345,346],{},"Cache-Control: no-store"," (and the\nartifact proxy with ",[145,349,350],{},"no-cache","), so the browser never serves a cached snapshot of a run.\nThe standalone UI (",[145,353,354],{},"sched-ui serve",") additionally forces ",[145,357,350],{}," on its ",[145,360,361],{},"\u002Fapi\u002F*"," proxy\nresponses. If a browser still shows a stale list, hard-refresh (Ctrl+F5) once.",[186,364,365],{},[141,366,367,368,371,372,375,376,379,380,383,384,387],{},"The same API is available to embedded apps: ",[145,369,370],{},"createAdminApi"," from ",[145,373,374],{},"@schedjs\u002Fadmin-api","\nreturns an ",[145,377,378],{},"AdminApi"," whose ",[145,381,382],{},"handleRequest(req, res)"," you can mount at any path\n(see ",[213,385,112],{"href":386},"ui"," § Embedded apps).",[389,390,392],"h2",{"id":391},"health","Health",[158,394,397],{"className":395,"code":396,"language":163},[161],"GET \u002Fapi\u002Fhealth   → { \"ok\": true, \"uptimeMs\": 1234, \"version\": \"0.16.0\" }\n",[145,398,396],{"__ignoreMap":166},[141,400,401,404,405,407,408,410,411,413],{},[145,402,403],{},"version"," is the daemon's own package version (falls back to ",[145,406,374],{}," for\nembedded hosts — pass ",[145,409,403],{}," to ",[145,412,370],{}," to override).",[158,415,419],{"className":416,"code":417,"language":418,"meta":166,"style":166},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"ok\": true, \"uptimeMs\": 123456 }\n","json",[145,420,421],{"__ignoreMap":166},[422,423,426,430,434,438,441,444,448,451,453,456,458,460,464],"span",{"class":424,"line":425},"line",1,[422,427,429],{"class":428},"soVBu","{",[422,431,433],{"class":432},"s4Jsk"," \"",[422,435,437],{"class":436},"sLorS","ok",[422,439,440],{"class":432},"\"",[422,442,443],{"class":428},":",[422,445,447],{"class":446},"s8XtY"," true",[422,449,450],{"class":428},",",[422,452,433],{"class":432},[422,454,455],{"class":436},"uptimeMs",[422,457,440],{"class":432},[422,459,443],{"class":428},[422,461,463],{"class":462},"s7CZa"," 123456",[422,465,466],{"class":428}," }\n",[389,468,18],{"id":469},"runs",[158,471,474],{"className":472,"code":473,"language":163},[161],"GET \u002Fruns?task=greet&status=failed&limit=20&offset=0\n",[145,475,473],{"__ignoreMap":166},[477,478,479,492],"table",{},[480,481,482],"thead",{},[483,484,485,489],"tr",{},[486,487,488],"th",{},"Query",[486,490,491],{},"Description",[493,494,495,506,532],"tbody",{},[483,496,497,503],{},[498,499,500],"td",{},[145,501,502],{},"task",[498,504,505],{},"filter by task name",[483,507,508,513],{},[498,509,510],{},[145,511,512],{},"status",[498,514,515,516,201,519,201,522,201,525,201,528,531],{},"filter by status (",[145,517,518],{},"queued",[145,520,521],{},"running",[145,523,524],{},"succeeded",[145,526,527],{},"failed",[145,529,530],{},"cancelled",")",[483,533,534,542],{},[498,535,536,269,539],{},[145,537,538],{},"limit",[145,540,541],{},"offset",[498,543,544],{},"pagination",[158,546,548],{"className":416,"code":547,"language":418,"meta":166,"style":166},"{ \"runs\": [ { \"id\": \"...\", \"taskName\": \"greet\", \"status\": \"failed\", ... } ] }\n",[145,549,550],{"__ignoreMap":166},[422,551,552,554,556,558,560,562,565,568,570,574,576,578,581,585,587,589,591,594,596,598,600,603,605,607,609,611,613,615,617,619,621,623,627,630,633],{"class":424,"line":425},[422,553,429],{"class":428},[422,555,433],{"class":432},[422,557,469],{"class":436},[422,559,440],{"class":432},[422,561,443],{"class":428},[422,563,564],{"class":428}," [",[422,566,567],{"class":428}," {",[422,569,433],{"class":432},[422,571,573],{"class":572},"sa2tF","id",[422,575,440],{"class":432},[422,577,443],{"class":428},[422,579,433],{"class":580},"sbYkP",[422,582,584],{"class":583},"sTbE_","...",[422,586,440],{"class":580},[422,588,450],{"class":428},[422,590,433],{"class":432},[422,592,593],{"class":572},"taskName",[422,595,440],{"class":432},[422,597,443],{"class":428},[422,599,433],{"class":580},[422,601,602],{"class":583},"greet",[422,604,440],{"class":580},[422,606,450],{"class":428},[422,608,433],{"class":432},[422,610,512],{"class":572},[422,612,440],{"class":432},[422,614,443],{"class":428},[422,616,433],{"class":580},[422,618,527],{"class":583},[422,620,440],{"class":580},[422,622,450],{"class":428},[422,624,626],{"class":625},"srjyR"," ...",[422,628,629],{"class":428}," }",[422,631,632],{"class":428}," ]",[422,634,466],{"class":428},[158,636,639],{"className":637,"code":638,"language":163},[161],"GET \u002Fruns\u002F:id          → the RunRecord, or 404\nGET \u002Fruns\u002F:id?logFromOffset=N → { run, logChunk, logTotalLength } (incremental log read)\nDELETE \u002Fruns\u002F:id       → delete a finished run (404 unknown, 409 while active — cancel first)\nPOST \u002Fruns\u002F:id\u002Fretry   → re-run a run (404 if unknown, 409 if its task is gone)\nPOST \u002Fruns\u002F:id\u002Fcancel  → cancel an active run (404 unknown, 409 if already finished)\n",[145,640,638],{"__ignoreMap":166},[141,642,643,646,647,650,651,654,655,657,658,661,662,664],{},[145,644,645],{},"GET \u002Fruns\u002F:id?logFromOffset=N"," reads the log ",[177,648,649],{},"incrementally",":\ninstead of the full ",[145,652,653],{},"log"," snapshot, the response carries ",[145,656,316],{}," (the tail\nstarting at offset ",[145,659,660],{},"N",") and ",[145,663,320],{}," (the current total), so a UI can\npoll for growth while a run is still writing:",[158,666,669],{"className":667,"code":668,"language":163},[161],"GET \u002Fruns\u002Fab12cd34?logFromOffset=64\n→ { \"id\": \"ab12cd34\", ..., \"log\": null,\n     \"logChunk\": \"line2\\nline3\", \"logTotalLength\": 21 }\n",[145,670,668],{"__ignoreMap":166},[256,672,673,682,691],{},[259,674,675,676,679,680,220],{},"Offset ",[145,677,678],{},"0"," → the whole log as a chunk (same content as the full ",[145,681,653],{},[259,683,675,684,687,688,690],{},[145,685,686],{},"≥ logTotalLength"," → empty ",[145,689,316],{}," (the UI keeps polling).",[259,692,693,694,696],{},"Without the parameter the response is unchanged (full ",[145,695,653],{}," included).",[698,699,701],"h3",{"id":700},"manual-retry","Manual retry",[141,703,704,707,708,711,712,715,716,719,720,723,724,727],{},[145,705,706],{},"POST \u002Fruns\u002F:id\u002Fretry"," executes the run again through its runner (like the task\nactions below, it does not touch the schedule). The new run: ",[145,709,710],{},"data"," = the\noriginal run's snapshot, ",[145,713,714],{},"retryOf"," = the original id, ",[145,717,718],{},"trigger = 'manual'",",\n",[145,721,722],{},"temporary"," inherited from the original, ",[145,725,726],{},"triggeredBy"," fresh — who retries now\n(null when the body omits it). The original run is left untouched for audit.\nChains are allowed — a retry can itself be retried.",[141,729,730],{},"Accepts an optional JSON body to name the retry actor:",[158,732,735],{"className":733,"code":734,"language":163},[161],"POST \u002Fruns\u002Fab12cd34\u002Fretry\nContent-Type: application\u002Fjson\n{ \"triggeredBy\": \"boss@books\" }\n",[145,736,734],{"__ignoreMap":166},[256,738,739],{},[259,740,741,743,744,294],{},[145,742,726],{}," — caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched does not verify it — caller-declared, audit-grade not\nauth-grade. Malformed \u002F non-object body → ",[145,745,746],{},"400",[158,748,751],{"className":749,"code":750,"language":163},[161],"POST \u002Fruns\u002Fab12cd34\u002Fretry   → 200 { \"run\": { \"id\": \"ef56…\", \"retryOf\": \"ab12cd34\", \"trigger\": \"manual\", ... } }\n",[145,752,750],{"__ignoreMap":166},[698,754,756],{"id":755},"cancel","Cancel",[141,758,759,762],{},[145,760,761],{},"POST \u002Fruns\u002F:id\u002Fcancel"," stops an active run — the worker is\nreally stopped, not just re-labelled:",[158,764,767],{"className":765,"code":766,"language":163},[161],"POST \u002Fruns\u002Fab12cd34\u002Fcancel   → 200 { \"run\": { \"id\": \"ab12cd34\", \"status\": \"cancelled\", ... } }\nPOST \u002Fruns\u002Fab12cd34\u002Fcancel   → 409 (already succeeded\u002Ffailed\u002Fcancelled)\nPOST \u002Fruns\u002Fnope\u002Fcancel       → 404\n",[145,768,766],{"__ignoreMap":166},[256,770,771,796,810],{},[259,772,773,775,776,779,780,783,784,788,789,791,792,795],{},[145,774,518],{}," (async, being polled) → the worker is told to stop first (when the\naccepted envelope advertised a ",[145,777,778],{},"cancelUrl",", sched POSTs ",[145,781,782],{},"{ runId }"," there — see\n",[213,785,787],{"href":786},"protocol#cancel","Runner protocol → Cancel","); then dropped from the poll queue,\nfinished ",[145,790,530],{},", schedule advanced, task lock released. A failed cancel\nsignal is recorded in the run's error (",[145,793,794],{},"cancel signal failed: \u003Creason>",") — the\nworker may still be running.",[259,797,798,800,801,804,805,809],{},[145,799,521],{}," (sync, in flight) → the runner is aborted via ",[145,802,803],{},"hooks.signal","\n(see ",[213,806,808],{"href":807},"runners\u002Fcustom#hookssignal-user-cancel","Custom runners → hooks.signal",");\nthe response is sent after the worker actually stopped.",[259,811,812,813,220],{},"A terminal run cannot be cancelled (",[145,814,815],{},"409",[141,817,818,821,822,825,826,828],{},[145,819,820],{},"DELETE \u002Fruns\u002F:id"," refuses an ",[177,823,824],{},"active"," run (",[145,827,815],{}," — cancel it first); finished\nruns delete normally.",[389,830,14],{"id":831},"tasks",[158,833,836],{"className":834,"code":835,"language":163},[161],"GET \u002Ftasks?limit=&offset=   → { \"tasks\": [...] } (name ASC, limit capped at 1000)\nGET \u002Ftasks\u002F:name            → one task, or 404\nPOST \u002Ftasks                 → create\u002Fupsert a task, returns { task } (201 created \u002F 200 updated)\n",[145,837,835],{"__ignoreMap":166},[698,839,841],{"id":840},"runtime-registration-post-tasks","Runtime registration — POST \u002Ftasks",[141,843,844,845,848,849,852,853,856],{},"Creates a task, or ",[177,846,847],{},"upserts"," an existing one (same semantics as ",[145,850,851],{},"tasks.json"," sync —\nthe body is a full ",[145,854,855],{},"TaskDefinition",", validated eagerly with the same fail-fast rules):",[158,858,861],{"className":859,"code":860,"language":163},[161],"POST \u002Ftasks\nContent-Type: application\u002Fjson\n\n{\n  \"name\": \"generate-thumbnail\",\n  \"runner\": \"http\",\n  \"schedules\": [{ \"cron\": \"0 9 * * *\" }],\n  \"config\": { \"url\": \"http:\u002F\u002Fworker\u002Fthumbnails\", \"method\": \"POST\" }\n}\n\n→ 201\n\n{ \"task\": { \"name\": \"generate-thumbnail\", ..., \"nextRunAt\": \"...\" } }\n",[145,862,860],{"__ignoreMap":166},[256,864,865,872,891,902,935],{},[259,866,867,868,871],{},"No daemon restart needed — the task is live immediately (a second POST with the same\nname updates it in place; schedule change recomputes ",[145,869,870],{},"nextRunAt"," from now).",[259,873,874,875,269,878,269,881,269,884,887,888,890],{},"Runtime state is preserved on upsert: ",[145,876,877],{},"paused",[145,879,880],{},"failCount",[145,882,883],{},"retryCount",[145,885,886],{},"disabled","\nand ",[145,889,870],{}," (unless the schedule changed) are never reset.",[259,892,893,894,896,897,899,900,294],{},"Validation failures → ",[145,895,746],{}," with the same messages ",[145,898,851],{}," uses (fail-fast — a\ntypo must not become silent failed runs). Malformed \u002F non-object body → ",[145,901,746],{},[259,903,904,906,907,911,912,915,916,918,919,923,924,927,928,931,932,294],{},[145,905,851],{}," remains the source of truth for ",[908,909,910],"em",{},"declared"," tasks; a task ",[177,913,914],{},"removed","\nfrom the file gets ",[177,917,886],{}," by the next sync (see\n",[213,920,922],{"href":921},"tasks#sync-semantics","Tasks → Sync semantics","). Runtime-registered tasks\n(",[145,925,926],{},"fileManaged: false",") are ",[177,929,930],{},"never"," disabled by sync — they live until removed\nvia ",[145,933,934],{},"DELETE \u002Ftasks\u002F:name",[259,936,937,938,941,942,220],{},"Embedded callers can register without HTTP: ",[145,939,940],{},"upsertTaskDefinition(storage, def, now)","\n(exported from ",[145,943,944],{},"@schedjs\u002Fcore",[141,946,947],{},"Actions (ad-hoc, do not touch the schedule):",[158,949,952],{"className":950,"code":951,"language":163},[161],"POST \u002Ftasks\u002F:name\u002Frun      → trigger the task now (engine.triggerTask), returns { run }\nDELETE \u002Ftasks\u002F:name        → remove a task (204), unknown → 404 (runtime tasks live until deleted)\nPOST \u002Ftasks\u002F:name\u002Fpause    → pause the task\nPOST \u002Ftasks\u002F:name\u002Fresume   → resume the task\n",[145,953,951],{"__ignoreMap":166},[141,955,956,959,960,963,964,967,968,970],{},[145,957,958],{},"triggerTask"," executes immediately through the runner and records run history — it works\nfor paused\u002Fdisabled tasks too (explicit manual trigger). A manual run updates the task's\n",[145,961,962],{},"lastRunId","\u002F",[145,965,966],{},"lastRunAt"," but never touches the schedule (",[145,969,870],{}," stays put).",[186,972,973],{},[141,974,975,976,979],{},"The call ",[177,977,978],{},"blocks until the run finishes"," for sync runners — the response is the\nterminal run. For long sync runs use a scheduled interval (or an async runner)\nif you need the HTTP call to return promptly.",[141,981,982,985,986,719,989,992,993,996],{},[145,983,984],{},"POST \u002Ftasks\u002F:name\u002Frun"," accepts an optional JSON body to pick the run's retention class,\nname the caller, and override its parameters (otherwise the run is ",[145,987,988],{},"temporary: false",[145,990,991],{},"triggeredBy: null"," with the task's default ",[145,994,995],{},"config.data","):",[158,998,1001],{"className":999,"code":1000,"language":163},[161],"POST \u002Ftasks\u002F:name\u002Frun\nContent-Type: application\u002Fjson\n{ \"temporary\": true, \"triggeredBy\": \"boss@books\", \"data\": { \"videoId\": \"v-42\" } }\n",[145,1002,1000],{"__ignoreMap":166},[256,1004,1005,1015,1027,1036],{},[259,1006,1007,1010,1011,220],{},[145,1008,1009],{},"temporary: true"," → short retention class (24h TTL, see ",[213,1012,1014],{"href":1013},"runs#retention","Runs → Retention",[259,1016,1017,1019,1020,1022,1023,1026],{},[145,1018,710],{}," → merged over the task's default ",[145,1021,995],{}," (",[145,1024,1025],{},"{ ...config.data, ...data }",").\nThe worker is dispatched with the merged payload — the override reaches the\nrun's execution, not just the audit record.",[259,1028,1029,1031,1032,1035],{},[145,1030,726],{}," → caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched is identity-agnostic — it does not verify the value\n(caller-declared, audit-grade not auth-grade); embedded callers pass it to\n",[145,1033,1034],{},"triggerTask(name, { triggeredBy })"," directly.",[259,1037,1038,1039,294],{},"Malformed \u002F non-object body → ",[145,1040,746],{},[186,1042,1043],{},[141,1044,1045,1048,1049,1051,1052,1055,1056,1058],{},[145,1046,1047],{},"POST \u002Ftasks\u002F:name\u002Fschedule"," is ",[177,1050,914],{},": it answers ",[145,1053,1054],{},"404"," pointing at\n",[145,1057,327],{}," below. Imperative schedules are created there — one schedule\nper rule, each with its own data\u002Fpolicy.",[389,1060,1062],{"id":1061},"schedules-schedule-as-entity","Schedules (schedule-as-entity)",[158,1064,1067],{"className":1065,"code":1066,"language":163},[161],"POST   \u002Fschedules                → create\u002Fupsert, { schedule } — 201 created \u002F 200 updated\nGET    \u002Fschedules?limit=&offset= → { schedules } (id ASC, limit capped at 1000)\nGET    \u002Fschedules\u002F:id            → ScheduleRecord | 404\nDELETE \u002Fschedules\u002F:id            → 204 | 404 (remove a schedule; runs keep their history)\nPOST   \u002Fschedules\u002F:id\u002Fpause      → { ok } | 404\nPOST   \u002Fschedules\u002F:id\u002Fresume     → { ok } | 404\n",[145,1068,1066],{"__ignoreMap":166},[141,1070,1071,1072,1075,1076,1078,1079,1081],{},"A ",[177,1073,1074],{},"schedule"," is one firing rule of a task with its own ",[145,1077,710],{},"\u002Fpolicy — the\nentity that replaced the task's single ",[145,1080,1074],{}," field (one task, one\nschedule per channel).",[698,1083,327],{"id":1084},"post-schedules",[158,1086,1089],{"className":1087,"code":1088,"language":163},[161],"POST \u002Fschedules\nContent-Type: application\u002Fjson\n\n{\n  \"taskName\": \"sync-channel-stats\",\n  \"schedule\": {\n    \"cron\": \"0 9 * * *\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"externalId\": \"ada\",\n    \"dedupKey\": \"channel-ada\"\n  }\n}\n\n→ 201\n\n{\n  \"schedule\": {\n    \"id\": \"...uuid...\",\n    \"taskName\": \"sync-channel-stats\",\n    \"schedule\": { \"cron\": \"0 9 * * *\" },\n    \"tz\": \"UTC\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"nextRunAt\": \"...\",\n    \"fileManaged\": false,\n    ...\n  }\n}\n",[145,1090,1088],{"__ignoreMap":166},[256,1092,1093,1118,1137,1148],{},[259,1094,1095,1096,1099,1100,1102,1103,1105,1106,1109,1110,1113,1114,1117],{},"Body: ",[145,1097,1098],{},"{ taskName, schedule: { cron | interval | once, timezone?, data?, externalId?, dedupKey?, retry?, priority? }, tz? }"," — the ",[145,1101,1074],{}," object is the same shape as a\n",[145,1104,851],{}," schedules element. ",[145,1107,1108],{},"tz"," defaults to the ",[177,1111,1112],{},"task's"," timezone; an inner\n",[145,1115,1116],{},"timezone"," on cron overrides it.",[259,1119,1120,1125,1126,1129,1130,1133,1134,1136],{},[177,1121,1122,1124],{},[145,1123,334],{}," is the idempotent upsert handle",": a second POST with the same key updates\nthe existing schedule in place (its id is preserved) and answers ",[145,1127,1128],{},"200","; a fresh schedule\nanswers ",[145,1131,1132],{},"201",". Without a ",[145,1135,334],{}," every POST creates a new schedule.",[259,1138,1139,1140,1142,1143,1145,1146,294],{},"Validation is identical to ",[145,1141,851],{}," (fail-fast): unknown task → ",[145,1144,1054],{},"; a malformed\nschedule, bad tz, invalid policy → ",[145,1147,746],{},[259,1149,1150,1151,1022,1154,1156,1157,294],{},"Created schedules are ",[177,1152,1153],{},"runtime-owned",[145,1155,926],{},") — sync never disables\nthem; remove one with ",[145,1158,1159],{},"DELETE \u002Fschedules\u002F:id",[698,1161,1163],{"id":1162},"get-schedules","GET \u002Fschedules",[141,1165,1166,1167,1170],{},"Returns every schedule as a first-class row: ",[145,1168,1169],{},"id\u002FtaskName\u002Fschedule\u002Ftz\u002Fdata\u002FexternalId\u002F dedupKey\u002FnextRunAt\u002FlastRunAt\u002FlastRunId\u002FfailCount\u002FretryCount\u002Fpriority\u002Fretry\u002Fpaused\u002Fdisabled","\nplus two resolved fields (no N+1 — three reads total):",[256,1172,1173,1183],{},[259,1174,1175,1178,1179,1182],{},[145,1176,1177],{},"lastRunStatus"," — how the schedule's most recent run ended (",[145,1180,1181],{},"null"," when it has no run,\nor its last run fell out of the recent window; listRuns is recent-first, capped at 1000).",[259,1184,1185,1099,1188,1191,1192,1195,1196,1199,1200,1203],{},[145,1186,1187],{},"effectiveStatus",[177,1189,1190],{},"AND-semantics made visible",": ",[145,1193,1194],{},"'paused-task'","\n(the family stop holds), ",[145,1197,1198],{},"'paused-schedule'"," (only this instance), or ",[145,1201,1202],{},"'active'",". The UI\nrenders 🔴 for paused-task and 🟡 for paused-schedule, so «снял паузу, а оно молчит»\nnever happens.",[158,1205,1207],{"className":416,"code":1206,"language":418,"