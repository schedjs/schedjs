edule (with ",[154,1531,1196],{},");\n",[154,1534,1535],{},"PATCH \u002Fschedules\u002F:id"," edits a schedule ",[186,1538,1539],{},"in place"," (partial merge — only the\nfields present in the body change; an explicit ",[154,1542,1190],{}," clears, an absent field\nkeeps its current value). ",[154,1545,879],{}," recomputes from now when the rule or the\neffective tz changed; runtime state (lock, fail count, retry count, last run) is\npreserved. Body: ",[154,1548,1549],{},"{ schedule: { cron | interval | once, timezone?, data?, externalId?, dedupKey?, retry?, priority? }, tz? }"," — same entry shape as\n",[154,1552,336],{},", so a rule-only patch like ",[154,1555,1556],{},"{ \"schedule\": { \"cron\": \"0 9 * * *\" } }","\nupdates the rule and leaves ",[154,1559,719],{},[154,1561,343],{},[154,1563,1459],{}," untouched. 404 on unknown\nid, 400 on a bad rule\u002Ftz.",[150,1566,1567,1569,1570,1573,1574,1577,1578,1581],{},[154,1568,1168],{}," removes the schedule but ",[186,1571,1572],{},"keeps its runs"," — the audit trail\nsurvives. ",[154,1575,1576],{},"POST \u002Fschedules\u002F:id\u002Fpause|resume"," toggles only the schedule-level flag\n(",[154,1579,1580],{},"pauseTask"," remains the family stop).",[398,1583,1585],{"id":1584},"errors","Errors",[265,1587,1588,1593,1599],{},[268,1589,1590,1592],{},[154,1591,1063],{}," — unknown resource",[268,1594,1595,1598],{},[154,1596,1597],{},"405"," — method not allowed on a route",[268,1600,1601,1604,1605],{},[154,1602,1603],{},"500"," — internal error with the message in ",[154,1606,1607],{},"{ \"error\": \"...\" }",[1609,1610,1611],"style",{},"html pre.shiki code .soVBu, html code.shiki .soVBu{--shiki-light:#39ADB5;--shiki-default:#999999;--shiki-dark:#666666}html pre.shiki code .s4Jsk, html code.shiki .s4Jsk{--shiki-light:#39ADB5;--shiki-default:#99841877;--shiki-dark:#B8A96577}html pre.shiki code .sLorS, html code.shiki .sLorS{--shiki-light:#9C3EDA;--shiki-default:#998418;--shiki-dark:#B8A965}html pre.shiki code .s8XtY, h