":138,"stem":139},"Self-hosting","\u002Fdocs\u002Fself-hosting","docs\u002F14.self-hosting",{"title":141,"path":142,"stem":143},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F15.security",{"id":145,"title":117,"body":146,"description":1897,"extension":1898,"links":1899,"meta":1900,"navigation":1901,"path":118,"seo":1902,"stem":119,"__hash__":1903},"docs\u002Fdocs\u002F10.admin-api.md",{"type":147,"value":148,"toc":1880},"minimark",[149,166,176,183,194,345,372,397,402,408,423,476,480,486,517,604,607,613,727,744,834,840,864,870,896,901,927,930,936,945,951,955,961,967,1013,1026,1030,1036,1045,1113,1116,1122,1126,1140,1146,1227,1230,1236,1253,1262,1279,1285,1323,1340,1344,1350,1363,1366,1372,1439,1443,1450,1481,1792,1833,1850,1854,1876],[150,151,152,153,157,158,161,162,165],"p",{},"The daemon serves a small JSON API under ",[154,155,156],"code",{},"--admin-port"," (mount point ",[154,159,160],{},"\u002Fapi","). Bearer auth\nis required when ",[154,163,164],{},"SCHED_ADMIN_KEY"," is set:",[167,168,173],"pre",{"className":169,"code":171,"language":172},[170],"language-text","Authorization: Bearer \u003CSCHED_ADMIN_KEY>\n","text",[154,174,171],{"__ignoreMap":175},"",[150,177,178,179,182],{},"Unauthenticated requests get ",[154,180,181],{},"401 { \"error\": \"unauthorized\" }",". When no key is configured,\nthe API is open (bind to a private host in that case).",[150,184,185,193],{},[186,187,188,189,192],"strong",{},"Exception: ",[154,190,191],{},"GET \u002Fhealth"," is always open"," — even with a key configured, the health\nprobe answers without credentials (compose healthchecks \u002F LB probes carry none, and the\npayload has no secrets). Every other route 401s without the key.",[195,196,197,215,230,258,264],"blockquote",{},[150,198,199,202,203,206,207,210,211,214],{},[186,200,201],{},"Machine-readable contract."," An OpenAPI 3.1 spec ships with the server package:\n",[154,204,205],{},"@schedjs\u002Fadmin-api\u002Fopenapi.json"," — generate a client in any language with\n",[154,208,209],{},"openapi-generator"," \u002F ",[154,212,213],{},"kiota"," \u002F fern. The spec is route-parity-tested against the\nrouter (every documented path is exercised; a removed route fails the suite).",[150,216,217,220,221,225,226,229],{},[186,218,219],{},"Download without running anything:"," the same file is served by this docs site at\n",[222,223,224],"a",{"href":224},"\u002Fopenapi.json"," (byte-identical to the package spec, guarded by\n",[154,227,228],{},"packages\u002Fadmin-api\u002Ftest\u002Fts-client-guard.test.ts",").",[150,231,232,235,236,238,239,242,243,246,247,249,250,253,254,257],{},[186,233,234],{},"Verified flavors:"," Python (",[154,237,209],{}," 7.24.0, suite\n24\u002F24 + smoke 19\u002F19 against a live daemon) and TypeScript (",[154,240,241],{},"typescript-axios",",\ncompiles clean under ",[154,244,245],{},"tsc --strict","; pinned spec copies are byte-identical to the\npackage one, guarded by ",[154,248,228],{},"). Two\ngenerator families over one spec — the 3.1 nullable unions\n(",[154,251,252],{},"type: [..., \"null\"]",") map to ",[154,255,256],{},"string | null"," in both.",[150,259,260,263],{},[186,261,262],{},"Generator-compatible shapes:","**",[265,266,267,286,304,317,331],"ul",{},[268,269,270,271,274,275,278,279,278,282,285],"li",{},"Mutations return ",[186,272,273],{},"wrapped"," records — ",[154,276,277],{},"{ task }",", ",[154,280,281],{},"{ run }",[154,283,284],{},"{ schedule }"," —\nsingular GETs return the bare record; the spec declares exactly that.",[268,287,288,291,292,295,296,299,300,303],{},[154,289,290],{},"Schedule"," is a ",[186,293,294],{},"flat output schema"," (kind + optional cron\u002Ftimezone\u002Fms\u002Fat) —\none-shot rules normalize to ",[154,297,298],{},"{ kind: \"once\", at }",", intervals to ",[154,301,302],{},"{ kind: \"interval\", ms }",".",[268,305,306,307,310,311,313,314,229],{},"No ",[154,308,309],{},"const: true"," \u002F no oneOf+discriminator — constructs that make ",[154,312,209],{},"\nemit broken models (string-enums for booleans, ",[154,315,316],{},"actual_instance=None",[268,318,319,322,323,326,327,330],{},[154,320,321],{},"GET \u002Fruns\u002F{id}?logFromOffset=N"," declares the incremental-chunk shape\n(",[154,324,325],{},"logChunk"," + ",[154,328,329],{},"logTotalLength"," alongside the run).",[268,332,333,334,210,337,340,341,344],{},"Unknown top-level body fields on ",[154,335,336],{},"POST \u002Fschedules",[154,338,339],{},"PATCH \u002Fschedules\u002F{id}","\nare rejected with 400 (fail-fast) — a silent-ignored ",[154,342,343],{},"dedupKey"," used to create\na duplicate schedule.",[195,346,347],{},[150,348,349,352,353,356,357,360,361,364,365,367,368,371],{},[186,350,351],{},"Cache control."," Every JSON response is sent with ",[154,354,355],{},"Cache-Control: no-store"," (and the\nartifact proxy with ",[154,358,359],{},"no-cache","), so the browser never serves a cached snapshot of a run.\nThe standalone UI (",[154,362,363],{},"sched-ui serve",") additionally forces ",[154,366,359],{}," on its ",[154,369,370],{},"\u002Fapi\u002F*"," proxy\nresponses. If a browser still shows a stale list, hard-refresh (Ctrl+F5) once.",[195,373,374],{},[150,375,376,377,380,381,384,385,388,389,392,393,396],{},"The same API is available to embedded apps: ",[154,378,379],{},"createAdminApi"," from ",[154,382,383],{},"@schedjs\u002Fadmin-api","\nreturns an ",[154,386,387],{},"AdminApi"," whose ",[154,390,391],{},"handleRequest(req, res)"," you can mount at any path\n(see ",[222,394,121],{"href":395},"ui"," § Embedded apps).",[398,399,401],"h2",{"id":400},"health","Health",[167,403,406],{"className":404,"code":405,"language":172},[170],"GET \u002Fapi\u002Fhealth   → { \"ok\": true, \"uptimeMs\": 1234, \"version\": \"0.16.0\" }\n",[154,407,405],{"__ignoreMap":175},[150,409,410,413,414,416,417,419,420,422],{},[154,411,412],{},"version"," is the daemon's own package version (falls back to ",[154,415,383],{}," for\nembedded hosts — pass ",[154,418,412],{}," to ",[154,421,379],{}," to override).",[167,424,428],{"className":425,"code":426,"language":427,"meta":175,"style":175},"language-json shiki shiki-themes material-theme-lighter vitesse-light vitesse-dark","{ \"ok\": true, \"uptimeMs\": 123456 }\n","json",[154,429,430],{"__ignoreMap":175},[431,432,435,439,443,447,450,453,457,460,462,465,467,469,473],"span",{"class":433,"line":434},"line",1,[431,436,438],{"class":437},"soVBu","{",[431,440,442],{"class":441},"s4Jsk"," \"",[431,444,446],{"class":445},"sLorS","ok",[431,448,449],{"class":441},"\"",[431,451,452],{"class":437},":",[431,454,456],{"class":455},"s8XtY"," true",[431,458,459],{"class":437},",",[431,461,442],{"class":441},[431,463,464],{"class":445},"uptimeMs",[431,466,449],{"class":441},[431,468,452],{"class":437},[431,470,472],{"class":471},"s7CZa"," 123456",[431,474,475],{"class":437}," }\n",[398,477,479],{"id":478},"queue-pause-resume","Queue (pause \u002F resume)",[167,481,484],{"className":482,"code":483,"language":172},[170],"GET  \u002Fapi\u002Fqueue          → { \"paused\": false, \"pausedAt\": null, \"startPaused\": false }\nPOST \u002Fapi\u002Fqueue\u002Fpause    → { \"ok\": true, \"paused\": true,  \"pausedAt\": \"2026-09-20T09:30:00.000Z\" }\nPOST \u002Fapi\u002Fqueue\u002Fresume   → { \"ok\": true, \"paused\": false, \"pausedAt\": null }\n",[154,485,483],{"__ignoreMap":175},[150,487,488,489,492,493,496,497,500,501,504,505,508,509,512,513,516],{},"Pausing stops the queue from claiming new work. It is a runtime kill-switch\nowned by the engine, ",[186,490,491],{},"not"," persisted state — a restart without ",[154,494,495],{},"startPaused","\nis active again. While paused, ",[154,498,499],{},"tasks.json"," sync, retention\u002Fprune and alerts on\nalready-running work keep going. On resume, recurring schedules ",[186,502,503],{},"skip"," the\nmissed window (their ",[154,506,507],{},"nextRunAt"," moves to the next future slot — no catch-up\nstorm, no ",[154,510,511],{},"missed-slot"," alert); ",[154,514,515],{},"once","\u002Fdelayed runs and pending retries still\nrun, each exactly once.",[265,518,519,557,577,590],{},[268,520,521,522,525,526,529,530,533,534,537,538,541,542,545,546,549,550,552,553,556],{},"Both mutations are ",[186,523,524],{},"idempotent",": ",[154,527,528],{},"POST \u002Fqueue\u002Fpause"," on an already-paused\nqueue returns ",[154,531,532],{},"200"," with the ",[186,535,536],{},"same"," ",[154,539,540],{},"pausedAt"," (never ",[154,543,544],{},"409","), and\n",[154,547,548],{},"POST \u002Fqueue\u002Fresume"," on an active queue returns ",[154,551,532],{}," with ",[154,554,555],{},"paused: false",".\nThink \"bring the queue to this state\", not a conditional write.",[268,558,559,561,562,565,566,569,570,572,573,576],{},[154,560,540],{}," — ISO-8601 timestamp of when the freeze started (",[154,563,564],{},"null"," when\nactive). With ",[154,567,568],{},"SCHED_START_PAUSED=1"," it is the process start time and\n",[154,571,495],{}," is ",[154,574,575],{},"true"," (\"frozen since boot\", not an operator command).",[268,578,579,580,582,583,585,586,589],{},"Queue state is deliberately ",[186,581,491],{}," part of the open ",[154,584,191],{}," payload —\n",[154,587,588],{},"\u002Fhealth"," answers liveness for compose\u002FLB probes, not control-plane state.",[268,591,592,593,595,596,599,600,603],{},"Embedded hosts that use ",[154,594,379],{}," without a queue accessor get ",[154,597,598],{},"501","\n(",[154,601,602],{},"queue control not configured",") — the routes never invent a fake state.",[398,605,27],{"id":606},"runs",[167,608,611],{"className":609,"code":610,"language":172},[170],"GET \u002Fruns?task=greet&status=failed&since=2026-09-19T00:00:00Z&until=2026-09-20T00:00:00Z&runner=docker&limit=20&offset=0\n",[154,612,610],{"__ignoreMap":175},[614,615,616,629],"table",{},[617,618,619],"thead",{},[620,621,622,626],"tr",{},[623,624,625],"th",{},"Query",[623,627,628],{},"Description",[630,631,632,643,672,694,714],"tbody",{},[620,633,634,640],{},[635,636,637],"td",{},[154,638,639],{},"task",[635,641,642],{},"filter by task name",[620,644,645,650],{},[635,646,647],{},[154,648,649],{},"status",[635,651,652,653,210,656,210,659,210,662,210,665,668,669],{},"filter by status (",[154,654,655],{},"queued",[154,657,658],{},"running",[154,660,661],{},"succeeded",[154,663,664],{},"failed",[154,666,667],{},"cancelled","); any other value → ",[186,670,671],{},"400",[620,673,674,682],{},[635,675,676,278,679],{},[154,677,678],{},"since",[154,680,681],{},"until",[635,683,684,685,278,688,691,692],{},"start-time window on ",[154,686,687],{},"startedAt",[186,689,690],{},"ISO-8601, both bounds inclusive","; an unparseable timestamp → ",[186,693,671],{},[620,695,696,701],{},[635,697,698],{},[154,699,700],{},"runner",[635,702,703,704,278,707,278,710,713],{},"exact runner match (",[154,705,706],{},"docker",[154,708,709],{},"http",[154,711,712],{},"process","…)",[620,715,716,724],{},[635,717,718,278,721],{},[154,719,720],{},"limit",[154,722,723],{},"offset",[635,725,726],{},"pagination",[150,728,729,730,732,733,736,737,739,740,229],{},"The window is on ",[154,731,687],{},", matching the fixed ",[154,734,735],{},"startedAt DESC"," order — a long\nrun that started before ",[154,738,678],{}," is not in the window even if it failed inside it\n(see ",[222,741,743],{"href":742},"runs#filtering-run-history","Runs → Filtering run history",[167,745,747],{"className":425,"code":746,"language":427,"meta":175,"style":175},"{ \"runs\": [ { \"id\": \"...\", \"taskName\": \"greet\", \"status\": \"failed\", ... } ] }\n",[154,748,749],{"__ignoreMap":175},[431,750,751,753,755,757,759,761,764,767,769,773,775,777,780,784,786,788,790,793,795,797,799,802,804,806,808,810,812,814,816,818,820,822,826,829,832],{"class":433,"line":434},[431,752,438],{"class":437},[431,754,442],{"class":441},[431,756,606],{"class":445},[431,758,449],{"class":441},[431,760,452],{"class":437},[431,762,763],{"class":437}," [",[431,765,766],{"class":437}," {",[431,768,442],{"class":441},[431,770,772],{"class":771},"sa2tF","id",[431,774,449],{"class":441},[431,776,452],{"class":437},[431,778,442],{"class":779},"sbYkP",[431,781,783],{"class":782},"sTbE_","...",[431,785,449],{"class":779},[431,787,459],{"class":437},[431,789,442],{"class":441},[431,791,792],{"class":771},"taskName",[431,794,449],{"class":441},[431,796,452],{"class":437},[431,798,442],{"class":779},[431,800,801],{"class":782},"greet",[431,803,449],{"class":779},[431,805,459],{"class":437},[431,807,442],{"class":441},[431,809,649],{"class":771},[431,811,449],{"class":441},[431,813,452],{"class":437},[431,815,442],{"class":779},[431,817,664],{"class":782},[431,819,449],{"class":779},[431,821,459],{"class":437},[431,823,825],{"class":824},"srjyR"," ...",[431,827,828],{"class":437}," }",[431,830,831],{"class":437}," ]",[431,833,475],{"class":437},[167,835,838],{"className":836,"code":837,"language":172},[170],"GET \u002Fruns\u002F:id          → the RunRecord, or 404\nGET \u002Fruns\u002F:id?logFromOffset=N → { run, logChunk, logTotalLength } (incremental log read)\nDELETE \u002Fruns\u002F:id       → delete a finished run (404 unknown, 409 while active — cancel first)\nPOST \u002Fruns\u002F:id\u002Fretry   → re-run a run (404 if unknown, 409 if its task is gone)\nPOST \u002Fruns\u002F:id\u002Fcancel  → cancel an active run (404 unknown, 409 if already finished)\n",[154,839,837],{"__ignoreMap":175},[150,841,842,845,846,849,850,853,854,856,857,860,861,863],{},[154,843,844],{},"GET \u002Fruns\u002F:id?logFromOffset=N"," reads the log ",[186,847,848],{},"incrementally",":\ninstead of the full ",[154,851,852],{},"log"," snapshot, the response carries ",[154,855,325],{}," (the tail\nstarting at offset ",[154,858,859],{},"N",") and ",[154,862,329],{}," (the current total), so a UI can\npoll for growth while a run is still writing:",[167,865,868],{"className":866,"code":867,"language":172},[170],"GET \u002Fruns\u002Fab12cd34?logFromOffset=64\n→ { \"id\": \"ab12cd34\", ..., \"log\": null,\n     \"logChunk\": \"line2\\nline3\", \"logTotalLength\": 21 }\n",[154,869,867],{"__ignoreMap":175},[265,871,872,881,890],{},[268,873,874,875,878,879,229],{},"Offset ",[154,876,877],{},"0"," → the whole log as a chunk (same content as the full ",[154,880,852],{},[268,882,874,883,886,887,889],{},[154,884,885],{},"≥ logTotalLength"," → empty ",[154,888,325],{}," (the UI keeps polling).",[268,891,892,893,895],{},"Without the parameter the response is unchanged (full ",[154,894,852],{}," included).",[897,898,900],"h3",{"id":899},"manual-retry","Manual retry",[150,902,903,906,907,910,911,914,915,918,919,922,923,926],{},[154,904,905],{},"POST \u002Fruns\u002F:id\u002Fretry"," executes the run again through its runner (like the task\nactions below, it does not touch the schedule). The new run: ",[154,908,909],{},"data"," = the\noriginal run's snapshot, ",[154,912,913],{},"retryOf"," = the original id, ",[154,916,917],{},"trigger = 'manual'",",\n",[154,920,921],{},"temporary"," inherited from the original, ",[154,924,925],{},"triggeredBy"," fresh — who retries now\n(null when the body omits it). The original run is left untouched for audit.\nChains are allowed — a retry can itself be retried.",[150,928,929],{},"Accepts an optional JSON body to name the retry actor:",[167,931,934],{"className":932,"code":933,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fretry\nContent-Type: application\u002Fjson\n{ \"triggeredBy\": \"boss@books\" }\n",[154,935,933],{"__ignoreMap":175},[265,937,938],{},[268,939,940,942,943,303],{},[154,941,925],{}," — caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched does not verify it — caller-declared, audit-grade not\nauth-grade. Malformed \u002F non-object body → ",[154,944,671],{},[167,946,949],{"className":947,"code":948,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fretry   → 200 { \"run\": { \"id\": \"ef56…\", \"retryOf\": \"ab12cd34\", \"trigger\": \"manual\", ... } }\n",[154,950,948],{"__ignoreMap":175},[897,952,954],{"id":953},"cancel","Cancel",[150,956,957,960],{},[154,958,959],{},"POST \u002Fruns\u002F:id\u002Fcancel"," stops an active run — the worker is\nreally stopped, not just re-labelled:",[167,962,965],{"className":963,"code":964,"language":172},[170],"POST \u002Fruns\u002Fab12cd34\u002Fcancel   → 200 { \"run\": { \"id\": \"ab12cd34\", \"status\": \"cancelled\", ... } }\nPOST \u002Fruns\u002Fab12cd34\u002Fcancel   → 409 (already succeeded\u002Ffailed\u002Fcancelled)\nPOST \u002Fruns\u002Fnope\u002Fcancel       → 404\n",[154,966,964],{"__ignoreMap":175},[265,968,969,994,1008],{},[268,970,971,973,974,977,978,981,982,986,987,989,990,993],{},[154,972,655],{}," (async, being polled) → the worker is told to stop first (when the\naccepted envelope advertised a ",[154,975,976],{},"cancelUrl",", sched POSTs ",[154,979,980],{},"{ runId }"," there — see\n",[222,983,985],{"href":984},"protocol#cancel","Runner protocol → Cancel","); then dropped from the poll queue,\nfinished ",[154,988,667],{},", schedule advanced, task lock released. A failed cancel\nsignal is recorded in the run's error (",[154,991,992],{},"cancel signal failed: \u003Creason>",") — the\nworker may still be running.",[268,995,996,998,999,1002,1003,1007],{},[154,997,658],{}," (sync, in flight) → the runner is aborted via ",[154,1000,1001],{},"hooks.signal","\n(see ",[222,1004,1006],{"href":1005},"runners\u002Fcustom#hookssignal-user-cancel","Custom runners → hooks.signal",");\nthe response is sent after the worker actually stopped.",[268,1009,1010,1011,229],{},"A terminal run cannot be cancelled (",[154,1012,544],{},[150,1014,1015,1018,1019,1022,1023,1025],{},[154,1016,1017],{},"DELETE \u002Fruns\u002F:id"," refuses an ",[186,1020,1021],{},"active"," run (",[154,1024,544],{}," — cancel it first); finished\nruns delete normally.",[897,1027,1029],{"id":1028},"bulk-cancel-retry","Bulk cancel \u002F retry",[167,1031,1034],{"className":1032,"code":1033,"language":172},[170],"POST \u002Fruns\u002Fbulk\u002Fcancel   → { \"ok\": [\"a1\", \"b2\"], \"failed\": [ { \"id\": \"c3\", \"reason\": \"already-terminal\" } ] }\nPOST \u002Fruns\u002Fbulk\u002Fretry    → { \"ok\": [\"a1\"],       \"failed\": [ { \"id\": \"zz\", \"reason\": \"not-found\" } ] }\n",[154,1035,1033],{"__ignoreMap":175},[150,1037,1038,1039,1042,1043,229],{},"Body: ",[154,1040,1041],{},"{ \"ids\": [\"a1\", \"b2\", \"c3\"] }"," — explicit run ids only (no selectors in\nv1; an unknown top-level field is a ",[154,1044,671],{},[265,1046,1047,1058,1076,1088,1103],{},[268,1048,1049,1050,1053,1054,1057],{},"The result is ",[186,1051,1052],{},"partial, never atomic",": every id is applied independently\nthrough exactly the same logic as ",[154,1055,1056],{},"POST \u002Fruns\u002F:id\u002Fcancel|retry",", so a run that\nraced with another cancel does not block the rest of the batch.",[268,1059,1060,1063,1064,1067,1068,1071,1072,1075],{},[154,1061,1062],{},"failed[].reason"," ∈ ",[154,1065,1066],{},"not-found"," (unknown run id — or, for retry, the target's\ntask is gone) · ",[154,1069,1070],{},"already-terminal"," (cancel on a run that already\nsucceeded\u002Ffailed\u002Fcancelled) · ",[154,1073,1074],{},"not-cancellable"," (the engine declined — the run\nwas not in flight — or the cancel signal left the run non-terminal).",[268,1077,1078,1079,1082,1083,1085,1086,303],{},"A missing or non-array ",[154,1080,1081],{},"ids",", an empty ",[154,1084,1081],{}," array, or a non-string\u002Fempty\nelement inside it → ",[154,1087,671],{},[268,1089,1090,1091,1094,1095,1098,1099,1102],{},"More than ",[186,1092,1093],{},"100"," ids → ",[154,1096,1097],{},"422"," with the count: a 5000-run operation is\n",[154,1100,1101],{},"prune",", not a bulk call. Split the batch.",[268,1104,1105,1106,1109,1110,303],{},"Route order matters: ",[154,1107,1108],{},"\u002Fruns\u002Fbulk\u002Fcancel"," is a distinct route — it is never\ninterpreted as the id literally named ",[154,1111,1112],{},"bulk",[398,1114,23],{"id":1115},"tasks",[167,1117,1120],{"className":1118,"code":1119,"language":172},[170],"GET \u002Ftasks?limit=&offset=   → { \"tasks\": [...] } (name ASC, limit capped at 1000)\nGET \u002Ftasks\u002F:name            → one task, or 404\nPOST \u002Ftasks                 → create\u002Fupsert a task, returns { task } (201 created \u002F 200 updated)\n",[154,1121,1119],{"__ignoreMap":175},[897,1123,1125],{"id":1124},"runtime-registration-post-tasks","Runtime registration — POST \u002Ftasks",[150,1127,1128,1129,1132,1133,1135,1136,1139],{},"Creates a task, or ",[186,1130,1131],{},"upserts"," an existing one (same semantics as ",[154,1134,499],{}," sync —\nthe body is a full ",[154,1137,1138],{},"TaskDefinition",", validated eagerly with the same fail-fast rules):",[167,1141,1144],{"className":1142,"code":1143,"language":172},[170],"POST \u002Ftasks\nContent-Type: application\u002Fjson\n\n{\n  \"name\": \"generate-thumbnail\",\n  \"runner\": \"http\",\n  \"schedules\": [{ \"cron\": \"0 9 * * *\" }],\n  \"config\": { \"url\": \"http:\u002F\u002Fworker\u002Fthumbnails\", \"method\": \"POST\" }\n}\n\n→ 201\n\n{ \"task\": { \"name\": \"generate-thumbnail\", ..., \"nextRunAt\": \"...\" } }\n",[154,1145,1143],{"__ignoreMap":175},[265,1147,1148,1154,1173,1184,1217],{},[268,1149,1150,1151,1153],{},"No daemon restart needed — the task is live immediately (a second POST with the same\nname updates it in place; schedule change recomputes ",[154,1152,507],{}," from now).",[268,1155,1156,1157,278,1160,278,1163,278,1166,1169,1170,1172],{},"Runtime state is preserved on upsert: ",[154,1158,1159],{},"paused",[154,1161,1162],{},"failCount",[154,1164,1165],{},"retryCount",[154,1167,1168],{},"disabled","\nand ",[154,1171,507],{}," (unless the schedule changed) are never reset.",[268,1174,1175,1176,1178,1179,1181,1182,303],{},"Validation failures → ",[154,1177,671],{}," with the same messages ",[154,1180,499],{}," uses (fail-fast — a\ntypo must not become silent failed runs). Malformed \u002F non-object body → ",[154,1183,671],{},[268,1185,1186,1188,1189,1193,1194,1197,1198,1200,1201,1205,1206,1209,1210,1213,1214,303],{},[154,1187,499],{}," remains the source of truth for ",[1190,1191,1192],"em",{},"declared"," tasks; a task ",[186,1195,1196],{},"removed","\nfrom the file gets ",[186,1199,1168],{}," by the next sync (see\n",[222,1202,1204],{"href":1203},"tasks#sync-semantics","Tasks → Sync semantics","). Runtime-registered tasks\n(",[154,1207,1208],{},"fileManaged: false",") are ",[186,1211,1212],{},"never"," disabled by sync — they live until removed\nvia ",[154,1215,1216],{},"DELETE \u002Ftasks\u002F:name",[268,1218,1219,1220,1223,1224,229],{},"Embedded callers can register without HTTP: ",[154,1221,1222],{},"upsertTaskDefinition(storage, def, now)","\n(exported from ",[154,1225,1226],{},"@schedjs\u002Fcore",[150,1228,1229],{},"Actions (ad-hoc, do not touch the schedule):",[167,1231,1234],{"className":1232,"code":1233,"language":172},[170],"POST \u002Ftasks\u002F:name\u002Frun      → trigger the task now (engine.triggerTask), returns { run }\nDELETE \u002Ftasks\u002F:name        → remove a task (204), unknown → 404 (runtime tasks live until deleted)\nPOST \u002Ftasks\u002F:name\u002Fpause    → pause the task\nPOST \u002Ftasks\u002F:name\u002Fresume   → resume the task\n",[154,1235,1233],{"__ignoreMap":175},[150,1237,1238,1241,1242,1245,1246,1249,1250,1252],{},[154,1239,1240],{},"triggerTask"," executes immediately through the runner and records run history — it works\nfor paused\u002Fdisabled tasks too (explicit manual trigger). A manual run updates the task's\n",[154,1243,1244],{},"lastRunId","\u002F",[154,1247,1248],{},"lastRunAt"," but never touches the schedule (",[154,1251,507],{}," stays put).",[195,1254,1255],{},[150,1256,1257,1258,1261],{},"The call ",[186,1259,1260],{},"blocks until the run finishes"," for sync runners — the response is the\nterminal run. For long sync runs use a scheduled interval (or an async runner)\nif you need the HTTP call to return promptly.",[150,1263,1264,1267,1268,918,1271,1274,1275,1278],{},[154,1265,1266],{},"POST \u002Ftasks\u002F:name\u002Frun"," accepts an optional JSON body to pick the run's retention class,\nname the caller, and override its parameters (otherwise the run is ",[154,1269,1270],{},"temporary: false",[154,1272,1273],{},"triggeredBy: null"," with the task's default ",[154,1276,1277],{},"config.data","):",[167,1280,1283],{"className":1281,"code":1282,"language":172},[170],"POST \u002Ftasks\u002F:name\u002Frun\nContent-Type: application\u002Fjson\n{ \"temporary\": true, \"triggeredBy\": \"boss@books\", \"data\": { \"videoId\": \"v-42\" } }\n",[154,1284,1282],{"__ignoreMap":175},[265,1286,1287,1297,1309,1318],{},[268,1288,1289,1292,1293,229],{},[154,1290,1291],{},"temporary: true"," → short retention class (24h TTL, see ",[222,1294,1296],{"href":1295},"runs#retention","Runs → Retention",[268,1298,1299,1301,1302,1304,1305,1308],{},[154,1300,909],{}," → merged over the task's default ",[154,1303,1277],{}," (",[154,1306,1307],{},"{ ...config.data, ...data }",").\nThe worker is dispatched with the merged payload — the override reaches the\nrun's execution, not just the audit record.",[268,1310,1311,1313,1314,1317],{},[154,1312,925],{}," → caller-supplied audit identity (string or null; absent\u002Fnull =\nanonymous). sched is identity-agnostic — it does not verify the value\n(caller-declared, audit-grade not auth-grade); embedded callers pass it to\n",[154,1315,1316],{},"triggerTask(name, { triggeredBy })"," directly.",[268,1319,1320,1321,303],{},"Malformed \u002F non-object body → ",[154,1322,671],{},[195,1324,1325],{},[150,1326,1327,572,1330,1332,1333,1336,1337,1339],{},[154,1328,1329],{},"POST \u002Ftasks\u002F:name\u002Fschedule",[186,1331,1196],{},": it answers ",[154,1334,1335],{},"404"," pointing at\n",[154,1338,336],{}," below. Imperative schedules are created there — one schedule\nper rule, each with its own data\u002Fpolicy.",[398,1341,1343],{"id":1342},"schedules-schedule-as-entity","Schedules (schedule-as-entity)",[167,1345,1348],{"className":1346,"code":1347,"language":172},[170],"POST   \u002Fschedules                → create\u002Fupsert, { schedule } — 201 created \u002F 200 updated\nGET    \u002Fschedules?limit=&offset= → { schedules } (id ASC, limit capped at 1000)\nGET    \u002Fschedules\u002F:id            → ScheduleRecord | 404\nDELETE \u002Fschedules\u002F:id            → 204 | 404 (remove a schedule; runs keep their history)\nPOST   \u002Fschedules\u002F:id\u002Fpause      → { ok } | 404\nPOST   \u002Fschedules\u002F:id\u002Fresume     → { ok } | 404\n",[154,1349,1347],{"__ignoreMap":175},[150,1351,1352,1353,1356,1357,1359,1360,1362],{},"A ",[186,1354,1355],{},"schedule"," is one firing rule of a task with its own ",[154,1358,909],{},"\u002Fpolicy — the\nentity that replaced the task's single ",[154,1361,1355],{}," field (one task, one\nschedule per channel).",[897,1364,336],{"id":1365},"post-schedules",[167,1367,1370],{"className":1368,"code":1369,"language":172},[170],"POST \u002Fschedules\nContent-Type: application\u002Fjson\n\n{\n  \"taskName\": \"sync-channel-stats\",\n  \"schedule\": {\n    \"cron\": \"0 9 * * *\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"externalId\": \"ada\",\n    \"dedupKey\": \"channel-ada\"\n  }\n}\n\n→ 201\n\n{\n  \"schedule\": {\n    \"id\": \"...uuid...\",\n    \"taskName\": \"sync-channel-stats\",\n    \"schedule\": { \"cron\": \"0 9 * * *\" },\n    \"tz\": \"UTC\",\n    \"data\": { \"channelId\": \"UC-ada\" },\n    \"nextRunAt\": \"...\",\n    \"fileManaged\": false,\n    ...\n  }\n}\n",[154,1371,1369],{"__ignoreMap":175},[265,1373,1374,1398,1416,1427],{},[268,1375,1038,1376,1379,1380,1382,1383,1385,1386,1389,1390,1393,1394,1397],{},[154,1377,1378],{},"{ taskName, schedule: { cron | interval | once, timezone?, data?, externalId?, dedupKey?, retry?, priority? }, tz? }"," — the ",[154,1381,1355],{}," object is the same shape as a\n",[154,1384,499],{}," schedules element. ",[154,1387,1388],{},"tz"," defaults to the ",[186,1391,1392],{},"task's"," timezone; an inner\n",[154,1395,1396],{},"timezone"," on cron overrides it.",[268,1399,1400,1405,1406,1408,1409,1412,1413,1415],{},[186,1401,1402,1404],{},[154,1403,343],{}," is the idempotent upsert handle",": a second POST with the same key updates\nthe existing schedule in place (its id is preserved) and answers ",[154,1407,532],{},"; a fresh schedule\nanswers ",[154,1410,1411],{},"201",". Without a ",[154,1414,343],{}," every POST creates a new schedule.",[268,1417,1418,1419,1421,1422,1424,1425,303],{},"Validation is identical to ",[154,1420,499],{}," (fail-fast): unknown task → ",[154,1423,1335],{},"; a malformed\nschedule, bad tz, invalid policy → ",[154,1426,671],{},[268,1428,1429,1430,1304,1433,1435,1436,303],{},"Created schedules are ",[186,1431,1432],{},"runtime-owned",[154,1434,1208],{},") — sync never disables\nthem; remove one with ",[154,1437,1438],{},"DELETE \u002Fschedules\u002F:id",[897,1440,1442],{"id":1441},"get-schedules","GET \u002Fschedules",[150,1444,1445,1446,1449],{},"Returns every schedule as a first-class row: ",[154,1447,1448],{},"id\u002FtaskName\u002Fschedule\u002Ftz\u002Fdata\u002FexternalId\u002F dedupKey\u002FnextRunAt\u002FlastRunAt\u002FlastRunId\u002FfailCount\u002FretryCount\u002Fpriority\u002Fretry\u002Fpaused\u002Fdisabled","\nplus two resolved fields (no N+1 — three reads total):",[265,1451,1452,1461],{},[268,1453,1454,1457,1458,1460],{},[154,1455,1456],{},"lastRunStatus"," — how the schedule's most recent run ended (",[154,1459,564],{}," when it has no run,\nor its last run fell out of the recent window; listRuns is recent-first, capped at 1000).",[268,1462,1463,1379,1466,525,1469,1472,1473,1476,1477,1480],{},[154,1464,1465],{},"effectiveStatus",[186,1467,1468],{},"AND-semantics made visible",[154,1470,1471],{},"'paused-task'","\n(the family stop holds), ",[154,1474,1475],{},"'paused-schedule'"," (only this instance), or ",[154,1478,1479],{},"'active'",". T