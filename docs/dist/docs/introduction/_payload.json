title":137,"path":138,"stem":139},"Security (allowedTools)","\u002Fdocs\u002Fsecurity","docs\u002F14.security",{"id":141,"title":10,"body":142,"description":470,"extension":471,"links":472,"meta":473,"navigation":474,"path":11,"seo":475,"stem":12,"__hash__":476},"docs\u002Fdocs\u002F01.introduction.md",{"type":143,"value":144,"toc":463},"minimark",[145,165,170,177,214,222,226,335,339,342,363,370,374,384,423,427],[146,147,148,152,153,156,157,160,161,164],"p",{},[149,150,151],"strong",{},"sched"," is a cron scheduler done right: ",[149,154,155],{},"reliable delivery",", ",[149,158,159],{},"run history",", and a\n",[149,162,163],{},"web UI"," — self-hosted, queue-based, polyglot-ready.",[166,167,169],"h2",{"id":168},"why-sched","Why sched",[146,171,172,173,176],{},"\"Fire and forget\" is not enough for a scheduler. sched's promise — ",[149,174,175],{},"the scheduler knows\neverything about every run",":",[178,179,180,192,198,204],"ul",{},[181,182,183,186,187,191],"li",{},[149,184,185],{},"Input"," — with what parameters the task was invoked (",[188,189,190],"code",{},"data",")",[181,193,194,197],{},[149,195,196],{},"Progress"," — 0–100 progress and captured stdout\u002Fstderr log",[181,199,200,203],{},[149,201,202],{},"Outcome"," — JSON result, error, artifacts (S3 keys, email receipts, URLs)",[181,205,206,209,210,213],{},[149,207,208],{},"Lifecycle"," — ",[188,211,212],{},"queued → running → succeeded | failed | cancelled",", timestamps, duration",[146,215,216,217,221],{},"Runs survive restarts, locks are reaped, and every run is recorded in the storage — SQLite\nby default, or MySQL\u002FMariaDB, Postgres or Mongo when history must live in an existing\ndatabase (each is a separate package, see ",[218,219,71],"a",{"href":220},"storage",").",[166,223,225],{"id":224},"key-features","Key features",[178,227,228,238,265,275,285,295,309,318,327],{},[181,229,230,233,234,237],{},[149,231,232],{},"Cron scheduling"," with timezone support (",[188,235,236],{},"tz",") and DST-safe next-run calculation",[181,239,240,243,244,247,248,156,250,156,253,156,256,156,259,156,262],{},[149,241,242],{},"Run history"," (",[188,245,246],{},"RunRecord","): ",[188,249,190],{},[188,251,252],{},"result",[188,254,255],{},"error",[188,257,258],{},"progress",[188,260,261],{},"log",[188,263,264],{},"artifacts",[181,266,267,270,271,274],{},[149,268,269],{},"Pluggable storage"," — SQLite first (in ",[188,272,273],{},"@schedjs\u002Fcore","), MySQL\u002FMariaDB, Postgres and\nMongo as separate adapter packages, all with a contract test-suite",[181,276,277,280,281,284],{},[149,278,279],{},"Polyglot runners"," — HTTP, Docker, and any custom runner you write against the ",[188,282,283],{},"Runner"," contract",[181,286,287,290,291,191],{},[149,288,289],{},"Embedded mode"," — schedule in-process functions with the internal runner; no daemon, no Docker (see ",[218,292,294],{"href":293},"quick-start#1-embedded-schedule-functions-in-process","quick start",[181,296,297,209,300,303,304,308],{},[149,298,299],{},"Retries with backoff",[188,301,302],{},"retry: { maxAttempts, backoffMs, multiplier }"," per task; a ",[305,306,307],"em",{},"persistent"," failure is one where retries ran out",[181,310,311,209,314,317],{},[149,312,313],{},"Idempotent dispatch",[188,315,316],{},"x-sched-run-id"," on the wire; workers dedupe by run id",[181,319,320,209,323,326],{},[149,321,322],{},"Async runs",[188,324,325],{},"202 accepted"," + polling for long-running jobs",[181,328,329,331,332,334],{},[149,330,113],{}," + ",[149,333,163],{}," (web components) — see runs, tasks, status",[166,336,338],{"id":337},"three-ways-to-run","Three ways to run",[146,340,341],{},"Pick by scale — the engine underneath is the same, so run history, retries and alerts\nwork on every path:",[343,344,345,351,357],"ol",{},[181,346,347,350],{},[149,348,349],{},"Embedded"," — schedule functions in-process, zero infra (SQLite file + handlers).",[181,352,353,356],{},[149,354,355],{},"Standalone daemon"," — own process with HTTP\u002FDocker workers, admin UI, alerts.",[181,358,359,362],{},[149,360,361],{},"Docker"," — the daemon in a container, compose-friendly, self-hosting.",[146,364,365,366,369],{},"See ",[218,367,14],{"href":368},"quick-start"," to run your first task on any of them.",[166,371,373],{"id":372},"architecture","Architecture",[375,376,381],"pre",{"className":377,"code":379,"language":380},[378],"language-text","            tasks.json (desired state)\n                    │ sync\n                    ▼\n   ┌────────────┐   tick\u002Fwatchdog\u002Fpoll    ┌───────────────────────────────┐\n   │   Engine   │ ──────────────────────▶ │      Runners (execution)      │\n   │ (scheduler)│   claim → run → record  │ http · docker · process · ssh │\n   │            │                         │ mcp · internal · custom       │\n   └─────┬──────┘                         └───────────────────────────────┘\n         │ storage seam\n         ▼\n   ┌───────────────────────┐    ┌──────────────────────────────────────┐\n   │        Storage        │    │  Daemon (CLI + Admin API + UI)       │\n   │ sqlite\u002Fmysql\u002Fpg\u002Fmongo │    │ --admin-port · SCHED_ADMIN_KEY       │\n   └───────────────────────┘    └──────────────────────────────────────┘\n","text",[188,382,379],{"__ignoreMap":383},"",[178,385,386,392,405,413],{},[181,387,388,391],{},[149,389,390],{},"Engine"," — deterministic tick loop + zombie watchdog over the storage seam. Claims due\ntasks, dispatches to the runner, records outcomes, reaps stale locks.",[181,393,394,396,397,400,401,404],{},[149,395,31],{}," — own ",[305,398,399],{},"how"," a task runs. HTTP (request\u002Fresponse, sync or ",[188,402,403],{},"accepted"," + poll),\nDocker (container spawn), or your own in-process function.",[181,406,407,409,410,412],{},[149,408,71],{}," — the ",[188,411,71],{}," contract: tasks, runs, locking. SQLite, MySQL\u002FMariaDB,\nPostgres and Mongo implement it.",[181,414,415,418,419,422],{},[149,416,417],{},"Daemon"," — loads ",[188,420,421],{},"tasks.json"," (desired state), syncs it, runs the engine, serves the\nadmin API and the web UI.",[166,424,426],{"id":425},"where-to-go-next","Where to go next",[178,428,429,434,442,450,456],{},[181,430,431,433],{},[218,432,14],{"href":368}," — run your first scheduled task in 3 minutes",[181,435,436,409,439,441],{},[218,437,19],{"href":438},"tasks",[188,440,421],{}," format and scheduling",[181,443,444,447,448],{},[218,445,23],{"href":446},"runs"," — the run lifecycle and ",[188,449,246],{},[181,451,452,455],{},[218,453,31],{"href":454},"runners\u002Fhttp"," — HTTP \u002F Docker \u002F custom runners",[181,457,458,462],{},[218,459,461],{"href":460},"protocol","Protocol"," — the wire contract between sched and workers",{"title":383,"searchDepth":17,"depth":17,"links":464},[465,466,467,468,469],{"id":168,"depth":17,"text":169},{"id":224,"depth":17,"text":225},{"id":337,"depth":17,"text":338},{"id":372,"depth":17,"text":373},{"id":425,"depth":17,"text":426},"What sched is and how it works","md",null,{},true,{"title":10,"description":470},"-jiCOdgxzLCZGqlMT8gY4y5Y_dYd5IVQ-UCDarh8Yo8",[478,480],{"title":5,"path":6,"stem":7,"description":479,"order":8,"children":-1},"Version history — release notes for every sched wave, newest first",{"title":14,"path":15,"stem":16,"description":481,"order":17,"children":-1},"Three ways to run sched — pick your scale",1788099622596]